test "elements render with their attributes and children, void ones without a closing tag" {
  let n = el("p", [("class", "lead")], [text("a "), tag("b", [text("bold")]), el("br", [], [])])
  assert(render(n) == "<p class=\"lead\">a <b>bold</b><br></p>")
}

test "a document has a doctype, a head with the title and the body" {
  assert(
    document("Hi", [text("x")]) ==
      "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Hi</title></head><body>x</body></html>\n",
  )
}

test "text and attribute values are escaped" {
  assert(
    render(text("<script>alert('x') & \"y\"</script>")) ==
      "&lt;script&gt;alert(&#39;x&#39;) &amp; &quot;y&quot;&lt;/script&gt;",
  )
  assert(
    render(link("\" onclick=\"evil()", "go")) == "<a href=\"&quot; onclick=&quot;evil()\">go</a>",
  )
}

test "no text opens a tag or ends an attribute"(s: Str) {
  let e = escape(s)
  assert(!e.contains("<") && !e.contains(">") && !e.contains("\"") && !e.contains("'"))
  assert(render(tag("p", [text(s)])) == "<p>" + e + "</p>")
}

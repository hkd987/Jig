import "std/time"

// Calendar dates: known moments, edges of the range, leap years, ISO 8601 both ways.

test "known moments format as ISO 8601 and HTTP dates" {
  assert(time.iso(0) == "1970-01-01T00:00:00.000Z")
  assert(time.iso(-1) == "1969-12-31T23:59:59.999Z")
  assert(time.iso(951782400000) == "2000-02-29T00:00:00.000Z")
  assert(time.iso(time.MIN_MS) == "0000-01-01T00:00:00.000Z")
  assert(time.iso(time.MAX_MS) == "9999-12-31T23:59:59.999Z")
  // RFC 9110's example.
  assert(time.http_date(784111777000) == "Sun, 06 Nov 1994 08:49:37 GMT")
  assert(time.weekday(0) == 4 && time.weekday(-86400000) == 3)
}

test "calendar fields and back" {
  let d = time.utc(1761643283250)
  assert(d.year == 2025 && d.month == 10 && d.day == 28 && d.hour == 9 && d.minute == 21)
  assert(d.second == 23 && d.ms == 250)
  assert(time.unix_ms(d) == 1761643283250)
  assert(time.is_leap(2000) && time.is_leap(2024) && !time.is_leap(1900) && !time.is_leap(2023))
  assert(time.days_in_month(2024, 2) == 29 && time.days_in_month(2023, 2) == 28)
  assert(time.days_in_month(2023, 4) == 30 && time.days_in_month(2023, 12) == 31)
}

test "ISO 8601 parses dates, times, fractions and offsets" {
  assert(time.parse_iso("1970-01-01") == Some(0))
  assert(time.parse_iso("1994-11-06T08:49:37Z") == Some(784111777000))
  assert(time.parse_iso("1994-11-06 08:49:37") == Some(784111777000))
  assert(time.parse_iso("1994-11-06T08:49:37.250Z") == Some(784111777250))
  assert(time.parse_iso("1994-11-06T09:49:37+01:00") == Some(784111777000))
  assert(time.parse_iso("1994-11-06T03:19:37-05:30") == Some(784111777000))
  for bad in [
    "",
    "1994-11-06T",
    "2023-02-29",
    "2024-13-01",
    "2024-00-10",
    "2024-01-32",
    "1994-11-06T24:00:00Z",
    "1994-11-06T08:60:00Z",
    "1994-11-06T08:49:37X",
    "19a4-11-06",
    "1994-11-06T08:49:37.25Z",
    "1994-11-06T08:49:37+0100",
  ] {
    assert(time.parse_iso(bad) == None)
  }
}

test "every moment in range reads back from ISO 8601"(ms: Int)
  requires ms >= time.MIN_MS, ms <= time.MAX_MS
{
  assert(time.parse_iso(time.iso(ms)) == Some(ms))
  let d = time.utc(ms)
  assert(time.unix_ms(d) == ms && d.day <= time.days_in_month(d.year, d.month))
}

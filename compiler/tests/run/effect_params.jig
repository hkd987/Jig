import "std/io"

/// Call `f` twice.
fn twice(f: fn() -> Int) -> Int effects {f} {
  return f() + f()
}

/// `f` applied to each, with `log`'s effects too.
fn each(xs: List<Int>, f: fn(Int), log: fn(Str)) effects {f, log} {
  for x in xs {
    f(x)
  }
  log("done")
}

struct Bag {
  xs: List<Int>
}

/// `f` on each item: a method's effect parameter.
fn Bag.each(self, f: fn(Int)) effects {f} {
  for x in self.xs {
    f(x)
  }
}

fn three() -> Int {
  return 3
}

fn loud() -> Int effects {io} {
  io.println("loud")
  return 1
}

fn passes_on(g: fn() -> Int) -> Int effects {g} {
  return twice(g)
}

fn main() effects {io} {
  io.println(twice(three).str())
  io.println(twice(loud).str())
  io.println(twice(fn() { 5 }).str())
  io.println(
    twice(fn() {
      io.println("closure")
      7
    }).str(),
  )
  io.println(passes_on(loud).str())
  each([1, 2], fn(x) { io.println(x.str()) }, fn(s) { io.println(s) })
  Bag { xs: [3, 4] }.each(fn(x) { io.println("item " + x.str()) })
  // Built-in methods take functions with effects too.
  let xs = [3, 1, 2]
  let doubled = xs.map(fn(x) {
    io.println("map " + x.str())
    x * 2
  })
  io.println(doubled.str())
  let small = xs.filter(fn(x) {
    io.println("keep " + x.str())
    x < 3
  })
  io.println(small.str())
  io.println(
    xs
      .fold(0, fn(a, x) {
        io.println("add " + x.str())
        a + x
      })
      .str(),
  )
  io.println(
    xs
      .any(fn(x) {
        io.println("any " + x.str())
        x == 1
      })
      .str(),
  )
  var sorted = xs
  sorted.sort_by(fn(a, b) {
    io.println("compare")
    a > b
  })
  io.println(sorted.str())
  io.println(
    Some(4)
      .map(fn(x) {
        io.println("some")
        x + 1
      })
      .str(),
  )
}

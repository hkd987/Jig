import "std/io"

fn word_counts(text: Str) -> Map<Str, Int> {
  var counts: Map<Str, Int> = Map.new()
  for line in text.lines() {
    for w in line.split(" ") {
      let word = w.trim().to_lower()
      if word.is_empty() {
        continue
      }
      counts.insert(word, counts.get(word).unwrap_or(0) + 1)
    }
  }
  return counts
}

fn top(counts: Map<Str, Int>, n: Int) -> List<(Str, Int)> {
  var es = counts.entries()
  es.sort_by(fn(a, b) { a.1 > b.1 || (a.1 == b.1 && a.0 < b.0) })
  es.truncate(n)
  return es
}

fn caesar(s: Str, shift: Int) -> Str {
  var out: List<Char> = []
  for c in s.chars() {
    if c.is_alpha() && c.is_lower() {
      let base = 'a' as Int
      let n = ((c as Int - base + shift) % 26 + 26) % 26
      out.push((base + n) as Char)
    } else {
      out.push(c)
    }
  }
  return Str.from_chars(out)
}

fn main() effects {io} {
  let text = "the cat sat on the mat\nThe dog sat\n  on  the log"
  for (w, c) in top(word_counts(text), 3) {
    io.println(w + " " + c.str())
  }
  let secret = caesar("hello, world", 3)
  io.println(secret + " / " + caesar(secret, -3))
  let parts = "a,b,,c".split(",")
  io.println(parts.len().str() + " " + parts.str())
  io.println(
    "abc"[1].str() + " " + "hello"[1..3] + " " + "x".repeat(3) + " " + "  pad ".trim() + "|",
  )
  match "42".to_int() {
    Some(n) => io.println((n * 2).str())
    None => io.println("nan")
  }
  io.println("forty".to_int().is_none().str())
  // Loops over split pieces, taken one at a time.
  for src in ["", ",", "a", ",a,", "a,,b"] {
    var seen: List<Str> = []
    for p in src.split(",") {
      seen.push("<" + p + ">")
    }
    io.println(seen.len().str() + " " + seen.str())
  }
  var s = "x--y--z"
  var n = 0
  for p in s.split("--") {
    s = s + "--w"
    n += 1
    if p == "z" {
      break
    }
  }
  io.println(n.str() + " " + s)
  var multi = ""
  for p in "héllo wörld".split("ö") {
    multi = multi + "[" + p + "]"
  }
  io.println(multi)
}

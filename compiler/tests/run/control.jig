import "std/io"

fn collatz(n: Int) -> Int
  requires n > 0
{
  var steps = 0
  var x = n
  for x != 1 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = 3 * x + 1
    }
    steps += 1
  }
  return steps
}

fn first_square_above(limit: Int) -> Int {
  var i = 0
  for {
    i += 1
    if i * i <= limit {
      continue
    }
    break
  }
  return i
}

fn classify(p: (Int, Int)) -> Str {
  return match p {
    (0, 0) => "origin"
    (0, _) | (_, 0) => "axis"
    (x, y) if x == y => "diagonal"
    _ => "plane"
  }
}

fn sum_to(n: Int) -> Int
  requires n >= 0
  ensures result == n * (n - 1) / 2
{
  var total = 0
  for i in 0..n invariant total == i * (i - 1) / 2 {
    total += i
  }
  return total
}

fn main() effects {io} {
  io.println(collatz(27).str())
  io.println(first_square_above(50).str())
  for p in [(0, 0), (0, 3), (2, 2), (1, 5)] {
    io.println(classify(p))
  }
  io.println(sum_to(100).str())
  let evens = forall i in 0..4: [0, 2, 4, 6][i] % 2 == 0
  let any_big = exists i in 0..3: [1, 9, 2][i] > 5
  io.println(evens.str() + " " + any_big.str())
  var counts = [0, 0, 0]
  for i in 0..10 {
    counts[i % 3] += 1
  }
  io.println(counts.str())
}

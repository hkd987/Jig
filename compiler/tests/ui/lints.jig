pub fn Shadowing(x: Int) -> Int { //~ E0504
  let BadName = 1 //~ E0504
  let y = x
  for i in 0..3 {
    let y = i //~ E0505
    if y > 1 {
      return y + BadName
    }
  }
  return y
}


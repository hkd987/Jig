pub struct Point {
  pub x: Int
  pub y: Int
}

pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}

pub fn norm(p: Point) -> Int { //~ E0603
  return p.x * p.x + p.y * p.y
}

pub fn dist(p: Point) -> Int {
  return norm(p)
}

fn secret() -> Int {
  return 7
}

pub fn uses_secret() -> Int {
  return secret()
}

pub const ORIGIN_X: Int = 0 //~ E0603

pub struct Hidden { //~ E0603
  n: Int
}

pub interface Sized { //~ E0603
  fn size(self) -> Int
}

fn Hidden.size(self) -> Int {
  return self.n
}

fn measure<T: Sized>(x: T) -> Int {
  return x.size()
}

pub fn hidden_size() -> Int {
  return measure(Hidden { n: ORIGIN_X })
}

import "std/io"
import "std/time"

pub fn pure_but_prints() {
  io.println("hi") //~ E0401
}

pub fn declared() effects {io} {
  io.println("hi")
}

pub fn too_many() effects {io, fs} { //~ E0403
  io.println("hi")
}

pub fn calls_effectful() {
  declared() //~ E0401
}

pub fn unknown() effects {disk} { //~ E0402
}

pub fn closures(xs: List<Int>) -> List<Int> effects {io} {
  let f: fn(Int) -> Int = fn(x) {
    io.println(x.str()) //~ E0401
    x
  }
  return xs.map(f)
}

pub fn clock_in_contract() -> Int
  requires time.now_ms() > 0 //~ E0321
{
  return 1
}

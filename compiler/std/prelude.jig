pub fn I32.max(self, other: I32) -> I32
pub fn I32.wrapping_add(self, other: I32) -> I32
pub fn I32.wrapping_sub(self, other: I32) -> I32
pub fn I32.wrapping_mul(self, other: I32) -> I32

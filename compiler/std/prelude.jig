// The prelude: names every package can use without an import.
// Functions without a body are compiler intrinsics.

pub enum Option<T> {
  Some(value: T)
  None
}

pub enum Result<T, E> {
  Ok(value: T)
  Err(error: E)
}

/// Aborts the program with `msg`.
pub fn panic(msg: Str) -> Never

/// Aborts the program if `cond` is false. Also a proof obligation.
pub fn assert(cond: Bool)

pub fn min<T: Ord>(a: T, b: T) -> T
  ensures result == a || result == b
{
  if b < a {
    return b
  }
  return a
}

pub fn max<T: Ord>(a: T, b: T) -> T
  ensures result == a || result == b
{
  if b > a {
    return b
  }
  return a
}

// ---- Option ----

pub fn Option<T>.is_some(self) -> Bool
  ensures result != self.is_none()
{
  return match self {
    Some(_) => true
    None => false
  }
}

pub fn Option<T>.is_none(self) -> Bool
  ensures result != self.is_some()
{
  return match self {
    Some(_) => false
    None => true
  }
}

pub fn Option<T>.unwrap(self) -> T
  requires self.is_some()
{
  return match self {
    Some(v) => v
    None => panic("called unwrap() on None")
  }
}

pub fn Option<T>.unwrap_or(self, default: T) -> T {
  return match self {
    Some(v) => v
    None => default
  }
}

pub fn Option<T>.ok_or<E>(self, err: E) -> Result<T, E>
  ensures result.is_ok() == self.is_some()
{
  return match self {
    Some(v) => Ok(v)
    None => Err(err)
  }
}

pub fn Option<T>.map<U>(self, f: fn(T) -> U) -> Option<U>
  ensures result.is_some() == self.is_some()
{
  return match self {
    Some(v) => Some(f(v))
    None => None
  }
}

// ---- Result ----

pub fn Result<T, E>.is_ok(self) -> Bool
  ensures result != self.is_err()
{
  return match self {
    Ok(_) => true
    Err(_) => false
  }
}

pub fn Result<T, E>.is_err(self) -> Bool
  ensures result != self.is_ok()
{
  return match self {
    Ok(_) => false
    Err(_) => true
  }
}

pub fn Result<T, E>.unwrap(self) -> T
  requires self.is_ok()
{
  return match self {
    Ok(v) => v
    Err(_) => panic("called unwrap() on Err")
  }
}

pub fn Result<T, E>.unwrap_or(self, default: T) -> T {
  return match self {
    Ok(v) => v
    Err(_) => default
  }
}

pub fn Result<T, E>.ok(self) -> Option<T>
  ensures result.is_some() == self.is_ok()
{
  return match self {
    Ok(v) => Some(v)
    Err(_) => None
  }
}

pub fn Result<T, E>.map<U>(self, f: fn(T) -> U) -> Result<U, E>
  ensures result.is_ok() == self.is_ok()
{
  return match self {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

pub fn Result<T, E>.map_err<F>(self, f: fn(E) -> F) -> Result<T, F>
  ensures result.is_ok() == self.is_ok()
{
  return match self {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}


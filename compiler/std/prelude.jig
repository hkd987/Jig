pub fn U32.max(self, other: U32) -> U32
pub fn U32.wrapping_add(self, other: U32) -> U32
pub fn U32.wrapping_sub(self, other: U32) -> U32
pub fn U32.wrapping_mul(self, other: U32) -> U32
pub fn U64.min(self, other: U64) -> U64
pub fn U64.max(self, other: U64) -> U64
pub fn U64.wrapping_add(self, other: U64) -> U64
pub fn U64.wrapping_sub(self, other: U64) -> U64
pub fn U64.wrapping_mul(self, other: U64) -> U64


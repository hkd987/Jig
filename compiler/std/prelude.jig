pub fn Char.to_lower(self) -> Char

// ---- Str ----

pub fn Str.len(self) -> Int
pub fn Str.is_empty(self) -> Bool
pub fn Str.contains(self, part: Str) -> Bool
pub fn Str.starts_with(self, prefix: Str) -> Bool
pub fn Str.ends_with(self, suffix: Str) -> Bool
pub fn Str.find(self, part: Str) -> Option<Int>
pub fn Str.split(self, sep: Str) -> List<Str>
pub fn Str.lines(self) -> List<Str>
pub fn Str.trim(self) -> Str
pub fn Str.replace(self, from: Str, to: Str) -> Str
pub fn Str.repeat(self, n: Int) -> Str
pub fn Str.to_upper(self) -> Str
pub fn Str.to_lower(self) -> Str
pub fn Str.to_int(self) -> Option<Int>
pub fn Str.to_float(self) -> Option<Float>
pub fn Str.bytes(self) -> List<U8>
pub fn Str.chars(self) -> List<Char>
pub fn Str.from_chars(chars: List<Char>) -> Str
pub fn Str.from_bytes(bytes: List<U8>) -> Option<Str>

// ---- List ----

pub fn List<T>.new() -> List<T>
pub fn List<T>.len(self) -> Int
pub fn List<T>.is_empty(self) -> Bool
pub fn List<T>.push(&mut self, item: T)
pub fn List<T>.pop(&mut self) -> Option<T>
pub fn List<T>.get(self, index: Int) -> Option<T>
pub fn List<T>.insert(&mut self, index: Int, item: T)
pub fn List<T>.remove(&mut self, index: Int) -> T
pub fn List<T>.clear(&mut self)
pub fn List<T>.extend(&mut self, other: List<T>)
pub fn List<T>.reverse(&mut self)
pub fn List<T>.swap(&mut self, i: Int, j: Int)
pub fn List<T>.truncate(&mut self, len: Int)
pub fn List<T>.repeat(self, n: Int) -> List<T>
pub fn List<T: Ord>.sort(&mut self)

pub fn List<T>.first(self) -> Option<T>
  ensures result.is_some() == !self.is_empty()
{
  return self.get(0)
}

pub fn List<T>.last(self) -> Option<T>
  ensures result.is_some() == !self.is_empty()
{
  return self.get(self.len() - 1)
}

pub fn List<T: Eq>.contains(self, item: T) -> Bool
  ensures !result || !self.is_empty()
{
  for x in self {
    if x == item {
      return true
    }
  }
  return false
}

pub fn List<T: Eq>.index_of(self, item: T) -> Option<Int>
  ensures result.is_none() || (result.unwrap() >= 0 && result.unwrap() < self.len())
{
  for i in 0..self.len() {
    if self[i] == item {
      return Some(i)
    }
  }
  return None
}

/// Sorts by a strict "less than" comparison, stably.
pub fn List<T>.sort_by(&mut self, less: fn(T, T) -> Bool)

pub fn List<T>.map<U>(self, f: fn(T) -> U) -> List<U>
  ensures result.len() == self.len()
{
  var out: List<U> = []
  for i in 0..self.len() invariant out.len() == i {
    out.push(f(self[i]))
  }
  return out
}

pub fn List<T>.filter(self, keep: fn(T) -> Bool) -> List<T>
  ensures result.len() <= self.len()
{
  var out: List<T> = []
  for i in 0..self.len() invariant out.len() <= i {
    if keep(self[i]) {
      out.push(self[i])
    }
  }
  return out
}

pub fn List<T>.fold<A>(self, init: A, f: fn(A, T) -> A) -> A {
  var acc = init
  for x in self {
    acc = f(acc, x)
  }
  return acc
}

pub fn List<T>.any(self, pred: fn(T) -> Bool) -> Bool
  ensures !result || !self.is_empty()
{
  for x in self {
    if pred(x) {
      return true
    }
  }
  return false
}

pub fn List<T>.all(self, pred: fn(T) -> Bool) -> Bool
  ensures result || !self.is_empty()
{
  for x in self {
    if !pred(x) {
      return false
    }
  }
  return true
}

pub fn List<T: Show>.join(self, sep: Str) -> Str
  ensures !self.is_empty() || result == ""
{
  var out = ""
  for i in 0..self.len() invariant i > 0 || out == "" {
    if i > 0 {
      out = out + sep
    }
    out = out + self[i].str()
  }
  return out
}

// ---- Map ----

pub fn Map<K: Hash, V>.new() -> Map<K, V>
pub fn Map<K: Hash, V>.len(self) -> Int
pub fn Map<K: Hash, V>.is_empty(self) -> Bool
pub fn Map<K: Hash, V>.get(self, key: K) -> Option<V>
pub fn Map<K: Hash, V>.insert(&mut self, key: K, value: V)
pub fn Map<K: Hash, V>.remove(&mut self, key: K) -> Option<V>
pub fn Map<K: Hash, V>.contains(self, key: K) -> Bool
pub fn Map<K: Hash, V>.keys(self) -> List<K>
pub fn Map<K: Hash, V>.values(self) -> List<V>
pub fn Map<K: Hash, V>.entries(self) -> List<(K, V)>

// ---- Set ----

pub fn Set<T: Hash>.new() -> Set<T>
pub fn Set<T: Hash>.len(self) -> Int
pub fn Set<T: Hash>.is_empty(self) -> Bool
pub fn Set<T: Hash>.insert(&mut self, item: T)
pub fn Set<T: Hash>.remove(&mut self, item: T) -> Bool
pub fn Set<T: Hash>.contains(self, item: T) -> Bool
pub fn Set<T: Hash>.items(self) -> List<T>

// Pure math functions.

pub const PI: Float = 3.141592653589793
pub const E: Float = 2.718281828459045

pub fn sin(x: Float) -> Float
pub fn cos(x: Float) -> Float
pub fn tan(x: Float) -> Float
pub fn atan2(y: Float, x: Float) -> Float
pub fn exp(x: Float) -> Float
pub fn ln(x: Float) -> Float
pub fn log10(x: Float) -> Float
pub fn pow(x: Float, y: Float) -> Float

// ---- integers, written in Jig ----

/// The greatest common divisor of two non-negative numbers (`gcd(0, 0)` is 0).
pub fn gcd(a: Int, b: Int) -> Int
  requires a >= 0, b >= 0
  ensures result >= 0
{
  var x = a
  var y = b
  for y != 0 invariant x >= 0 && y >= 0 {
    let r = x % y
    x = y
    y = r
  }
  return x
}

/// `x`, limited to `lo` and `hi`.
pub fn clamp(x: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
  ensures result >= lo && result <= hi
{
  if x < lo {
    return lo
  }
  if x > hi {
    return hi
  }
  return x
}

/// -1, 0 or 1: the sign of `x`.
pub fn sign(x: Int) -> Int
  ensures result >= -1 && result <= 1
{
  if x < 0 {
    return -1
  }
  if x > 0 {
    return 1
  }
  return 0
}

/// The integer square root: the largest `r` with `r * r <= n`.
pub fn isqrt(n: Int) -> Int
  requires n >= 0
  ensures result >= 0 && result * result <= n
{
  // 3037000499 is the largest number whose square fits in an `Int`.
  var lo = 0
  var hi = min(n, 3037000499) + 1
  for hi - lo > 1 invariant lo >= 0 && lo < hi && hi <= 3037000500 && lo * lo <= n {
    let mid = lo + (hi - lo) / 2
    if mid * mid <= n {
      lo = mid
    } else {
      hi = mid
    }
  }
  return lo
}

/// `base` to the power `exp`, modulo `m`, without overflow (`m` at most 3037000499).
pub fn pow_mod(base: Int, exp: Int, m: Int) -> Int
  requires exp >= 0, m > 0, m <= 3037000499
  ensures result >= 0 && result < m
{
  var acc = 1 % m
  var b = (base % m + m) % m
  var e = exp
  for e > 0 invariant acc >= 0 && acc < m && b >= 0 && b < m && e >= 0 {
    if e % 2 == 1 {
      acc = acc * b % m
    }
    b = b * b % m
    e = e / 2
  }
  return acc
}

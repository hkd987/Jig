import "std/io"

fn to_roman(n: Int) -> Str
  requires n >= 1 && n <= 3999
{
  let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
  let names = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
  var rest = n
  var out = ""
  for i in 0..values.len() {
    for rest >= values[i] {
      out = out + names[i]
      rest -= values[i]
    }
  }
  return out
}

fn digit(c: Char) -> Option<Int> {
  return match c {
    'I' => Some(1)
    'V' => Some(5)
    'X' => Some(10)
    'L' => Some(50)
    'C' => Some(100)
    'D' => Some(500)
    'M' => Some(1000)
    _ => None
  }
}

/// A numeral in standard form: converting the value back gives the same text.
fn from_roman(s: Str) -> Option<Int> {
  let cs = s.chars()
  var total = 0
  for i in 0..cs.len() {
    let v = digit(cs[i])?
    if total > 4000 {
      return None
    }
    if i + 1 < cs.len() && v < digit(cs[i + 1])? {
      total -= v
    } else {
      total += v
    }
  }
  if total < 1 || total > 3999 || to_roman(total) != s {
    return None
  }
  return Some(total)
}

fn convert(line: Str) -> Str {
  return match line.to_int() {
    Some(n) => if n >= 1 && n <= 3999 { to_roman(n) } else { "invalid" }
    None => match from_roman(line) {
      Some(n) => n.str()
      None => "invalid"
    }
  }
}

fn main() effects {io} {
  for line in io.read_all().lines() {
    io.println(convert(line.trim()))
  }
}

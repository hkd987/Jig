import "std/io"
import "std/os"

fn a(i: Int, j: Int) -> Float
  requires 0 <= i && i < 100000 && 0 <= j && j < 100000
{
  return 1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as Float)
}

fn mul_av(v: List<Float>, out: &mut List<Float>)
  requires v.len() < 100000 && out.len() == v.len()
  ensures out.len() == v.len()
{
  let n = v.len()
  for i in 0..n {
    var s = 0.0
    for j in 0..n {
      s += a(i, j) * v[j]
    }
    out[i] = s
  }
}

fn mul_atv(v: List<Float>, out: &mut List<Float>)
  requires v.len() < 100000 && out.len() == v.len()
  ensures out.len() == v.len()
{
  let n = v.len()
  for i in 0..n {
    var s = 0.0
    for j in 0..n {
      s += a(j, i) * v[j]
    }
    out[i] = s
  }
}

fn mul_atav(v: List<Float>, out: &mut List<Float>, tmp: &mut List<Float>)
  requires v.len() < 100000 && out.len() == v.len() && tmp.len() == v.len()
  ensures out.len() == v.len() && tmp.len() == v.len()
{
  mul_av(v, &mut tmp)
  mul_atv(tmp, &mut out)
}

fn main() effects {io, env} {
  let args = os.args()
  let n = if args.len() > 1 { args[1].to_int().unwrap_or(100) } else { 100 }
  if n < 1 || n > 10000 {
    io.println("n must be between 1 and 10000")
    return
  }
  var u = [1.0].repeat(n)
  var v = [0.0].repeat(n)
  var tmp = [0.0].repeat(n)
  for _k in 0..10 invariant u.len() == n && v.len() == n && tmp.len() == n {
    mul_atav(u, &mut v, &mut tmp)
    mul_atav(v, &mut u, &mut tmp)
  }
  var vbv = 0.0
  var vv = 0.0
  for i in 0..n {
    vbv += u[i] * v[i]
    vv += v[i] * v[i]
  }
  io.println((vbv / vv).sqrt().str())
}

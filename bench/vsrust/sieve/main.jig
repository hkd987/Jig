import "std/io"
import "std/os"

fn main() effects {io, env} {
  let args = os.args()
  let n = if args.len() > 1 { args[1].to_int().unwrap_or(1000) } else { 1000 }
  var composite: List<Bool> = []
  for _i in 0..n + 1 {
    composite.push(false)
  }
  var count = 0
  var sum = 0
  for i in 2..n + 1 {
    if !composite[i] {
      count += 1
      sum += i
      var j = i * i
      for j <= n {
        composite[j] = true
        j += i
      }
    }
  }
  io.println(count.str() + " primes, sum " + sum.str())
}

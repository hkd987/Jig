import "std/io"
import "std/os"

// Count words in generated text, then print the ten most common.

fn word(seed: Int) -> Str {
  let syllables = ["ka", "lo", "mi", "ne", "ru", "ta", "vo", "zi"]
  var w = ""
  var s = seed
  for _i in 0..1 + s % 3 {
    w = w + syllables[s % 8]
    s = s / 8
  }
  return w
}

fn main() effects {io, env} {
  let args = os.args()
  let n = if args.len() > 1 { args[1].to_int().unwrap_or(1000) } else { 1000 }
  var state = 12345
  var text = ""
  for _i in 0..n {
    state = (state * 1103515245 + 12345) % 2147483648
    text = text + word(state / 65536 % 4096) + " "
  }
  var counts: Map<Str, Int> = Map.new()
  for w in text.split(" ") {
    if !w.is_empty() {
      counts.insert(w, counts.get(w).unwrap_or(0) + 1)
    }
  }
  var es = counts.entries()
  es.sort_by(fn(a, b) { a.1 > b.1 || (a.1 == b.1 && a.0 < b.0) })
  io.println(counts.len().str() + " distinct words")
  for i in 0..min(10, es.len()) {
    io.println(es[i].0 + " " + es[i].1.str())
  }
}

import "std/fs"
import "std/io"
import "std/os"
import "syntax"

// jigc: the Jig compiler, written in Jig. So far it lexes and parses: `jigc tokens FILE` and
// `jigc ast FILE` print the same text as `jig debug tokens FILE` and `jig debug ast FILE`.

fn main() effects {io, fs, env} {
  let args = os.args()
  if args.len() < 3 || (args[1] != "tokens" && args[1] != "ast") {
    io.eprintln("usage: jigc tokens|ast FILE")
    os.exit(2)
  }
  match fs.read(args[2]) {
    Ok(src) => io.print(
      if args[1] == "tokens" { syntax.dump_tokens(src) } else { syntax.dump_ast(src) },
    )
    Err(e) => {
      io.eprintln(e)
      os.exit(1)
    }
  }
}

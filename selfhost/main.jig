import "sema"
import "std/io"
import "std/os"

// jigc: the Jig compiler, written in Jig. Its commands take the same arguments as `jig`'s and
// print the same; `jigc debug ...` prints the dumps the tests compare with `jig debug ...`, and
// `jigc cc DIR` the one C file that is `bootstrap/jigc.c` for `selfhost` (see `sema/cli.jig`).

fn main() effects {io, fs, net, clock, env, ffi} {
  let args = os.args()
  let o = sema.run_cli(
    args[1..args.len()],
    os.env("PWD").unwrap_or(""),
    os.env("JIG_STD").unwrap_or(""),
  )
  io.print(o.out)
  if !o.err.is_empty() {
    // Standard error has no print without a line break.
    io.eprintln(if o.err.ends_with("\n") { o.err[0..o.err.len() - 1] } else { o.err })
  }
  if o.code != 0 {
    os.exit(o.code)
  }
}

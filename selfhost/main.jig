import "std/fs"
import "std/io"
import "std/os"
import "syntax"

// jigc: the Jig compiler, written in Jig. So far: `jigc tokens FILE` prints the tokens,
// comments, blank lines and errors of a file, in the same format as `jig debug tokens`.

fn dump_tokens(src: Str) -> Str {
  let lx = syntax.lex(src, 0)
  var out = ""
  for t in lx.tokens {
    out = out + "token " + t.kind.str() + " " + t.lo.str() + " " + t.hi.str() + "\n"
  }
  for c in lx.comments {
    out = out +
      "comment " +
      c.lo.str() +
      " " +
      c.hi.str() +
      " " +
      c.doc.str() +
      " " +
      c.trailing.str() +
      "\n"
  }
  for b in lx.blank_lines {
    out = out + "blank " + b.str() + "\n"
  }
  for e in lx.errors {
    out = out + "error " + e.code + " " + e.lo.str() + " " + e.hi.str() + " " + e.msg + "\n"
  }
  return out
}

fn main() effects {io, fs, env} {
  let args = os.args()
  if args.len() < 3 || args[1] != "tokens" {
    io.eprintln("usage: jigc tokens FILE")
    os.exit(2)
  }
  match fs.read(args[2]) {
    Ok(src) => io.print(dump_tokens(src))
    Err(e) => {
      io.eprintln(e)
      os.exit(1)
    }
  }
}

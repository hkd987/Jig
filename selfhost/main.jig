import "sema"
import "std/fs"
import "std/io"
import "std/os"
import "syntax"

// jigc: the Jig compiler, written in Jig. So far it lexes, parses and checks:
// `jigc tokens FILE`, `jigc ast FILE` and `jigc check DIR STD` print the same text as
// `jig debug tokens FILE`, `jig debug ast FILE` and `jig debug check DIR` (STD is the
// standard library's directory, `compiler/std`).

fn main() effects {io, fs, env} {
  let args = os.args()
  if args.len() == 4 && args[1] == "check" {
    io.print(sema.check_dump(args[2], args[3]))
    return
  }
  if args.len() < 3 || (args[1] != "tokens" && args[1] != "ast") {
    io.eprintln("usage: jigc tokens|ast FILE, jigc check DIR STD")
    os.exit(2)
  }
  match fs.read(args[2]) {
    Ok(src) => io.print(
      if args[1] == "tokens" { syntax.dump_tokens(src) } else { syntax.dump_ast(src) },
    )
    Err(e) => {
      io.eprintln(e)
      os.exit(1)
    }
  }
}

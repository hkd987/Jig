// Generated by bootstrap/stdlib.py; do not edit. The standard library, C runtime, diagnostic
// codes and language reference jigc carries, as the bootstrap compiler carries them
// (`include_str!`).

/// The text of standard library file `name` (`io.jig`, `prelude.jig`, ...).
fn std_source(name: Str) -> Option<Str> {
  return match name {
    "fs.jig" => Some(STD_FS_JIG)
    "hash.jig" => Some(STD_HASH_JIG)
    "html.jig" => Some(STD_HTML_JIG)
    "io.jig" => Some(STD_IO_JIG)
    "json.jig" => Some(STD_JSON_JIG)
    "lists.jig" => Some(STD_LISTS_JIG)
    "math.jig" => Some(STD_MATH_JIG)
    "net.jig" => Some(STD_NET_JIG)
    "os.jig" => Some(STD_OS_JIG)
    "prelude.jig" => Some(STD_PRELUDE_JIG)
    "rand.jig" => Some(STD_RAND_JIG)
    "regex.jig" => Some(STD_REGEX_JIG)
    "sim.jig" => Some(STD_SIM_JIG)
    "strings.jig" => Some(STD_STRINGS_JIG)
    "task.jig" => Some(STD_TASK_JIG)
    "time.jig" => Some(STD_TIME_JIG)
    _ => None
  }
}

/// The text of C runtime file `name` (`jig_rt.c`, `jig_rt.h`).
fn runtime_source(name: Str) -> Option<Str> {
  return match name {
    "jig_rt.c" => Some(RT_JIG_RT_C)
    "jig_rt.h" => Some(RT_JIG_RT_H)
    _ => None
  }
}


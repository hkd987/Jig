const E0101_SLUG: Str = "unexpected-char"
const E0101_SUMMARY: Str = "unexpected character"
const E0101_EXPLAIN: Str = "The lexer found a character that cannot start any token. Jig source is UTF-8; identifiers are ASCII letters, digits and `_`. Remove the character or put it inside a string literal."
const E0102_SLUG: Str = "unterminated-string"
const E0102_SUMMARY: Str = "unterminated string literal"
const E0102_EXPLAIN: Str = "A string literal is missing its closing `\"`. Strings cannot span lines; use `\\n`."
const E0103_SLUG: Str = "invalid-escape"
const E0103_SUMMARY: Str = "invalid escape sequence"
const E0103_EXPLAIN: Str = "Valid escapes are `\\n \\t \\r \\0 \\\\ \\\" \\'` and `\\u{XXXX}` with 1 to 6 hex digits naming a Unicode scalar value."
const E0104_SLUG: Str = "invalid-number"
const E0104_SUMMARY: Str = "invalid number literal"
const E0104_EXPLAIN: Str = "Integer literals are decimal, `0x` hex or `0b` binary, with optional `_` separators. Float literals need digits on both sides of the `.` (`1.0`, not `1.`), and an optional exponent (`1e9`, `2.5e-3`). A literal must fit its type."
const E0105_SLUG: Str = "unexpected-token"
const E0105_SUMMARY: Str = "unexpected token"
const E0105_EXPLAIN: Str = "The parser expected something else at this point. The message lists what was expected. Common causes: a binary operator at the start of a line (put it at the end of the previous line instead), a missing `{`, or `else` on its own line after a missing `}`."
const E0106_SLUG: Str = "invalid-char"
const E0106_SUMMARY: Str = "invalid character literal"
const E0106_EXPLAIN: Str = "A character literal holds exactly one Unicode scalar value: `'a'`, `'\\n'`, `'\\u{e9}'`."
const E0107_SLUG: Str = "semicolon"
const E0107_SUMMARY: Str = "semicolons are not used"
const E0107_EXPLAIN: Str = "Jig ends statements at line breaks. Put each statement on its own line and remove the `;`."
const E0108_SLUG: Str = "invalid-item"
const E0108_SUMMARY: Str = "expected an item"
const E0108_EXPLAIN: Str = "Only `import`, `fn`, `struct`, `enum`, `interface`, `type`, `const`, `unit`, `test` and `step` declarations may appear at the top level of a file."
const E0109_SLUG: Str = "missing-body"
const E0109_SUMMARY: Str = "function has no body"
const E0109_EXPLAIN: Str = "Every function outside an interface needs a `{ ... }` body after its signature and contract clauses (`requires`, `ensures`, `effects`). Only interface methods, the standard library's builtins and C functions (declared with `effects {ffi}`) are declared without one."
const E0201_SLUG: Str = "unresolved-name"
const E0201_SUMMARY: Str = "cannot find name"
const E0201_EXPLAIN: Str = "No variable, function, type or package with this name is in scope. Check the spelling, add the missing `import`, or declare the item. Names from another package are written `pkg.name` and must be `pub`."
const E0202_SLUG: Str = "duplicate-definition"
const E0202_SUMMARY: Str = "name defined more than once"
const E0202_EXPLAIN: Str = "Each name may be declared once per package (functions, types, constants) or once per type (methods, fields, variants). Rename one of them."
const E0203_SLUG: Str = "unresolved-import"
const E0203_SUMMARY: Str = "cannot find package"
const E0203_EXPLAIN: Str = "The import path does not name a directory under the project root (the directory with `jig.mod`) or a standard library package. Standard library packages are `std/io`, `std/fs`, `std/os`, `std/time`, `std/rand` and `std/math`."
const E0204_SLUG: Str = "import-cycle"
const E0204_SUMMARY: Str = "import cycle"
const E0204_EXPLAIN: Str = "Packages form a directed acyclic graph. Move the shared code into a third package that both can import."
const E0205_SLUG: Str = "private-item"
const E0205_SUMMARY: Str = "item is private"
const E0205_EXPLAIN: Str = "The item exists but is not marked `pub` in its package. Mark it `pub` if it is part of the package's API, or use a public function instead."
const E0206_SLUG: Str = "unknown-field"
const E0206_SUMMARY: Str = "no such field"
const E0206_EXPLAIN: Str = "The type has no field with this name, or the field is private to another package."
const E0207_SLUG: Str = "unknown-method"
const E0207_SUMMARY: Str = "no such method"
const E0207_EXPLAIN: Str = "The type has no method with this name. Methods are declared as `fn Type.name(self, ...)` in the type's own package; see the reference for built-in methods on `Str`, `List`, `Map`, `Set`, `Option` and `Result`."
const E0208_SLUG: Str = "unknown-variant"
const E0208_SUMMARY: Str = "no such variant"
const E0208_EXPLAIN: Str = "The enum has no variant with this name. Patterns name variants without the enum (`Circle(r)`); expressions qualify them (`Shape.Circle(1.0)`)."
const E0209_SLUG: Str = "name-conflict"
const E0209_SUMMARY: Str = "name conflict"
const E0209_EXPLAIN: Str = "Two imports, or an import and a declaration, bind the same name."
const E0210_SLUG: Str = "no-project-root"
const E0210_SUMMARY: Str = "package import outside a project"
const E0210_EXPLAIN: Str = "Importing a non-standard package needs a project root: a directory containing a `jig.mod` file with the line `module <name>`."
const E0211_SLUG: Str = "module"
const E0211_SUMMARY: Str = "module not available"
const E0211_EXPLAIN: Str = "`jig.mod` requires a module that is not in the module cache (run `jig get` to download every required version), or a line of `jig.mod` is not understood. Lines are `module NAME`, `link NAME`, `require PATH VERSION` (a git tag of `https://PATH`) and `replace PATH => DIR`."
const E0301_SLUG: Str = "type-mismatch"
const E0301_SUMMARY: Str = "mismatched types"
const E0301_EXPLAIN: Str = "The expression has a different type from the one required here. Jig has no implicit conversions: convert numbers with `as`, wrap values in `Some(...)` or `Ok(...)` explicitly, and call `.str()` to turn values into strings."
const E0302_SLUG: Str = "arg-count"
const E0302_SUMMARY: Str = "wrong number of arguments"
const E0302_EXPLAIN: Str = "The call passes a different number of arguments from the function's parameters."
const E0303_SLUG: Str = "not-callable"
const E0303_SUMMARY: Str = "not callable"
const E0303_EXPLAIN: Str = "Only functions, methods, closures and enum variants with fields can be called."
const E0304_SLUG: Str = "missing-fields"
const E0304_SUMMARY: Str = "missing fields in struct literal"
const E0304_EXPLAIN: Str = "Jig has no zero values: a struct literal must give every field a value."
const E0305_SLUG: Str = "cannot-infer"
const E0305_SUMMARY: Str = "type annotations needed"
const E0305_EXPLAIN: Str = "The compiler cannot work out a type here. Add an annotation, e.g. `let xs: List<Int> = []` or `let m: Map<Str, Int> = Map.new()`."
const E0306_SLUG: Str = "bad-operands"
const E0306_SUMMARY: Str = "invalid operand types"
const E0306_EXPLAIN: Str = "The operator is not defined for these types. Arithmetic needs two numbers of the same type (and unit); `+` also joins two `Str`s; `&&` and `||` need `Bool`s; comparisons need equal types that satisfy `Eq` or `Ord`."
const E0307_SLUG: Str = "immutable"
const E0307_SUMMARY: Str = "cannot mutate an immutable value"
const E0307_EXPLAIN: Str = "Only `var` variables, `&mut` parameters and `&mut self` receivers can be assigned or mutated. Declare the variable with `var`, or take the parameter as `&mut T`."
const E0308_SLUG: Str = "missing-return"
const E0308_SUMMARY: Str = "missing return"
const E0308_EXPLAIN: Str = "A function with a return type must end every path with `return`. Jig function bodies do not return their last expression."
const E0309_SLUG: Str = "bad-try"
const E0309_SUMMARY: Str = "invalid use of `?`"
const E0309_EXPLAIN: Str = "`?` works on `Result<T, E>` inside a function returning `Result<_, E>` with the same `E`, and on `Option<T>` inside a function returning `Option<_>`. Convert errors explicitly with `.map_err(...)` or `.ok_or(...)`."
const E0310_SLUG: Str = "bad-cast"
const E0310_SUMMARY: Str = "invalid cast"
const E0310_EXPLAIN: Str = "`as` converts between numeric types, between `Char` and integers, and adds or removes units of measure. Other conversions are methods, e.g. `n.str()` or `s.to_int()`."
const E0311_SLUG: Str = "not-indexable"
const E0311_SUMMARY: Str = "cannot index this value"
const E0311_EXPLAIN: Str = "Only `List<T>` (by `Int`, giving `T`) and `Str` (by `Int`, giving the byte as `U8`) can be indexed, and both can be sliced with a range `a..b`. Use `m.get(k)` for maps."
const E0312_SLUG: Str = "bound-not-met"
const E0312_SUMMARY: Str = "type does not satisfy a bound"
const E0312_EXPLAIN: Str = "A generic parameter requires an interface the type does not implement. User interfaces are satisfied by declaring each method (`fn T.method(self, ...)`). Functions never satisfy `Eq`; `Float` does not satisfy `Ord` or `Hash`."
const E0313_SLUG: Str = "type-arg-count"
const E0313_SUMMARY: Str = "wrong number of type arguments"
const E0313_EXPLAIN: Str = "The generic type or function takes a different number of type arguments."
const E0314_SLUG: Str = "bad-mut-arg"
const E0314_SUMMARY: Str = "invalid `&mut` argument"
const E0314_EXPLAIN: Str = "A `&mut T` parameter needs `&mut place` at the call site, where the place is a `var`, a `&mut` parameter, or a field or element of one. `&mut` may only appear on parameters and call arguments; it cannot be stored in variables, fields or return types."
const E0315_SLUG: Str = "aliased-mut"
const E0315_SUMMARY: Str = "overlapping `&mut` arguments"
const E0315_EXPLAIN: Str = "Two `&mut` arguments to one call refer to the same place, or one contains the other. Jig forbids this so a function can reason about its parameters locally."
const E0316_SLUG: Str = "break-outside-loop"
const E0316_SUMMARY: Str = "`break` or `continue` outside a loop"
const E0316_EXPLAIN: Str = "`break` and `continue` may only appear inside a `for` loop (and not inside a closure defined in it)."
const E0317_SLUG: Str = "unit-mismatch"
const E0317_SUMMARY: Str = "mismatched units of measure"
const E0317_EXPLAIN: Str = "`+`, `-` and comparisons need operands with the same unit. Multiply or divide to combine units, or convert explicitly with `as Float<unit>`."
const E0318_SLUG: Str = "bad-main"
const E0318_SUMMARY: Str = "invalid `main` function"
const E0318_EXPLAIN: Str = "`main` takes no parameters, has no type parameters, and returns `()`. Read arguments with `os.args()` and set the exit code with `os.exit(code)`."
const E0319_SLUG: Str = "infinite-type"
const E0319_SUMMARY: Str = "recursive struct has infinite size"
const E0319_EXPLAIN: Str = "A struct contains itself by value. Store the nested values in a `List` or an `Option` of an enum, or model the structure as an enum (whose recursive payloads are boxed automatically)."
const E0320_SLUG: Str = "contract-context"
const E0320_SUMMARY: Str = "contract syntax used out of place"
const E0320_EXPLAIN: Str = "`result` and `old(...)` are only meaningful in `ensures` clauses; `forall` and `exists` only in contracts, invariants, refinements and assertions."
const E0321_SLUG: Str = "impure-contract"
const E0321_SUMMARY: Str = "contract is not pure"
const E0321_EXPLAIN: Str = "Contracts, invariants and refinements must be pure: they may not call functions with effects, mutate anything, or panic."
const E0322_SLUG: Str = "duplicate-member"
const E0322_SUMMARY: Str = "duplicate field, variant or parameter"
const E0322_EXPLAIN: Str = "A struct's fields, an enum's variants and a function's parameters must have distinct names."
const E0323_SLUG: Str = "bad-pattern"
const E0323_SUMMARY: Str = "pattern does not match the type"
const E0323_EXPLAIN: Str = "The pattern's shape (variant, tuple arity, literal type) does not fit the type of the value being matched."
const E0324_SLUG: Str = "not-a-struct"
const E0324_SUMMARY: Str = "not a struct type"
const E0324_EXPLAIN: Str = "Struct literal syntax `Name { field: value }` needs a struct type. Enum variants are constructed with `Enum.Variant(args)`."
const E0325_SLUG: Str = "value-in-type"
const E0325_SUMMARY: Str = "expected a type"
const E0325_EXPLAIN: Str = "A value or package was used where a type is required."
const E0326_SLUG: Str = "type-in-value"
const E0326_SUMMARY: Str = "expected a value"
const E0326_EXPLAIN: Str = "A type was used where a value is required. Construct a struct with `Name { ... }` or call an associated function with `Name.func(...)`."
const E0327_SLUG: Str = "bad-receiver"
const E0327_SUMMARY: Str = "invalid method receiver"
const E0327_EXPLAIN: Str = "Methods take `self` or `&mut self` as their first parameter. Calling a `&mut self` method needs a mutable receiver (a `var`, or a `&mut` parameter)."
const E0328_SLUG: Str = "foreign-method"
const E0328_SUMMARY: Str = "method on a type from another package"
const E0328_EXPLAIN: Str = "Methods can only be declared in the package that declares the type."
const E0329_SLUG: Str = "const-expr"
const E0329_SUMMARY: Str = "not a constant expression"
const E0329_EXPLAIN: Str = "`const` values must be literals, or arithmetic and comparisons on other constants."
const E0330_SLUG: Str = "never-returns"
const E0330_SUMMARY: Str = "unreachable expression type"
const E0330_EXPLAIN: Str = "This expression can never produce a value (for example `panic(...)` or `return`) in a position that needs one."
const E0331_SLUG: Str = "bad-ffi"
const E0331_SUMMARY: Str = "invalid C function"
const E0331_EXPLAIN: Str = "A function declared without a body and with the `ffi` effect calls the C function of the same name. Its parameters and result must be `Int`, `I32`, `U8`, `U32`, `U64`, `Float`, `Bool` or `Str` (passed as a NUL-terminated `const char *`; a returned one is copied); a parameter may also be a byte buffer, `List<U8>` (a `const uint8_t *` to its bytes) or `&mut List<U8>` (a `uint8_t *` C may write, as many bytes as the list holds). It cannot be generic or a method, and it takes at most 6 integer-sized and 8 `Float` arguments. Libraries are linked with `link NAME` lines in `jig.mod`."
const E0332_SLUG: Str = "refined-variant-value"
const E0332_SUMMARY: Str = "refined variant used as a function"
const E0332_EXPLAIN: Str = "A variant whose fields are refined (a refinement alias or a `where` clause) checks them where it is built, so it can only be called, not passed as a function. Wrap it in a closure: `xs.map(fn(c) { State.Paying(c) })`."
const E0401_SLUG: Str = "undeclared-effect"
const E0401_SUMMARY: Str = "effect not declared"
const E0401_EXPLAIN: Str = "The function performs an effect (directly or by calling a function that declares it) that its own `effects {...}` clause does not list. Add the effect to the clause, or restructure so the effectful call happens in the caller."
const E0402_SLUG: Str = "unknown-effect"
const E0402_SUMMARY: Str = "unknown effect"
const E0402_EXPLAIN: Str = "Effects are `io`, `fs`, `net`, `clock`, `rand`, `env`, `spawn` and `ffi`. A function's `effects` clause may also name one of its parameters of function type: a call then performs the effects of the function passed for it."
const E0403_SLUG: Str = "unused-effect"
const E0403_SUMMARY: Str = "declared effect is never used"
const E0403_EXPLAIN: Str = "The function declares an effect it never performs. Remove it so callers do not have to declare it too."
const E0404_SLUG: Str = "effect-param-value"
const E0404_SUMMARY: Str = "function with effect parameters used as a value"
const E0404_EXPLAIN: Str = "A function whose `effects` clause names one of its parameters performs the effects of the function passed for it, which each call decides, so it can only be called, not passed as a function. Wrap it in a closure: `fn(f) { twice(f) }`."
const E0451_SLUG: Str = "non-exhaustive"
const E0451_SUMMARY: Str = "non-exhaustive match"
const E0451_EXPLAIN: Str = "Some values of the matched type reach no arm. The message gives an example. Add arms for the missing cases, or a final `_ =>` arm if they should share one behavior."
const E0452_SLUG: Str = "unreachable-arm"
const E0452_SUMMARY: Str = "match arm can never match"
const E0452_EXPLAIN: Str = "Every value this arm matches is already handled by earlier arms. Remove it or reorder the arms."
const E0501_SLUG: Str = "unused-variable"
const E0501_SUMMARY: Str = "unused variable"
const E0501_EXPLAIN: Str = "A variable or parameter is never read. Remove it, or name it `_` if a pattern requires a binding."
const E0502_SLUG: Str = "unused-import"
const E0502_SUMMARY: Str = "unused import"
const E0502_EXPLAIN: Str = "The imported package is never used. Remove the import."
const E0503_SLUG: Str = "needless-var"
const E0503_SUMMARY: Str = "variable does not need to be `var`"
const E0503_EXPLAIN: Str = "The variable is declared with `var` but never mutated. Use `let`."
const E0504_SLUG: Str = "naming"
const E0504_SUMMARY: Str = "naming convention"
const E0504_EXPLAIN: Str = "Types, variants and interfaces are `UpperCamel`; functions, variables, fields and packages are `snake_case`; constants are `UPPER_SNAKE`. Units are lower case. A C function keeps its C name."
const E0505_SLUG: Str = "shadowing"
const E0505_SUMMARY: Str = "name shadows another binding"
const E0505_EXPLAIN: Str = "A local binding reuses the name of another local in an enclosing scope of the same function. Choose a different name."
const E0506_SLUG: Str = "unreachable-code"
const E0506_SUMMARY: Str = "unreachable code"
const E0506_EXPLAIN: Str = "This code comes after a `return`, `break`, `continue` or `panic` and can never run."
const E0507_SLUG: Str = "unused-result"
const E0507_SUMMARY: Str = "unused result"
const E0507_EXPLAIN: Str = "The call returns a value that is ignored. Use it, or discard it explicitly with `let _ = ...` when ignoring it is intended."
const E0508_SLUG: Str = "self-comparison"
const E0508_SUMMARY: Str = "comparison or assignment of a value with itself"
const E0508_EXPLAIN: Str = "The expression compares or assigns a value to itself, which is always true, always false, or does nothing."
const E0509_SLUG: Str = "constant-condition"
const E0509_SUMMARY: Str = "condition is always the same"
const E0509_EXPLAIN: Str = "The condition is a literal `true` or `false`. Use `for { }` for an infinite loop and remove dead branches."
const E0510_SLUG: Str = "needless-mut"
const E0510_SUMMARY: Str = "parameter does not need `&mut`"
const E0510_EXPLAIN: Str = "The parameter is taken as `&mut` but never mutated. Take it by value."
const E0601_SLUG: Str = "dead-function"
const E0601_SUMMARY: Str = "function is never reached"
const E0601_EXPLAIN: Str = "No entrypoint reaches this function. Entrypoints are `main`, the `pub` API of a library package, and step functions used by a scenario. Tests do not justify code. Delete the function, or use it."
const E0602_SLUG: Str = "unused-field"
const E0602_SUMMARY: Str = "field is never read"
const E0602_EXPLAIN: Str = "No reachable code reads this field. Remove it."
const E0603_SLUG: Str = "unused-export"
const E0603_SUMMARY: Str = "exported item is never used"
const E0603_EXPLAIN: Str = "The item is `pub` but no other package in the program uses it, and its package is not the root of a library. Remove `pub`, or remove the item."
const E0604_SLUG: Str = "unused-variant"
const E0604_SUMMARY: Str = "variant is never constructed"
const E0604_EXPLAIN: Str = "No reachable code constructs this enum variant, so matches on it are impossible. Remove the variant."
const E0605_SLUG: Str = "unused-step"
const E0605_SUMMARY: Str = "step is never used"
const E0605_EXPLAIN: Str = "No scenario in any `.feature` file uses this step function."
const E0606_SLUG: Str = "unused-item"
const E0606_SUMMARY: Str = "item is never used"
const E0606_EXPLAIN: Str = "This type, constant, interface or unit is never used by reachable code."
const E0607_SLUG: Str = "simulation-in-program"
const E0607_SUMMARY: Str = "program code uses the test simulation"
const E0607_EXPLAIN: Str = "`std/sim` sets up and inspects the simulated world that tests and scenarios run in. Code reachable from `main` (or a library's `pub` API) runs against the real world, so it cannot use it. Move the call into a test, a step or a test helper."
const E0701_SLUG: Str = "precondition"
const E0701_SUMMARY: Str = "precondition may not hold"
const E0701_EXPLAIN: Str = "The caller cannot show that the callee's `requires` holds here. Strengthen the caller's own `requires`, add a check before the call, or weaken the callee's precondition."
const E0702_SLUG: Str = "postcondition"
const E0702_SUMMARY: Str = "postcondition may not hold"
const E0702_EXPLAIN: Str = "Some path through the function ends in a state that violates its `ensures`."
const E0703_SLUG: Str = "invariant-entry"
const E0703_SUMMARY: Str = "loop invariant may not hold on entry"
const E0703_EXPLAIN: Str = "The loop invariant is false before the first iteration."
const E0704_SLUG: Str = "invariant-preserved"
const E0704_SUMMARY: Str = "loop invariant may not be preserved"
const E0704_EXPLAIN: Str = "An iteration that starts with the invariant true may end with it false."
const E0705_SLUG: Str = "assertion"
const E0705_SUMMARY: Str = "assertion may fail"
const E0705_EXPLAIN: Str = "The `assert` condition can be false."
const E0706_SLUG: Str = "overflow"
const E0706_SUMMARY: Str = "arithmetic may overflow"
const E0706_EXPLAIN: Str = "The operation can exceed the range of its integer type. Bound the inputs with `requires` or refinements, or use `wrapping_add` and friends if wrap-around is intended."
const E0707_SLUG: Str = "bounds"
const E0707_SUMMARY: Str = "index may be out of bounds"
const E0707_EXPLAIN: Str = "The index can be negative or at least the length. Check it, iterate with `for x in xs`, or add a `requires` relating the index to `xs.len()`."
const E0708_SLUG: Str = "div-zero"
const E0708_SUMMARY: Str = "division by zero possible"
const E0708_EXPLAIN: Str = "The divisor can be zero. Check it first or require it to be non-zero."
const E0709_SLUG: Str = "refinement"
const E0709_SUMMARY: Str = "refinement may not hold"
const E0709_EXPLAIN: Str = "A value flowing into a refined type (`T where pred`) may not satisfy the predicate."
const E0710_SLUG: Str = "struct-invariant"
const E0710_SUMMARY: Str = "struct invariant may not hold"
const E0710_EXPLAIN: Str = "Constructing or mutating the struct can break its `invariant`."
const E0711_SLUG: Str = "unwrap"
const E0711_SUMMARY: Str = "unwrap may fail"
const E0711_EXPLAIN: Str = "`unwrap()` is called on a value that may be `None` or `Err`."
const E0712_SLUG: Str = "panic-reachable"
const E0712_SUMMARY: Str = "panic is reachable"
const E0712_EXPLAIN: Str = "Some input reaches this `panic`."
const E0713_SLUG: Str = "unknown"
const E0713_SUMMARY: Str = "proof inconclusive"
const E0713_EXPLAIN: Str = "The solver timed out or gave up. The obligation is checked at run time in debug builds and covered by generated property tests. Simplify the code, add intermediate `assert`s, or add loop invariants."
const E0714_SLUG: Str = "refuted"
const E0714_SUMMARY: Str = "contract violated"
const E0714_EXPLAIN: Str = "A concrete input violates the contract; the counterexample was replayed and confirmed. This is a real bug in the implementation or the contract."
const E0715_SLUG: Str = "solver-missing"
const E0715_SUMMARY: Str = "SMT solver not available"
const E0715_EXPLAIN: Str = "`jig prove` needs Z3 on the PATH (or `JIG_Z3` set to its path). Install the pinned version with `pip install z3-solver==5.3.2.0`."
const E0801_SLUG: Str = "gherkin-syntax"
const E0801_SUMMARY: Str = "invalid feature file"
const E0801_EXPLAIN: Str = "Feature files use the Gherkin subset: `Feature:`, `Scenario:`, `Scenario Outline:` with `Examples:` tables, and steps starting with `Given`, `When`, `Then`, `And` or `But`. Hooks, tags and backgrounds are not supported."
const E0802_SLUG: Str = "no-step"
const E0802_SUMMARY: Str = "no step matches"
const E0802_EXPLAIN: Str = "No `step` function's pattern matches this line. Write one, e.g. `step \"an account {name} with balance {amt}\" fn ...`."
const E0803_SLUG: Str = "ambiguous-step"
const E0803_SUMMARY: Str = "several steps match"
const E0803_EXPLAIN: Str = "More than one step pattern matches this line. Make the patterns more specific."
const E0804_SLUG: Str = "step-type"
const E0804_SUMMARY: Str = "step argument does not fit the parameter type"
const E0804_EXPLAIN: Str = "A placeholder's text does not parse as the parameter's type: `Str` needs a quoted string, integer and float types need numeric literals, `Bool` needs `true` or `false`."
const E0805_SLUG: Str = "bad-step"
const E0805_SUMMARY: Str = "invalid step function"
const E0805_EXPLAIN: Str = "Every `{placeholder}` must name a parameter, and every parameter except an optional first `w: &mut World` must appear as a placeholder. Step functions return `()`."
const E0806_SLUG: Str = "uncovered-entrypoint"
const E0806_SUMMARY: Str = "entrypoint is not covered by any scenario"
const E0806_EXPLAIN: Str = "Every entrypoint must be exercised by at least one scenario."
const E0901_SLUG: Str = "test-failed"
const E0901_SUMMARY: Str = "test failed"
const E0901_EXPLAIN: Str = "A test, property test or scenario failed. The report gives the failing assertion and the input values."
const E0902_SLUG: Str = "io-error"
const E0902_SUMMARY: Str = "cannot read or write a file"
const E0902_EXPLAIN: Str = "The compiler could not read a source file or write an output file."
const E0903_SLUG: Str = "build-failed"
const E0903_SUMMARY: Str = "native build failed"
const E0903_EXPLAIN: Str = "The linker or a backend tool failed. The message includes its output."
const E0904_SLUG: Str = "unsupported"
const E0904_SUMMARY: Str = "not supported yet"
const E0904_EXPLAIN: Str = "This construct parses and type-checks but is not supported by this compiler stage yet."

/// The language reference (`jig reference`).
const REFERENCE: Str = "# Jig language reference\n\nJig is a strict, Go-shaped systems language with verification built in. Humans write\nfeature scenarios and contracts; agents write implementations; the compiler proves the\ncontracts or, failing that, tests them. No nil, no zero values, no implicit conversions,\nno GC, no warnings: every lint is an error.\n\n## Files and packages\n\n- A package is a directory of `.jig` files. All files in it share one namespace, but\n  imports are per file: each file imports the packages it names.\n- A project root holds a `jig.mod` file starting `module <name>`. Import paths are\n  relative to the root: `import \"geom\"` loads `<root>/geom/`. `std/...` is the standard\n  library. Without `jig.mod`, a package can import only `std`.\n- Other projects are modules: `require github.com/x/y v1.2.0` in `jig.mod` (a git tag of\n  `https://github.com/x/y`), then `import \"github.com/x/y/pkg\"`. `jig get` downloads them and\n  records their commits in `jig.sum`; check and build never fetch. The highest version any\n  module requires is used. `replace github.com/x/y => ../y` uses a local directory.\n- The imported package is named by its last path segment: `geom.area(p)`.\n- Import cycles and unused imports are errors.\n- Items are private to their package unless marked `pub`. Struct fields are private unless\n  marked `pub`.\n\n## Lexical rules\n\n- Comments: `// line`, `/// doc comment`. No block comments.\n- Statements end at a newline when the line's last token is an identifier, a literal,\n  `return`, `break`, `continue`, `)`, `]`, `}`, `>` or `?`. Put binary operators at the\n  end of a line to continue it.\n- Literals: `42`, `1_000`, `0xff`, `0b1010`, `3.14`, `1e-9`, `true`, `false`, `'a'`\n  (`Char`, or `U8` when a `U8` is expected), `\"text\\n\"` (escapes `\\n \\t \\r \\0 \\\\ \\\" \\'\n  \\u{1F600}`).\n- Naming is enforced: types, variants and interfaces `UpperCamel`; functions, variables,\n  fields and packages `snake_case`; constants `UPPER_SNAKE`.\n\n## Types\n\n| Type | Meaning |\n| --- | --- |\n| `Int` | 64-bit signed integer |\n| `I32`, `U8`, `U32`, `U64` | sized integers |\n| `Float` | 64-bit IEEE float |\n| `Bool`, `Char` | boolean, Unicode scalar value |\n| `Str` | immutable UTF-8 string |\n| `()` | unit |\n| `(A, B)` | tuple; fields `t.0`, `t.1` |\n| `List<T>` | growable array |\n| `Map<K, V>`, `Set<T>` | hash map/set, iterate in insertion order |\n| `Option<T>` | `Some(value)` or `None` |\n| `Result<T, E>` | `Ok(value)` or `Err(error)` |\n| `fn(A) -> B effects {io}` | function value |\n| `Never` | type of `panic(...)`; converts to any type |\n\nThere is no nil and no default value: every variable and field is initialized explicitly.\nNumbers never convert implicitly; use `as`: `n as Float`, `f as Int` (truncates),\n`x as U8` (traps if out of range), `c as U32`.\n\n### Structs, enums, aliases, constants\n\n```\npub struct Point {\n  pub x: Int\n  pub y: Int\n}\n\npub struct Span {\n  lo: Int\n  hi: Int\n  invariant lo <= hi            // checked on construction and mutation\n}\n\npub enum Shape {\n  Circle(r: Float)\n  Rect(w: Float, h: Float)\n  Empty\n}\n\npub enum Tree<T> {              // recursive payloads are boxed automatically\n  Leaf\n  Node(left: Tree<T>, value: T, right: Tree<T>)\n}\n\ntype Cents = Int where self >= 0   // refinement alias\ntype Grid = List<List<Int>>        // plain alias\nconst MAX_USERS: Int = 1_000\n```\n\nConstruct with all fields named: `Point { x: 1, y: 2 }`. Variants are qualified when\nconstructed: `Shape.Circle(1.0)`, `Shape.Empty`, or through an alias\n(`type E = model.LedgerError` then `E.OutOfStock(n)`). The prelude variants `Some`, `None`,\n`Ok` and `Err` need no qualifier. Prelude names (`Option`, `Result`, `Some`, `Err`,\n`min`, ...) cannot be redefined.\n\n### Units of measure\n\n```\nunit m\nunit s\nfn speed(d: Float<m>, t: Float<s>) -> Float<m/s> {\n  return d / t\n}\n```\n\n`+`, `-` and comparisons need equal units; `*` and `/` combine them. Literals take the unit\ntheir context expects. `x as Float<m>` adds a unit; `d as Float` removes it. Units work on\n`Int` too (`Int<cent>`). Unit names are program-wide: declare each once, in any package,\nand use it unqualified everywhere.\n\n## Values and memory\n\nJig has **mutable value semantics**. Assignment and argument passing copy the value\n(copies of `Str`, `List`, `Map` and `Set` are cheap: they share storage until one is\nmutated). Two variables never observe each other's changes. There are no pointers.\n\n- `let x = …` is immutable; `var x = …` is mutable. A `var` that is never mutated is an error.\n- `&mut` lets a function mutate the caller's variable. It appears only on parameters and at\n  the call site, and cannot be stored:\n\n```\nfn bump(n: &mut Int) {\n  n += 1\n}\nvar count = 0\nbump(&mut count)\n```\n\n- Two `&mut` arguments to one call must be different places (`f(&mut a, &mut a.x)` is an\n  error).\n- For graphs and cyclic data, store nodes in a `List` and refer to them by index.\n\n## Functions\n\n```\npub fn transfer(from: &mut Acct, to: &mut Acct, amt: Cents)\n  requires amt > 0, from.bal >= amt\n  ensures from.bal + to.bal == old(from.bal + to.bal)\n  effects {}\n{\n  from.bal -= amt\n  to.bal += amt\n}\n```\n\n- Every parameter and the return type are annotated. A missing `-> T` means `()`.\n- Function bodies return with an explicit `return`. Every path of a non-`()` function\n  must return.\n- Generics: `fn first<T>(xs: List<T>) -> Option<T>`. Type arguments are inferred at call\n  sites. Bounds name interfaces: `fn largest<T: Ord>(xs: List<T>) -> Option<T>`.\n- Methods are declared on a type of the same package and called with a dot:\n\n```\nfn Point.norm2(self) -> Int {\n  return self.x * self.x + self.y * self.y\n}\nfn Acct.deposit(&mut self, amt: Cents) {\n  self.bal += amt\n}\nfn Point.origin() -> Point {                 // associated function: Point.origin()\n  return Point { x: 0, y: 0 }\n}\n```\n\n- A method may share a field's name: `x.name` reads the field, `x.name()` calls the\n  method. A custom `fn T.str(self) -> Str` replaces the derived `Show` everywhere, even\n  when it is not `pub`.\n- Closures capture copies of variables. Their body yields its last expression:\n  `xs.map(fn(x) { x * 2 })`. Parameter types may be omitted when the expected type is known.\n- `if` and `match` are expressions; their blocks also yield their last expression.\n\n### Interfaces\n\nInterfaces are structural: a type satisfies one if it has the methods. They are used as\ngeneric bounds and are resolved at compile time.\n\n```\npub interface Shape {\n  fn area(self) -> Float\n}\nfn total<T: Shape>(xs: List<T>) -> Float { … }\n```\n\nBuilt-in interfaces: `Eq` (`==`, `!=`), `Ord` (`<`, `<=`, `>`, `>=`), `Hash`, `Show`\n(`.str()`); `Ord` and `Hash` imply `Eq`. Every type except functions satisfies `Eq` and `Show`; every type except\nfunctions and `Float` satisfies `Hash` and `Ord`. Structs and enums compare field by field\nin declaration order. Define `fn T.str(self) -> Str` to customize `Show`.\n\n## Effects\n\nA function is pure unless it declares effects. A function may only call functions whose\neffects are a subset of its own.\n\n| Effect | Grants |\n| --- | --- |\n| `io` | console input and output |\n| `fs` | files and directories |\n| `net` | network |\n| `clock` | wall and monotonic time |\n| `rand` | randomness |\n| `env` | process arguments, environment variables, exit |\n| `spawn` | threads |\n| `ffi` | C functions |\n\n```\nimport \"std/io\"\nfn main() effects {io} {\n  io.println(\"hello\")\n}\n```\n\nFunction types carry effects: `fn(Int) -> Int effects {io}`. A pure function value cannot\nperform effects. Tests run effects against deterministic fakes.\n\nAn `effects` clause may name a parameter of function type: the parameter then takes a\nfunction with any effects, and each call performs that function's effects. Such a function\nis called, not passed as a value. The built-in methods that take a function (`map`,\n`filter`, `fold`, `any`, `all`, `sort_by`, `Option.map`, `Result.map`, `map_err`, and\n`lists.find`, `position`, `count`, `partition`) work this way, so `xs.map(f)` has `f`'s\neffects.\n\n```\nfn twice(f: fn() -> Int) -> Int effects {f} {\n  return f() + f()\n}\n```\n\nC functions are declared without a body and with the `ffi` effect; calls go to the C symbol\nof the same name (which need not be snake_case). Parameters and results are `Int`, `I32`, `U8`, `U32`, `U64`, `Float`,\n`Bool` or `Str` (a NUL-terminated `const char *`; a returned one is copied, `NULL` is `\"\"`),\nat most 6 integer-sized and 8 `Float` arguments. A parameter may also be a byte buffer:\n`List<U8>` is passed as a `const uint8_t *` to its bytes, and `&mut List<U8>` as a\n`uint8_t *` that C may write, as many bytes as the list holds (size it first); pass the\nlength as an `Int` yourself. Pointers C hands out are `Int`s, and a struct passed by pointer\nis a `&mut List<U8>` of its size, read by byte offset. C's `long` is `Int` on Linux and macOS\nbut 32 bits on Windows, where it is `I32`. C cannot call back into Jig. Their\ncontracts are checked at run time. Link libraries with `link NAME` lines in `jig.mod`\n(`libc` and `libm` are always there).\n\n```\nfn erf(x: Float) -> Float effects {ffi}\nfn read(fd: I32, buf: &mut List<U8>, n: Int) -> Int effects {ffi}\n```\n\nParallelism is fork-join through `std/task` and the `spawn` effect: `task.map(items, f)`,\n`task.all(jobs)` and `task.both(f, g)` run their functions in parallel and return when all\nhave finished, results in order. Task functions have type `fn() -> T effects {spawn}`: they\nmay start tasks but do nothing else, so results never depend on scheduling (tests run them\nin order). Write a list of jobs as `var jobs: List<fn() -> Int effects {spawn}> = []`.\n\n```\nlet sizes = task.map(files, fn(f) { parse(f).len() })\n```\n\n## Statements and expressions\n\n```\nlet p = Point { x: 1, y: 2 }\nvar total = 0\ntotal += p.x\nlet (q, r) = divmod(17, 5)\nlet big = if total > 10 { \"big\" } else { \"small\" }\n\nfor i in 0..10 { … }               // half-open range\nfor x in xs { … }                  // each element, by value\nfor (k, v) in m { … }              // map entries in insertion order\nfor i in 0..n invariant total >= 0 { … }\nfor queue.len() > 0 { … }          // while\nfor { … }                          // loop; leave with break or return\n```\n\nOperators, tightest first: postfix (`f()`, `x[i]`, `x.f`, `?`), `as`, unary (`-`, `!`, `~`),\n`* / % << >> &`, `+ - | ^`, comparisons, `&&`, `||`. Integer overflow, division by zero,\nout-of-range shifts and out-of-bounds indexing trap unless the compiler proves they cannot\nhappen. A call statement whose result is not `()` is an error; write `let _ = f()`.\nAssignment is a statement, not an expression. Declaring a name that is already in scope\n(shadowing) is an error.\n\n### Match\n\n`match` must be exhaustive; an arm that can never match is an error. Patterns: `_`, a binding\nname, literals, variants with sub-patterns (unqualified), tuples, alternatives `A | B`,\nguards `if cond`. An arm's body is an expression, a block, or a single statement\n(`Open => n += 1`, `Done => return total`).\n\n```\nfn area(s: Shape) -> Float {\n  return match s {\n    Circle(r) => 3.14159 * r * r\n    Rect(w, h) => w * h\n    Empty => 0.0\n  }\n}\n```\n\n### Errors\n\nUse `Result` and `Option`; `?` returns early with the `Err` or `None`. The error types must\nmatch exactly.\n\n```\nfn parse_port(s: Str) -> Result<Int, Str> {\n  let n = s.to_int().ok_or(\"not a number\")?\n  if n < 1 || n > 65535 {\n    return Err(\"out of range: \" + n.str())\n  }\n  return Ok(n)\n}\n```\n\n`panic(msg)` aborts the program. `assert(cond)` is a proof obligation and a runtime check.\n\n## Contracts and refinements\n\n- `requires` lists preconditions; callers must establish them.\n- `ensures` lists postconditions; `result` is the return value and `old(e)` is `e` on entry.\n- `invariant` on a `for` loop must hold before each iteration; on a struct, whenever a\n  value is constructed or mutated.\n- `T where pred` refines a parameter (`amt: Int where amt > 0`), a struct or variant field,\n  an alias (`self` names the value) or the return type (`-> Int where result >= 0`, the same\n  as `ensures result >= 0`). It is checked wherever a value enters the type: arguments,\n  returns, construction and assignment; the prover assumes it wherever the value is used\n  (a variant's, in the arm that matches it). A variant with refined fields is called, not\n  passed as a function. For a local, use `assert`.\n- Contract expressions are pure. They may call pure functions, and use\n  `forall i in a..b: pred` and `exists i in a..b: pred`.\n\n`jig prove` checks each function against its own contract and its callees' contracts, never\ntheir bodies, and also proves the absence of traps (overflow, division by zero, bounds,\n`unwrap`, reachable `panic`); it knows a list or string holds at most 2^60 items, so `i + 1`\ncannot overflow for an index `i`. Integer arithmetic is exact, and so are shifts by a\nconstant (`x >> 3` divides by 8 rounding down; `x << 3` multiplies by 8, wrapping within the\ntype), masks of the form `x & (2^k - 1)` (`x` modulo `2^k`) and `~x`; other bit operations are\nknown by bounds (`x & y` is between 0 and `x` when `x >= 0`, `x | y` at least both when both\nare non-negative). Strings are known by their length: `s.starts_with(p)`, `ends_with` and\n`contains` imply `p.len() <= s.len()`. Two things are read off a callee's body. What it can write:\nafter `f(&mut x)` or `x.m()` with `&mut self`, fields `f` never assigns keep their values.\nAnd what a pure function reads: a call to one that reads only scalars (not lists) is a\nfunction of them, so `self.at(i)` twice on the same fields gives the same result, even if\nother fields changed in between. Results are cached per function: changing a body re-proves\nonly that function and, if what it can write or read changed, its callers. A failed contract comes with a\ncounterexample in source terms, and is replayed on the interpreter: \"confirmed\" means\nthose inputs really fail, \"not reproduced\" means the prover is missing a fact. An unproven\nobligation keeps its runtime check in every build; a proved one has none, and a `requires`\nproved at every call is not checked in the callee either. To prove facts after a loop,\nstate them as loop invariants; to prove facts about a call's result, put them in the\ncallee's `ensures`.\n\n## Tests\n\n`test` blocks live next to the code they test and run in a deterministic runner with fake\neffects. A `test` with parameters is a property test: it runs 100 generated inputs (edge\nvalues first, growing in size), skips inputs that fail its own `requires`, and shrinks a\nfailure to a minimal counterexample.\n\n```\ntest \"transfer keeps the total\" {\n  var a = Acct { id: 1, bal: 100 }\n  var b = Acct { id: 2, bal: 0 }\n  transfer(&mut a, &mut b, 40)\n  assert(a.bal == 60 && b.bal == 40)\n}\n\ntest \"add commutes\"(x: Int, y: Int) requires x < 1000, y < 1000 {\n  assert(add(x, y) == add(y, x))\n}\n```\n\nTests do not justify code: a function called only from tests is dead code, unless it is in\na file whose name ends in `_test.jig` (a test helper).\n\nTests and scenarios run against a simulated world: output is captured, stdin is empty,\nfiles live in memory, the clock starts at a fixed time and moves 1 ms per reading (and by\n`time.sleep`), randomness is seeded, and the network is simulated (`sim.reply` queues a\nserver's answer to `net.request`; `sim.connect` queues a request for `net.serve`, which\nanswers what is queued and returns). `std/sim` sets this world up and inspects it; code\nthat `main` reaches may not use it (E0607).\n\n```\ntest \"the copy is stamped\" {\n  sim.set_file(\"a.txt\", \"hi\")\n  sim.set_time(1000)\n  sim.set_args([\"stamp\", \"a.txt\", \"b.txt\"])\n  main()\n  assert(sim.stdout() == \"stamped b.txt\\n\" && sim.file(\"b.txt\") == Some(\"1500\\nhi\"))\n}\n```\n\n## Features and steps\n\nScenarios are Gherkin `.feature` files in the package directory (`Feature`, `Scenario`,\n`Scenario Outline` with `Examples`, `Given`/`When`/`Then`/`And`/`But`). Steps bind to\nfunctions at compile time; `{name}` placeholders bind to parameters of the same name and\nare type-checked (`Str` matches a quoted string, numbers match literals).\n\n```\nFeature: Transfers\n  Scenario: transfer moves funds\n    Given an account \"A\" with balance 100\n    When \"A\" transfers 40 to \"B\"\n    Then \"A\" has balance 60\n```\n\n```\npub struct World {\n  accts: Map<Str, Acct>\n}\nfn World.new() -> World { … }\n\nstep \"an account {name} with balance {amt}\"\nfn given_account(w: &mut World, name: Str, amt: Cents) { … }\n\nstep \"{name} has balance {amt}\"\nfn then_balance(w: World, name: Str, amt: Int) { … }\n```\n\nEach scenario starts from `World.new()` and runs its steps in order: a step takes the world\nfirst (`&mut World` to change it, `World` to read it), then one parameter per placeholder.\nPlaceholders are `Str` (quoted), numbers or `Bool`. A `Scenario Outline` runs once per\n`Examples` row with `<column>` replaced. `jig test` runs every scenario. A missing (the error\nsuggests a step), ambiguous or mistyped step is a compile error, and so is a step no\nscenario uses. Scenarios are roots for dead code: code they reach is justified.\n\n## Dead code and traceability\n\nRoots are `main` and step functions used by a scenario; a package without `main` (a\nlibrary) also has its root package's `pub` items as roots. Unreachable functions, unused\nfields, variants and constants, and impossible match arms fail the build. So does an\nunused export: a `pub` item of a non-root package that no other package uses (remove the\n`pub`). `jig trace` answers which scenarios exercise a function (`jig trace fn transfer`),\nwhat is reachable but covered by no scenario (`jig trace uncovered`), and what becomes dead\nif a scenario is deleted (`jig trace scenario overdraft`).\n\n## Standard library\n\nPrelude (no import): `assert(c)`, `panic(msg) -> Never`, `min(a, b)`, `max(a, b)`.\n\n| Type | Methods |\n| --- | --- |\n| integers | `str() abs() min(b) max(b) pow(n) wrapping_add(b) wrapping_sub(b) wrapping_mul(b)` |\n| `Float` | `str() abs() sqrt() floor() ceil() round() is_nan()` |\n| `Char` | `str() is_digit() is_alpha() is_space()` |\n| `Str` | `len() is_empty() s[i] -> U8, s[a..b] -> Str, + contains(t) starts_with(t) ends_with(t) find(t) -> Option<Int> split(sep) -> List<Str> lines() trim() replace(a, b) repeat(n) to_upper() to_lower() to_int() -> Option<Int> to_float() -> Option<Float> bytes() -> List<U8> chars() -> List<Char>` |\n| `List<T>` | `List.new() [a, b] len() is_empty() xs[i] xs[a..b] push(x) pop() -> Option<T> get(i) -> Option<T> first() last() insert(i, x) remove(i) -> T clear() extend(ys) reverse() swap(i, j) truncate(n) repeat(n) contains(x) index_of(x) -> Option<Int> sort() sort_by(f) map(f) filter(f) fold(init, f) any(f) all(f) join(sep)` (`join` on `List<Str>`; `[0].repeat(n)` is n zeros) |\n| `Map<K, V>` | `Map.new() len() is_empty() get(k) -> Option<V> insert(k, v) remove(k) -> Option<V> contains(k) keys() values() entries()` |\n| `Set<T>` | `Set.new() len() insert(x) remove(x) contains(x) items()` |\n| `Option<T>` | `is_some() is_none() unwrap() unwrap_or(d) ok_or(e) map(f)` |\n| `Result<T, E>` | `is_ok() is_err() unwrap() unwrap_or(d) ok() map(f) map_err(f)` |\n\n`unwrap()` requires `is_some()`/`is_ok()`: it is a proof obligation like any `requires`.\nThe prover knows the prelude's contracts (all proved, `jig prove --std`): `map` keeps the\nlength and `filter` does not grow it, `index_of` returns an index in bounds, `first()` and\n`last()` are `Some` exactly when the list is not empty, `Option`/`Result` `map`, `ok_or` and\n`ok` keep whether a value is present, and `min`/`max` return one of their arguments.\nAlso: `Char.is_upper() is_lower() is_alnum() to_upper() to_lower()` and `Set.is_empty()`.\nBehavior worth knowing: `io.read_line()` strips `\\n` or `\\r\\n` and returns a final\nunterminated line; `\"a  b\".split(\" \")` keeps empty pieces; `sort_by(less)` takes a strict\n`fn(T, T) -> Bool` and sorts in place, like `sort()`; `Map.insert` on an existing key keeps\nits position; `Str.to_int` and `to_float` ignore surrounding spaces and accept a sign.\n\n| Package | Functions |\n| --- | --- |\n| `std/io` (`io`) | `print(s) println(s) eprintln(s) read_line() -> Option<Str> read_all() -> Str read(n) -> Str` (`read`: up to `n` bytes, fewer only at the end) |\n| `std/fs` (`fs`) | `read(path) -> Result<Str, Str> write(path, s) -> Result<(), Str> exists(path) -> Bool list(dir) -> Result<List<Str>, Str>` |\n| `std/os` (`env`) | `args() -> List<Str> env(name) -> Option<Str> exit(code) -> Never` |\n| `std/time` (`clock`) | `now_ms() -> Int now_ns() -> Int sleep(ms)`; pure, for UTC dates in years 0 to 9999 (`MIN_MS` to `MAX_MS`): `utc(ms) -> DateTime` (`year month day hour minute second ms`) `unix_ms(d) iso(ms) http_date(ms) -> Str parse_iso(s) -> Option<Int> weekday(ms)` (1 is Monday) `is_leap(year) days_in_month(year, month)` |\n| `std/rand` (`rand`) | `int(lo, hi) -> Int float() -> Float` |\n| `std/math` (pure) | `PI E sin(x) cos(x) tan(x) exp(x) ln(x) log10(x) pow(x, y) gcd(a, b) clamp(x, lo, hi) sign(x) isqrt(n) pow_mod(b, e, m)` |\n| `std/lists` (pure) | `sum(xs) max_of(xs) min_of(xs) -> Option<T> reversed(xs) take(xs, n) drop(xs, n) zip(xs, ys) enumerate(xs) flatten(xss) find(xs, f) -> Option<T> position(xs, f) -> Option<Int> count(xs, f) partition(xs, f) -> (List<T>, List<T>) dedup(xs) unique(xs) chunks(xs, n) binary_search(xs, x) -> Option<Int>` |\n| `std/strings` (pure) | `split_once(s, sep) -> Option<(Str, Str)> strip_prefix(s, p) strip_suffix(s, p) -> Option<Str> trim_start(s) trim_end(s) is_blank(s) pad_left(s, width, c) pad_right(s, width, c) count(s, part) words(s) -> List<Str>` |\n| `std/html` (pure) | `Node` (`Text(text)`, `Element(tag, attrs, children)`), `text(s) el(tag, attrs, children) tag(name, children) render(n) document(title, head, body) escape(s) is_void(tag)`: text and attribute values are escaped when rendered |\n| `std/json` (pure) | `Json` (`Null Bool(value) Int(value) Float(value) String(value) Array(items) Object(fields)`), `parse(s) -> Result<Json, Str>` (errors give line and column; nesting is limited to `MAX_DEPTH`) `stringify(j) pretty(j) quote(s) -> Str`, `j.get(key) j.at(i) -> Option<Json> j.as_str() as_int() as_float() as_bool() as_list() as_fields()` |\n| `std/hash` (pure) | `sha256(s) -> Str sha256_bytes(bytes) -> List<U8> hmac_sha256(key, msg) -> Str hmac_sha256_bytes(key, msg) -> List<U8> hex(bytes) -> Str equal(a, b) -> Bool` (hex digests; `equal` takes the same time wherever texts differ) |\n| `std/regex` (pure) | `compile(pattern) -> Result<Regex, Str>`, `re.find(s) -> Option<Match> re.find_all(s) -> List<Match> re.is_match(s) re.full_match(s) -> Bool re.replace_all(s, with) -> Str re.split(s) -> List<Str>`, `m.start m.end m.text(s) m.group(s, g) -> Option<Str>`, `escape(s) -> Str`. Literals, `.`, `[a-z]` `[^...]` `\\d \\w \\s` (and `\\D \\W \\S`), `^ $ \\b \\B`, `* + ? {m} {m,} {m,n}` (lazy with a `?` after), `( )` and `(?: )`, `\\|`; `$1` and `$$` in `with`. Matching takes time linear in the text; positions are byte offsets |\n| `std/net` (`net`) | `request(addr, req) -> Result<Str, Str> serve(addr, state, handle, limit) -> Result<S, Str>` with `handle: fn(S, Str) -> (S, Str)`, effects `{net}` and `handle`'s; one request per connection, read until the client closes its side; `serve_http` (same arguments) ends a request after its headers and `Content-Length` body, for browsers and HTTP clients (raw request in, raw reply out); `addr` is `host:port` or `:port`. HTTP client: `get(url) post(url, content_type, body) send(method, url, headers, body) -> Result<Response, Str>` (`Response`: `status headers body`, `r.header(name)`; `get` follows up to five redirects), over `fetch(addr, request, tls) -> Result<Str, Str>`; `https://` is TLS through the system's OpenSSL, certificates checked (`SSL_CERT_FILE` adds roots). `parse_url(url) -> Result<Url, Str> request_text(method, url, headers, body) parse_response(raw) -> Result<Response, Str>`; for handlers, `parse_request(raw) -> Result<Request, Str>` (`method path headers body`, `q.header(name)`) and `reply(status, content_type, body) -> Str`. `serve_http_parallel(addr, handle, limit) -> Result<Int, Str>` with a stateless `handle: fn(Str) -> Str` answers several requests at once natively (`JIG_THREADS` workers, else twice the processors) and returns how many it answered |\n| `std/sim` (tests only) | `stdout() stderr() -> Str set_stdin(s) set_args(xs) set_env(k, v) set_file(path, s) file(path) -> Option<Str> remove_file(path) set_time(ms) advance(ms) seed(n) reply(addr, s) requests(addr) -> List<Str> connect(addr, req) answers(addr) -> List<Str>` |\n| `std/task` (`spawn`) | `all(jobs) -> List<T> map(items, f) -> List<U> both(f, g) -> (A, B)` |\n\n## Toolchain\n\n| Command | Does |\n| --- | --- |\n| `jig check [--json]` | parse, types, effects, lints, dead code; milliseconds |\n| `jig prove [filter] [--json] [--verbose] [--std]` | SMT proofs per function, cached in `.jig/proofs` (`--std`: the standard library's) |\n| `jig test [--json] [filter]` | unit tests, property tests, scenarios |\n| `jig get` | download the modules `jig.mod` requires |\n| `jig build [--release] [-o out]` | native binary (debug: checks on; release: `clang -O2`, contracts off) |\n| `jig run [--native] [-- args]` | run `main` (interpreter, or a native debug build) |\n| `jig fmt [--check]` | canonical formatting; no options |\n| `jig trace [fn F \\| scenario S \\| uncovered] [--json]` | traceability between scenarios and code |\n| `jig explain <code>` | long explanation of a diagnostic code |\n| `jig lsp` | a language server for editors over stdio: diagnostics as you type, types and signatures on hover, go to definition, formatting (`editors/vscode` is the VS Code extension) |\n\nEvery diagnostic has a stable code (`E0301`), a span, a message, and where possible a\ncounterexample and candidate fixes. `--json` prints one JSON object per line.\n"

const STD_FS_JIG: Str = "// Files and directories.\n\npub fn read(path: Str) -> Result<Str, Str> effects {fs}\npub fn write(path: Str, contents: Str) -> Result<(), Str> effects {fs}\npub fn exists(path: Str) -> Bool effects {fs}\npub fn list(dir: Str) -> Result<List<Str>, Str> effects {fs}\n"

const STD_HASH_JIG: Str = "// Hashing: SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104), over bytes or text, as bytes\n// or lowercase hex; and a comparison that takes the same time wherever two texts differ,\n// for checking a MAC.\n\n/// SHA-256's round constants.\nfn round_constants() -> List<U32>\n  ensures result.len() == 64\n{\n  return [\n    1116352408,\n    1899447441,\n    3049323471,\n    3921009573,\n    961987163,\n    1508970993,\n    2453635748,\n    2870763221,\n    3624381080,\n    310598401,\n    607225278,\n    1426881987,\n    1925078388,\n    2162078206,\n    2614888103,\n    3248222580,\n    3835390401,\n    4022224774,\n    264347078,\n    604807628,\n    770255983,\n    1249150122,\n    1555081692,\n    1996064986,\n    2554220882,\n    2821834349,\n    2952996808,\n    3210313671,\n    3336571891,\n    3584528711,\n    113926993,\n    338241895,\n    666307205,\n    773529912,\n    1294757372,\n    1396182291,\n    1695183700,\n    1986661051,\n    2177026350,\n    2456956037,\n    2730485921,\n    2820302411,\n    3259730800,\n    3345764771,\n    3516065817,\n    3600352804,\n    4094571909,\n    275423344,\n    430227734,\n    506948616,\n    659060556,\n    883997877,\n    958139571,\n    1322822218,\n    1537002063,\n    1747873779,\n    1955562222,\n    2024104815,\n    2227730452,\n    2361852424,\n    2428436474,\n    2756734187,\n    3204031479,\n    3329325298,\n  ]\n}\n\n/// `x` rotated right by `n` bits.\nfn rotr(x: U32, n: Int) -> U32\n  requires n > 0 && n < 32\n{\n  return (x >> n) | (x << (32 - n))\n}\n\n/// The SHA-256 digest of `data`: 32 bytes.\npub fn sha256_bytes(data: List<U8>) -> List<U8>\n  ensures result.len() == 32\n{\n  let k = round_constants()\n  var h: List<U32> = [\n    1779033703,\n    3144134277,\n    1013904242,\n    2773480762,\n    1359893119,\n    2600822924,\n    528734635,\n    1541459225,\n  ]\n  // The message, a 1 bit, zeros to 56 bytes past a multiple of 64, and its length in bits.\n  var m = data\n  let bits = (data.len() as U64).wrapping_mul(8)\n  m.push(128)\n  for m.len() % 64 != 56 {\n    m.push(0)\n  }\n  for i in 0..8 {\n    m.push(((bits >> (56 - 8 * i)) % 256) as U8)\n  }\n  var w: List<U32> = [0].repeat(64)\n  for blk in 0..m.len() / 64 invariant w.len() == 64 && h.len() == 8 {\n    for t in 0..16 invariant w.len() == 64 {\n      let j = blk * 64 + t * 4\n      w[t] = (m[j] as U32) << 24 |\n        (m[j + 1] as U32) << 16 |\n        (m[j + 2] as U32) << 8 |\n        m[j + 3] as U32\n    }\n    for t in 16..64 invariant w.len() == 64 {\n      let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)\n      let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)\n      w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1)\n    }\n    var a = h[0]\n    var b = h[1]\n    var c = h[2]\n    var d = h[3]\n    var e = h[4]\n    var f = h[5]\n    var g = h[6]\n    var hh = h[7]\n    for t in 0..64 {\n      let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)\n      let ch = (e & f) ^ (~e & g)\n      let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(k[t]).wrapping_add(w[t])\n      let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)\n      let maj = (a & b) ^ (a & c) ^ (b & c)\n      let t2 = s0.wrapping_add(maj)\n      hh = g\n      g = f\n      f = e\n      e = d.wrapping_add(t1)\n      d = c\n      c = b\n      b = a\n      a = t1.wrapping_add(t2)\n    }\n    h[0] = h[0].wrapping_add(a)\n    h[1] = h[1].wrapping_add(b)\n    h[2] = h[2].wrapping_add(c)\n    h[3] = h[3].wrapping_add(d)\n    h[4] = h[4].wrapping_add(e)\n    h[5] = h[5].wrapping_add(f)\n    h[6] = h[6].wrapping_add(g)\n    h[7] = h[7].wrapping_add(hh)\n  }\n  var out: List<U8> = []\n  for i in 0..8 invariant out.len() == i * 4 {\n    out.push(((h[i] >> 24) % 256) as U8)\n    out.push(((h[i] >> 16) % 256) as U8)\n    out.push(((h[i] >> 8) % 256) as U8)\n    out.push((h[i] % 256) as U8)\n  }\n  return out\n}\n\n/// The SHA-256 digest of `s`'s bytes, in hex: 64 characters.\npub fn sha256(s: Str) -> Str\n  ensures result.len() == 64\n{\n  return hex(sha256_bytes(s.bytes()))\n}\n\n/// The HMAC-SHA-256 of `msg` under `key` (RFC 2104): 32 bytes.\npub fn hmac_sha256_bytes(key: List<U8>, msg: List<U8>) -> List<U8>\n  ensures result.len() == 32\n{\n  var k = if key.len() > 64 { sha256_bytes(key) } else { key }\n  for k.len() < 64 {\n    k.push(0)\n  }\n  var inner: List<U8> = []\n  var outer: List<U8> = []\n  for i in 0..64 {\n    inner.push(k[i] ^ 54)\n    outer.push(k[i] ^ 92)\n  }\n  inner.extend(msg)\n  outer.extend(sha256_bytes(inner))\n  return sha256_bytes(outer)\n}\n\n/// The HMAC-SHA-256 of `msg` under `key`, in hex: 64 characters.\npub fn hmac_sha256(key: Str, msg: Str) -> Str\n  ensures result.len() == 64\n{\n  return hex(hmac_sha256_bytes(key.bytes(), msg.bytes()))\n}\n\n/// `bytes` in lowercase hex, two characters a byte.\npub fn hex(bytes: List<U8>) -> Str\n  ensures result.len() == bytes.len() * 2\n{\n  let digits = \"0123456789abcdef\"\n  var out = \"\"\n  for i in 0..bytes.len() invariant out.len() == i * 2 {\n    let b = bytes[i] as Int\n    out += digits[b / 16..b / 16 + 1] + digits[b % 16..b % 16 + 1]\n  }\n  return out\n}\n\n/// Whether `a` and `b` are the same text, taking as long wherever they differ, so the time\n/// does not tell how much of a secret was guessed right.\npub fn equal(a: Str, b: Str) -> Bool\n  ensures !result || a.len() == b.len()\n{\n  if a.len() != b.len() {\n    return false\n  }\n  var diff: U8 = 0\n  for i in 0..a.len() {\n    diff = diff | (a[i] ^ b[i])\n  }\n  return diff == 0\n}\n"

const STD_HTML_JIG: Str = "// HTML pages as trees of nodes, rendered to text with every text and attribute value\n// escaped, so no data can open a tag, close one or end an attribute. Tag and attribute\n// names are written as they are given: they come from the program, not from its data.\n\n/// A piece of a page.\npub enum Node {\n  Text(text: Str)\n  Element(tag: Str, attrs: List<(Str, Str)>, children: List<Node>)\n}\n\n/// Text, shown as written.\npub fn text(s: Str) -> Node\n  ensures result == Node.Text(s)\n{\n  return Node.Text(s)\n}\n\n/// An element with attributes (name and value) and children.\npub fn el(tag: Str, attrs: List<(Str, Str)>, children: List<Node>) -> Node\n  ensures result == Node.Element(tag, attrs, children)\n{\n  return Node.Element(tag, attrs, children)\n}\n\n/// An element with children and no attributes.\npub fn tag(name: Str, children: List<Node>) -> Node\n  ensures result == Node.Element(name, [], children)\n{\n  return Node.Element(name, [], children)\n}\n\n/// The character reference for byte `b`, or \"\" if it needs none.\nfn reference(b: U8) -> Str\n  ensures result.is_empty() || result.len() >= 4\n{\n  if b == 38 {\n    return \"&amp;\"\n  }\n  if b == 60 {\n    return \"&lt;\"\n  }\n  if b == 62 {\n    return \"&gt;\"\n  }\n  if b == 34 {\n    return \"&quot;\"\n  }\n  if b == 39 {\n    return \"&#39;\"\n  }\n  return \"\"\n}\n\n/// `s` with `&`, `<`, `>`, `\"` and `'` replaced by character references.\npub fn escape(s: Str) -> Str\n  ensures result.len() >= s.len()\n{\n  var out = \"\"\n  var start = 0\n  for i in 0..s.len() invariant start >= 0 && start <= i && out.len() >= start {\n    let r = reference(s[i])\n    if !r.is_empty() {\n      out += s[start..i] + r\n      start = i + 1\n    }\n  }\n  return out + s[start..s.len()]\n}\n\n/// Elements HTML writes without children or a closing tag.\npub fn is_void(tag: Str) -> Bool {\n  return tag == \"meta\" ||\n    tag == \"link\" ||\n    tag == \"br\" ||\n    tag == \"hr\" ||\n    tag == \"img\" ||\n    tag == \"input\"\n}\n\n/// The opening tag of an element: its name and attributes, values escaped.\nfn open_tag(name: Str, attrs: List<(Str, Str)>) -> Str\n  ensures result.len() >= name.len() + 2\n{\n  var out = \"<\" + name\n  for i in 0..attrs.len() invariant out.len() >= name.len() + 1 {\n    out += \" \" + attrs[i].0 + \"=\\\"\" + escape(attrs[i].1) + \"\\\"\"\n  }\n  return out + \">\"\n}\n\n/// `n` as HTML.\npub fn render(n: Node) -> Str {\n  return match n {\n    Text(s) => escape(s)\n    Element(name, attrs, children) => {\n      var out = open_tag(name, attrs)\n      if !is_void(name) {\n        for c in children {\n          out += render(c)\n        }\n        out += \"</\" + name + \">\"\n      }\n      out\n    }\n  }\n}\n\n/// A whole document: the doctype, then `<html>` with a head (the charset, `title`, then\n/// `head`) and `body`.\npub fn document(title: Str, head: List<Node>, body: List<Node>) -> Str {\n  var h = [el(\"meta\", [(\"charset\", \"utf-8\")], []), tag(\"title\", [text(title)])]\n  h.extend(head)\n  return \"<!doctype html>\\n\" + render(tag(\"html\", [tag(\"head\", h), tag(\"body\", body)])) + \"\\n\"\n}\n"

const STD_IO_JIG: Str = "// Console input and output.\n\npub fn print(s: Str) effects {io}\npub fn println(s: Str) effects {io}\npub fn eprintln(s: Str) effects {io}\npub fn read_line() -> Option<Str> effects {io}\npub fn read_all() -> Str effects {io}\n\n/// Up to `n` bytes of standard input: fewer only when it ends, `\"\"` after.\npub fn read(n: Int) -> Str\n  requires n >= 0\n  effects {io}\n"

const STD_JSON_JIG: Str = "// JSON (RFC 8259): `parse` reads a document into a `Json` value and `stringify` and `pretty`\n// write one. Numbers without a fraction or exponent that fit in an `Int` stay exact; others\n// are `Float`s. Objects keep their keys in the order written. Nesting deeper than\n// `MAX_DEPTH` is an error rather than a deep recursion.\n\n/// A JSON value.\npub enum Json {\n  Null\n  Bool(value: Bool)\n  Int(value: Int)\n  Float(value: Float)\n  String(value: Str)\n  Array(items: List<Json>)\n  Object(fields: List<(Str, Json)>)\n}\n\n/// How deeply arrays and objects may nest in a document `parse` reads.\npub const MAX_DEPTH: Int = 512\n\n/// A parse in progress: the text, its bytes, the offset reached and the nesting depth.\nstruct Reader {\n  s: Str\n  b: List<U8>\n  i: Int\n  depth: Int\n  invariant b.len() == s.len() && i >= 0 && i <= b.len() && depth >= 0\n}\n\n/// The value `src` holds, or what is wrong and where (`line 3, column 7: ...`).\npub fn parse(src: Str) -> Result<Json, Str> {\n  var r = Reader { s: src, b: src.bytes(), i: 0, depth: 0 }\n  r.ws()\n  let v = r.value()?\n  r.ws()\n  if r.i != r.b.len() {\n    return Err(r.err(\"text after the value\"))\n  }\n  return Ok(v)\n}\n\nfn Reader.ws(&mut self)\n  ensures self.i >= old(self.i)\n{\n  let start = self.i\n  for self.i < self.b.len() &&\n    (self.b[self.i] == 32 || self.b[self.i] == 9 || self.b[self.i] == 10 || self.b[self.i] == 13)\n    invariant self.i >= start && self.i <= self.b.len()\n  {\n    self.i += 1\n  }\n}\n\n/// `msg` with where the reader is: `line 2, column 5: msg`.\nfn Reader.err(self, msg: Str) -> Str\n  ensures result.len() > msg.len()\n{\n  var line = 1\n  var col = 1\n  for k in 0..self.i invariant line >= 1 && line <= k + 1 && col >= 1 && col <= k + 1 {\n    if self.b[k] == 10 {\n      line += 1\n      col = 1\n    } else if self.b[k] < 128 || self.b[k] >= 192 {\n      col += 1\n    }\n  }\n  return \"line \" + line.str() + \", column \" + col.str() + \": \" + msg\n}\n\n/// Whether the next byte is `c`.\nfn Reader.at(self, c: U8) -> Bool\n  ensures !result || self.i < self.b.len()\n{\n  return self.i < self.b.len() && self.b[self.i] == c\n}\n\nfn Reader.word(&mut self, w: Str, v: Json) -> Result<Json, Str>\n  ensures self.i >= old(self.i)\n{\n  if w.len() <= self.s.len() - self.i && self.s[self.i..self.i + w.len()] == w {\n    self.i += w.len()\n    return Ok(v)\n  }\n  return Err(self.err(\"unknown word\"))\n}\n\nfn Reader.value(&mut self) -> Result<Json, Str>\n  ensures self.i >= old(self.i)\n{\n  if self.i >= self.b.len() {\n    return Err(self.err(\"a value is missing\"))\n  }\n  let c = self.b[self.i]\n  if c == 110 {\n    return self.word(\"null\", Json.Null)\n  }\n  if c == 116 {\n    return self.word(\"true\", Json.Bool(true))\n  }\n  if c == 102 {\n    return self.word(\"false\", Json.Bool(false))\n  }\n  if c == 34 {\n    return Ok(Json.String(self.string()?))\n  }\n  if c == 91 || c == 123 {\n    if self.depth >= MAX_DEPTH {\n      return Err(self.err(\"nested more than \" + MAX_DEPTH.str() + \" deep\"))\n    }\n    self.depth += 1\n    let v = if c == 91 { self.array()? } else { self.object()? }\n    self.depth = max(self.depth - 1, 0)\n    return Ok(v)\n  }\n  if c == 45 || c >= 48 && c <= 57 {\n    return self.number()\n  }\n  return Err(self.err(\"a value cannot start with this character\"))\n}\n\nfn Reader.array(&mut self) -> Result<Json, Str>\n  requires self.i < self.b.len()\n  ensures self.i >= old(self.i)\n{\n  let i0 = self.i\n  self.i += 1\n  var items: List<Json> = []\n  self.ws()\n  if self.at(93) {\n    self.i += 1\n    return Ok(Json.Array(items))\n  }\n  for invariant self.i > i0 && self.i <= self.b.len() {\n    self.ws()\n    items.push(self.value()?)\n    self.ws()\n    if self.at(44) {\n      self.i += 1\n    } else if self.at(93) {\n      self.i += 1\n      return Ok(Json.Array(items))\n    } else {\n      return Err(self.err(\"expected `,` or `]`\"))\n    }\n  }\n}\n\nfn Reader.object(&mut self) -> Result<Json, Str>\n  requires self.i < self.b.len()\n  ensures self.i >= old(self.i)\n{\n  let i0 = self.i\n  self.i += 1\n  var fields: List<(Str, Json)> = []\n  self.ws()\n  if self.at(125) {\n    self.i += 1\n    return Ok(Json.Object(fields))\n  }\n  for invariant self.i > i0 && self.i <= self.b.len() {\n    self.ws()\n    if !self.at(34) {\n      return Err(self.err(\"expected a key in quotes\"))\n    }\n    let k = self.string()?\n    self.ws()\n    if !self.at(58) {\n      return Err(self.err(\"expected `:`\"))\n    }\n    self.i += 1\n    self.ws()\n    fields.push((k, self.value()?))\n    self.ws()\n    if self.at(44) {\n      self.i += 1\n    } else if self.at(125) {\n      self.i += 1\n      return Ok(Json.Object(fields))\n    } else {\n      return Err(self.err(\"expected `,` or `}`\"))\n    }\n  }\n}\n\n/// How many digits start at `self.i`.\nfn Reader.digits(&mut self) -> Int\n  ensures result >= 0 && self.i - old(self.i) == result\n{\n  let start = self.i\n  for self.i < self.b.len() && self.b[self.i] >= 48 && self.b[self.i] <= 57\n    invariant self.i >= start && self.i <= self.b.len()\n  {\n    self.i += 1\n  }\n  return self.i - start\n}\n\n/// A number, as the grammar has it: `-`, then `0` or digits not starting with `0`, then\n/// optionally `.` and digits, then optionally `e` or `E`, a sign and digits.\nfn Reader.number(&mut self) -> Result<Json, Str>\n  ensures self.i >= old(self.i)\n{\n  let start = self.i\n  if self.at(45) {\n    self.i += 1\n  }\n  let first = self.i\n  let whole = self.digits()\n  if whole == 0 || whole > 1 && self.b[first] == 48 {\n    return Err(self.err(\"a number needs digits, and no leading zero\"))\n  }\n  var exact = true\n  if self.at(46) {\n    self.i += 1\n    exact = false\n    if self.digits() == 0 {\n      return Err(self.err(\"a fraction needs digits\"))\n    }\n  }\n  if self.at(101) || self.at(69) {\n    self.i += 1\n    exact = false\n    if self.at(43) || self.at(45) {\n      self.i += 1\n    }\n    if self.digits() == 0 {\n      return Err(self.err(\"an exponent needs digits\"))\n    }\n  }\n  let text = self.s[start..self.i]\n  if exact {\n    match text.to_int() {\n      Some(n) => {\n        return Ok(Json.Int(n))\n      }\n      None => {}\n    }\n  }\n  return match text.to_float() {\n    Some(f) => Ok(Json.Float(f))\n    None => Err(self.err(\"not a number\"))\n  }\n}\n\n/// The value of hex digit `b`, or -1.\nfn hex_digit(b: U8) -> Int\n  ensures result >= -1 && result < 16\n{\n  if b >= 48 && b <= 57 {\n    return b as Int - 48\n  }\n  if b >= 97 && b <= 102 {\n    return b as Int - 87\n  }\n  if b >= 65 && b <= 70 {\n    return b as Int - 55\n  }\n  return -1\n}\n\n/// The four hex digits after `\\u`.\nfn Reader.hex4(&mut self) -> Result<Int, Str>\n  ensures self.i >= old(self.i), result.is_err() || result.unwrap() >= 0 && result.unwrap() < 65536\n{\n  if 4 > self.b.len() - self.i {\n    return Err(self.err(\"a \\\\u escape needs four hex digits\"))\n  }\n  let (a, b, c, d) = (\n    hex_digit(self.b[self.i]),\n    hex_digit(self.b[self.i + 1]),\n    hex_digit(self.b[self.i + 2]),\n    hex_digit(self.b[self.i + 3]),\n  )\n  if a < 0 || b < 0 || c < 0 || d < 0 {\n    return Err(self.err(\"a \\\\u escape needs four hex digits\"))\n  }\n  self.i += 4\n  return Ok(a * 4096 + b * 256 + c * 16 + d)\n}\n\n/// A string, from its opening quote to its closing one, escapes read.\nfn Reader.string(&mut self) -> Result<Str, Str>\n  requires self.i < self.b.len()\n  ensures self.i >= old(self.i)\n{\n  let i0 = self.i\n  self.i += 1\n  var out = \"\"\n  for invariant self.i > i0 && self.i <= self.b.len() {\n    let start = self.i\n    for self.i < self.b.len() &&\n      self.b[self.i] != 34 &&\n      self.b[self.i] != 92 &&\n      self.b[self.i] >= 32 invariant self.i >= start && self.i <= self.b.len() {\n      self.i += 1\n    }\n    out += self.s[start..self.i]\n    if self.i >= self.b.len() {\n      return Err(self.err(\"a string is not closed\"))\n    }\n    let q = self.b[self.i]\n    if q == 34 {\n      self.i += 1\n      return Ok(out)\n    }\n    if q < 32 {\n      return Err(self.err(\"a control character must be escaped in a string\"))\n    }\n    self.i += 1\n    if self.i >= self.b.len() {\n      return Err(self.err(\"an escape is not finished\"))\n    }\n    let e = self.b[self.i]\n    self.i += 1\n    if e == 117 {\n      var cp = self.hex4()?\n      if cp >= 55296 &&\n        cp < 56320 &&\n        self.at(92) &&\n        self.i + 1 < self.b.len() &&\n        self.b[self.i + 1] == 117 {\n        let back = self.i\n        self.i += 2\n        let lo = self.hex4()?\n        if lo >= 56320 && lo < 57344 {\n          cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)\n        } else {\n          self.i = back\n        }\n      }\n      // A surrogate without its other half is not a character: the replacement character.\n      out += ((if cp >= 55296 && cp < 57344 { 65533 } else { cp }) as Char).str()\n      continue\n    }\n    out += if e == 34 {\n      \"\\\"\"\n    } else if e == 92 {\n      \"\\\\\"\n    } else if e == 47 {\n      \"/\"\n    } else if e == 98 {\n      (8 as Char).str()\n    } else if e == 102 {\n      (12 as Char).str()\n    } else if e == 110 {\n      \"\\n\"\n    } else if e == 114 {\n      \"\\r\"\n    } else if e == 116 {\n      \"\\t\"\n    } else {\n      return Err(self.err(\"unknown escape\"))\n    }\n  }\n}\n\n/// `s` as a JSON string: in quotes, with `\"`, `\\` and control characters escaped.\npub fn quote(s: Str) -> Str\n  ensures result.len() >= s.len() + 2\n{\n  var out = \"\\\"\"\n  var start = 0\n  let hex = \"0123456789abcdef\"\n  for i in 0..s.len() invariant start >= 0 && start <= i && out.len() >= start + 1 {\n    let b = s[i]\n    if b == 34 || b == 92 || b < 32 {\n      let e = if b == 34 {\n        \"\\\\\\\"\"\n      } else if b == 92 {\n        \"\\\\\\\\\"\n      } else if b == 10 {\n        \"\\\\n\"\n      } else if b == 13 {\n        \"\\\\r\"\n      } else if b == 9 {\n        \"\\\\t\"\n      } else {\n        let n = b as Int\n        \"\\\\u00\" + hex[n / 16..n / 16 + 1] + hex[n % 16..n % 16 + 1]\n      }\n      out += s[start..i] + e\n      start = i + 1\n    }\n  }\n  return out + s[start..s.len()] + \"\\\"\"\n}\n\n/// A number as JSON writes it: integral values without a fraction, and `null` for what JSON\n/// cannot write (infinities and NaN).\nfn number_text(f: Float) -> Str\n  ensures !result.is_empty()\n{\n  if f.is_nan() || f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {\n    return \"null\"\n  }\n  if f == f.floor() && f.abs() < 1000000000000000.0 {\n    return (f as Int).str() + \".0\"\n  }\n  let t = f.str()\n  return if t.is_empty() { \"null\" } else { t }\n}\n\n/// `j` as compact JSON text.\npub fn stringify(j: Json) -> Str\n  ensures !result.is_empty()\n{\n  return match j {\n    Null => \"null\"\n    Bool(b) => if b { \"true\" } else { \"false\" }\n    Int(n) => n.str()\n    Float(f) => number_text(f)\n    String(s) => quote(s)\n    Array(items) => {\n      var parts: List<Str> = []\n      for x in items {\n        parts.push(stringify(x))\n      }\n      \"[\" + parts.join(\",\") + \"]\"\n    }\n    Object(fields) => {\n      var parts: List<Str> = []\n      for f in fields {\n        parts.push(quote(f.0) + \":\" + stringify(f.1))\n      }\n      \"{\" + parts.join(\",\") + \"}\"\n    }\n  }\n}\n\n/// `j` as JSON text indented by two spaces a level, one item or field a line.\npub fn pretty(j: Json) -> Str\n  ensures !result.is_empty()\n{\n  return indented(j, \"\")\n}\n\nfn indented(j: Json, pad: Str) -> Str\n  ensures !result.is_empty()\n{\n  let inner = pad + \"  \"\n  return match j {\n    Array(items) => if items.is_empty() {\n      \"[]\"\n    } else {\n      var parts: List<Str> = []\n      for x in items {\n        parts.push(inner + indented(x, inner))\n      }\n      \"[\\n\" + parts.join(\",\\n\") + \"\\n\" + pad + \"]\"\n    }\n    Object(fields) => if fields.is_empty() {\n      \"{}\"\n    } else {\n      var parts: List<Str> = []\n      for f in fields {\n        parts.push(inner + quote(f.0) + \": \" + indented(f.1, inner))\n      }\n      \"{\\n\" + parts.join(\",\\n\") + \"\\n\" + pad + \"}\"\n    }\n    _ => stringify(j)\n  }\n}\n\n/// The value of field `key`, if this is an object that has it (the first, if it has two).\npub fn Json.get(self, key: Str) -> Option<Json> {\n  match self {\n    Object(fields) => {\n      for f in fields {\n        if f.0 == key {\n          return Some(f.1)\n        }\n      }\n    }\n    _ => {}\n  }\n  return None\n}\n\n/// Item `i`, if this is an array that long.\npub fn Json.at(self, i: Int) -> Option<Json> {\n  return match self {\n    Array(items) => items.get(i)\n    _ => None\n  }\n}\n\n/// The text, if this is a string.\npub fn Json.as_str(self) -> Option<Str> {\n  return match self {\n    String(s) => Some(s)\n    _ => None\n  }\n}\n\n/// The number, if this is an integer (or a float with an integral value that fits).\npub fn Json.as_int(self) -> Option<Int> {\n  return match self {\n    Int(n) => Some(n)\n    Float(f) => if f == f.floor() && f.abs() < 9000000000000000000.0 {\n      Some(f as Int)\n    } else {\n      None\n    }\n    _ => None\n  }\n}\n\n/// The number, if this is one.\npub fn Json.as_float(self) -> Option<Float> {\n  return match self {\n    Int(n) => Some(n as Float)\n    Float(f) => Some(f)\n    _ => None\n  }\n}\n\n/// The truth value, if this is `true` or `false`.\npub fn Json.as_bool(self) -> Option<Bool> {\n  return match self {\n    Bool(b) => Some(b)\n    _ => None\n  }\n}\n\n/// The items, if this is an array.\npub fn Json.as_list(self) -> Option<List<Json>> {\n  return match self {\n    Array(items) => Some(items)\n    _ => None\n  }\n}\n\n/// The fields, if this is an object.\npub fn Json.as_fields(self) -> Option<List<(Str, Json)>> {\n  return match self {\n    Object(fields) => Some(fields)\n    _ => None\n  }\n}\n"

const STD_LISTS_JIG: Str = "// List helpers, written in Jig. Every contract here is proved (`jig prove --std`).\n\n/// The sum of the numbers (traps on overflow).\npub fn sum(xs: List<Int>) -> Int\n  ensures !xs.is_empty() || result == 0\n{\n  var total = 0\n  for i in 0..xs.len() invariant i > 0 || total == 0 {\n    total += xs[i]\n  }\n  return total\n}\n\n/// The largest element, or `None` for an empty list.\npub fn max_of<T: Ord>(xs: List<T>) -> Option<T>\n  ensures result.is_some() == !xs.is_empty()\n{\n  if xs.is_empty() {\n    return None\n  }\n  var best = xs[0]\n  for i in 1..xs.len() {\n    if xs[i] > best {\n      best = xs[i]\n    }\n  }\n  return Some(best)\n}\n\n/// The smallest element, or `None` for an empty list.\npub fn min_of<T: Ord>(xs: List<T>) -> Option<T>\n  ensures result.is_some() == !xs.is_empty()\n{\n  if xs.is_empty() {\n    return None\n  }\n  var best = xs[0]\n  for i in 1..xs.len() {\n    if xs[i] < best {\n      best = xs[i]\n    }\n  }\n  return Some(best)\n}\n\n/// A reversed copy.\npub fn reversed<T>(xs: List<T>) -> List<T>\n  ensures result.len() == xs.len()\n{\n  var out: List<T> = []\n  for i in 0..xs.len() invariant out.len() == i {\n    out.push(xs[xs.len() - 1 - i])\n  }\n  return out\n}\n\n/// The first `n` elements (all of them if there are fewer).\npub fn take<T>(xs: List<T>, n: Int) -> List<T>\n  requires n >= 0\n  ensures result.len() == min(n, xs.len())\n{\n  let k = min(n, xs.len())\n  var out: List<T> = []\n  for i in 0..k invariant out.len() == i {\n    out.push(xs[i])\n  }\n  return out\n}\n\n/// Everything after the first `n` elements.\npub fn drop<T>(xs: List<T>, n: Int) -> List<T>\n  requires n >= 0\n  ensures result.len() == xs.len() - min(n, xs.len())\n{\n  let k = min(n, xs.len())\n  var out: List<T> = []\n  for i in k..xs.len() invariant out.len() == i - k {\n    out.push(xs[i])\n  }\n  return out\n}\n\n/// Pairs of elements at the same position, as many as the shorter list has.\npub fn zip<A, B>(xs: List<A>, ys: List<B>) -> List<(A, B)>\n  ensures result.len() == min(xs.len(), ys.len())\n{\n  let n = min(xs.len(), ys.len())\n  var out: List<(A, B)> = []\n  for i in 0..n invariant out.len() == i {\n    out.push((xs[i], ys[i]))\n  }\n  return out\n}\n\n/// Each element with its index.\npub fn enumerate<T>(xs: List<T>) -> List<(Int, T)>\n  ensures result.len() == xs.len()\n{\n  var out: List<(Int, T)> = []\n  for i in 0..xs.len() invariant out.len() == i {\n    out.push((i, xs[i]))\n  }\n  return out\n}\n\n/// The lists one after another.\npub fn flatten<T>(xss: List<List<T>>) -> List<T>\n  ensures !xss.is_empty() || result.is_empty()\n{\n  var out: List<T> = []\n  for i in 0..xss.len() invariant i > 0 || out.is_empty() {\n    out.extend(xss[i])\n  }\n  return out\n}\n\n/// The first element `pred` accepts.\npub fn find<T>(xs: List<T>, pred: fn(T) -> Bool) -> Option<T>\n  ensures result.is_none() || !xs.is_empty()\n  effects {pred}\n{\n  for i in 0..xs.len() {\n    if pred(xs[i]) {\n      return Some(xs[i])\n    }\n  }\n  return None\n}\n\n/// The index of the first element `pred` accepts.\npub fn position<T>(xs: List<T>, pred: fn(T) -> Bool) -> Option<Int>\n  ensures result.is_none() || (result.unwrap() >= 0 && result.unwrap() < xs.len())\n  effects {pred}\n{\n  for i in 0..xs.len() {\n    if pred(xs[i]) {\n      return Some(i)\n    }\n  }\n  return None\n}\n\n/// How many elements `pred` accepts.\npub fn count<T>(xs: List<T>, pred: fn(T) -> Bool) -> Int\n  ensures result >= 0 && result <= xs.len()\n  effects {pred}\n{\n  var n = 0\n  for i in 0..xs.len() invariant n >= 0 && n <= i {\n    if pred(xs[i]) {\n      n += 1\n    }\n  }\n  return n\n}\n\n/// The elements `pred` accepts, then the rest, each in order.\npub fn partition<T>(xs: List<T>, pred: fn(T) -> Bool) -> (List<T>, List<T>)\n  ensures result.0.len() + result.1.len() == xs.len()\n  effects {pred}\n{\n  var yes: List<T> = []\n  var no: List<T> = []\n  for i in 0..xs.len() invariant yes.len() + no.len() == i {\n    if pred(xs[i]) {\n      yes.push(xs[i])\n    } else {\n      no.push(xs[i])\n    }\n  }\n  return (yes, no)\n}\n\n/// The list without consecutive repeats (`[1, 1, 2, 1]` becomes `[1, 2, 1]`).\npub fn dedup<T: Eq>(xs: List<T>) -> List<T>\n  ensures result.len() <= xs.len()\n{\n  var out: List<T> = []\n  for i in 0..xs.len() invariant out.len() <= i {\n    if i == 0 || xs[i] != xs[i - 1] {\n      out.push(xs[i])\n    }\n  }\n  return out\n}\n\n/// The first occurrence of each distinct element, in order.\npub fn unique<T: Hash>(xs: List<T>) -> List<T>\n  ensures result.len() <= xs.len()\n{\n  var seen: Set<T> = Set.new()\n  var out: List<T> = []\n  for i in 0..xs.len() invariant out.len() <= i {\n    if !seen.contains(xs[i]) {\n      seen.insert(xs[i])\n      out.push(xs[i])\n    }\n  }\n  return out\n}\n\n/// Consecutive pieces of `size` elements; the last may be shorter.\npub fn chunks<T>(xs: List<T>, size: Int) -> List<List<T>>\n  requires size > 0\n  ensures !xs.is_empty() || result.is_empty()\n{\n  var out: List<List<T>> = []\n  var i = 0\n  for i < xs.len() invariant i >= 0 && i <= xs.len() && (i > 0 || out.is_empty()) {\n    let end = if size >= xs.len() - i { xs.len() } else { i + size }\n    out.push(xs[i..end])\n    i = end\n  }\n  return out\n}\n\n/// The index of `x` in a list sorted in ascending order, if it is there.\npub fn binary_search<T: Ord>(xs: List<T>, x: T) -> Option<Int>\n  ensures result.is_none() || (result.unwrap() >= 0 && result.unwrap() < xs.len())\n{\n  var lo = 0\n  var hi = xs.len()\n  for lo < hi invariant lo >= 0 && hi <= xs.len() {\n    let mid = lo + (hi - lo) / 2\n    if xs[mid] == x {\n      return Some(mid)\n    }\n    if xs[mid] < x {\n      lo = mid + 1\n    } else {\n      hi = mid\n    }\n  }\n  return None\n}\n"

const STD_MATH_JIG: Str = "// Pure math functions.\n\npub const PI: Float = 3.141592653589793\npub const E: Float = 2.718281828459045\n\npub fn sin(x: Float) -> Float\npub fn cos(x: Float) -> Float\npub fn tan(x: Float) -> Float\npub fn atan2(y: Float, x: Float) -> Float\npub fn exp(x: Float) -> Float\npub fn ln(x: Float) -> Float\npub fn log10(x: Float) -> Float\npub fn pow(x: Float, y: Float) -> Float\n\n// ---- integers, written in Jig ----\n\n/// The greatest common divisor of two non-negative numbers (`gcd(0, 0)` is 0).\npub fn gcd(a: Int, b: Int) -> Int\n  requires a >= 0, b >= 0\n  ensures result >= 0\n{\n  var x = a\n  var y = b\n  for y != 0 invariant x >= 0 && y >= 0 {\n    let r = x % y\n    x = y\n    y = r\n  }\n  return x\n}\n\n/// `x`, limited to `lo` and `hi`.\npub fn clamp(x: Int, lo: Int, hi: Int) -> Int\n  requires lo <= hi\n  ensures result >= lo && result <= hi\n{\n  if x < lo {\n    return lo\n  }\n  if x > hi {\n    return hi\n  }\n  return x\n}\n\n/// -1, 0 or 1: the sign of `x`.\npub fn sign(x: Int) -> Int\n  ensures result >= -1 && result <= 1\n{\n  if x < 0 {\n    return -1\n  }\n  if x > 0 {\n    return 1\n  }\n  return 0\n}\n\n/// The integer square root: the largest `r` with `r * r <= n`.\npub fn isqrt(n: Int) -> Int\n  requires n >= 0\n  ensures result >= 0 && result * result <= n\n{\n  // 3037000499 is the largest number whose square fits in an `Int`.\n  var lo = 0\n  var hi = min(n, 3037000499) + 1\n  for hi - lo > 1 invariant lo >= 0 && lo < hi && hi <= 3037000500 && lo * lo <= n {\n    let mid = lo + (hi - lo) / 2\n    if mid * mid <= n {\n      lo = mid\n    } else {\n      hi = mid\n    }\n  }\n  return lo\n}\n\n/// `base` to the power `exp`, modulo `m`, without overflow (`m` at most 3037000499).\npub fn pow_mod(base: Int, exp: Int, m: Int) -> Int\n  requires exp >= 0, m > 0, m <= 3037000499\n  ensures result >= 0 && result < m\n{\n  var acc = 1 % m\n  var b = (base % m + m) % m\n  var e = exp\n  for e > 0 invariant acc >= 0 && acc < m && b >= 0 && b < m && e >= 0 {\n    if e % 2 == 1 {\n      acc = acc * b % m\n    }\n    b = b * b % m\n    e = e / 2\n  }\n  return acc\n}\n"

const STD_NET_JIG: Str = "// Networking over TCP, one request per connection: the client sends its request and closes\n// its sending side, the server reads it to the end, answers and closes. Addresses are\n// \"host:port\"; \":port\" means this machine.\n\n/// Send `request` to the server at `addr` and return its reply.\npub fn request(addr: Str, request: Str) -> Result<Str, Str> effects {net}\n\n/// Serve HTTP on `addr` like `serve_http`, answering several connections at once: native\n/// programs take each request on one of several threads (`JIG_THREADS`, else twice the\n/// processors), so `handle` keeps no state of its own (keep it in a database or files) and\n/// may run more than once at a time. A connection waits at most 30 seconds for its client.\n/// Returns how many requests it answered, after `limit` (0: keep serving). The interpreter,\n/// and so `jig test`, answers one at a time.\npub fn serve_http_parallel(addr: Str, handle: fn(Str) -> Str, limit: Int) -> Result<Int, Str>\n  requires limit >= 0\n  effects {net, handle}\n\n/// Send the HTTP request `request` to `addr` and read the reply until the server closes the\n/// connection, which a request with `Connection: close` asks it to; unlike `request`, the\n/// sending side stays open. With `tls`, the connection is TLS through the system's OpenSSL,\n/// opened when first needed: the server's certificate must chain to a trusted root (the\n/// system's, or the file `SSL_CERT_FILE` names) and name the host in `addr`. A read waits at\n/// most 30 seconds. In tests it answers from the replies queued with `sim.reply` for `addr`,\n/// as `request` does. `get`, `post` and `send` build on it.\npub fn fetch(addr: Str, request: Str, tls: Bool) -> Result<Str, Str> effects {net}\n\n/// Serve on `addr`, one connection at a time. Each request goes to `handle` with the\n/// current state, which returns the new state and the reply; serving performs whatever\n/// effects `handle` has. Returns the final state after `limit` requests (0: keep serving).\n/// In tests it answers the simulated connections queued with `sim.connect`, then returns.\npub fn serve<S>(addr: Str, state: S, handle: fn(S, Str) -> (S, Str), limit: Int) -> Result<S, Str>\n  requires limit >= 0\n  effects {net, handle}\n\n/// Serve HTTP/1.x on `addr`, like `serve`, for browsers and other HTTP clients, which do not\n/// close their sending side: a request ends after its headers and the `Content-Length` bytes\n/// of body they announce. `handle` gets the raw request (request line, headers, body) and\n/// returns the raw reply (status line, headers, body); the connection closes after it. A\n/// request with `Transfer-Encoding` (a chunked body) is answered `411 Length Required`, one\n/// whose `Content-Length` is not a number `400 Bad Request`, without calling `handle`.\npub fn serve_http<S>(\n  addr: Str,\n  state: S,\n  handle: fn(S, Str) -> (S, Str),\n  limit: Int,\n) -> Result<S, Str>\n  requires limit >= 0\n  effects {net, handle}\n\n// ---- HTTP messages, written in Jig ----\n\n/// A URL `send` can fetch: `http://` or `https://`, a host, an optional port and a path with\n/// any query (`/` if none).\npub struct Url {\n  pub tls: Bool\n  pub host: Str\n  pub port: Int\n  pub path: Str\n  invariant port >= 1 && port <= 65535\n}\n\n/// An HTTP reply.\npub struct Response {\n  pub status: Int\n  pub headers: List<(Str, Str)>\n  pub body: Str\n}\n\n/// An HTTP request, as `serve_http` hands it to a handler.\npub struct Request {\n  pub method: Str\n  pub path: Str\n  pub headers: List<(Str, Str)>\n  pub body: Str\n}\n\n/// Where `part` first occurs in `s` at or after `from`, or -1.\nfn index_from(s: Str, part: Str, from: Int) -> Int\n  requires from >= 0\n  ensures result == -1 || result >= from && result <= s.len() - part.len()\n{\n  let n = part.len()\n  if n > s.len() {\n    return -1\n  }\n  for i in from..s.len() - n + 1 {\n    if s[i..i + n] == part {\n      return i\n    }\n  }\n  return -1\n}\n\n/// `url`'s parts, or what is wrong with it.\npub fn parse_url(url: Str) -> Result<Url, Str>\n  ensures result.is_err() || !result.unwrap().host.is_empty()\n{\n  var tls = false\n  var start = 0\n  if url.len() >= 8 && url[0..8].to_lower() == \"https://\" {\n    tls = true\n    start = 8\n  } else if url.len() >= 7 && url[0..7].to_lower() == \"http://\" {\n    start = 7\n  } else {\n    return Err(\"`\" + url + \"` is not an http:// or https:// URL\")\n  }\n  // The host and port end at the first `/`, `?` or `#`.\n  var end = start\n  for end < url.len() && url[end] != 47 && url[end] != 63 && url[end] != 35\n    invariant end >= start && end <= url.len()\n  {\n    end += 1\n  }\n  let authority = url[start..end]\n  var path = url[end..url.len()]\n  let hash = index_from(path, \"#\", 0)\n  if hash >= 0 {\n    path = path[0..hash]\n  }\n  if path.is_empty() || path[0] != 47 {\n    path = \"/\" + path\n  }\n  if index_from(authority, \"@\", 0) >= 0 {\n    return Err(\"`\" + url + \"`: a user name or password in a URL is not supported\")\n  }\n  var host = authority\n  var port = if tls { 443 } else { 80 }\n  let colon = index_from(authority, \":\", 0)\n  if colon >= 0 {\n    host = authority[0..colon]\n    match authority[colon + 1..authority.len()].to_int() {\n      Some(p) => {\n        if p < 1 || p > 65535 {\n          return Err(\"`\" + url + \"`: the port must be 1 to 65535\")\n        }\n        port = p\n      }\n      None => {\n        return Err(\"`\" + url + \"`: the port is not a number\")\n      }\n    }\n  }\n  if host.is_empty() {\n    return Err(\"`\" + url + \"` has no host\")\n  }\n  return Ok(Url { tls: tls, host: host, port: port, path: path })\n}\n\n/// The value of the header `name` (in any case) among `headers`.\nfn header_in(headers: List<(Str, Str)>, name: Str) -> Option<Str>\n  ensures result.is_none() || !headers.is_empty()\n{\n  let want = name.to_lower()\n  for i in 0..headers.len() {\n    if headers[i].0.to_lower() == want {\n      return Some(headers[i].1)\n    }\n  }\n  return None\n}\n\n/// The value of the reply's header `name`, in any case.\npub fn Response.header(self, name: Str) -> Option<Str>\n  ensures result.is_none() || !self.headers.is_empty()\n{\n  return header_in(self.headers, name)\n}\n\n/// The value of the request's header `name`, in any case.\npub fn Request.header(self, name: Str) -> Option<Str>\n  ensures result.is_none() || !self.headers.is_empty()\n{\n  return header_in(self.headers, name)\n}\n\n/// The text of a `method` request for `u`: the request line, `Host`, `Connection: close`, a\n/// `Content-Length` when there is a body, then `headers` and `body`.\npub fn request_text(method: Str, u: Url, headers: List<(Str, Str)>, body: Str) -> Str\n  ensures result.len() > method.len()\n{\n  let default_port = if u.tls { 443 } else { 80 }\n  let host = if u.port == default_port { u.host } else { u.host + \":\" + u.port.str() }\n  var out = method + \" \" + u.path + \" HTTP/1.1\\r\\nHost: \" + host + \"\\r\\nConnection: close\\r\\n\"\n  if !body.is_empty() || method == \"POST\" || method == \"PUT\" || method == \"PATCH\" {\n    out += \"Content-Length: \" + body.len().str() + \"\\r\\n\"\n  }\n  for i in 0..headers.len() invariant out.len() > method.len() {\n    out += headers[i].0 + \": \" + headers[i].1 + \"\\r\\n\"\n  }\n  return out + \"\\r\\n\" + body\n}\n\n/// A message's start line and headers, and where its body starts.\nfn parse_head(raw: Str) -> Result<(Str, List<(Str, Str)>, Int), Str>\n  ensures result.is_err() || result.unwrap().2 >= 0 && result.unwrap().2 <= raw.len()\n{\n  let end = index_from(raw, \"\\r\\n\\r\\n\", 0)\n  if end < 0 {\n    return Err(\"the message ends before its headers do\")\n  }\n  let lines = raw[0..end].split(\"\\r\\n\")\n  var headers: List<(Str, Str)> = []\n  for i in 1..lines.len() {\n    let l = lines[i]\n    let colon = index_from(l, \":\", 0)\n    if colon <= 0 {\n      return Err(\"a header line has no name: `\" + l + \"`\")\n    }\n    headers.push((l[0..colon].trim(), l[colon + 1..l.len()].trim()))\n  }\n  return Ok((lines.get(0).unwrap_or(\"\"), headers, end + 4))\n}\n\n/// The number a chunk's size line gives, in hexadecimal before any `;`, or -1.\nfn hex_value(line: Str) -> Int\n  ensures result >= -1\n{\n  var n = 0\n  var digits = 0\n  for i in 0..line.len() invariant n >= 0 && n < 1099511627776 && digits >= 0 && digits <= i {\n    let b = line[i]\n    if b == 59 {\n      break\n    }\n    if b == 32 || b == 9 {\n      continue\n    }\n    let d = if b >= 48 && b <= 57 {\n      b as Int - 48\n    } else if b >= 97 && b <= 102 {\n      b as Int - 87\n    } else if b >= 65 && b <= 70 {\n      b as Int - 55\n    } else {\n      -1\n    }\n    if d < 0 || n >= 68719476736 {\n      return -1\n    }\n    n = n * 16 + d\n    digits += 1\n  }\n  return if digits == 0 { -1 } else { n }\n}\n\n/// A chunked body (`Transfer-Encoding: chunked`), its chunks joined.\nfn dechunk(s: Str) -> Result<Str, Str>\n  ensures result.is_err() || result.unwrap().len() <= s.len()\n{\n  var out = \"\"\n  var i = 0\n  for i < s.len() invariant i >= 0 && i <= s.len() && out.len() <= i {\n    let eol = index_from(s, \"\\r\\n\", i)\n    if eol < 0 {\n      return Err(\"a chunk's size line does not end\")\n    }\n    let size = hex_value(s[i..eol])\n    if size < 0 {\n      return Err(\"a chunk's size is not hexadecimal\")\n    }\n    let start = eol + 2\n    if size == 0 {\n      return Ok(out)\n    }\n    if size > s.len() - start {\n      return Err(\"the body ends inside a chunk\")\n    }\n    out += s[start..start + size]\n    i = start + size\n    if i > s.len() - 2 || s[i..i + 2] != \"\\r\\n\" {\n      return Err(\"a chunk does not end with a line break\")\n    }\n    i += 2\n  }\n  return Err(\"the body ends before its last chunk\")\n}\n\n/// A message's body from `rest`, what follows its headers: joined from chunks, cut to its\n/// `Content-Length`, or all of it.\nfn body_of(headers: List<(Str, Str)>, rest: Str) -> Result<Str, Str>\n  ensures result.is_err() || result.unwrap().len() <= rest.len()\n{\n  match header_in(headers, \"transfer-encoding\") {\n    Some(te) => {\n      if te.to_lower().contains(\"chunked\") {\n        return dechunk(rest)\n      }\n    }\n    None => {}\n  }\n  return match header_in(headers, \"content-length\") {\n    Some(v) => match v.to_int() {\n      Some(n) => if n < 0 {\n        Err(\"a Content-Length is negative\")\n      } else if n > rest.len() {\n        Err(\"the message ends before its body does\")\n      } else {\n        Ok(rest[0..n])\n      }\n      None => Err(\"a Content-Length is not a number: `\" + v + \"`\")\n    }\n    None => Ok(rest)\n  }\n}\n\n/// A reply's status, headers and body, or what is wrong with it.\npub fn parse_response(raw: Str) -> Result<Response, Str>\n  ensures result.is_err() || result.unwrap().status >= 100 && result.unwrap().status <= 999\n  ensures result.is_err() || result.unwrap().body.len() <= raw.len()\n{\n  let (line, headers, at) = parse_head(raw)?\n  let parts = line.split(\" \")\n  if parts.len() < 2 || parts[0].len() < 5 || parts[0][0..5] != \"HTTP/\" {\n    return Err(\"not an HTTP reply: `\" + line + \"`\")\n  }\n  let status = parts[1].to_int().unwrap_or(0)\n  if status < 100 || status > 999 {\n    return Err(\"not an HTTP status: `\" + parts[1] + \"`\")\n  }\n  let body = body_of(headers, raw[at..raw.len()])?\n  return Ok(Response { status: status, headers: headers, body: body })\n}\n\n/// A request's method, path, headers and body, from the text `serve_http` hands a handler.\npub fn parse_request(raw: Str) -> Result<Request, Str>\n  ensures result.is_err() || result.unwrap().body.len() <= raw.len()\n{\n  let (line, headers, at) = parse_head(raw)?\n  let parts = line.split(\" \")\n  if parts.len() != 3 || parts[2].len() < 5 || parts[2][0..5] != \"HTTP/\" {\n    return Err(\"not an HTTP request line: `\" + line + \"`\")\n  }\n  let body = body_of(headers, raw[at..raw.len()])?\n  return Ok(Request { method: parts[0], path: parts[1], headers: headers, body: body })\n}\n\n/// The reason phrase HTTP gives `status`, for the common ones.\nfn reason(status: Int) -> Str {\n  let known = [\n    (200, \"OK\"),\n    (201, \"Created\"),\n    (204, \"No Content\"),\n    (301, \"Moved Permanently\"),\n    (302, \"Found\"),\n    (303, \"See Other\"),\n    (304, \"Not Modified\"),\n    (307, \"Temporary Redirect\"),\n    (308, \"Permanent Redirect\"),\n    (400, \"Bad Request\"),\n    (401, \"Unauthorized\"),\n    (403, \"Forbidden\"),\n    (404, \"Not Found\"),\n    (405, \"Method Not Allowed\"),\n    (409, \"Conflict\"),\n    (413, \"Content Too Large\"),\n    (422, \"Unprocessable Content\"),\n    (429, \"Too Many Requests\"),\n    (500, \"Internal Server Error\"),\n    (502, \"Bad Gateway\"),\n    (503, \"Service Unavailable\"),\n  ]\n  for k in known {\n    if k.0 == status {\n      return k.1\n    }\n  }\n  return \"Status\"\n}\n\n/// A reply for `serve_http` to send: the status line, `Content-Type`, `Content-Length` and\n/// `Connection: close`, then `body`.\npub fn reply(status: Int, content_type: Str, body: Str) -> Str\n  ensures result.len() > body.len()\n{\n  return \"HTTP/1.1 \" +\n    status.str() +\n    \" \" +\n    reason(status) +\n    \"\\r\\nContent-Type: \" +\n    content_type +\n    \"\\r\\nContent-Length: \" +\n    body.len().str() +\n    \"\\r\\nConnection: close\\r\\n\\r\\n\" +\n    body\n}\n\n/// Send a `method` request with `headers` and `body` to `url`, and read the reply.\npub fn send(method: Str, url: Str, headers: List<(Str, Str)>, body: Str) -> Result<Response, Str>\n  ensures result.is_err() || result.unwrap().status >= 100\n  effects {net}\n{\n  let u = parse_url(url)?\n  for h in headers {\n    if h.0.contains(\":\") || (h.0 + h.1).contains(\"\\r\") || (h.0 + h.1).contains(\"\\n\") {\n      return Err(\"a header name has a colon, or a header a line break: `\" + h.0 + \"`\")\n    }\n  }\n  return parse_response(\n    fetch(u.host + \":\" + u.port.str(), request_text(method, u, headers, body), u.tls)?,\n  )\n}\n\n/// Where a redirect's `location` points, from `base`: itself when it is absolute, else on\n/// `base`'s scheme, host and port.\nfn resolve(base: Str, location: Str) -> Str {\n  let lower = location.to_lower()\n  if lower.starts_with(\"http://\") || lower.starts_with(\"https://\") {\n    return location\n  }\n  return match parse_url(base) {\n    Ok(u) => {\n      let origin = (if u.tls { \"https://\" } else { \"http://\" }) + u.host + \":\" + u.port.str()\n      if location.starts_with(\"/\") {\n        origin + location\n      } else {\n        let cut = u.path.split(\"?\").get(0).unwrap_or(\"/\")\n        let parts = cut.split(\"/\")\n        origin + parts[0..max(parts.len() - 1, 0)].join(\"/\") + \"/\" + location\n      }\n    }\n    Err(_) => location\n  }\n}\n\n/// GET `url`, following up to five redirects.\npub fn get(url: Str) -> Result<Response, Str>\n  ensures result.is_err() || result.unwrap().status >= 100\n  effects {net}\n{\n  var at = url\n  for _ in 0..6 {\n    let r = send(\"GET\", at, [], \"\")?\n    let moved = r.status == 301 ||\n      r.status == 302 ||\n      r.status == 303 ||\n      r.status == 307 ||\n      r.status == 308\n    let next = if moved { r.header(\"location\") } else { None }\n    match next {\n      Some(loc) => at = resolve(at, loc)\n      None => {\n        return Ok(r)\n      }\n    }\n  }\n  return Err(\"more than five redirects from `\" + url + \"`\")\n}\n\n/// POST `body`, of type `content_type`, to `url`.\npub fn post(url: Str, content_type: Str, body: Str) -> Result<Response, Str>\n  ensures result.is_err() || result.unwrap().status >= 100\n  effects {net}\n{\n  return send(\"POST\", url, [(\"Content-Type\", content_type)], body)\n}\n"

const STD_OS_JIG: Str = "// Process arguments, environment variables and exit.\n\npub fn args() -> List<Str> effects {env}\npub fn env(name: Str) -> Option<Str> effects {env}\npub fn exit(code: Int) -> Never effects {env}\n"

const STD_PRELUDE_JIG: Str = "// The prelude: names every package can use without an import.\n// Functions without a body are compiler intrinsics.\n\npub enum Option<T> {\n  Some(value: T)\n  None\n}\n\npub enum Result<T, E> {\n  Ok(value: T)\n  Err(error: E)\n}\n\n/// Aborts the program with `msg`.\npub fn panic(msg: Str) -> Never\n\n/// Aborts the program if `cond` is false. Also a proof obligation.\npub fn assert(cond: Bool)\n\npub fn min<T: Ord>(a: T, b: T) -> T\n  ensures result == a || result == b\n{\n  if b < a {\n    return b\n  }\n  return a\n}\n\npub fn max<T: Ord>(a: T, b: T) -> T\n  ensures result == a || result == b\n{\n  if b > a {\n    return b\n  }\n  return a\n}\n\n// ---- Option ----\n\npub fn Option<T>.is_some(self) -> Bool\n  ensures result != self.is_none()\n{\n  return match self {\n    Some(_) => true\n    None => false\n  }\n}\n\npub fn Option<T>.is_none(self) -> Bool\n  ensures result != self.is_some()\n{\n  return match self {\n    Some(_) => false\n    None => true\n  }\n}\n\npub fn Option<T>.unwrap(self) -> T\n  requires self.is_some()\n{\n  return match self {\n    Some(v) => v\n    None => panic(\"called unwrap() on None\")\n  }\n}\n\npub fn Option<T>.unwrap_or(self, default: T) -> T {\n  return match self {\n    Some(v) => v\n    None => default\n  }\n}\n\npub fn Option<T>.ok_or<E>(self, err: E) -> Result<T, E>\n  ensures result.is_ok() == self.is_some()\n{\n  return match self {\n    Some(v) => Ok(v)\n    None => Err(err)\n  }\n}\n\npub fn Option<T>.map<U>(self, f: fn(T) -> U) -> Option<U>\n  ensures result.is_some() == self.is_some()\n  effects {f}\n{\n  return match self {\n    Some(v) => Some(f(v))\n    None => None\n  }\n}\n\n// ---- Result ----\n\npub fn Result<T, E>.is_ok(self) -> Bool\n  ensures result != self.is_err()\n{\n  return match self {\n    Ok(_) => true\n    Err(_) => false\n  }\n}\n\npub fn Result<T, E>.is_err(self) -> Bool\n  ensures result != self.is_ok()\n{\n  return match self {\n    Ok(_) => false\n    Err(_) => true\n  }\n}\n\npub fn Result<T, E>.unwrap(self) -> T\n  requires self.is_ok()\n{\n  return match self {\n    Ok(v) => v\n    Err(_) => panic(\"called unwrap() on Err\")\n  }\n}\n\npub fn Result<T, E>.unwrap_or(self, default: T) -> T {\n  return match self {\n    Ok(v) => v\n    Err(_) => default\n  }\n}\n\npub fn Result<T, E>.ok(self) -> Option<T>\n  ensures result.is_some() == self.is_ok()\n{\n  return match self {\n    Ok(v) => Some(v)\n    Err(_) => None\n  }\n}\n\npub fn Result<T, E>.map<U>(self, f: fn(T) -> U) -> Result<U, E>\n  ensures result.is_ok() == self.is_ok()\n  effects {f}\n{\n  return match self {\n    Ok(v) => Ok(f(v))\n    Err(e) => Err(e)\n  }\n}\n\npub fn Result<T, E>.map_err<F>(self, f: fn(E) -> F) -> Result<T, F>\n  ensures result.is_ok() == self.is_ok()\n  effects {f}\n{\n  return match self {\n    Ok(v) => Ok(v)\n    Err(e) => Err(f(e))\n  }\n}\n\n// ---- integers ----\n\npub fn Int.abs(self) -> Int\npub fn Int.min(self, other: Int) -> Int\npub fn Int.max(self, other: Int) -> Int\npub fn Int.pow(self, exp: Int) -> Int\npub fn Int.wrapping_add(self, other: Int) -> Int\npub fn Int.wrapping_sub(self, other: Int) -> Int\npub fn Int.wrapping_mul(self, other: Int) -> Int\npub fn I32.abs(self) -> I32\npub fn I32.min(self, other: I32) -> I32\npub fn I32.max(self, other: I32) -> I32\npub fn I32.wrapping_add(self, other: I32) -> I32\npub fn I32.wrapping_sub(self, other: I32) -> I32\npub fn I32.wrapping_mul(self, other: I32) -> I32\npub fn U8.min(self, other: U8) -> U8\npub fn U8.max(self, other: U8) -> U8\npub fn U8.wrapping_add(self, other: U8) -> U8\npub fn U8.wrapping_sub(self, other: U8) -> U8\npub fn U8.wrapping_mul(self, other: U8) -> U8\npub fn U32.min(self, other: U32) -> U32\npub fn U32.max(self, other: U32) -> U32\npub fn U32.wrapping_add(self, other: U32) -> U32\npub fn U32.wrapping_sub(self, other: U32) -> U32\npub fn U32.wrapping_mul(self, other: U32) -> U32\npub fn U64.min(self, other: U64) -> U64\npub fn U64.max(self, other: U64) -> U64\npub fn U64.wrapping_add(self, other: U64) -> U64\npub fn U64.wrapping_sub(self, other: U64) -> U64\npub fn U64.wrapping_mul(self, other: U64) -> U64\n\n// ---- Float ----\n\npub fn Float.abs(self) -> Float\npub fn Float.sqrt(self) -> Float\npub fn Float.floor(self) -> Float\npub fn Float.ceil(self) -> Float\npub fn Float.round(self) -> Float\npub fn Float.min(self, other: Float) -> Float\npub fn Float.max(self, other: Float) -> Float\npub fn Float.is_nan(self) -> Bool\n\n// ---- Char ----\n\npub fn Char.is_digit(self) -> Bool\npub fn Char.is_alpha(self) -> Bool\npub fn Char.is_alnum(self) -> Bool\npub fn Char.is_space(self) -> Bool\npub fn Char.is_upper(self) -> Bool\npub fn Char.is_lower(self) -> Bool\npub fn Char.to_upper(self) -> Char\npub fn Char.to_lower(self) -> Char\n\n// ---- Str ----\n\npub fn Str.len(self) -> Int\npub fn Str.is_empty(self) -> Bool\npub fn Str.contains(self, part: Str) -> Bool\npub fn Str.starts_with(self, prefix: Str) -> Bool\npub fn Str.ends_with(self, suffix: Str) -> Bool\npub fn Str.find(self, part: Str) -> Option<Int>\npub fn Str.split(self, sep: Str) -> List<Str>\npub fn Str.lines(self) -> List<Str>\npub fn Str.trim(self) -> Str\npub fn Str.replace(self, from: Str, to: Str) -> Str\npub fn Str.repeat(self, n: Int) -> Str\npub fn Str.to_upper(self) -> Str\npub fn Str.to_lower(self) -> Str\npub fn Str.to_int(self) -> Option<Int>\npub fn Str.to_float(self) -> Option<Float>\npub fn Str.bytes(self) -> List<U8>\npub fn Str.chars(self) -> List<Char>\npub fn Str.from_chars(chars: List<Char>) -> Str\npub fn Str.from_bytes(bytes: List<U8>) -> Option<Str>\n\n// ---- List ----\n\npub fn List<T>.new() -> List<T>\npub fn List<T>.len(self) -> Int\npub fn List<T>.is_empty(self) -> Bool\npub fn List<T>.push(&mut self, item: T)\npub fn List<T>.pop(&mut self) -> Option<T>\npub fn List<T>.get(self, index: Int) -> Option<T>\npub fn List<T>.insert(&mut self, index: Int, item: T)\npub fn List<T>.remove(&mut self, index: Int) -> T\npub fn List<T>.clear(&mut self)\npub fn List<T>.extend(&mut self, other: List<T>)\npub fn List<T>.reverse(&mut self)\npub fn List<T>.swap(&mut self, i: Int, j: Int)\npub fn List<T>.truncate(&mut self, len: Int)\npub fn List<T>.repeat(self, n: Int) -> List<T>\npub fn List<T: Ord>.sort(&mut self)\n\npub fn List<T>.first(self) -> Option<T>\n  ensures result.is_some() == !self.is_empty()\n{\n  return self.get(0)\n}\n\npub fn List<T>.last(self) -> Option<T>\n  ensures result.is_some() == !self.is_empty()\n{\n  return self.get(self.len() - 1)\n}\n\npub fn List<T: Eq>.contains(self, item: T) -> Bool\n  ensures !result || !self.is_empty()\n{\n  for x in self {\n    if x == item {\n      return true\n    }\n  }\n  return false\n}\n\npub fn List<T: Eq>.index_of(self, item: T) -> Option<Int>\n  ensures result.is_none() || (result.unwrap() >= 0 && result.unwrap() < self.len())\n{\n  for i in 0..self.len() {\n    if self[i] == item {\n      return Some(i)\n    }\n  }\n  return None\n}\n\n/// Sorts by a strict \"less than\" comparison, stably.\npub fn List<T>.sort_by(&mut self, less: fn(T, T) -> Bool) effects {less}\n\npub fn List<T>.map<U>(self, f: fn(T) -> U) -> List<U>\n  ensures result.len() == self.len()\n  effects {f}\n{\n  var out: List<U> = []\n  for i in 0..self.len() invariant out.len() == i {\n    out.push(f(self[i]))\n  }\n  return out\n}\n\npub fn List<T>.filter(self, keep: fn(T) -> Bool) -> List<T>\n  ensures result.len() <= self.len()\n  effects {keep}\n{\n  var out: List<T> = []\n  for i in 0..self.len() invariant out.len() <= i {\n    if keep(self[i]) {\n      out.push(self[i])\n    }\n  }\n  return out\n}\n\npub fn List<T>.fold<A>(self, init: A, f: fn(A, T) -> A) -> A effects {f} {\n  var acc = init\n  for x in self {\n    acc = f(acc, x)\n  }\n  return acc\n}\n\npub fn List<T>.any(self, pred: fn(T) -> Bool) -> Bool\n  ensures !result || !self.is_empty()\n  effects {pred}\n{\n  for x in self {\n    if pred(x) {\n      return true\n    }\n  }\n  return false\n}\n\npub fn List<T>.all(self, pred: fn(T) -> Bool) -> Bool\n  ensures result || !self.is_empty()\n  effects {pred}\n{\n  for x in self {\n    if !pred(x) {\n      return false\n    }\n  }\n  return true\n}\n\npub fn List<T: Show>.join(self, sep: Str) -> Str\n  ensures !self.is_empty() || result == \"\"\n{\n  var out = \"\"\n  for i in 0..self.len() invariant i > 0 || out == \"\" {\n    if i > 0 {\n      out = out + sep\n    }\n    out = out + self[i].str()\n  }\n  return out\n}\n\n// ---- Map ----\n\npub fn Map<K: Hash, V>.new() -> Map<K, V>\npub fn Map<K: Hash, V>.len(self) -> Int\npub fn Map<K: Hash, V>.is_empty(self) -> Bool\npub fn Map<K: Hash, V>.get(self, key: K) -> Option<V>\npub fn Map<K: Hash, V>.insert(&mut self, key: K, value: V)\npub fn Map<K: Hash, V>.remove(&mut self, key: K) -> Option<V>\npub fn Map<K: Hash, V>.contains(self, key: K) -> Bool\npub fn Map<K: Hash, V>.keys(self) -> List<K>\npub fn Map<K: Hash, V>.values(self) -> List<V>\npub fn Map<K: Hash, V>.entries(self) -> List<(K, V)>\n\n// ---- Set ----\n\npub fn Set<T: Hash>.new() -> Set<T>\npub fn Set<T: Hash>.len(self) -> Int\npub fn Set<T: Hash>.is_empty(self) -> Bool\npub fn Set<T: Hash>.insert(&mut self, item: T)\npub fn Set<T: Hash>.remove(&mut self, item: T) -> Bool\npub fn Set<T: Hash>.contains(self, item: T) -> Bool\npub fn Set<T: Hash>.items(self) -> List<T>\n"

const STD_RAND_JIG: Str = "// Randomness.\n\n/// A uniformly random integer in `lo..hi`.\npub fn int(lo: Int, hi: Int) -> Int\n  requires lo < hi\n  effects {rand}\n\n/// A uniformly random float in `[0, 1)`.\npub fn float() -> Float effects {rand}\n"

const STD_REGEX_JIG: Str = "// Regular expressions, matched in time linear in the text: a Pike VM runs every possible\n// match in step, so no pattern backtracks. Patterns have literals, `.` (any character but\n// a line break), classes (`[a-z_]`, `[^0-9]`, and `\\d \\w \\s` with their negations `\\D \\W\n// \\S`), anchors (`^` and `$` for the start and end of the text, `\\b` and `\\B` for word\n// edges), repetition (`* + ? {m} {m,} {m,n}`, greedy, or lazy with a `?` after), groups\n// (`( )` capture, `(?: )` do not) and alternation (`|`). `\\` makes any other punctuation\n// literal. Matches are leftmost, and among those the one Perl would choose; positions are\n// byte offsets, as everywhere for `Str`.\n\n/// The largest count `{m,n}` may give, the most groups a pattern may have, and the most\n/// instructions it may compile to.\npub const MAX_REPEAT: Int = 1000\npub const MAX_GROUPS: Int = 1000\nconst MAX_PROGRAM: Int = 100000\n\n/// A pattern, parsed.\nenum Node {\n  Empty\n  Lit(c: Char)\n  Any\n  Class(ranges: List<(Char, Char)>, negated: Bool)\n  Start\n  End\n  Edge(negated: Bool)\n  Group(index: Int where index >= 1 && index <= MAX_GROUPS, inner: Node)\n  Cat(items: List<Node>)\n  Alt(options: List<Node>)\n  Repeat(inner: Node, min: Int, max: Int, greedy: Bool)\n}\n\n/// An instruction of the matching program.\nenum Inst {\n  Char(c: Char)\n  Any\n  Class(ranges: List<(Char, Char)>, negated: Bool)\n  /// Go on at `x`, and also at `y`, which matches only if `x` does not.\n  Split(x: Int, y: Int)\n  Jump(x: Int)\n  /// Record the position in capture slot `slot`.\n  Save(slot: Int)\n  Start\n  End\n  Edge(negated: Bool)\n  Done\n}\n\n/// A compiled pattern.\npub struct Regex {\n  prog: List<Inst>\n  /// Capture groups, not counting the whole match (group 0).\n  groups: Int\n  invariant groups >= 0 && groups <= MAX_GROUPS\n}\n\n/// Where a pattern matched: the whole match, and each group's span if it took part.\npub struct Match {\n  pub start: Int\n  pub end: Int\n  pub groups: List<Option<(Int, Int)>>\n}\n\n/// A pattern being parsed: its characters, the position reached and the groups so far.\nstruct Parser {\n  cs: List<Char>\n  i: Int\n  groups: Int\n  invariant i >= 0 && i <= cs.len() && groups >= 0 && groups <= MAX_GROUPS\n}\n\nfn Parser.peek(self, c: Char) -> Bool\n  ensures !result || self.i < self.cs.len()\n{\n  return self.i < self.cs.len() && self.cs[self.i] == c\n}\n\nfn Parser.alt(&mut self) -> Result<Node, Str>\n  ensures self.i >= old(self.i)\n{\n  let start = self.i\n  var options = [self.cat()?]\n  for self.peek('|') invariant self.i >= start && self.i <= self.cs.len() {\n    self.i += 1\n    options.push(self.cat()?)\n  }\n  return Ok(if options.len() == 1 { options[0] } else { Node.Alt(options) })\n}\n\nfn Parser.cat(&mut self) -> Result<Node, Str>\n  ensures self.i >= old(self.i)\n{\n  var items: List<Node> = []\n  let start = self.i\n  for self.i < self.cs.len() && !self.peek('|') && !self.peek(')')\n    invariant self.i >= start && self.i <= self.cs.len()\n  {\n    let before = self.i\n    let atom = self.atom()?\n    if self.i == before {\n      return Err(\"nothing to match at \" + before.str())\n    }\n    items.push(self.quantified(atom)?)\n  }\n  return Ok(\n    if items.is_empty() {\n      Node.Empty\n    } else if items.len() == 1 {\n      items[0]\n    } else {\n      Node.Cat(items)\n    },\n  )\n}\n\n/// A number in `{m,n}`, if digits follow.\nfn Parser.count(&mut self) -> Option<Int>\n  ensures self.i >= old(self.i)\n  ensures result.is_none() || result.unwrap() >= 0 && result.unwrap() <= MAX_REPEAT + 1\n{\n  let start = self.i\n  var n = -1\n  for self.i < self.cs.len() && self.cs[self.i].is_digit()\n    invariant n >= -1 && n <= MAX_REPEAT + 1 && self.i >= start && self.i <= self.cs.len()\n  {\n    let d = self.cs[self.i].str().to_int().unwrap_or(0)\n    n = min(max(n, 0) * 10 + max(min(d, 9), 0), MAX_REPEAT + 1)\n    self.i += 1\n  }\n  return if n < 0 { None } else { Some(n) }\n}\n\nfn Parser.quantified(&mut self, atom: Node) -> Result<Node, Str>\n  ensures self.i >= old(self.i)\n{\n  var lo = 0\n  var hi = -1\n  if self.peek('*') {\n    self.i += 1\n  } else if self.peek('+') {\n    self.i += 1\n    lo = 1\n  } else if self.peek('?') {\n    self.i += 1\n    hi = 1\n  } else if self.peek('{') {\n    let back = self.i\n    self.i += 1\n    match self.count() {\n      Some(m) => {\n        lo = m\n        hi = m\n        if self.peek(',') {\n          self.i += 1\n          hi = match self.count() {\n            Some(n) => n\n            None => -1\n          }\n        }\n        if !self.peek('}') {\n          return Err(\"`{` needs `}` at \" + self.i.str())\n        }\n        self.i += 1\n        if lo > MAX_REPEAT || hi > MAX_REPEAT || hi >= 0 && hi < lo {\n          return Err(\"a count must be at most \" + MAX_REPEAT.str() + \", and `{m,n}` needs m <= n\")\n        }\n      }\n      None => {\n        // Not a count: a literal `{`.\n        self.i = back\n        return Ok(atom)\n      }\n    }\n  } else {\n    return Ok(atom)\n  }\n  var greedy = true\n  if self.peek('?') {\n    self.i += 1\n    greedy = false\n  }\n  return match atom {\n    Start | End | Edge(_) => Err(\"an anchor cannot repeat\")\n    _ => Ok(Node.Repeat(atom, lo, hi, greedy))\n  }\n}\n\n/// The character class an escape like `\\d` names, if it names one.\nfn class_escape(c: Char) -> Option<Node>\n  ensures result.is_some() == (c == 'd' || c == 'D' || c == 'w' || c == 'W' || c == 's' || c == 'S')\n{\n  let digits = [('0', '9')]\n  let word = [('0', '9'), ('A', 'Z'), ('a', 'z'), ('_', '_')]\n  let space = [(' ', ' '), ('\\t', '\\r')]\n  return if c == 'd' {\n    Some(Node.Class(digits, false))\n  } else if c == 'D' {\n    Some(Node.Class(digits, true))\n  } else if c == 'w' {\n    Some(Node.Class(word, false))\n  } else if c == 'W' {\n    Some(Node.Class(word, true))\n  } else if c == 's' {\n    Some(Node.Class(space, false))\n  } else if c == 'S' {\n    Some(Node.Class(space, true))\n  } else {\n    None\n  }\n}\n\n/// The character an escape stands for, other than a class: `\\n`, `\\t`, `\\r`, or itself.\nfn escaped(c: Char) -> Char\n  ensures result == c || c == 'n' || c == 't' || c == 'r'\n{\n  return if c == 'n' { '\\n' } else if c == 't' { '\\t' } else if c == 'r' { '\\r' } else { c }\n}\n\nfn Parser.atom(&mut self) -> Result<Node, Str>\n  requires self.i < self.cs.len()\n  ensures self.i >= old(self.i)\n{\n  let c = self.cs[self.i]\n  self.i += 1\n  if c == '.' {\n    return Ok(Node.Any)\n  }\n  if c == '^' {\n    return Ok(Node.Start)\n  }\n  if c == '$' {\n    return Ok(Node.End)\n  }\n  if c == '*' || c == '+' || c == '?' {\n    return Err(\"`\" + c.str() + \"` at \" + (self.i - 1).str() + \" repeats nothing\")\n  }\n  if c == '(' {\n    var index = -1\n    if self.i + 1 < self.cs.len() && self.cs[self.i] == '?' && self.cs[self.i + 1] == ':' {\n      self.i += 2\n    } else {\n      if self.groups >= MAX_GROUPS {\n        return Err(\"more than \" + MAX_GROUPS.str() + \" groups\")\n      }\n      self.groups += 1\n      index = self.groups\n    }\n    let inner = self.alt()?\n    if !self.peek(')') {\n      return Err(\"`(` needs `)`\")\n    }\n    self.i += 1\n    if index < 1 || index > MAX_GROUPS {\n      return Ok(inner)\n    }\n    return Ok(Node.Group(index, inner))\n  }\n  if c == ')' {\n    return Err(\"`)` at \" + (self.i - 1).str() + \" closes nothing\")\n  }\n  if c == '[' {\n    return self.class()\n  }\n  if c == '\\\\' {\n    if self.i >= self.cs.len() {\n      return Err(\"the pattern ends in `\\\\`\")\n    }\n    let e = self.cs[self.i]\n    self.i += 1\n    if e == 'b' || e == 'B' {\n      return Ok(Node.Edge(e == 'B'))\n    }\n    return match class_escape(e) {\n      Some(n) => Ok(n)\n      None => if e.is_alpha() && e != 'n' && e != 't' && e != 'r' {\n        Err(\"unknown escape `\\\\\" + e.str() + \"`\")\n      } else {\n        Ok(Node.Lit(escaped(e)))\n      }\n    }\n  }\n  return Ok(Node.Lit(c))\n}\n\n/// A bracketed class, after its `[`.\nfn Parser.class(&mut self) -> Result<Node, Str>\n  ensures self.i >= old(self.i)\n{\n  let start = self.i\n  var negated = false\n  if self.peek('^') {\n    self.i += 1\n    negated = true\n  }\n  var ranges: List<(Char, Char)> = []\n  var first = true\n  for self.i < self.cs.len() && (first || !self.peek(']'))\n    invariant self.i >= start && self.i <= self.cs.len()\n  {\n    first = false\n    var lo = self.cs[self.i]\n    self.i += 1\n    if lo == '\\\\' && self.i < self.cs.len() {\n      let e = self.cs[self.i]\n      self.i += 1\n      match class_escape(e) {\n        Some(Class(rs, false)) => {\n          ranges.extend(rs)\n          continue\n        }\n        Some(_) => {\n          return Err(\"`\\\\\" + e.str() + \"` cannot be in a class\")\n        }\n        None => lo = escaped(e)\n      }\n    }\n    var hi = lo\n    if self.i + 1 < self.cs.len() && self.cs[self.i] == '-' && self.cs[self.i + 1] != ']' {\n      hi = self.cs[self.i + 1]\n      self.i += 2\n      if hi == '\\\\' && self.i < self.cs.len() {\n        hi = escaped(self.cs[self.i])\n        self.i += 1\n      }\n      if hi < lo {\n        return Err(\"a class range runs backwards\")\n      }\n    }\n    ranges.push((lo, hi))\n  }\n  if !self.peek(']') {\n    return Err(\"`[` needs `]`\")\n  }\n  self.i += 1\n  return Ok(Node.Class(ranges, negated))\n}\n\n/// Instructions for `n`, appended to `prog`.\nfn emit(n: Node, prog: &mut List<Inst>) -> Result<(), Str>\n  ensures prog.len() >= old(prog.len())\n{\n  let len0 = prog.len()\n  if prog.len() > MAX_PROGRAM {\n    return Err(\"the pattern is too large\")\n  }\n  match n {\n    Empty => {}\n    Lit(c) => prog.push(Inst.Char(c))\n    Any => prog.push(Inst.Any)\n    Class(rs, neg) => prog.push(Inst.Class(rs, neg))\n    Start => prog.push(Inst.Start)\n    End => prog.push(Inst.End)\n    Edge(neg) => prog.push(Inst.Edge(neg))\n    Group(index, inner) => {\n      if index < 1 || index > MAX_GROUPS {\n        return Err(\"a group number is out of range\")\n      }\n      prog.push(Inst.Save(2 * index))\n      emit(inner, &mut prog)?\n      prog.push(Inst.Save(2 * index + 1))\n    }\n    Cat(items) => {\n      for it in items invariant prog.len() >= len0 {\n        emit(it, &mut prog)?\n      }\n    }\n    Alt(options) => {\n      var jumps: List<Int> = []\n      for k in 0..options.len() invariant prog.len() >= len0 {\n        if k + 1 < options.len() {\n          let split = prog.len()\n          prog.push(Inst.Split(split + 1, -1))\n          emit(options[k], &mut prog)?\n          jumps.push(prog.len())\n          prog.push(Inst.Jump(-1))\n          prog[split] = Inst.Split(split + 1, prog.len())\n        } else {\n          emit(options[k], &mut prog)?\n        }\n      }\n      for j in jumps invariant prog.len() >= len0 {\n        if j >= 0 && j < prog.len() {\n          prog[j] = Inst.Jump(prog.len())\n        }\n      }\n    }\n    Repeat(inner, lo, hi, greedy) => {\n      for _ in 0..lo invariant prog.len() >= len0 {\n        emit(inner, &mut prog)?\n      }\n      if hi < 0 {\n        let top = prog.len()\n        prog.push(Inst.Split(-1, -1))\n        emit(inner, &mut prog)?\n        prog.push(Inst.Jump(top))\n        let out = prog.len()\n        prog[top] = if greedy { Inst.Split(top + 1, out) } else { Inst.Split(out, top + 1) }\n      } else {\n        var splits: List<Int> = []\n        for _ in lo..hi invariant prog.len() >= len0 {\n          splits.push(prog.len())\n          prog.push(Inst.Split(-1, -1))\n          emit(inner, &mut prog)?\n        }\n        let out = prog.len()\n        for s in splits invariant prog.len() >= len0 {\n          if s >= 0 && s < prog.len() {\n            prog[s] = if greedy { Inst.Split(s + 1, out) } else { Inst.Split(out, s + 1) }\n          }\n        }\n      }\n    }\n  }\n  return Ok(())\n}\n\n/// Whether byte `b` means something in a pattern.\nfn is_special(b: U8) -> Bool {\n  return b == 92 ||\n    b == 46 ||\n    b == 94 ||\n    b == 36 ||\n    b == 42 ||\n    b == 43 ||\n    b == 63 ||\n    b == 40 ||\n    b == 41 ||\n    b == 91 ||\n    b == 93 ||\n    b == 123 ||\n    b == 125 ||\n    b == 124\n}\n\n/// A pattern that matches exactly `s`: its special characters escaped with `\\`.\npub fn escape(s: Str) -> Str\n  ensures result.len() >= s.len()\n{\n  var out = \"\"\n  var start = 0\n  for i in 0..s.len() invariant start >= 0 && start <= i && out.len() >= start {\n    if is_special(s[i]) {\n      out += s[start..i] + \"\\\\\"\n      start = i\n    }\n  }\n  return out + s[start..s.len()]\n}\n\n/// `pattern`, compiled, or what is wrong with it.\npub fn compile(pattern: Str) -> Result<Regex, Str>\n  ensures result.is_err() || result.unwrap().prog.len() >= 3\n{\n  var p = Parser { cs: pattern.chars(), i: 0, groups: 0 }\n  let tree = p.alt()?\n  if p.i < p.cs.len() {\n    return Err(\"`)` at \" + p.i.str() + \" closes nothing\")\n  }\n  var prog = [Inst.Save(0)]\n  emit(tree, &mut prog)?\n  prog.push(Inst.Save(1))\n  prog.push(Inst.Done)\n  return Ok(Regex { prog: prog, groups: p.groups })\n}\n\nfn is_word(c: Char) -> Bool {\n  return c.is_alpha() || c.is_digit() || c == '_'\n}\n\n/// Whether `c` is in the class.\nfn in_class(c: Char, ranges: List<(Char, Char)>, negated: Bool) -> Bool\n  ensures !ranges.is_empty() || result == negated\n{\n  for r in ranges {\n    if c >= r.0 && c <= r.1 {\n      return !negated\n    }\n  }\n  return negated\n}\n\n/// A thread of the VM: where it is in the program, and what it has captured.\nstruct Thread {\n  pc: Int\n  slots: List<Int>\n}\n\n/// The threads reached from `pc` at character `i` without reading a character, in\n/// priority order, added to `list` (`seen` marks the instructions reached at position `mark`).\nfn Regex.add(\n  self,\n  list: &mut List<Thread>,\n  seen: &mut List<Int>,\n  mark: Int,\n  pc0: Int,\n  slots0: List<Int>,\n  cs: List<Char>,\n  i: Int,\n)\n  ensures list.len() >= old(list.len())\n{\n  let len0 = list.len()\n  var stack = [Thread { pc: pc0, slots: slots0 }]\n  for !stack.is_empty() invariant list.len() >= len0 {\n    let t = match stack.pop() {\n      Some(x) => x\n      None => {\n        return\n      }\n    }\n    let pc = t.pc\n    if pc < 0 || pc >= self.prog.len() || pc >= seen.len() || seen[pc] == mark {\n      continue\n    }\n    seen[pc] = mark\n    match self.prog[pc] {\n      Jump(x) => stack.push(Thread { pc: x, slots: t.slots })\n      Split(x, y) => {\n        stack.push(Thread { pc: y, slots: t.slots })\n        stack.push(Thread { pc: x, slots: t.slots })\n      }\n      Save(k) => {\n        var s = t.slots\n        if k >= 0 && k < s.len() {\n          s[k] = i\n        }\n        stack.push(Thread { pc: pc + 1, slots: s })\n      }\n      Start => if i == 0 { stack.push(Thread { pc: pc + 1, slots: t.slots }) }\n      End => if i == cs.len() { stack.push(Thread { pc: pc + 1, slots: t.slots }) }\n      Edge(neg) => {\n        let before = i > 0 && i <= cs.len() && is_word(cs[i - 1])\n        let after = i >= 0 && i < cs.len() && is_word(cs[i])\n        if (before != after) != neg {\n          stack.push(Thread { pc: pc + 1, slots: t.slots })\n        }\n      }\n      _ => list.push(t)\n    }\n  }\n}\n\n/// The capture slots (character indices) of the first match starting at or after\n/// character `from`; with `whole`, only a match of all of `cs` from `from`.\nfn Regex.run(self, cs: List<Char>, from: Int, whole: Bool) -> Option<List<Int>> {\n  let nslots = 2 * self.groups + 2\n  // Each instruction is reached at most once per position: `seen` holds the last position.\n  var seen = [-1].repeat(self.prog.len())\n  var clist: List<Thread> = []\n  var found: Option<List<Int>> = None\n  for i in max(from, 0)..cs.len() + 1 {\n    if found.is_none() && (i == from || !whole) {\n      self.add(&mut clist, &mut seen, i, 0, [-1].repeat(nslots), cs, i)\n    }\n    if clist.is_empty() {\n      if found.is_some() || whole {\n        break\n      }\n      continue\n    }\n    var nlist: List<Thread> = []\n    for t in clist {\n      let pc = t.pc\n      if pc < 0 || pc >= self.prog.len() {\n        continue\n      }\n      let inst = self.prog[pc]\n      if inst == Inst.Done {\n        if !whole || i == cs.len() {\n          found = Some(t.slots)\n          // The threads after this one have lower priority.\n          break\n        }\n        continue\n      }\n      let ok = match inst {\n        Char(c) => i < cs.len() && cs[i] == c\n        Any => i < cs.len() && cs[i] != '\\n'\n        Class(rs, neg) => i < cs.len() && in_class(cs[i], rs, neg)\n        _ => false\n      }\n      if ok {\n        self.add(&mut nlist, &mut seen, i + 1, pc + 1, t.slots, cs, i + 1)\n      }\n    }\n    clist = nlist\n  }\n  return found\n}\n\n/// Byte offsets of each character of `s`, and `s.len()` after the last.\nfn offsets(s: Str) -> List<Int>\n  ensures !result.is_empty()\n{\n  var out: List<Int> = []\n  for i in 0..s.len() {\n    if s[i] < 128 || s[i] >= 192 {\n      out.push(i)\n    }\n  }\n  out.push(s.len())\n  return out\n}\n\n/// The byte offset of character `k`, kept in `0..=s.len()`.\nfn offset_of(offs: List<Int>, k: Int, n: Int) -> Int\n  requires n >= 0\n  ensures result >= 0 && result <= n\n{\n  if k < 0 || k >= offs.len() {\n    return n\n  }\n  return min(max(offs[k], 0), n)\n}\n\nfn Regex.to_match(self, slots: List<Int>, offs: List<Int>, n: Int) -> Match\n  requires n >= 0\n  ensures result.start >= 0 && result.start <= result.end && result.end <= n\n{\n  let a = if slots.len() > 0 { offset_of(offs, slots[0], n) } else { 0 }\n  let b = if slots.len() > 1 { offset_of(offs, slots[1], n) } else { 0 }\n  var groups: List<Option<(Int, Int)>> = []\n  for g in 1..self.groups + 1 {\n    if 2 * g + 1 < slots.len() && slots[2 * g] >= 0 && slots[2 * g + 1] >= 0 {\n      groups.push(Some((offset_of(offs, slots[2 * g], n), offset_of(offs, slots[2 * g + 1], n))))\n    } else {\n      groups.push(None)\n    }\n  }\n  return Match { start: min(a, b), end: max(a, b), groups: groups }\n}\n\n/// The first match in `s`.\npub fn Regex.find(self, s: Str) -> Option<Match>\n  ensures result.is_none() ||\n    result.unwrap().start <= result.unwrap().end && result.unwrap().end <= s.len()\n{\n  return match self.run(s.chars(), 0, false) {\n    Some(slots) => Some(self.to_match(slots, offsets(s), s.len()))\n    None => None\n  }\n}\n\n/// Whether the pattern matches somewhere in `s`.\npub fn Regex.is_match(self, s: Str) -> Bool {\n  return self.run(s.chars(), 0, false).is_some()\n}\n\n/// Whether the pattern matches all of `s`.\npub fn Regex.full_match(self, s: Str) -> Bool {\n  return self.run(s.chars(), 0, true).is_some()\n}\n\n/// Every match in `s`, from the left, none overlapping (after an empty match the search\n/// moves on a character).\npub fn Regex.find_all(self, s: Str) -> List<Match> {\n  let cs = s.chars()\n  let offs = offsets(s)\n  var out: List<Match> = []\n  var from = 0\n  for from <= cs.len() invariant from >= 0 {\n    match self.run(cs, from, false) {\n      Some(slots) => {\n        out.push(self.to_match(slots, offs, s.len()))\n        let end = if slots.len() > 1 { slots[1] } else { cs.len() }\n        from = if end > from { end } else { from + 1 }\n      }\n      None => {\n        break\n      }\n    }\n  }\n  return out\n}\n\n/// The text a match covers.\npub fn Match.text(self, s: Str) -> Str\n  ensures result.len() <= s.len()\n{\n  let a = min(max(self.start, 0), s.len())\n  return s[a..min(max(self.end, a), s.len())]\n}\n\n/// The text group `g` matched (group 0 is the whole match), if it took part.\npub fn Match.group(self, s: Str, g: Int) -> Option<Str>\n  ensures result.is_none() || result.unwrap().len() <= s.len()\n{\n  if g == 0 {\n    return Some(self.text(s))\n  }\n  if g < 0 {\n    return None\n  }\n  return match self.groups.get(g - 1) {\n    Some(Some((a, b))) => if a >= 0 && a <= b && b <= s.len() { Some(s[a..b]) } else { None }\n    _ => None\n  }\n}\n\n/// `with` for match `m` of `s`: `$0` to `$9` replaced by the groups, `$$` by `$`.\nfn expand(with: Str, m: Match, s: Str) -> Str {\n  var out = \"\"\n  var start = 0\n  var i = 0\n  for i < with.len() invariant i >= 0 && start >= 0 && start <= i && i <= with.len() {\n    if with[i] == 36 &&\n      i + 1 < with.len() &&\n      (with[i + 1] == 36 || with[i + 1] >= 48 && with[i + 1] <= 57) {\n      out += with[start..i]\n      let next = with[i + 1]\n      out += if next == 36 { \"$\" } else { m.group(s, next as Int - 48).unwrap_or(\"\") }\n      i += 2\n      start = i\n    } else {\n      i += 1\n    }\n  }\n  return out + with[start..with.len()]\n}\n\n/// `s` with every match replaced by `with`, in which `$0` to `$9` stand for the groups and\n/// `$$` for `$`.\npub fn Regex.replace_all(self, s: Str, with: Str) -> Str {\n  var out = \"\"\n  var last = 0\n  for m in self.find_all(s) invariant last >= 0 && last <= s.len() {\n    if m.start < last || m.end < m.start || m.end > s.len() {\n      continue\n    }\n    out += s[last..m.start] + expand(with, m, s)\n    last = m.end\n  }\n  return out + s[last..s.len()]\n}\n\n/// The pieces of `s` between matches.\npub fn Regex.split(self, s: Str) -> List<Str>\n  ensures !result.is_empty()\n{\n  var out: List<Str> = []\n  var last = 0\n  for m in self.find_all(s) invariant last >= 0 && last <= s.len() {\n    if m.start < last || m.end <= m.start || m.end > s.len() {\n      continue\n    }\n    out.push(s[last..m.start])\n    last = m.end\n  }\n  out.push(s[last..s.len()])\n  return out\n}\n"

const STD_SIM_JIG: Str = "// The simulated world that tests and scenarios run against. Every effect in a test is\n// deterministic: output is captured, files live in memory, the clock moves only when asked\n// (and by 1 ms per reading) and randomness comes from a seed. These functions set that world\n// up and look at it. Tests, scenario steps and test helpers may use them; code reachable from\n// `main` may not.\n\n/// Everything printed so far with `io.print` and `io.println`.\npub fn stdout() -> Str effects {io}\n/// Everything printed so far with `io.eprintln`.\npub fn stderr() -> Str effects {io}\n/// The text `io.read_line` and `io.read_all` read next, replacing what is left.\npub fn set_stdin(text: Str) effects {io}\n/// What `os.args()` returns (the program name first).\npub fn set_args(args: List<Str>) effects {env}\n/// Set an environment variable for `os.env`.\npub fn set_env(name: Str, value: Str) effects {env}\n/// Create or replace a file in the in-memory file system.\npub fn set_file(path: Str, contents: Str) effects {fs}\n/// A file's current contents, if it exists.\npub fn file(path: Str) -> Option<Str> effects {fs}\n/// Delete a file.\npub fn remove_file(path: Str) effects {fs}\n/// Set the clock, in milliseconds since the Unix epoch.\npub fn set_time(ms: Int) effects {clock}\n\n/// Move the clock forward.\npub fn advance(ms: Int)\n  requires ms >= 0\n  effects {clock}\n\n/// Restart the random number generator from a seed.\npub fn seed(n: Int) effects {rand}\n/// The simulated server at `addr` answers the next request with `reply`; without a queued\n/// reply, requests to it fail as refused.\npub fn reply(addr: Str, reply: Str) effects {net}\n/// The requests sent to `addr` so far.\npub fn requests(addr: Str) -> List<Str> effects {net}\n/// A client sends `request` to the server at `addr` (answered by `net.serve`).\npub fn connect(addr: Str, request: Str) effects {net}\n/// The replies the server at `addr` has sent.\npub fn answers(addr: Str) -> List<Str> effects {net}\n"

const STD_STRINGS_JIG: Str = "// String helpers, written in Jig. Every contract here is proved (`jig prove --std`).\n// Lengths and positions are in bytes, as everywhere for `Str`.\n\n/// The text before and after the first `sep`.\npub fn split_once(s: Str, sep: Str) -> Option<(Str, Str)>\n  ensures result.is_none() ||\n    result.unwrap().0.len() + result.unwrap().1.len() + sep.len() == s.len()\n{\n  return match s.find(sep) {\n    Some(i) => Some((s[0..i], s[i + sep.len()..s.len()]))\n    None => None\n  }\n}\n\n/// `s` without `prefix`, if it starts with it.\npub fn strip_prefix(s: Str, prefix: Str) -> Option<Str>\n  ensures result.is_none() || result.unwrap().len() + prefix.len() == s.len()\n{\n  if !s.starts_with(prefix) {\n    return None\n  }\n  return Some(s[prefix.len()..s.len()])\n}\n\n/// `s` without `suffix`, if it ends with it.\npub fn strip_suffix(s: Str, suffix: Str) -> Option<Str>\n  ensures result.is_none() || result.unwrap().len() + suffix.len() == s.len()\n{\n  if !s.ends_with(suffix) {\n    return None\n  }\n  return Some(s[0..s.len() - suffix.len()])\n}\n\nfn is_blank_byte(b: U8) -> Bool {\n  return b == 32 || b == 9 || b == 10 || b == 13\n}\n\n/// `s` without leading spaces, tabs and line breaks.\npub fn trim_start(s: Str) -> Str\n  ensures result.len() <= s.len()\n{\n  var i = 0\n  for i < s.len() && is_blank_byte(s[i]) invariant i >= 0 && i <= s.len() {\n    i += 1\n  }\n  return s[i..s.len()]\n}\n\n/// `s` without trailing spaces, tabs and line breaks.\npub fn trim_end(s: Str) -> Str\n  ensures result.len() <= s.len()\n{\n  var n = s.len()\n  for n > 0 && is_blank_byte(s[n - 1]) invariant n >= 0 && n <= s.len() {\n    n -= 1\n  }\n  return s[0..n]\n}\n\n/// Whether `s` is empty or only spaces, tabs and line breaks.\npub fn is_blank(s: Str) -> Bool\n  ensures result || !s.is_empty()\n{\n  for i in 0..s.len() {\n    if !is_blank_byte(s[i]) {\n      return false\n    }\n  }\n  return true\n}\n\n/// `s` with copies of `fill` in front, until it is at least `width` bytes long.\npub fn pad_left(s: Str, width: Int, fill: Char) -> Str\n  ensures result.len() >= s.len()\n{\n  if s.len() >= width {\n    return s\n  }\n  let need = width - s.len()\n  var pad = \"\"\n  let f = fill.str()\n  for pad.len() < need invariant pad.len() >= 0 {\n    pad = pad + f\n  }\n  return pad + s\n}\n\n/// `s` with copies of `fill` after it, until it is at least `width` bytes long.\npub fn pad_right(s: Str, width: Int, fill: Char) -> Str\n  ensures result.len() >= s.len()\n{\n  var out = s\n  let f = fill.str()\n  for out.len() < width invariant out.len() >= s.len() {\n    out = out + f\n  }\n  return out\n}\n\n/// How many times `part` occurs in `s`, without overlaps.\npub fn count(s: Str, part: Str) -> Int\n  requires !part.is_empty()\n  ensures result >= 0 && result <= s.len()\n{\n  var n = 0\n  var rest = s\n  for invariant n >= 0 && n <= s.len() - rest.len() {\n    match rest.find(part) {\n      Some(i) => {\n        n += 1\n        rest = rest[i + part.len()..rest.len()]\n      }\n      None => {\n        break\n      }\n    }\n  }\n  return n\n}\n\n/// The words of `s`: the pieces between runs of spaces, tabs and line breaks.\npub fn words(s: Str) -> List<Str>\n  ensures forall k in 0..result.len(): !result[k].is_empty()\n{\n  var out: List<Str> = []\n  var start = 0\n  for i in 0..s.len() + 1\n    invariant start >= 0 && start <= i, forall k in 0..out.len(): !out[k].is_empty()\n  {\n    if i == s.len() || is_blank_byte(s[i]) {\n      if i > start {\n        out.push(s[start..i])\n      }\n      start = i + 1\n    }\n  }\n  return out\n}\n"

const STD_TASK_JIG: Str = "// Structured parallelism. Every task finishes before the call that started it returns, so\n// none can outlive its caller. A task may start tasks of its own but has no other effects:\n// it computes from the values it captures, so results never depend on scheduling.\n\n/// Run every job in parallel; the results in job order.\npub fn all<T>(jobs: List<fn() -> T effects {spawn}>) -> List<T> effects {spawn}\n\n/// Apply `f` to every item in parallel; the results in item order.\npub fn map<T, U>(items: List<T>, f: fn(T) -> U effects {spawn}) -> List<U> effects {spawn}\n\n/// Run two jobs in parallel.\npub fn both<A, B>(a: fn() -> A effects {spawn}, b: fn() -> B effects {spawn}) -> (A, B)\n  effects {spawn}\n"

const STD_TIME_JIG: Str = "// Wall-clock and monotonic time.\n\n/// Milliseconds since the Unix epoch.\npub fn now_ms() -> Int effects {clock}\n/// Monotonic nanoseconds, for measuring durations.\npub fn now_ns() -> Int effects {clock}\n\n/// Wait. In tests the simulated clock moves forward instead.\npub fn sleep(ms: Int)\n  requires ms >= 0\n  effects {clock}\n\n// ---- calendar dates in UTC, written in Jig ----\n// Dates are proleptic Gregorian, years 0 to 9999, from milliseconds since the Unix epoch\n// (`now_ms()`). Leap seconds are not counted, as Unix time does not count them.\n\n/// The first and last milliseconds `utc` takes: 0000-01-01T00:00:00.000Z and\n/// 9999-12-31T23:59:59.999Z.\npub const MIN_MS: Int = -62167219200000\npub const MAX_MS: Int = 253402300799999\n\nconst DAY_MS: Int = 86400000\n\n/// A moment in UTC, as calendar fields.\npub struct DateTime {\n  pub year: Int\n  pub month: Int\n  pub day: Int\n  pub hour: Int\n  pub minute: Int\n  pub second: Int\n  pub ms: Int\n  invariant year >= 0 && year <= 9999 && month >= 1 && month <= 12 && day >= 1 && day <= 31\n  invariant hour >= 0 && hour < 24 && minute >= 0 && minute < 60 && second >= 0 && second < 60\n  invariant ms >= 0 && ms < 1000\n}\n\n/// Whether `year` has a February 29th.\npub fn is_leap(year: Int) -> Bool\n  ensures result == (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0))\n{\n  return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)\n}\n\n/// How many days `month` (1 to 12) of `year` has.\npub fn days_in_month(year: Int, month: Int) -> Int\n  requires month >= 1 && month <= 12\n  ensures result >= 28 && result <= 31\n{\n  if month == 2 {\n    return if is_leap(year) { 29 } else { 28 }\n  }\n  if month == 4 || month == 6 || month == 9 || month == 11 {\n    return 30\n  }\n  return 31\n}\n\n/// Days from 1970-01-01 to the date.\nfn days_from_civil(year: Int, month: Int, day: Int) -> Int\n  requires year >= 0 && year <= 9999 && month >= 1 && month <= 12 && day >= 1 && day <= 31\n  ensures result >= -719528 && result <= 2932896\n{\n  let y = if month <= 2 { year - 1 } else { year }\n  let era = (if y >= 0 { y } else { y - 399 }) / 400\n  let yoe = y - era * 400\n  let mp = (month + 9) % 12\n  let doy = (153 * mp + 2) / 5 + day - 1\n  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy\n  return era * 146097 + doe - 719468\n}\n\n/// The date (year, month, day) `days` after 1970-01-01.\nfn civil_from_days(days: Int) -> (Int, Int, Int)\n  requires days >= -719528 && days <= 2932896\n  ensures result.0 >= 0 && result.0 <= 9999\n  ensures result.1 >= 1 && result.1 <= 12 && result.2 >= 1 && result.2 <= 31\n{\n  let z = days + 719468\n  let era = (if z >= 0 { z } else { z - 146096 }) / 146097\n  let doe = z - era * 146097\n  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n  assert(doy >= 0 && doy <= 365)\n  let mp = (5 * doy + 2) / 153\n  assert(mp >= 0 && mp <= 11)\n  let day = doy - (153 * mp + 2) / 5 + 1\n  let month = if mp < 10 { mp + 3 } else { mp - 9 }\n  let year = yoe + era * 400 + (if month <= 2 { 1 } else { 0 })\n  return (year, month, day)\n}\n\n/// The calendar fields of `ms` milliseconds after the Unix epoch.\npub fn utc(ms: Int) -> DateTime\n  requires ms >= MIN_MS && ms <= MAX_MS\n{\n  let days = if ms >= 0 { ms / DAY_MS } else { (ms + 1) / DAY_MS - 1 }\n  let rest = ms - days * DAY_MS\n  let (year, month, day) = civil_from_days(days)\n  return DateTime {\n    year: year\n    month: month\n    day: day\n    hour: rest / 3600000\n    minute: rest / 60000 % 60\n    second: rest / 1000 % 60\n    ms: rest % 1000\n  }\n}\n\n/// Milliseconds since the Unix epoch of `d`.\npub fn unix_ms(d: DateTime) -> Int\n  ensures result >= MIN_MS && result <= MAX_MS + 31 * DAY_MS\n{\n  let days = days_from_civil(d.year, d.month, d.day)\n  return days * DAY_MS + d.hour * 3600000 + d.minute * 60000 + d.second * 1000 + d.ms\n}\n\n/// The day of the week of `ms`: 1 for Monday to 7 for Sunday.\npub fn weekday(ms: Int) -> Int\n  requires ms >= MIN_MS && ms <= MAX_MS\n  ensures result >= 1 && result <= 7\n{\n  let days = if ms >= 0 { ms / DAY_MS } else { (ms + 1) / DAY_MS - 1 }\n  // 1970-01-01 was a Thursday.\n  return (days % 7 + 10) % 7 + 1\n}\n\n/// `n` in decimal, padded with zeros to `width` digits.\nfn pad(n: Int, width: Int) -> Str\n  requires n >= 0 && width >= 0 && width <= 10\n  ensures result.len() >= width\n{\n  let s = n.str()\n  return if s.len() >= width { s } else { \"0\".repeat(width - s.len()) + s }\n}\n\n/// `ms` in ISO 8601: `2026-10-28T09:15:00.000Z`.\npub fn iso(ms: Int) -> Str\n  requires ms >= MIN_MS && ms <= MAX_MS\n  ensures result.len() >= 24\n{\n  let d = utc(ms)\n  return pad(d.year, 4) +\n    \"-\" +\n    pad(d.month, 2) +\n    \"-\" +\n    pad(d.day, 2) +\n    \"T\" +\n    pad(d.hour, 2) +\n    \":\" +\n    pad(d.minute, 2) +\n    \":\" +\n    pad(d.second, 2) +\n    \".\" +\n    pad(d.ms, 3) +\n    \"Z\"\n}\n\n/// `ms` as HTTP writes dates (RFC 9110): `Wed, 28 Oct 2026 09:15:00 GMT`.\npub fn http_date(ms: Int) -> Str\n  requires ms >= MIN_MS && ms <= MAX_MS\n  ensures result.len() >= 29\n{\n  let d = utc(ms)\n  let days = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n  let months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n  return days[weekday(ms) - 1] +\n    \", \" +\n    pad(d.day, 2) +\n    \" \" +\n    months[d.month - 1] +\n    \" \" +\n    pad(d.year, 4) +\n    \" \" +\n    pad(d.hour, 2) +\n    \":\" +\n    pad(d.minute, 2) +\n    \":\" +\n    pad(d.second, 2) +\n    \" GMT\"\n}\n\n/// The value of the digit at `at` in `s`, or -1.\nfn digit(s: Str, at: Int) -> Int\n  requires at >= 0 && at < s.len()\n  ensures result >= -1 && result <= 9\n{\n  let b = s[at]\n  return if b >= 48 && b <= 57 { b as Int - 48 } else { -1 }\n}\n\n/// The two-digit number at `at` in `s`, or -1.\nfn two(s: Str, at: Int) -> Int\n  requires at >= 0 && at < s.len() - 1\n  ensures result >= -1 && result <= 99\n{\n  let (a, b) = (digit(s, at), digit(s, at + 1))\n  return if a < 0 || b < 0 { -1 } else { a * 10 + b }\n}\n\n/// The moment an ISO 8601 date or date and time names: `2026-10-28`,\n/// `2026-10-28T09:15:00Z`, with optional milliseconds (`.250`) and a `Z` or `+hh:mm` /\n/// `-hh:mm` offset (none means UTC).\npub fn parse_iso(s: Str) -> Option<Int>\n  ensures result.is_none() ||\n    result.unwrap() >= MIN_MS - DAY_MS && result.unwrap() <= MAX_MS + DAY_MS\n{\n  if s.len() < 10 || s[4] != 45 || s[7] != 45 {\n    return None\n  }\n  let (c, y2, mo, d) = (two(s, 0), two(s, 2), two(s, 5), two(s, 8))\n  if c < 0 || y2 < 0 || mo < 1 || mo > 12 || d < 1 {\n    return None\n  }\n  let y = c * 100 + y2\n  if d > days_in_month(y, mo) {\n    return None\n  }\n  var ms = days_from_civil(y, mo, d) * DAY_MS\n  if s.len() == 10 {\n    return Some(ms)\n  }\n  if s.len() < 19 || (s[10] != 84 && s[10] != 32) || s[13] != 58 || s[16] != 58 {\n    return None\n  }\n  let (h, mi, se) = (two(s, 11), two(s, 14), two(s, 17))\n  if h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se > 59 {\n    return None\n  }\n  ms += h * 3600000 + mi * 60000 + se * 1000\n  var i = 19\n  if i < s.len() && s[i] == 46 {\n    if i + 4 > s.len() {\n      return None\n    }\n    let (f1, f2) = (digit(s, i + 1), two(s, i + 2))\n    if f1 < 0 || f2 < 0 {\n      return None\n    }\n    ms += f1 * 100 + f2\n    i += 4\n  }\n  if i == s.len() || i + 1 == s.len() && s[i] == 90 {\n    return Some(ms)\n  }\n  if i + 6 != s.len() || (s[i] != 43 && s[i] != 45) || s[i + 3] != 58 {\n    return None\n  }\n  let (oh, om) = (two(s, i + 1), two(s, i + 4))\n  if oh < 0 || oh > 23 || om < 0 || om > 59 {\n    return None\n  }\n  let offset = oh * 3600000 + om * 60000\n  return Some(if s[i] == 43 { ms - offset } else { ms + offset })\n}\n"

const RT_JIG_RT_C: Str = "/* The Jig runtime. See jig_rt.h for conventions. */\n#ifndef _GNU_SOURCE\n#define _GNU_SOURCE\n#endif\n#include \"jig_rt.h\"\n\n#ifdef _WIN32\n/* Windows, through MinGW-w64: winpthreads gives pthreads, clock_gettime and nanosleep, the\n   C library gives dirent and stat, and sockets are Winsock's (link with -lws2_32). */\n#define WIN32_LEAN_AND_MEAN\n#include <winsock2.h>\n#include <ws2tcpip.h>\n#include <windows.h>\n#include <direct.h>\n#include <fcntl.h>\n#include <io.h>\n#else\n#include <netdb.h>\n#include <sys/socket.h>\n#endif\n#include <dirent.h>\n#include <pthread.h>\n#include <errno.h>\n#include <math.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/stat.h>\n#include <sys/time.h>\n#include <time.h>\n#include <unistd.h>\n\n/* ---------- platform ----------\n   What differs between POSIX and Windows: sockets (a handle type, how they close, time out\n   and report errors), the processor count, reading a line, searching memory, waiting\n   forever, and opening libraries. */\n\nstatic void jig_oom(void) __attribute__((noreturn, cold));\n\n#ifdef _WIN32\ntypedef SOCKET jig_sock;\n#define BAD_SOCK INVALID_SOCKET\n#define sock_close(s) closesocket(s)\n#define SHUT_WR SD_SEND\n#define MSG_NOSIGNAL 0\n\n/* The last socket call's error, worded by the system (without its final period). */\nstatic const char *sock_error(void) {\n    static __thread char buf[256];\n    DWORD n = FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,\n                             (DWORD)WSAGetLastError(), 0, buf, sizeof buf, NULL);\n    while (n > 0 && (buf[n - 1] == '\\r' || buf[n - 1] == '\\n' || buf[n - 1] == ' ' || buf[n - 1] == '.')) n--;\n    buf[n] = 0;\n    return n ? buf : \"socket error\";\n}\nstatic bool sock_interrupted(void) { return WSAGetLastError() == WSAEINTR; }\nstatic bool sock_timed_out(void) { return WSAGetLastError() == WSAETIMEDOUT; }\nstatic void sock_timeouts(jig_sock s, int secs) {\n    DWORD ms = (DWORD)secs * 1000;\n    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, (const char *)&ms, sizeof ms);\n    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, (const char *)&ms, sizeof ms);\n}\nstatic long cpu_count(void) {\n    SYSTEM_INFO si;\n    GetSystemInfo(&si);\n    return (long)si.dwNumberOfProcessors;\n}\n/* POSIX getline: a line with its '\\n', in *line (grown as needed); -1 at the end of input. */\nstatic ssize_t read_line(char **line, size_t *cap, FILE *f) {\n    size_t n = 0;\n    int c;\n    while ((c = fgetc(f)) != EOF) {\n        if (n + 2 > *cap) {\n            size_t m = *cap ? 2 * *cap : 128;\n            char *p = realloc(*line, m);\n            if (!p) jig_oom();\n            *line = p;\n            *cap = m;\n        }\n        (*line)[n++] = (char)c;\n        if (c == '\\n') break;\n    }\n    if (n == 0) return -1;\n    (*line)[n] = 0;\n    return (ssize_t)n;\n}\nstatic void *memmem(const void *hay, size_t n, const void *needle, size_t m) {\n    const char *h = hay, *k = needle;\n    if (m == 0) return (void *)h;\n    for (size_t i = 0; m <= n && i <= n - m; i++)\n        if (h[i] == k[0] && memcmp(h + i, k, m) == 0) return (void *)(h + i);\n    return NULL;\n}\n#define pause() Sleep(INFINITE)\nstatic void *lib_open(const char *name) { return (void *)LoadLibraryA(name); }\nstatic void *lib_sym(void *h, const char *name) { return (void *)GetProcAddress((HMODULE)h, name); }\n#else\ntypedef int jig_sock;\n#define BAD_SOCK (-1)\n#define sock_close(s) close(s)\nstatic const char *sock_error(void) { return strerror(errno); }\nstatic bool sock_interrupted(void) { return errno == EINTR; }\nstatic bool sock_timed_out(void) { return errno == EAGAIN || errno == EWOULDBLOCK; }\nstatic void sock_timeouts(jig_sock s, int secs) {\n    struct timeval tv = {secs, 0};\n    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);\n    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);\n}\nstatic long cpu_count(void) { return sysconf(_SC_NPROCESSORS_ONLN); }\n#define read_line getline\n/* `dlsym` and `dlopen` are weak references, so a program that never opens a library needs no\n   extra one (where they are missing, nothing is found). */\n#include <dlfcn.h>\n#pragma weak dlsym\n#pragma weak dlopen\nstatic void *lib_open(const char *name) { return dlopen ? dlopen(name, RTLD_NOW | RTLD_GLOBAL) : NULL; }\nstatic void *lib_sym(void *h, const char *name) { return dlsym ? dlsym(h, name) : NULL; }\n#endif\n\n/* ---------- process ---------- */\n\nstatic int g_argc;\nstatic char **g_argv;\nstatic char g_out[1 << 16];\nstatic size_t g_out_len;\nstatic uint64_t g_rng;\n/* Set once a server answers on several threads (`net.serve_http_parallel`), whose handlers\n   may print or draw random numbers: from then on the output buffer and the generator are\n   locked. Task functions (std/task) have no such effects. */\nstatic bool g_threaded;\nstatic pthread_mutex_t g_shared_mu = PTHREAD_MUTEX_INITIALIZER;\n#define SHARED_LOCK() \\\n    do { \\\n        if (g_threaded) pthread_mutex_lock(&g_shared_mu); \\\n    } while (0)\n#define SHARED_UNLOCK() \\\n    do { \\\n        if (g_threaded) pthread_mutex_unlock(&g_shared_mu); \\\n    } while (0)\n\nstatic void flush_out(void) {\n    if (g_out_len) {\n        fwrite(g_out, 1, g_out_len, stdout);\n        g_out_len = 0;\n    }\n    fflush(stdout);\n}\n\nvoid jig_init(int argc, char **argv) {\n    g_argc = argc;\n    g_argv = argv;\n#ifdef _WIN32\n    /* Bytes in and out as they are, with no '\\r' added or taken away. */\n    _setmode(_fileno(stdin), _O_BINARY);\n    _setmode(_fileno(stdout), _O_BINARY);\n    _setmode(_fileno(stderr), _O_BINARY);\n    WSADATA wsa;\n    WSAStartup(MAKEWORD(2, 2), &wsa);\n    /* The working directory as POSIX shells give it, in PWD, with '/' between names: from\n       PWD when it starts with a drive, else (unset, or an MSYS shell's `/c/...`, which other\n       Windows programs cannot open) from the system. */\n    char cwd[4096];\n    const char *pwd = getenv(\"PWD\");\n    bool drive = pwd && ((pwd[0] | 32) >= 'a' && (pwd[0] | 32) <= 'z') && pwd[1] == ':';\n    if (drive ? strlen(pwd) < sizeof cwd : _getcwd(cwd, sizeof cwd) != NULL) {\n        if (drive) strcpy(cwd, pwd);\n        for (char *p = cwd; *p; p++)\n            if (*p == '\\\\') *p = '/';\n        _putenv_s(\"PWD\", cwd);\n    }\n#endif\n    struct timespec ts;\n    clock_gettime(CLOCK_REALTIME, &ts);\n    g_rng = ((uint64_t)ts.tv_nsec * 0x9e3779b97f4a7c15ull) ^ ((uint64_t)getpid() << 32) ^ (uint64_t)ts.tv_sec;\n    if (!g_rng) g_rng = 1;\n    atexit(flush_out);\n}\n\nstatic void *run_thunk(void *f) {\n    ((void (*)(void))f)();\n    return NULL;\n}\n\nvoid jig_run_main(void (*f)(void)) {\n    /* Deeply recursive programs get the same headroom as under the test runner. */\n    pthread_attr_t attr;\n    pthread_t t;\n    pthread_attr_init(&attr);\n    if (pthread_attr_setstacksize(&attr, (size_t)1 << 30) != 0 || pthread_create(&t, &attr, run_thunk, (void *)f) != 0) {\n        f();\n        return;\n    }\n    pthread_join(t, NULL);\n}\n\nvoid jig_exit(int code) {\n    SHARED_LOCK();\n    flush_out();\n    exit(code);\n}\n\nvoid jig_panic(const char *msg, const char *loc) {\n    /* With tasks, several threads may fail at once: the first one reports. */\n    static int panicking;\n    if (__atomic_exchange_n(&panicking, 1, __ATOMIC_SEQ_CST))\n        for (;;) pause();\n    flush_out();\n    fprintf(stderr, \"panic at %s: %s\\n\", loc, msg);\n    fflush(stderr);\n    _exit(101);\n}\n\nvoid jig_panic_buf(jig_buf *b, const char *loc) {\n    jig_buf_push(b, \"\", 1);\n    jig_panic(b->data, loc);\n}\n\nvoid jig_unreachable(const char *loc) { jig_panic(\"entered unreachable code\", loc); }\n\n/* ---------- memory ---------- */\n\nstatic void jig_oom(void) __attribute__((noreturn, cold));\nstatic void jig_oom(void) {\n    fputs(\"out of memory\\n\", stderr);\n    _exit(102);\n}\n\n#ifdef JIG_POOL\n/* Release builds: blocks up to POOL_MAX bytes come from per-thread free lists, one per\n * 16-byte size class, carved from 64 KiB slabs that are never returned. Each block starts\n * with an 8-byte header holding its class (0 for a large block from malloc), so jig_free\n * needs no size. Debug builds use malloc directly so Valgrind sees every block. */\n#define POOL_MAX 512\ntypedef struct pool_block {\n    struct pool_block *next;\n} pool_block;\nstatic __thread pool_block *pool_free[POOL_MAX / 16 + 1];\nstatic __thread char *pool_cur, *pool_end;\n\nstatic uint64_t *pool_carve(size_t sz) __attribute__((noinline));\nstatic uint64_t *pool_carve(size_t sz) {\n    if ((size_t)(pool_end - pool_cur) < sz) {\n        size_t slab = (size_t)1 << 16;\n        pool_cur = malloc(slab);\n        if (!pool_cur) jig_oom();\n        pool_end = pool_cur + slab;\n    }\n    uint64_t *h = (uint64_t *)pool_cur;\n    pool_cur += sz;\n    return h;\n}\n\nvoid *jig_alloc(size_t n) {\n    size_t need = n + 8;\n    if (__builtin_expect(need <= POOL_MAX, 1)) {\n        size_t c = (need + 15) >> 4;\n        pool_block *b = pool_free[c];\n        uint64_t *h;\n        if (b) {\n            pool_free[c] = b->next;\n            h = (uint64_t *)b;\n        } else {\n            h = pool_carve(c << 4);\n        }\n        h[0] = c;\n        return h + 1;\n    }\n    uint64_t *h = malloc(need);\n    if (!h) jig_oom();\n    h[0] = 0;\n    return h + 1;\n}\n\nvoid *jig_alloc_obj(size_t n) {\n    if (__builtin_expect(n > POOL_MAX, 0)) {\n        void *p = malloc(n);\n        if (!p) jig_oom();\n        return p;\n    }\n    size_t c = (n + 15) >> 4;\n    pool_block *b = pool_free[c];\n    if (b) {\n        pool_free[c] = b->next;\n        return b;\n    }\n    return pool_carve(c << 4);\n}\n\nvoid jig_free_obj(void *p, size_t n) {\n    if (n > POOL_MAX) {\n        free(p);\n        return;\n    }\n    size_t c = (n + 15) >> 4;\n    pool_block *b = p;\n    b->next = pool_free[c];\n    pool_free[c] = b;\n}\n\nstatic void *jig_alloc_zeroed(size_t n) {\n    if (n + 8 <= POOL_MAX) return memset(jig_alloc(n), 0, n);\n    uint64_t *h = calloc(1, n + 8);\n    if (!h) jig_oom();\n    return h + 1;\n}\n\nvoid jig_free(void *p) {\n    if (!p) return;\n    uint64_t *h = (uint64_t *)p - 1;\n    size_t c = h[0];\n    if (c == 0) {\n        free(h);\n        return;\n    }\n    pool_block *b = (pool_block *)h;\n    b->next = pool_free[c];\n    pool_free[c] = b;\n}\n\n/* The bytes jig_alloc(n) really provides: its size class, less the header. */\nstatic size_t jig_alloc_size(size_t n) {\n    size_t need = n + 8;\n    return need <= POOL_MAX ? ((need + 15) & ~(size_t)15) - 8 : n;\n}\n\nstatic void *jig_realloc(void *p, size_t n) {\n    if (!p) return jig_alloc(n);\n    uint64_t *h = (uint64_t *)p - 1;\n    size_t c = h[0];\n    if (c == 0) {\n        h = realloc(h, n + 8);\n        if (!h) jig_oom();\n        return h + 1;\n    }\n    size_t have = (c << 4) - 8;\n    if (n <= have) return p;\n    void *q = jig_alloc(n);\n    memcpy(q, p, have);\n    jig_free(p);\n    return q;\n}\n#else\nvoid *jig_alloc(size_t n) {\n    void *p = malloc(n ? n : 1);\n    if (!p) jig_oom();\n    return p;\n}\n\nstatic void *jig_alloc_zeroed(size_t n) {\n    void *p = calloc(1, n ? n : 1);\n    if (!p) jig_oom();\n    return p;\n}\n\nvoid jig_free(void *p) { free(p); }\n\nvoid *jig_alloc_obj(size_t n) { return jig_alloc(n); }\n\nvoid jig_free_obj(void *p, size_t n) {\n    (void)n;\n    free(p);\n}\n\nstatic size_t jig_alloc_size(size_t n) { return n; }\n\nstatic void *jig_realloc(void *p, size_t n) {\n    void *q = realloc(p, n ? n : 1);\n    if (!q) jig_oom();\n    return q;\n}\n#endif\n\n/* ---------- tasks ---------- */\n\n/* A batch of `n` independent calls body(ctx, i). The thread that starts it works through it\n * and idle workers help; the starter waits only for indices other threads have taken, so a\n * task that starts its own batch (nesting) always makes progress. Workers are started once\n * and kept, so their allocation pools are never lost. */\ntypedef struct jig_batch {\n    int64_t n, next, helpers;\n    void (*body)(void *ctx, int64_t i);\n    void *ctx;\n    struct jig_batch *link;\n} jig_batch;\n\nint jig_sharing;\n\nstatic pthread_mutex_t batch_mu = PTHREAD_MUTEX_INITIALIZER;\nstatic pthread_cond_t batch_work = PTHREAD_COND_INITIALIZER;\nstatic pthread_cond_t batch_idle = PTHREAD_COND_INITIALIZER;\nstatic jig_batch *batches;\nstatic int workers = -1;\n\nstatic void batch_run(jig_batch *b) {\n    for (;;) {\n        int64_t i = __atomic_fetch_add(&b->next, 1, __ATOMIC_RELAXED);\n        if (i >= b->n) return;\n        b->body(b->ctx, i);\n    }\n}\n\nstatic void *batch_worker(void *arg) {\n    (void)arg;\n    pthread_mutex_lock(&batch_mu);\n    for (;;) {\n        jig_batch *b = batches;\n        while (b && __atomic_load_n(&b->next, __ATOMIC_RELAXED) >= b->n) b = b->link;\n        if (!b) {\n            pthread_cond_wait(&batch_work, &batch_mu);\n            continue;\n        }\n        b->helpers++;\n        pthread_mutex_unlock(&batch_mu);\n        batch_run(b);\n        pthread_mutex_lock(&batch_mu);\n        if (--b->helpers == 0) pthread_cond_broadcast(&batch_idle);\n    }\n    return NULL;\n}\n\nstatic int worker_count(void) {\n    const char *e = getenv(\"JIG_THREADS\");\n    long n = e ? atol(e) : cpu_count();\n    return n > 1 ? (int)(n - 1) : 0;\n}\n\n/* Under batch_mu. */\nstatic void start_workers(void) {\n    if (workers >= 0) return;\n    workers = worker_count();\n    pthread_attr_t attr;\n    pthread_attr_init(&attr);\n    pthread_attr_setstacksize(&attr, (size_t)256 << 20);\n    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);\n    for (int i = 0; i < workers; i++) {\n        pthread_t t;\n        if (pthread_create(&t, &attr, batch_worker, NULL) != 0) {\n            workers = i;\n            break;\n        }\n    }\n    pthread_attr_destroy(&attr);\n}\n\nstatic void parallel_for(int64_t n, void (*body)(void *, int64_t), void *ctx) {\n    pthread_mutex_lock(&batch_mu);\n    start_workers();\n    if (n < 2 || workers == 0) {\n        pthread_mutex_unlock(&batch_mu);\n        for (int64_t i = 0; i < n; i++) body(ctx, i);\n        return;\n    }\n    jig_batch b = {n, 0, 0, body, ctx, batches};\n    batches = &b;\n    /* From before any worker can take an index until every one has finished. */\n    __atomic_add_fetch(&jig_sharing, 1, __ATOMIC_SEQ_CST);\n    pthread_cond_broadcast(&batch_work);\n    pthread_mutex_unlock(&batch_mu);\n    batch_run(&b);\n    pthread_mutex_lock(&batch_mu);\n    jig_batch **pp = &batches;\n    while (*pp != &b) pp = &(*pp)->link;\n    *pp = b.link;\n    while (b.helpers > 0) pthread_cond_wait(&batch_idle, &batch_mu);\n    __atomic_sub_fetch(&jig_sharing, 1, __ATOMIC_SEQ_CST);\n    pthread_mutex_unlock(&batch_mu);\n}\n\ntypedef struct {\n    jig_fn *fns;\n    const char *in;\n    size_t isz;\n    char *out;\n    size_t osz;\n    jig_task_call call;\n} task_ctx;\n\nstatic void task_all_body(void *c, int64_t i) {\n    task_ctx *t = c;\n    t->call(&t->fns[i], NULL, t->out + (size_t)i * t->osz);\n}\n\nstatic void task_map_body(void *c, int64_t i) {\n    task_ctx *t = c;\n    t->call(t->fns, t->in + (size_t)i * t->isz, t->out + (size_t)i * t->osz);\n}\n\nstatic jig_list *task_results(int64_t n, const jig_type *rt) {\n    jig_list *r = jig_list_with_capacity(n, rt);\n    r->len = n;\n    return r;\n}\n\njig_list *jig_task_all(const jig_list *jobs, jig_task_call call, const jig_type *rt) {\n    int64_t n = jig_list_len(jobs);\n    if (!n) return NULL;\n    jig_list *r = task_results(n, rt);\n    task_ctx c = {(jig_fn *)jobs->data, NULL, 0, r->data, rt->size, call};\n    parallel_for(n, task_all_body, &c);\n    return r;\n}\n\njig_list *jig_task_map(const jig_list *items, jig_fn *f, jig_task_call call, const jig_type *it, const jig_type *rt) {\n    int64_t n = jig_list_len(items);\n    if (!n) return NULL;\n    jig_list *r = task_results(n, rt);\n    task_ctx c = {f, items->data, it->size, r->data, rt->size, call};\n    parallel_for(n, task_map_body, &c);\n    return r;\n}\n\ntypedef struct {\n    jig_fn *f[2];\n    jig_task_call call[2];\n    void *out[2];\n} both_ctx;\n\nstatic void task_both_body(void *c, int64_t i) {\n    both_ctx *b = c;\n    b->call[i](b->f[i], NULL, b->out[i]);\n}\n\nvoid jig_task_both(jig_fn *a, jig_fn *b, jig_task_call ca, jig_task_call cb, void *oa, void *ob) {\n    both_ctx c = {{a, b}, {ca, cb}, {oa, ob}};\n    parallel_for(2, task_both_body, &c);\n}\n\n/* ---------- buffers ---------- */\n\nvoid jig_buf_push(jig_buf *b, const char *s, int64_t n) {\n    if (b->len + n > b->cap) {\n        int64_t cap = b->cap ? b->cap * 2 : 64;\n        while (cap < b->len + n) cap *= 2;\n        b->data = jig_realloc(b->data, (size_t)cap);\n        b->cap = cap;\n    }\n    memcpy(b->data + b->len, s, (size_t)n);\n    b->len += n;\n}\n\nvoid jig_buf_push_cstr(jig_buf *b, const char *s) { jig_buf_push(b, s, (int64_t)strlen(s)); }\n\nvoid jig_buf_push_str(jig_buf *b, const jig_str *s) { jig_buf_push(b, jig_str_data(s), jig_str_len(s)); }\n\nvoid jig_buf_free(jig_buf *b) {\n    jig_free(b->data);\n    b->data = NULL;\n    b->len = b->cap = 0;\n}\n\njig_str *jig_buf_to_str(jig_buf *b) {\n    jig_str *s = jig_str_new(b->data, b->len);\n    jig_buf_free(b);\n    return s;\n}\n\n/* ---------- strings ---------- */\n\n/* A string block with room for at least `len` bytes; its capacity is all the block holds, so\n * appends can use the allocator's rounding. */\nstatic jig_str *jig_str_block(int64_t len) {\n    size_t sz = jig_alloc_size(sizeof(jig_str) + (size_t)len + 1);\n    jig_str *s = jig_alloc(sz);\n    s->rc = 1;\n    s->cap = (int64_t)(sz - sizeof(jig_str) - 1);\n    return s;\n}\n\njig_str *jig_str_new(const char *data, int64_t len) {\n    if (len == 0) return NULL;\n    jig_str *s = jig_str_block(len);\n    s->len = len;\n    memcpy(s->data, data, (size_t)len);\n    s->data[len] = 0;\n    return s;\n}\n\njig_str *jig_str_concat(const jig_str *a, const jig_str *b) {\n    int64_t la = jig_str_len(a), lb = jig_str_len(b);\n    if (la + lb == 0) return NULL;\n    jig_str *s = jig_str_block(la + lb);\n    s->len = la + lb;\n    memcpy(s->data, jig_str_data(a), (size_t)la);\n    memcpy(s->data + la, jig_str_data(b), (size_t)lb);\n    s->data[la + lb] = 0;\n    return s;\n}\n\njig_str *jig_str_from_cstr(const char *s) {\n    return s ? jig_str_new(s, (int64_t)strlen(s)) : NULL;\n}\n\njig_str *jig_str_concat_n(int64_t n, const jig_str *const *xs) {\n    int64_t len = 0;\n    for (int64_t i = 0; i < n; i++) len += jig_str_len(xs[i]);\n    if (len == 0) return NULL;\n    jig_str *s = jig_str_block(len);\n    s->len = len;\n    char *d = s->data;\n    for (int64_t i = 0; i < n; i++) {\n        int64_t k = jig_str_len(xs[i]);\n        jig_copy_small(d, jig_str_data(xs[i]), (size_t)k);\n        d += k;\n    }\n    *d = 0;\n    return s;\n}\n\nvoid jig_str_append_slow(jig_str **sp, const jig_str *t) {\n    int64_t lt = jig_str_len(t);\n    if (lt == 0) return;\n    jig_str *s = *sp;\n    int64_t ls = jig_str_len(s);\n    if (s && s->rc == 1 && s != t) {\n        if (ls + lt > s->cap) {\n            /* Grow geometrically so a loop of appends is linear. */\n            int64_t cap = s->cap * 2 > ls + lt ? s->cap * 2 : ls + lt;\n            size_t sz = jig_alloc_size(sizeof(jig_str) + (size_t)cap + 1);\n            s = jig_realloc(s, sz);\n            s->cap = (int64_t)(sz - sizeof(jig_str) - 1);\n        }\n        memcpy(s->data + ls, t->data, (size_t)lt);\n        s->len = ls + lt;\n        s->data[s->len] = 0;\n        *sp = s;\n        return;\n    }\n    /* Shared, static, empty or appending to itself: a fresh string with room to grow. */\n    jig_str *n = jig_str_block(ls + lt < 16 ? 16 : ls + lt);\n    n->len = ls + lt;\n    memcpy(n->data, jig_str_data(s), (size_t)ls);\n    memcpy(n->data + ls, jig_str_data(t), (size_t)lt);\n    n->data[n->len] = 0;\n    jig_str_release(s);\n    *sp = n;\n}\n\nbool jig_str_eq(const jig_str *a, const jig_str *b) {\n    int64_t la = jig_str_len(a);\n    return la == jig_str_len(b) && memcmp(jig_str_data(a), jig_str_data(b), (size_t)la) == 0;\n}\n\nint jig_str_cmp(const jig_str *a, const jig_str *b) {\n    int64_t la = jig_str_len(a), lb = jig_str_len(b);\n    int c = memcmp(jig_str_data(a), jig_str_data(b), (size_t)(la < lb ? la : lb));\n    if (c) return c < 0 ? -1 : 1;\n    return la < lb ? -1 : la > lb ? 1 : 0;\n}\n\nuint64_t jig_hash_u64(uint64_t x) {\n    x ^= x >> 30;\n    x *= 0xbf58476d1ce4e5b9ull;\n    x ^= x >> 27;\n    x *= 0x94d049bb133111ebull;\n    return x ^ (x >> 31);\n}\n\nuint64_t jig_hash_combine(uint64_t h, uint64_t x) { return jig_hash_u64(h ^ (x + 0x9e3779b97f4a7c15ull + (h << 6))); }\n\n/* Eight bytes at a time; the tail is read with overlapping loads inside the string. */\nuint64_t jig_str_hash(const jig_str *s) {\n    const unsigned char *p = (const unsigned char *)jig_str_data(s);\n    int64_t n = jig_str_len(s);\n    uint64_t h = 0x9e3779b97f4a7c15ull ^ (uint64_t)n;\n    for (; n > 8; p += 8, n -= 8) {\n        uint64_t w;\n        memcpy(&w, p, 8);\n        h = (h ^ w) * 0xbf58476d1ce4e5b9ull;\n        h ^= h >> 29;\n    }\n    uint64_t w = 0;\n    if (n == 8) {\n        memcpy(&w, p, 8);\n    } else if (n >= 4) {\n        uint32_t a, b;\n        memcpy(&a, p, 4);\n        memcpy(&b, p + n - 4, 4);\n        w = ((uint64_t)a << 32) | b;\n    } else if (n) {\n        w = (uint64_t)p[0] | (uint64_t)p[n / 2] << 8 | (uint64_t)p[n - 1] << 16;\n    }\n    return jig_hash_u64(h ^ w);\n}\n\njig_str *jig_str_slice(const jig_str *s, int64_t lo, int64_t hi, const char *loc) {\n    int64_t n = jig_str_len(s);\n    if (lo < 0 || hi < lo || hi > n) {\n        char msg[160];\n        snprintf(msg, sizeof msg, \"slice %lld..%lld is out of bounds for a string of length %lld\", (long long)lo, (long long)hi, (long long)n);\n        jig_panic(msg, loc);\n    }\n    const char *d = jig_str_data(s);\n    /* character boundaries: a continuation byte cannot start or end a slice */\n    if ((lo < n && ((unsigned char)d[lo] & 0xc0) == 0x80) || (hi < n && ((unsigned char)d[hi] & 0xc0) == 0x80)) {\n        char msg[160];\n        snprintf(msg, sizeof msg, \"slice %lld..%lld does not fall on character boundaries\", (long long)lo, (long long)hi);\n        jig_panic(msg, loc);\n    }\n    return jig_str_new(d + lo, hi - lo);\n}\n\nint64_t jig_str_find(const jig_str *s, const jig_str *t) {\n    int64_t n = jig_str_len(s), m = jig_str_len(t);\n    if (m == 0) return 0;\n    const char *a = jig_str_data(s), *b = jig_str_data(t);\n    const char *p = m <= n ? memmem(a, (size_t)n, b, (size_t)m) : NULL;\n    return p ? p - a : -1;\n}\n\nbool jig_str_contains(const jig_str *s, const jig_str *t) { return jig_str_find(s, t) >= 0; }\n\nbool jig_str_starts_with(const jig_str *s, const jig_str *t) {\n    int64_t m = jig_str_len(t);\n    return m <= jig_str_len(s) && memcmp(jig_str_data(s), jig_str_data(t), (size_t)m) == 0;\n}\n\nbool jig_str_ends_with(const jig_str *s, const jig_str *t) {\n    int64_t n = jig_str_len(s), m = jig_str_len(t);\n    return m <= n && memcmp(jig_str_data(s) + n - m, jig_str_data(t), (size_t)m) == 0;\n}\n\nstatic void push_str_elem(jig_list **l, const char *d, int64_t n) {\n    jig_str *p = jig_str_new(d, n);\n    jig_list_push_fast(l, &p, sizeof p, &jig_type_str);\n}\n\nstatic int utf8_len(unsigned char c) { return c < 0x80 ? 1 : c < 0xe0 ? 2 : c < 0xf0 ? 3 : 4; }\n\njig_list *jig_str_split(const jig_str *s, const jig_str *sep) {\n    jig_list *out = NULL;\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s), m = jig_str_len(sep);\n    if (m == 0) {\n        for (int64_t i = 0; i < n;) {\n            int k = utf8_len((unsigned char)d[i]);\n            push_str_elem(&out, d + i, k);\n            i += k;\n        }\n        return out;\n    }\n    const char *sd = jig_str_data(sep);\n    int64_t start = 0;\n    for (int64_t i = 0; i + m <= n;) {\n        /* Jump to the next occurrence of the separator's first byte. */\n        const char *p = memchr(d + i, sd[0], (size_t)(n - m + 1 - i));\n        if (!p) break;\n        i = p - d;\n        if (m == 1 || memcmp(p + 1, sd + 1, (size_t)m - 1) == 0) {\n            push_str_elem(&out, d + start, i - start);\n            i += m;\n            start = i;\n        } else {\n            i++;\n        }\n    }\n    push_str_elem(&out, d + start, n - start);\n    return out;\n}\n\njig_str *jig_str_split_next(const jig_str *s, const jig_str *sep, int64_t *pos) {\n    const char *d = jig_str_data(s), *sd = jig_str_data(sep);\n    int64_t n = jig_str_len(s), m = jig_str_len(sep), i = *pos;\n    const char *p = i + m <= n ? memmem(d + i, (size_t)(n - i), sd, (size_t)m) : NULL;\n    if (!p) {\n        *pos = -1;\n        return jig_str_new(d + i, n - i);\n    }\n    *pos = (p - d) + m;\n    return jig_str_new(d + i, (p - d) - i);\n}\n\njig_list *jig_str_lines(const jig_str *s) {\n    jig_list *out = NULL;\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s), start = 0;\n    for (int64_t i = 0; i < n; i++) {\n        if (d[i] == '\\n') {\n            int64_t end = i;\n            if (end > start && d[end - 1] == '\\r') end--;\n            push_str_elem(&out, d + start, end - start);\n            start = i + 1;\n        }\n    }\n    if (start < n) {\n        int64_t end = n;\n        if (end > start && d[end - 1] == '\\r') end--;\n        push_str_elem(&out, d + start, end - start);\n    }\n    return out;\n}\n\nstatic bool is_ws(unsigned char c) { return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '\\v' || c == '\\f'; }\n\njig_str *jig_str_trim(const jig_str *s) {\n    const char *d = jig_str_data(s);\n    int64_t lo = 0, hi = jig_str_len(s);\n    while (lo < hi && is_ws((unsigned char)d[lo])) lo++;\n    while (hi > lo && is_ws((unsigned char)d[hi - 1])) hi--;\n    return jig_str_new(d + lo, hi - lo);\n}\n\njig_str *jig_str_replace(const jig_str *s, const jig_str *from, const jig_str *to) {\n    int64_t m = jig_str_len(from);\n    if (m == 0) {\n        jig_str *r = (jig_str *)s;\n        jig_str_retain(r);\n        return r;\n    }\n    jig_buf b = {0};\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s);\n    for (int64_t i = 0; i < n;) {\n        if (i + m <= n && memcmp(d + i, jig_str_data(from), (size_t)m) == 0) {\n            jig_buf_push_str(&b, to);\n            i += m;\n        } else {\n            jig_buf_push(&b, d + i, 1);\n            i++;\n        }\n    }\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_str_repeat(const jig_str *s, int64_t n, const char *loc) {\n    if (n < 0) jig_panic(\"repeat count is negative\", loc);\n    jig_buf b = {0};\n    for (int64_t i = 0; i < n; i++) jig_buf_push_str(&b, s);\n    return jig_buf_to_str(&b);\n}\n\nstatic uint32_t decode_utf8(const char *d, int64_t *i, int64_t n) {\n    unsigned char c = (unsigned char)d[*i];\n    int k = utf8_len(c);\n    uint32_t cp = k == 1 ? c : k == 2 ? (c & 0x1f) : k == 3 ? (c & 0x0f) : (c & 0x07);\n    for (int j = 1; j < k && *i + j < n; j++) cp = (cp << 6) | ((unsigned char)d[*i + j] & 0x3f);\n    *i += k;\n    return cp;\n}\n\nstatic void encode_utf8(jig_buf *b, uint32_t c) {\n    char tmp[4];\n    int n;\n    if (c < 0x80) {\n        tmp[0] = (char)c;\n        n = 1;\n    } else if (c < 0x800) {\n        tmp[0] = (char)(0xc0 | (c >> 6));\n        tmp[1] = (char)(0x80 | (c & 0x3f));\n        n = 2;\n    } else if (c < 0x10000) {\n        tmp[0] = (char)(0xe0 | (c >> 12));\n        tmp[1] = (char)(0x80 | ((c >> 6) & 0x3f));\n        tmp[2] = (char)(0x80 | (c & 0x3f));\n        n = 3;\n    } else {\n        tmp[0] = (char)(0xf0 | (c >> 18));\n        tmp[1] = (char)(0x80 | ((c >> 12) & 0x3f));\n        tmp[2] = (char)(0x80 | ((c >> 6) & 0x3f));\n        tmp[3] = (char)(0x80 | (c & 0x3f));\n        n = 4;\n    }\n    jig_buf_push(b, tmp, n);\n}\n\nstatic jig_str *map_chars(const jig_str *s, uint32_t (*f)(uint32_t)) {\n    jig_buf b = {0};\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s);\n    for (int64_t i = 0; i < n;) encode_utf8(&b, f(decode_utf8(d, &i, n)));\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_str_to_upper(const jig_str *s) { return map_chars(s, jig_char_to_upper); }\njig_str *jig_str_to_lower(const jig_str *s) { return map_chars(s, jig_char_to_lower); }\n\nbool jig_str_to_int(const jig_str *s, int64_t *out) {\n    jig_str *t = jig_str_trim(s);\n    const char *d = jig_str_data(t);\n    int64_t n = jig_str_len(t);\n    bool ok = n > 0;\n    int64_t i = 0;\n    bool neg = false;\n    if (ok && (d[0] == '-' || d[0] == '+')) {\n        neg = d[0] == '-';\n        i = 1;\n        ok = n > 1;\n    }\n    uint64_t v = 0;\n    for (; ok && i < n; i++) {\n        if (d[i] < '0' || d[i] > '9') {\n            ok = false;\n            break;\n        }\n        uint64_t nv = v * 10 + (uint64_t)(d[i] - '0');\n        if (nv / 10 != v || nv > (uint64_t)INT64_MAX + (neg ? 1 : 0)) {\n            ok = false;\n            break;\n        }\n        v = nv;\n    }\n    if (ok) *out = neg ? (int64_t)(0 - v) : (int64_t)v;\n    jig_str_release(t);\n    return ok;\n}\n\nbool jig_str_to_float(const jig_str *s, double *out) {\n    jig_str *t = jig_str_trim(s);\n    bool ok = false;\n    if (jig_str_len(t) > 0) {\n        char *end;\n        errno = 0;\n        double v = strtod(t->data, &end);\n        ok = *end == 0 && end != t->data;\n        if (ok) *out = v;\n    }\n    jig_str_release(t);\n    return ok;\n}\n\njig_list *jig_str_bytes(const jig_str *s) {\n    int64_t n = jig_str_len(s);\n    jig_list *l = jig_list_with_capacity(n, &jig_type_u8);\n    if (n) {\n        memcpy(l->data, jig_str_data(s), (size_t)n);\n        l->len = n;\n    }\n    return l;\n}\n\njig_list *jig_str_chars(const jig_str *s) {\n    jig_list *out = NULL;\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s);\n    for (int64_t i = 0; i < n;) {\n        uint32_t c = decode_utf8(d, &i, n);\n        jig_list_push(&out, &c, &jig_type_char);\n    }\n    return out;\n}\n\njig_str *jig_str_from_chars(const jig_list *cs) {\n    jig_buf b = {0};\n    for (int64_t i = 0; i < jig_list_len(cs); i++) encode_utf8(&b, ((uint32_t *)cs->data)[i]);\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_str_from_bytes(const jig_list *bs, bool *ok) {\n    int64_t n = jig_list_len(bs);\n    const unsigned char *d = n ? (const unsigned char *)bs->data : (const unsigned char *)\"\";\n    /* validate UTF-8 */\n    for (int64_t i = 0; i < n;) {\n        int k = utf8_len(d[i]);\n        if ((d[i] & 0xc0) == 0x80 || i + k > n) {\n            *ok = false;\n            return NULL;\n        }\n        for (int j = 1; j < k; j++)\n            if ((d[i + j] & 0xc0) != 0x80) {\n                *ok = false;\n                return NULL;\n            }\n        i += k;\n    }\n    *ok = true;\n    return jig_str_new((const char *)d, n);\n}\n\njig_str *jig_char_to_str(uint32_t c) {\n    jig_buf b = {0};\n    encode_utf8(&b, c);\n    return jig_buf_to_str(&b);\n}\n\n/* ---------- lists ---------- */\n\nvoid jig_list_retain(jig_list *l) {\n    if (l) jig_rc_inc(&l->rc);\n}\n\nvoid jig_list_release(jig_list *l, const jig_type *t) {\n    if (!l || !jig_rc_dec(&l->rc)) return;\n    if (t->release)\n        for (int64_t i = 0; i < l->len; i++) t->release(l->data + (size_t)i * t->size);\n    jig_free(l->data);\n    jig_free_obj(l, sizeof(jig_list));\n}\n\njig_list *jig_list_with_capacity(int64_t n, const jig_type *t) {\n    jig_list *l = jig_alloc_obj(sizeof(jig_list));\n    l->rc = 1;\n    l->len = 0;\n    l->cap = n;\n    l->data = n ? jig_alloc((size_t)n * t->size) : NULL;\n    return l;\n}\n\nvoid jig_list_make_unique(jig_list **lp, const jig_type *t) {\n    jig_list *l = *lp;\n    if (!l) {\n        *lp = jig_list_with_capacity(4, t);\n        return;\n    }\n    if (l->rc == 1) return;\n    jig_list *c = jig_list_with_capacity(l->len > 4 ? l->len : 4, t);\n    if (l->len) memcpy(c->data, l->data, (size_t)l->len * t->size);\n    c->len = l->len;\n    if (t->retain)\n        for (int64_t i = 0; i < c->len; i++) t->retain(c->data + (size_t)i * t->size);\n    jig_list_release(l, t);\n    *lp = c;\n}\n\nstatic void grow(jig_list *l, int64_t need, const jig_type *t) {\n    if (need <= l->cap) return;\n    int64_t cap = l->cap ? l->cap * 2 : 4;\n    while (cap < need) cap *= 2;\n    l->data = jig_realloc(l->data, (size_t)cap * t->size);\n    l->cap = cap;\n}\n\nvoid *jig_list_at(const jig_list *l, int64_t i, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(l);\n    if (i < 0 || i >= n) jig_index_oob(i, n, loc);\n    return l->data + (size_t)i * t->size;\n}\n\nvoid *jig_list_at_mut(jig_list **l, int64_t i, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(*l);\n    if (i < 0 || i >= n) jig_index_oob(i, n, loc);\n    jig_list_make_unique(l, t);\n    return (*l)->data + (size_t)i * t->size;\n}\n\nvoid jig_list_push(jig_list **lp, void *elem, const jig_type *t) {\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    grow(l, l->len + 1, t);\n    memcpy(l->data + (size_t)l->len * t->size, elem, t->size);\n    l->len++;\n}\n\nbool jig_list_pop(jig_list **lp, void *out, const jig_type *t) {\n    if (jig_list_len(*lp) == 0) return false;\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    l->len--;\n    memcpy(out, l->data + (size_t)l->len * t->size, t->size);\n    return true;\n}\n\nbool jig_list_get(const jig_list *l, int64_t i, void *out, const jig_type *t) {\n    if (i < 0 || i >= jig_list_len(l)) return false;\n    memcpy(out, l->data + (size_t)i * t->size, t->size);\n    if (t->retain) t->retain(out);\n    return true;\n}\n\nvoid jig_list_insert(jig_list **lp, int64_t i, void *elem, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(*lp);\n    if (i < 0 || i > n) {\n        char msg[128];\n        snprintf(msg, sizeof msg, \"insert index %lld is out of bounds for length %lld\", (long long)i, (long long)n);\n        jig_panic(msg, loc);\n    }\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    grow(l, n + 1, t);\n    memmove(l->data + (size_t)(i + 1) * t->size, l->data + (size_t)i * t->size, (size_t)(n - i) * t->size);\n    memcpy(l->data + (size_t)i * t->size, elem, t->size);\n    l->len++;\n}\n\nvoid jig_list_remove(jig_list **lp, int64_t i, void *out, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(*lp);\n    if (i < 0 || i >= n) {\n        char msg[128];\n        snprintf(msg, sizeof msg, \"remove index %lld is out of bounds for length %lld\", (long long)i, (long long)n);\n        jig_panic(msg, loc);\n    }\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    memcpy(out, l->data + (size_t)i * t->size, t->size);\n    memmove(l->data + (size_t)i * t->size, l->data + (size_t)(i + 1) * t->size, (size_t)(n - i - 1) * t->size);\n    l->len--;\n}\n\nvoid jig_list_clear(jig_list **lp, const jig_type *t) {\n    jig_list_release(*lp, t);\n    *lp = NULL;\n}\n\nvoid jig_list_extend(jig_list **lp, const jig_list *other, const jig_type *t) {\n    int64_t m = jig_list_len(other);\n    if (!m) return;\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    grow(l, l->len + m, t);\n    memcpy(l->data + (size_t)l->len * t->size, other->data, (size_t)m * t->size);\n    if (t->retain)\n        for (int64_t i = 0; i < m; i++) t->retain(l->data + (size_t)(l->len + i) * t->size);\n    l->len += m;\n}\n\njig_list *jig_list_repeat(const jig_list *l, int64_t n, const jig_type *t, const char *loc) {\n    if (n < 0) jig_panic(\"repeat count is negative\", loc);\n    int64_t m = jig_list_len(l);\n    if (!m || !n) return NULL;\n    if (m > INT64_MAX / n || (uint64_t)(m * n) > SIZE_MAX / t->size) jig_panic(\"the repeated list is too long\", loc);\n    size_t chunk = (size_t)m * t->size, all = (size_t)(m * n) * t->size;\n    bool zero = true;\n    for (size_t i = 0; i < chunk && zero; i++) zero = l->data[i] == 0;\n    jig_list *r = jig_alloc_obj(sizeof(jig_list));\n    r->rc = 1;\n    r->len = r->cap = m * n;\n    if (zero) {\n        /* All-zero elements (false, 0, empty values): fresh zeroed pages, no copying. */\n        r->data = jig_alloc_zeroed(all);\n        return r;\n    }\n    r->data = jig_alloc(all);\n    memcpy(r->data, l->data, chunk);\n    for (size_t done = chunk; done < all;) {\n        size_t c = done < all - done ? done : all - done;\n        memcpy(r->data + done, r->data, c);\n        done += c;\n    }\n    if (t->retain)\n        for (int64_t i = 0; i < r->len; i++) t->retain(r->data + (size_t)i * t->size);\n    return r;\n}\n\nvoid jig_list_reverse(jig_list **lp, const jig_type *t) {\n    if (jig_list_len(*lp) < 2) return;\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    char *tmp = jig_alloc(t->size);\n    for (int64_t i = 0, j = l->len - 1; i < j; i++, j--) {\n        memcpy(tmp, l->data + (size_t)i * t->size, t->size);\n        memcpy(l->data + (size_t)i * t->size, l->data + (size_t)j * t->size, t->size);\n        memcpy(l->data + (size_t)j * t->size, tmp, t->size);\n    }\n    jig_free(tmp);\n}\n\nvoid jig_list_swap(jig_list **lp, int64_t i, int64_t j, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(*lp);\n    if (i < 0 || j < 0 || i >= n || j >= n) {\n        char msg[128];\n        snprintf(msg, sizeof msg, \"swap(%lld, %lld) is out of bounds for length %lld\", (long long)i, (long long)j, (long long)n);\n        jig_panic(msg, loc);\n    }\n    if (i == j) return;\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    char small[64];\n    char *tmp = t->size <= sizeof small ? small : jig_alloc(t->size);\n    memcpy(tmp, l->data + (size_t)i * t->size, t->size);\n    memcpy(l->data + (size_t)i * t->size, l->data + (size_t)j * t->size, t->size);\n    memcpy(l->data + (size_t)j * t->size, tmp, t->size);\n    jig_free(tmp);\n}\n\nvoid jig_list_truncate(jig_list **lp, int64_t n, const jig_type *t, const char *loc) {\n    if (n < 0) jig_panic(\"truncate length is negative\", loc);\n    if (n >= jig_list_len(*lp)) return;\n    jig_list_make_unique(lp, t);\n    jig_list *l = *lp;\n    if (t->release)\n        for (int64_t i = n; i < l->len; i++) t->release(l->data + (size_t)i * t->size);\n    l->len = n;\n}\n\ntypedef struct sort_ctx {\n    const jig_type *t;\n    bool (*less)(jig_fn *, const void *, const void *);\n    jig_fn *f;\n} sort_ctx;\n\nstatic bool sort_less(const sort_ctx *c, const void *a, const void *b) {\n    if (c->less) return c->less(c->f, a, b);\n    return c->t->cmp(a, b) < 0;\n}\n\nstatic void merge_sort(char *xs, char *buf, int64_t n, const sort_ctx *c) {\n    size_t sz = c->t->size;\n    if (n < 2) return;\n    int64_t mid = n / 2;\n    merge_sort(xs, buf, mid, c);\n    merge_sort(xs + (size_t)mid * sz, buf, n - mid, c);\n    int64_t i = 0, j = mid, k = 0;\n    while (i < mid && j < n) {\n        if (sort_less(c, xs + (size_t)j * sz, xs + (size_t)i * sz)) {\n            memcpy(buf + (size_t)k * sz, xs + (size_t)j * sz, sz);\n            j++;\n        } else {\n            memcpy(buf + (size_t)k * sz, xs + (size_t)i * sz, sz);\n            i++;\n        }\n        k++;\n    }\n    while (i < mid) memcpy(buf + (size_t)(k++) * sz, xs + (size_t)(i++) * sz, sz);\n    while (j < n) memcpy(buf + (size_t)(k++) * sz, xs + (size_t)(j++) * sz, sz);\n    memcpy(xs, buf, (size_t)n * sz);\n}\n\nstatic void sort_impl(jig_list **lp, const sort_ctx *c) {\n    if (jig_list_len(*lp) < 2) return;\n    jig_list_make_unique(lp, c->t);\n    jig_list *l = *lp;\n    char *buf = jig_alloc((size_t)l->len * c->t->size);\n    merge_sort(l->data, buf, l->len, c);\n    jig_free(buf);\n}\n\nvoid jig_swap_oob(int64_t i, int64_t j, int64_t n, const char *loc) {\n    char msg[128];\n    snprintf(msg, sizeof msg, \"swap(%lld, %lld) is out of bounds for length %lld\", (long long)i, (long long)j, (long long)n);\n    jig_panic(msg, loc);\n}\n\n/* Sorting primitive keys: equal keys are indistinguishable, so stability doesn't matter.\n * Introsort with a branchless Lomuto partition (no mispredicted branches on random data),\n * median-of-3 (ninther for large ranges) pivots, a second pass that gathers keys equal to\n * a minimal pivot (so many duplicates stay linear), heapsort past the depth limit and\n * insertion sort for short ranges. Instantiated per scalar type. */\n#define JIG_SORT_IMPL(NAME, T)                                                                  \\\n    static void NAME##_sift(T *a, int64_t root, int64_t n) {                                    \\\n        for (;;) {                                                                              \\\n            int64_t c = 2 * root + 1;                                                           \\\n            if (c >= n) return;                                                                 \\\n            if (c + 1 < n && a[c] < a[c + 1]) c++;                                              \\\n            if (!(a[root] < a[c])) return;                                                      \\\n            T t = a[root]; a[root] = a[c]; a[c] = t;                                            \\\n            root = c;                                                                           \\\n        }                                                                                       \\\n    }                                                                                           \\\n    static inline int64_t NAME##_med3(T *a, int64_t i, int64_t j, int64_t k) {                  \\\n        return a[i] < a[j] ? (a[j] < a[k] ? j : (a[i] < a[k] ? k : i))                          \\\n                           : (a[i] < a[k] ? i : (a[j] < a[k] ? k : j));                         \\\n    }                                                                                           \\\n    static void NAME##_rec(T *a, int64_t n, int depth) {                                        \\\n        while (n > 24) {                                                                        \\\n            if (depth-- == 0) {                                                                 \\\n                for (int64_t i = n / 2 - 1; i >= 0; i--) NAME##_sift(a, i, n);                  \\\n                for (int64_t e = n - 1; e > 0; e--) {                                           \\\n                    T t = a[0]; a[0] = a[e]; a[e] = t;                                          \\\n                    NAME##_sift(a, 0, e);                                                       \\\n                }                                                                               \\\n                return;                                                                         \\\n            }                                                                                   \\\n            int64_t m = n / 2, pi;                                                              \\\n            if (n > 128) {                                                                      \\\n                int64_t s = n / 8;                                                              \\\n                pi = NAME##_med3(a, NAME##_med3(a, 0, s, 2 * s), NAME##_med3(a, m - s, m, m + s), \\\n                                 NAME##_med3(a, n - 1 - 2 * s, n - 1 - s, n - 1));               \\\n            } else {                                                                            \\\n                pi = NAME##_med3(a, 0, m, n - 1);                                               \\\n            }                                                                                   \\\n            { T t = a[0]; a[0] = a[pi]; a[pi] = t; }                                            \\\n            T p = a[0];                                                                         \\\n            int64_t lt = 1;                                                                     \\\n            for (int64_t i = 1; i < n; i++) {                                                   \\\n                T v = a[i];                                                                     \\\n                int less = v < p;                                                               \\\n                a[i] = a[lt];                                                                   \\\n                a[lt] = v;                                                                      \\\n                lt += less;                                                                     \\\n            }                                                                                   \\\n            lt--;                                                                               \\\n            { T t = a[0]; a[0] = a[lt]; a[lt] = t; }                                            \\\n            /* a[0..lt) < p == a[lt] <= a(lt..n) */                                             \\\n            int64_t lo = lt + 1;                                                                \\\n            if (lt == 0) {                                                                      \\\n                /* The pivot is the minimum: keys equal to it are done. */                      \\\n                for (int64_t i = 1; i < n; i++) {                                               \\\n                    T v = a[i];                                                                 \\\n                    int eq = !(p < v);                                                          \\\n                    a[i] = a[lo];                                                               \\\n                    a[lo] = v;                                                                  \\\n                    lo += eq;                                                                   \\\n                }                                                                               \\\n            }                                                                                   \\\n            /* Recurse into the smaller side, loop on the larger. */                           \\\n            if (lt < n - lo) {                                                                  \\\n                NAME##_rec(a, lt, depth);                                                       \\\n                a += lo;                                                                        \\\n                n -= lo;                                                                        \\\n            } else {                                                                            \\\n                NAME##_rec(a + lo, n - lo, depth);                                              \\\n                n = lt;                                                                         \\\n            }                                                                                   \\\n        }                                                                                       \\\n        for (int64_t i = 1; i < n; i++) {                                                       \\\n            T v = a[i];                                                                         \\\n            int64_t k = i;                                                                      \\\n            while (k > 0 && v < a[k - 1]) { a[k] = a[k - 1]; k--; }                             \\\n            a[k] = v;                                                                           \\\n        }                                                                                       \\\n    }                                                                                           \\\n    void NAME(jig_list **lp, const jig_type *t) {                                               \\\n        int64_t n = jig_list_len(*lp);                                                          \\\n        if (n < 2) return;                                                                      \\\n        jig_list_make_unique(lp, t);                                                            \\\n        int depth = 2;                                                                          \\\n        for (int64_t m = n; m > 1; m >>= 1) depth += 2;                                         \\\n        NAME##_rec((T *)(*lp)->data, n, depth);                                                 \\\n    }\nJIG_SORT_IMPL(jig_list_sort_i64, int64_t)\nJIG_SORT_IMPL(jig_list_sort_i32, int32_t)\nJIG_SORT_IMPL(jig_list_sort_u8, uint8_t)\nJIG_SORT_IMPL(jig_list_sort_u32, uint32_t)\nJIG_SORT_IMPL(jig_list_sort_u64, uint64_t)\n\nvoid jig_list_sort(jig_list **lp, const jig_type *t) {\n    sort_ctx c = {t, NULL, NULL};\n    sort_impl(lp, &c);\n}\n\nvoid jig_list_sort_by(jig_list **lp, const jig_type *t, bool (*less)(jig_fn *, const void *, const void *), jig_fn *f) {\n    sort_ctx c = {t, less, f};\n    sort_impl(lp, &c);\n}\n\njig_list *jig_list_slice(const jig_list *l, int64_t lo, int64_t hi, const jig_type *t, const char *loc) {\n    int64_t n = jig_list_len(l);\n    if (lo < 0 || hi < lo || hi > n) {\n        char msg[160];\n        snprintf(msg, sizeof msg, \"slice %lld..%lld is out of bounds for a list of length %lld\", (long long)lo, (long long)hi, (long long)n);\n        jig_panic(msg, loc);\n    }\n    if (hi == lo) return NULL;\n    jig_list *r = jig_list_with_capacity(hi - lo, t);\n    memcpy(r->data, l->data + (size_t)lo * t->size, (size_t)(hi - lo) * t->size);\n    r->len = hi - lo;\n    if (t->retain)\n        for (int64_t i = 0; i < r->len; i++) t->retain(r->data + (size_t)i * t->size);\n    return r;\n}\n\nbool jig_list_eq(const jig_list *a, const jig_list *b, const jig_type *t) {\n    int64_t n = jig_list_len(a);\n    if (n != jig_list_len(b)) return false;\n    if (a == b) return true;\n    for (int64_t i = 0; i < n; i++)\n        if (!t->eq(a->data + (size_t)i * t->size, b->data + (size_t)i * t->size)) return false;\n    return true;\n}\n\nint jig_list_cmp(const jig_list *a, const jig_list *b, const jig_type *t) {\n    int64_t na = jig_list_len(a), nb = jig_list_len(b);\n    for (int64_t i = 0; i < na && i < nb; i++) {\n        int c = t->cmp(a->data + (size_t)i * t->size, b->data + (size_t)i * t->size);\n        if (c) return c;\n    }\n    return na < nb ? -1 : na > nb ? 1 : 0;\n}\n\nuint64_t jig_list_hash(const jig_list *a, const jig_type *t) {\n    uint64_t h = jig_hash_u64((uint64_t)jig_list_len(a));\n    for (int64_t i = 0; i < jig_list_len(a); i++) h = jig_hash_combine(h, t->hash(a->data + (size_t)i * t->size));\n    return h;\n}\n\nvoid jig_list_show(jig_buf *b, const jig_list *l, const jig_type *t) {\n    jig_buf_push(b, \"[\", 1);\n    for (int64_t i = 0; i < jig_list_len(l); i++) {\n        if (i) jig_buf_push(b, \", \", 2);\n        t->show(b, l->data + (size_t)i * t->size, true);\n    }\n    jig_buf_push(b, \"]\", 1);\n}\n\n/* ---------- maps ---------- */\n\nstatic void map_rebuild_index(jig_map *m, const jig_type *k) {\n    int64_t cap = 8;\n    while (cap < m->len * 2 + 2) cap *= 2;\n    jig_free(m->index);\n    m->index = jig_alloc((size_t)cap * sizeof(int32_t));\n    for (int64_t i = 0; i < cap; i++) m->index[i] = -1;\n    m->index_cap = cap;\n    for (int64_t i = 0; i < m->len; i++) {\n        uint64_t h = k->hash(m->keys + (size_t)i * k->size);\n        int64_t slot = (int64_t)(h & (uint64_t)(cap - 1));\n        while (m->index[slot] >= 0) slot = (slot + 1) & (cap - 1);\n        m->index[slot] = (int32_t)i;\n    }\n}\n\nstatic int64_t map_find(const jig_map *m, const void *key, const jig_type *k) {\n    if (!m || !m->len) return -1;\n    uint64_t h = k->hash(key);\n    int64_t mask = m->index_cap - 1;\n    for (int64_t slot = (int64_t)(h & (uint64_t)mask);; slot = (slot + 1) & mask) {\n        int32_t idx = m->index[slot];\n        if (idx < 0) return -1;\n        if (k->eq(m->keys + (size_t)idx * k->size, key)) return idx;\n    }\n}\n\nvoid jig_map_retain(jig_map *m) {\n    if (m) jig_rc_inc(&m->rc);\n}\n\nvoid jig_map_release(jig_map *m, const jig_type *k, const jig_type *v) {\n    if (!m || !jig_rc_dec(&m->rc)) return;\n    for (int64_t i = 0; i < m->len; i++) {\n        if (k->release) k->release(m->keys + (size_t)i * k->size);\n        if (v->release) v->release(m->vals + (size_t)i * v->size);\n    }\n    jig_free(m->keys);\n    jig_free(m->vals);\n    jig_free(m->index);\n    jig_free_obj(m, sizeof(jig_map));\n}\n\nstatic void map_copy(jig_map **mp, const jig_type *k, const jig_type *v) __attribute__((noinline));\n\nstatic inline void map_make_unique(jig_map **mp, const jig_type *k, const jig_type *v) {\n    if (__builtin_expect(!*mp || (*mp)->rc != 1, 0)) map_copy(mp, k, v);\n}\n\nstatic void map_copy(jig_map **mp, const jig_type *k, const jig_type *v) {\n    jig_map *m = *mp;\n    jig_map *c = jig_alloc_obj(sizeof(jig_map));\n    c->rc = 1;\n    c->len = m ? m->len : 0;\n    c->cap = c->len > 4 ? c->len : 4;\n    c->keys = jig_alloc((size_t)c->cap * k->size);\n    c->vals = jig_alloc((size_t)c->cap * v->size);\n    c->index = NULL;\n    if (m && m->len) {\n        memcpy(c->keys, m->keys, (size_t)m->len * k->size);\n        memcpy(c->vals, m->vals, (size_t)m->len * v->size);\n        for (int64_t i = 0; i < c->len; i++) {\n            if (k->retain) k->retain(c->keys + (size_t)i * k->size);\n            if (v->retain) v->retain(c->vals + (size_t)i * v->size);\n        }\n    }\n    map_rebuild_index(c, k);\n    if (m) jig_map_release(m, k, v);\n    *mp = c;\n}\n\nvoid jig_map_insert(jig_map **mp, void *key, void *val, const jig_type *k, const jig_type *v) {\n    map_make_unique(mp, k, v);\n    jig_map *m = *mp;\n    int64_t idx = map_find(m, key, k);\n    if (idx >= 0) {\n        if (v->release) v->release(m->vals + (size_t)idx * v->size);\n        memcpy(m->vals + (size_t)idx * v->size, val, v->size);\n        if (k->release) k->release(key);\n        return;\n    }\n    if (m->len == m->cap) {\n        m->cap *= 2;\n        m->keys = jig_realloc(m->keys, (size_t)m->cap * k->size);\n        m->vals = jig_realloc(m->vals, (size_t)m->cap * v->size);\n    }\n    memcpy(m->keys + (size_t)m->len * k->size, key, k->size);\n    memcpy(m->vals + (size_t)m->len * v->size, val, v->size);\n    m->len++;\n    if (m->len * 2 + 2 > m->index_cap) {\n        map_rebuild_index(m, k);\n    } else {\n        uint64_t h = k->hash(key);\n        int64_t mask = m->index_cap - 1;\n        int64_t slot = (int64_t)(h & (uint64_t)mask);\n        while (m->index[slot] >= 0) slot = (slot + 1) & mask;\n        m->index[slot] = (int32_t)(m->len - 1);\n    }\n}\n\nbool jig_map_get(const jig_map *m, const void *key, void *out, const jig_type *k, const jig_type *v) {\n    int64_t idx = map_find(m, key, k);\n    if (idx < 0) return false;\n    memcpy(out, m->vals + (size_t)idx * v->size, v->size);\n    if (v->retain) v->retain(out);\n    return true;\n}\n\nbool jig_map_contains(const jig_map *m, const void *key, const jig_type *k) { return map_find(m, key, k) >= 0; }\n\nbool jig_map_remove(jig_map **mp, const void *key, void *out, const jig_type *k, const jig_type *v) {\n    if (map_find(*mp, key, k) < 0) return false;\n    map_make_unique(mp, k, v);\n    jig_map *m = *mp;\n    int64_t idx = map_find(m, key, k);\n    if (k->release) k->release(m->keys + (size_t)idx * k->size);\n    if (out) {\n        memcpy(out, m->vals + (size_t)idx * v->size, v->size);\n    } else if (v->release) {\n        v->release(m->vals + (size_t)idx * v->size);\n    }\n    int64_t rest = m->len - idx - 1;\n    memmove(m->keys + (size_t)idx * k->size, m->keys + (size_t)(idx + 1) * k->size, (size_t)rest * k->size);\n    memmove(m->vals + (size_t)idx * v->size, m->vals + (size_t)(idx + 1) * v->size, (size_t)rest * v->size);\n    m->len--;\n    map_rebuild_index(m, k);\n    return true;\n}\n\nstatic jig_list *copy_array(const char *data, int64_t n, const jig_type *t) {\n    if (!n) return NULL;\n    jig_list *l = jig_list_with_capacity(n, t);\n    memcpy(l->data, data, (size_t)n * t->size);\n    l->len = n;\n    if (t->retain)\n        for (int64_t i = 0; i < n; i++) t->retain(l->data + (size_t)i * t->size);\n    return l;\n}\n\njig_list *jig_map_keys(const jig_map *m, const jig_type *k) { return m ? copy_array(m->keys, m->len, k) : NULL; }\njig_list *jig_map_values(const jig_map *m, const jig_type *v) { return m ? copy_array(m->vals, m->len, v) : NULL; }\nvoid *jig_map_key_at(const jig_map *m, int64_t i, const jig_type *k) { return m->keys + (size_t)i * k->size; }\nvoid *jig_map_val_at(const jig_map *m, int64_t i, const jig_type *v) { return m->vals + (size_t)i * v->size; }\n\nbool jig_map_eq(const jig_map *a, const jig_map *b, const jig_type *k, const jig_type *v) {\n    if (jig_map_len(a) != jig_map_len(b)) return false;\n    for (int64_t i = 0; i < jig_map_len(a); i++) {\n        int64_t j = map_find(b, a->keys + (size_t)i * k->size, k);\n        if (j < 0 || !v->eq(a->vals + (size_t)i * v->size, b->vals + (size_t)j * v->size)) return false;\n    }\n    return true;\n}\n\nvoid jig_map_show(jig_buf *b, const jig_map *m, const jig_type *k, const jig_type *v, bool is_set) {\n    jig_buf_push(b, \"{\", 1);\n    for (int64_t i = 0; i < jig_map_len(m); i++) {\n        if (i) jig_buf_push(b, \", \", 2);\n        k->show(b, m->keys + (size_t)i * k->size, true);\n        if (!is_set) {\n            jig_buf_push(b, \": \", 2);\n            v->show(b, m->vals + (size_t)i * v->size, true);\n        }\n    }\n    jig_buf_push(b, \"}\", 1);\n}\n\n/* ---------- checked arithmetic ---------- */\n\nvoid jig_overflow(const char *op, const char *loc) {\n    char msg[256];\n    snprintf(msg, sizeof msg, \"arithmetic overflow: %s\", op);\n    jig_panic(msg, loc);\n}\n\nvoid jig_div_zero(const char *loc) { jig_panic(\"division by zero\", loc); }\n\nvoid jig_shift_range(int64_t amount, const char *loc) {\n    char msg[128];\n    snprintf(msg, sizeof msg, \"shift amount %lld is out of range\", (long long)amount);\n    jig_panic(msg, loc);\n}\n\nvoid jig_cast_range_i(int64_t v, const char *ty, const char *loc) {\n    char msg[128];\n    snprintf(msg, sizeof msg, \"cannot convert %lld to `%s`: out of range\", (long long)v, ty);\n    jig_panic(msg, loc);\n}\n\nvoid jig_cast_range_u(uint64_t v, const char *ty, const char *loc) {\n    char msg[128];\n    snprintf(msg, sizeof msg, \"cannot convert %llu to `%s`: out of range\", (unsigned long long)v, ty);\n    jig_panic(msg, loc);\n}\n\nvoid jig_cast_range_f(double v, const char *ty, const char *loc) {\n    jig_buf b = {0};\n    jig_buf_push_cstr(&b, \"cannot convert \");\n    jig_show_f64(&b, v);\n    jig_buf_push_cstr(&b, \" to `\");\n    jig_buf_push_cstr(&b, ty);\n    jig_buf_push_cstr(&b, \"`: out of range\");\n    jig_panic_buf(&b, loc);\n}\n\nvoid jig_index_oob(int64_t i, int64_t len, const char *loc) {\n    char msg[128];\n    snprintf(msg, sizeof msg, \"index out of bounds: the index is %lld but the length is %lld\", (long long)i, (long long)len);\n    jig_panic(msg, loc);\n}\n\nint64_t jig_ipow(int64_t base, int64_t exp, const char *loc) {\n    if (exp < 0) jig_panic(\"negative exponent\", loc);\n    int64_t r = 1;\n    for (int64_t i = 0; i < exp; i++)\n        if (__builtin_mul_overflow(r, base, &r)) jig_overflow(\"pow\", loc);\n    return r;\n}\n\n/* ---------- formatting ---------- */\n\n/* Decimal digits of `v`, written backwards so they end at `end`; returns their count. */\nstatic int jig_digits(char *end, uint64_t v) {\n    static const char pairs[201] =\n        \"00010203040506070809101112131415161718192021222324252627282930313233343536373839\"\n        \"40414243444546474849505152535455565758596061626364656667686970717273747576777879\"\n        \"8081828384858687888990919293949596979899\";\n    char *p = end;\n    while (v >= 100) {\n        unsigned r = (unsigned)(v % 100);\n        v /= 100;\n        p -= 2;\n        memcpy(p, pairs + 2 * r, 2);\n    }\n    if (v >= 10) {\n        p -= 2;\n        memcpy(p, pairs + 2 * v, 2);\n    } else {\n        *--p = (char)('0' + v);\n    }\n    return (int)(end - p);\n}\n\n/* `v` in decimal, ending at `end` (at least 20 bytes after the start); returns its length. */\nstatic int jig_fmt_i64(char *end, int64_t v) {\n    uint64_t u = v < 0 ? (uint64_t)0 - (uint64_t)v : (uint64_t)v;\n    int n = jig_digits(end, u);\n    if (v < 0) end[-++n] = '-';\n    return n;\n}\n\nvoid jig_show_i64(jig_buf *b, int64_t v) {\n    char tmp[24];\n    int n = jig_fmt_i64(tmp + sizeof tmp, v);\n    jig_buf_push(b, tmp + sizeof tmp - n, n);\n}\n\nvoid jig_show_u64(jig_buf *b, uint64_t v) {\n    char tmp[24];\n    int n = jig_digits(tmp + sizeof tmp, v);\n    jig_buf_push(b, tmp + sizeof tmp - n, n);\n}\n\njig_str *jig_i64_str(int64_t v) {\n    char tmp[24];\n    int n = jig_fmt_i64(tmp + sizeof tmp, v);\n    return jig_str_new(tmp + sizeof tmp - n, n);\n}\n\njig_str *jig_u64_str(uint64_t v) {\n    char tmp[24];\n    int n = jig_digits(tmp + sizeof tmp, v);\n    return jig_str_new(tmp + sizeof tmp - n, n);\n}\n\n/* Shortest round-trip formatting, matching Rust's `{:?}` for f64. */\nvoid jig_show_f64(jig_buf *b, double v) {\n    if (isnan(v)) {\n        jig_buf_push_cstr(b, \"NaN\");\n        return;\n    }\n    if (isinf(v)) {\n        jig_buf_push_cstr(b, v > 0 ? \"inf\" : \"-inf\");\n        return;\n    }\n    char tmp[64];\n    int p;\n    for (p = 1; p <= 17; p++) {\n        snprintf(tmp, sizeof tmp, \"%.*e\", p - 1, v);\n        if (strtod(tmp, NULL) == v) break;\n    }\n    /* tmp: [-]d[.ddd]e[+-]XX */\n    const char *s = tmp;\n    bool neg = *s == '-';\n    if (neg) s++;\n    char digits[32];\n    int nd = 0;\n    while (*s && *s != 'e') {\n        if (*s != '.') digits[nd++] = *s;\n        s++;\n    }\n    int exp = atoi(s + 1);\n    while (nd > 1 && digits[nd - 1] == '0') nd--;\n    double a = fabs(v);\n    if (neg) jig_buf_push(b, \"-\", 1);\n    if (a == 0 || (a >= 1e-4 && a < 1e16)) {\n        if (exp >= 0) {\n            for (int i = 0; i <= exp; i++) jig_buf_push(b, i < nd ? &digits[i] : \"0\", 1);\n            jig_buf_push(b, \".\", 1);\n            if (exp + 1 < nd)\n                jig_buf_push(b, digits + exp + 1, nd - exp - 1);\n            else\n                jig_buf_push(b, \"0\", 1);\n        } else {\n            jig_buf_push(b, \"0.\", 2);\n            for (int i = 0; i < -exp - 1; i++) jig_buf_push(b, \"0\", 1);\n            jig_buf_push(b, digits, nd);\n        }\n    } else {\n        jig_buf_push(b, digits, 1);\n        if (nd > 1) {\n            jig_buf_push(b, \".\", 1);\n            jig_buf_push(b, digits + 1, nd - 1);\n        }\n        char e[16];\n        int n = snprintf(e, sizeof e, \"e%d\", exp);\n        jig_buf_push(b, e, n);\n    }\n}\n\nvoid jig_show_bool(jig_buf *b, bool v) { jig_buf_push_cstr(b, v ? \"true\" : \"false\"); }\n\nstatic void escape_char(jig_buf *b, uint32_t c, char quote) {\n    switch (c) {\n    case '\\t': jig_buf_push(b, \"\\\\t\", 2); return;\n    case '\\r': jig_buf_push(b, \"\\\\r\", 2); return;\n    case '\\n': jig_buf_push(b, \"\\\\n\", 2); return;\n    case '\\\\': jig_buf_push(b, \"\\\\\\\\\", 2); return;\n    case 0: jig_buf_push(b, \"\\\\0\", 2); return;\n    default: break;\n    }\n    if (c == (uint32_t)quote) {\n        jig_buf_push(b, \"\\\\\", 1);\n        jig_buf_push(b, &quote, 1);\n        return;\n    }\n    if (c < 0x20 || c == 0x7f) {\n        char tmp[16];\n        int n = snprintf(tmp, sizeof tmp, \"\\\\u{%x}\", c);\n        jig_buf_push(b, tmp, n);\n        return;\n    }\n    encode_utf8(b, c);\n}\n\nvoid jig_show_char(jig_buf *b, uint32_t c, bool nested) {\n    if (!nested) {\n        encode_utf8(b, c);\n        return;\n    }\n    jig_buf_push(b, \"'\", 1);\n    escape_char(b, c, '\\'');\n    jig_buf_push(b, \"'\", 1);\n}\n\nvoid jig_show_str(jig_buf *b, const jig_str *s, bool nested) {\n    if (!nested) {\n        jig_buf_push_str(b, s);\n        return;\n    }\n    jig_buf_push(b, \"\\\"\", 1);\n    const char *d = jig_str_data(s);\n    int64_t n = jig_str_len(s);\n    for (int64_t i = 0; i < n;) escape_char(b, decode_utf8(d, &i, n), '\"');\n    jig_buf_push(b, \"\\\"\", 1);\n}\n\n/* ---------- characters (ASCII fast paths; others via towupper-like ranges) ---------- */\n\nbool jig_char_is_digit(uint32_t c) { return c >= '0' && c <= '9'; }\nbool jig_char_is_upper(uint32_t c) { return (c >= 'A' && c <= 'Z') || (c >= 0xC0 && c <= 0xDE && c != 0xD7); }\nbool jig_char_is_lower(uint32_t c) { return (c >= 'a' && c <= 'z') || (c >= 0xDF && c <= 0xFF && c != 0xF7); }\nbool jig_char_is_alpha(uint32_t c) { return jig_char_is_upper(c) || jig_char_is_lower(c) || (c > 0xFF && c != 0x3000); }\nbool jig_char_is_alnum(uint32_t c) { return jig_char_is_alpha(c) || jig_char_is_digit(c); }\nbool jig_char_is_space(uint32_t c) { return c == ' ' || (c >= 9 && c <= 13) || c == 0x85 || c == 0xA0 || c == 0x3000; }\nuint32_t jig_char_to_upper(uint32_t c) {\n    if ((c >= 'a' && c <= 'z') || (c >= 0xE0 && c <= 0xFE && c != 0xF7)) return c - 32;\n    return c;\n}\nuint32_t jig_char_to_lower(uint32_t c) {\n    if ((c >= 'A' && c <= 'Z') || (c >= 0xC0 && c <= 0xDE && c != 0xD7)) return c + 32;\n    return c;\n}\nvoid jig_char_invalid(int64_t v, const char *loc) {\n    char msg[96];\n    snprintf(msg, sizeof msg, \"%lld is not a valid `Char`\", (long long)v);\n    jig_panic(msg, loc);\n}\n\n/* ---------- effects ---------- */\n\nvoid jig_print(const jig_str *s, bool newline, bool err) {\n    SHARED_LOCK();\n    if (err) {\n        flush_out();\n        fwrite(jig_str_data(s), 1, (size_t)jig_str_len(s), stderr);\n        if (newline) fputc('\\n', stderr);\n        SHARED_UNLOCK();\n        return;\n    }\n    const char *d = jig_str_data(s);\n    size_t n = (size_t)jig_str_len(s);\n    if (g_out_len + n + 1 > sizeof g_out) flush_out();\n    if (n + 1 > sizeof g_out) {\n        fwrite(d, 1, n, stdout);\n    } else {\n        memcpy(g_out + g_out_len, d, n);\n        g_out_len += n;\n    }\n    if (newline) g_out[g_out_len++] = '\\n';\n    SHARED_UNLOCK();\n}\n\njig_str *jig_read_line(bool *ok) {\n    flush_out();\n    char *line = NULL;\n    size_t cap = 0;\n    ssize_t n = read_line(&line, &cap, stdin);\n    if (n < 0) {\n        free(line);\n        *ok = false;\n        return NULL;\n    }\n    while (n > 0 && (line[n - 1] == '\\n' || line[n - 1] == '\\r')) n--;\n    jig_str *s = jig_str_new(line, n);\n    free(line);\n    *ok = true;\n    return s;\n}\n\njig_str *jig_read_all(void) {\n    flush_out();\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    size_t n;\n    while ((n = fread(tmp, 1, sizeof tmp, stdin)) > 0) jig_buf_push(&b, tmp, (int64_t)n);\n    return jig_buf_to_str(&b);\n}\n\n/* `io.read(n)`: up to `n` bytes of standard input, fewer only at its end. */\njig_str *jig_read_n(int64_t n, const char *loc) {\n    if (n < 0) jig_panic(\"precondition failed: n >= 0\", loc);\n    flush_out();\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    while (n > 0) {\n        size_t k = fread(tmp, 1, n < (int64_t)sizeof tmp ? (size_t)n : sizeof tmp, stdin);\n        if (!k) break;\n        jig_buf_push(&b, tmp, (int64_t)k);\n        n -= (int64_t)k;\n    }\n    return jig_buf_to_str(&b);\n}\n\nstatic char *cpath(const jig_str *p) {\n    char *s = jig_alloc((size_t)jig_str_len(p) + 1);\n    memcpy(s, jig_str_data(p), (size_t)jig_str_len(p));\n    s[jig_str_len(p)] = 0;\n    return s;\n}\n\nstatic jig_str *err_str(const jig_str *path) {\n    jig_buf b = {0};\n    jig_buf_push_str(&b, path);\n    jig_buf_push_cstr(&b, \": \");\n    jig_buf_push_cstr(&b, strerror(errno));\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_fs_read(const jig_str *path, bool *ok) {\n    char *p = cpath(path);\n    FILE *f = fopen(p, \"rb\");\n    jig_free(p);\n    if (!f) {\n        *ok = false;\n        return err_str(path);\n    }\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    size_t n;\n    while ((n = fread(tmp, 1, sizeof tmp, f)) > 0) jig_buf_push(&b, tmp, (int64_t)n);\n    if (ferror(f)) {\n        /* A directory opens, then fails to read. */\n        int e = errno;\n        fclose(f);\n        jig_buf_free(&b);\n        errno = e;\n        *ok = false;\n        return err_str(path);\n    }\n    fclose(f);\n    *ok = true;\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_fs_write(const jig_str *path, const jig_str *contents, bool *ok) {\n    char *p = cpath(path);\n    FILE *f = fopen(p, \"wb\");\n    jig_free(p);\n    if (!f) {\n        *ok = false;\n        return err_str(path);\n    }\n    fwrite(jig_str_data(contents), 1, (size_t)jig_str_len(contents), f);\n    fclose(f);\n    *ok = true;\n    return NULL;\n}\n\nbool jig_fs_exists(const jig_str *path) {\n    char *p = cpath(path);\n    struct stat st;\n    bool r = stat(p, &st) == 0;\n    jig_free(p);\n    return r;\n}\n\nstatic int cmp_strp(const void *a, const void *b) { return jig_str_cmp(*(jig_str *const *)a, *(jig_str *const *)b); }\n\njig_list *jig_fs_list(const jig_str *dir, bool *ok, jig_str **err) {\n    char *p = cpath(dir);\n    DIR *d = opendir(p);\n    jig_free(p);\n    if (!d) {\n        *ok = false;\n        *err = err_str(dir);\n        return NULL;\n    }\n    jig_list *out = NULL;\n    struct dirent *e;\n    while ((e = readdir(d))) {\n        if (!strcmp(e->d_name, \".\") || !strcmp(e->d_name, \"..\")) continue;\n        push_str_elem(&out, e->d_name, (int64_t)strlen(e->d_name));\n    }\n    closedir(d);\n    if (out) qsort(out->data, (size_t)out->len, sizeof(jig_str *), cmp_strp);\n    *ok = true;\n    return out;\n}\n\njig_list *jig_args(void) {\n    jig_list *out = NULL;\n    for (int i = 0; i < g_argc; i++) push_str_elem(&out, g_argv[i], (int64_t)strlen(g_argv[i]));\n    return out;\n}\n\njig_str *jig_env_var(const jig_str *name, bool *ok) {\n    char *p = cpath(name);\n    const char *v = getenv(p);\n    jig_free(p);\n    *ok = v != NULL;\n    return v ? jig_str_new(v, (int64_t)strlen(v)) : NULL;\n}\n\nint64_t jig_now_ms(void) {\n#ifdef _WIN32\n    /* The precise clock: the C library's moves in steps of about 16 ms. It counts 100 ns\n       intervals since 1601. */\n    FILETIME ft;\n    GetSystemTimePreciseAsFileTime(&ft);\n    uint64_t t = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;\n    return (int64_t)(t / 10000) - INT64_C(11644473600000);\n#else\n    struct timespec ts;\n    clock_gettime(CLOCK_REALTIME, &ts);\n    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;\n#endif\n}\n\nvoid jig_sleep_ms(int64_t ms, const char *loc) {\n    if (ms < 0) jig_panic(\"precondition failed: ms >= 0\", loc);\n    struct timespec ts = {ms / 1000, (ms % 1000) * 1000000};\n    while (nanosleep(&ts, &ts) != 0 && errno == EINTR) {\n    }\n}\n\n/* ---------- net ---------- */\n\nstatic jig_str *net_err(const jig_str *addr, const char *what) {\n    jig_buf b = {0};\n    jig_buf_push_str(&b, addr);\n    jig_buf_push_cstr(&b, \": \");\n    jig_buf_push_cstr(&b, what);\n    return jig_buf_to_str(&b);\n}\n\n/* How long a client or a server's connection waits to read or write, in seconds. */\n#define NET_TIMEOUT 30\n\n/* \"host:port\" (\":port\" is this machine) resolved for connecting or listening. */\nstatic struct addrinfo *net_resolve(const jig_str *addr, bool listen, const char **err) {\n    int64_t n = jig_str_len(addr), colon = -1;\n    const char *d = jig_str_data(addr);\n    for (int64_t i = 0; i < n; i++)\n        if (d[i] == ':') colon = i;\n    if (colon < 0 || colon == n - 1) {\n        *err = \"expected host:port\";\n        return NULL;\n    }\n    char host[256], port[32];\n    if (colon >= (int64_t)sizeof host || n - colon - 1 >= (int64_t)sizeof port) {\n        *err = \"address too long\";\n        return NULL;\n    }\n    memcpy(host, d, (size_t)colon);\n    host[colon] = 0;\n    memcpy(port, d + colon + 1, (size_t)(n - colon - 1));\n    port[n - colon - 1] = 0;\n    struct addrinfo hints = {0}, *res = NULL;\n    hints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n    if (listen) hints.ai_flags = AI_PASSIVE;\n    const char *h = colon ? host : (listen ? NULL : \"127.0.0.1\");\n    int rc = getaddrinfo(h, port, &hints, &res);\n    if (rc != 0) {\n        *err = gai_strerror(rc);\n        return NULL;\n    }\n    return res;\n}\n\n#if !defined(MSG_NOSIGNAL)\n/* Without MSG_NOSIGNAL (macOS), writing to a peer that has gone must fail, not end the\n   program with SIGPIPE: ignore the signal instead. */\n#include <signal.h>\n#define MSG_NOSIGNAL 0\n#define JIG_NO_SIGPIPE() signal(SIGPIPE, SIG_IGN)\n#else\n/* Linux, and Windows, which has no SIGPIPE. */\n#define JIG_NO_SIGPIPE() ((void)0)\n#endif\n\nstatic bool net_send_all(jig_sock fd, const char *p, size_t n) {\n    JIG_NO_SIGPIPE();\n    while (n) {\n        ssize_t k = send(fd, p, n > (1u << 30) ? (1u << 30) : (int)n, MSG_NOSIGNAL);\n        if (k < 0 && sock_interrupted()) continue;\n        if (k <= 0) return false;\n        p += k;\n        n -= (size_t)k;\n    }\n    return true;\n}\n\nstatic jig_str *net_read_all(jig_sock fd) {\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    for (;;) {\n        ssize_t k = recv(fd, tmp, sizeof tmp, 0);\n        if (k < 0 && sock_interrupted()) continue;\n        if (k <= 0) break;\n        jig_buf_push(&b, tmp, (int64_t)k);\n    }\n    return jig_buf_to_str(&b);\n}\n\njig_str *jig_net_request(const jig_str *addr, const jig_str *req, bool *ok) {\n    const char *err = NULL;\n    struct addrinfo *res = net_resolve(addr, false, &err);\n    *ok = false;\n    if (!res) return net_err(addr, err);\n    jig_sock fd = BAD_SOCK;\n    for (struct addrinfo *ai = res; ai; ai = ai->ai_next) {\n        fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);\n        if (fd == BAD_SOCK) continue;\n        if (connect(fd, ai->ai_addr, ai->ai_addrlen) == 0) break;\n        sock_close(fd);\n        fd = BAD_SOCK;\n    }\n    freeaddrinfo(res);\n    if (fd == BAD_SOCK) return net_err(addr, sock_error());\n    if (!net_send_all(fd, jig_str_data(req), (size_t)jig_str_len(req))) {\n        jig_str *e = net_err(addr, sock_error());\n        sock_close(fd);\n        return e;\n    }\n    shutdown(fd, SHUT_WR);\n    jig_str *reply = net_read_all(fd);\n    sock_close(fd);\n    *ok = true;\n    return reply;\n}\n\n/* HTTP framing (`net.serve_http`): how much of what a connection sent so far is its request.\n   A request ends after the blank line that ends its headers and the `Content-Length` bytes of\n   body they announce. Returns the request's length, -1 while it is incomplete, or the status\n   it is refused with: 411 for any `Transfer-Encoding` (a chunked body), 400 for a\n   `Content-Length` that is not a number. The same rules are in both interpreters. */\nstatic bool http_name_is(const char *p, size_t n, const char *name) {\n    size_t k = strlen(name);\n    if (n != k) return false;\n    for (size_t i = 0; i < k; i++) {\n        char c = p[i];\n        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');\n        if (c != name[i]) return false;\n    }\n    return true;\n}\n\nstatic int64_t http_frame(const char *s, size_t n, int *refuse) {\n    *refuse = 0;\n    size_t end = 0;\n    for (size_t i = 0; i + 4 <= n; i++) {\n        if (s[i] == '\\r' && s[i + 1] == '\\n' && s[i + 2] == '\\r' && s[i + 3] == '\\n') {\n            end = i + 4;\n            break;\n        }\n    }\n    if (!end) return -1;\n    uint64_t body = 0;\n    /* Header lines: after the request line, up to the blank line. */\n    size_t i = 0;\n    while (i < end && s[i] != '\\n') i++;\n    i++;\n    while (i + 2 < end) {\n        size_t lo = i;\n        while (i < end && s[i] != '\\n') i++;\n        size_t hi = i > lo && s[i - 1] == '\\r' ? i - 1 : i;\n        i++;\n        size_t colon = lo;\n        while (colon < hi && s[colon] != ':') colon++;\n        if (colon == hi) continue;\n        size_t ns = lo, ne = colon;\n        while (ns < ne && (s[ns] == ' ' || s[ns] == '\\t')) ns++;\n        while (ne > ns && (s[ne - 1] == ' ' || s[ne - 1] == '\\t')) ne--;\n        size_t v = colon + 1, ve = hi;\n        while (v < ve && (s[v] == ' ' || s[v] == '\\t')) v++;\n        while (ve > v && (s[ve - 1] == ' ' || s[ve - 1] == '\\t')) ve--;\n        if (http_name_is(s + ns, ne - ns, \"transfer-encoding\")) {\n            *refuse = 411;\n            return 0;\n        }\n        if (http_name_is(s + ns, ne - ns, \"content-length\")) {\n            if (v == ve || ve - v > 18) {\n                *refuse = 400;\n                return 0;\n            }\n            body = 0;\n            for (size_t k = v; k < ve; k++) {\n                if (s[k] < '0' || s[k] > '9') {\n                    *refuse = 400;\n                    return 0;\n                }\n                body = body * 10 + (uint64_t)(s[k] - '0');\n            }\n        }\n    }\n    if ((uint64_t)(n - end) < body) return -1;\n    return (int64_t)(end + body);\n}\n\nstatic const char *http_refusal(int status) {\n    return status == 411 ? \"HTTP/1.1 411 Length Required\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\"\n                         : \"HTTP/1.1 400 Bad Request\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\";\n}\n\n/* A connection's HTTP request: read until it is complete, refused or the client stops. */\nstatic jig_str *net_read_http(jig_sock fd, int *refuse) {\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    *refuse = 0;\n    for (;;) {\n        int64_t n = http_frame(b.data, (size_t)b.len, refuse);\n        if (*refuse) break;\n        if (n >= 0) {\n            b.len = n;\n            break;\n        }\n        ssize_t k = recv(fd, tmp, sizeof tmp, 0);\n        if (k < 0 && sock_interrupted()) continue;\n        if (k <= 0) break;\n        jig_buf_push(&b, tmp, (int64_t)k);\n    }\n    return jig_buf_to_str(&b);\n}\n\n/* A socket listening at `res` (freed), or BAD_SOCK with the reason in *e. */\nstatic jig_sock net_listen(const jig_str *addr, struct addrinfo *res, int backlog, jig_str **e) {\n    jig_sock fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);\n    int one = 1;\n    if (fd != BAD_SOCK) setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (const char *)&one, sizeof one);\n    if (fd == BAD_SOCK || bind(fd, res->ai_addr, res->ai_addrlen) != 0 || listen(fd, backlog) != 0) {\n        *e = net_err(addr, sock_error());\n        if (fd != BAD_SOCK) sock_close(fd);\n        freeaddrinfo(res);\n        return BAD_SOCK;\n    }\n    freeaddrinfo(res);\n    return fd;\n}\n\nstatic jig_str *net_serve_loop(const jig_str *addr, void *state, jig_fn *f, jig_serve_call call, int64_t limit,\n                               bool *ok, const char *loc, bool http) {\n    if (limit < 0) jig_panic(\"precondition failed: limit >= 0\", loc);\n    const char *err = NULL;\n    struct addrinfo *res = net_resolve(addr, true, &err);\n    *ok = false;\n    if (!res) return net_err(addr, err);\n    jig_str *e = NULL;\n    jig_sock fd = net_listen(addr, res, 64, &e);\n    if (fd == BAD_SOCK) return e;\n    for (int64_t served = 0; limit == 0 || served < limit; served++) {\n        /* What the program printed shows before the server waits. */\n        flush_out();\n        jig_sock c = accept(fd, NULL, NULL);\n        if (c == BAD_SOCK) {\n            if (sock_interrupted()) {\n                served--;\n                continue;\n            }\n            e = net_err(addr, sock_error());\n            sock_close(fd);\n            return e;\n        }\n        int refuse = 0;\n        jig_str *req = http ? net_read_http(c, &refuse) : net_read_all(c);\n        if (refuse) {\n            const char *r = http_refusal(refuse);\n            net_send_all(c, r, strlen(r));\n        } else {\n            jig_str *reply = call(f, state, req);\n            net_send_all(c, jig_str_data(reply), (size_t)jig_str_len(reply));\n            jig_str_release(reply);\n        }\n        sock_close(c);\n        jig_str_release(req);\n    }\n    sock_close(fd);\n    *ok = true;\n    return NULL;\n}\n\njig_str *jig_net_serve(const jig_str *addr, void *state, jig_fn *f, jig_serve_call call, int64_t limit, bool *ok,\n                       const char *loc) {\n    return net_serve_loop(addr, state, f, call, limit, ok, loc, false);\n}\n\njig_str *jig_net_serve_http(const jig_str *addr, void *state, jig_fn *f, jig_serve_call call, int64_t limit,\n                            bool *ok, const char *loc) {\n    return net_serve_loop(addr, state, f, call, limit, ok, loc, true);\n}\n\n/* `net.serve_http_parallel`: this thread accepts connections and queues them; workers each\n   take one, read its request, call the handler and answer. A connection waits at most\n   NET_TIMEOUT seconds for its client. Returns after `limit` requests are answered. */\ntypedef struct {\n    pthread_mutex_t mu;\n    pthread_cond_t ready;\n    jig_sock *fds;\n    int64_t head, len, cap;\n    bool done;\n    jig_fn *f;\n    jig_handle_call call;\n} serve_queue;\n\nstatic void *serve_worker(void *arg) {\n    serve_queue *q = arg;\n    for (;;) {\n        pthread_mutex_lock(&q->mu);\n        while (q->head == q->len && !q->done) pthread_cond_wait(&q->ready, &q->mu);\n        if (q->head == q->len) {\n            pthread_mutex_unlock(&q->mu);\n            return NULL;\n        }\n        jig_sock c = q->fds[q->head++];\n        pthread_mutex_unlock(&q->mu);\n        sock_timeouts(c, NET_TIMEOUT);\n        int refuse = 0;\n        jig_str *req = net_read_http(c, &refuse);\n        if (refuse) {\n            const char *r = http_refusal(refuse);\n            net_send_all(c, r, strlen(r));\n        } else {\n            jig_str *reply = q->call(q->f, req);\n            net_send_all(c, jig_str_data(reply), (size_t)jig_str_len(reply));\n            jig_str_release(reply);\n        }\n        sock_close(c);\n        jig_str_release(req);\n    }\n}\n\nstatic int serve_workers(void) {\n    const char *e = getenv(\"JIG_THREADS\");\n    long n = e ? atol(e) : 2 * cpu_count();\n    return n < 1 ? 1 : n > 256 ? 256 : (int)n;\n}\n\njig_str *jig_net_serve_parallel(const jig_str *addr, jig_fn *f, jig_handle_call call, int64_t limit,\n                                int64_t *served, bool *ok, const char *loc) {\n    if (limit < 0) jig_panic(\"precondition failed: limit >= 0\", loc);\n    const char *err = NULL;\n    struct addrinfo *res = net_resolve(addr, true, &err);\n    *ok = false;\n    *served = 0;\n    if (!res) return net_err(addr, err);\n    jig_str *e = NULL;\n    jig_sock fd = net_listen(addr, res, 128, &e);\n    if (fd == BAD_SOCK) return e;\n    pthread_mutex_lock(&g_shared_mu);\n    g_threaded = true;\n    pthread_mutex_unlock(&g_shared_mu);\n    /* Handlers run on several threads from here until the server returns. */\n    __atomic_add_fetch(&jig_sharing, 1, __ATOMIC_SEQ_CST);\n    serve_queue q = {PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, NULL, 0, 0, 0, false, f, call};\n    int n = serve_workers();\n    pthread_t *ts = malloc(sizeof *ts * (size_t)n);\n    if (!ts) jig_oom();\n    pthread_attr_t attr;\n    pthread_attr_init(&attr);\n    pthread_attr_setstacksize(&attr, (size_t)64 << 20);\n    int started = 0;\n    while (started < n && pthread_create(&ts[started], &attr, serve_worker, &q) == 0) started++;\n    pthread_attr_destroy(&attr);\n    for (int64_t accepted = 0; started > 0 && (limit == 0 || accepted < limit);) {\n        SHARED_LOCK();\n        flush_out();\n        SHARED_UNLOCK();\n        jig_sock c = accept(fd, NULL, NULL);\n        if (c == BAD_SOCK) {\n            if (sock_interrupted()) continue;\n            e = net_err(addr, sock_error());\n            break;\n        }\n        pthread_mutex_lock(&q.mu);\n        if (q.len == q.cap) {\n            /* Room at the front first: the taken connections are done with. */\n            memmove(q.fds, q.fds + q.head, sizeof *q.fds * (size_t)(q.len - q.head));\n            q.len -= q.head;\n            q.head = 0;\n            if (q.len == q.cap) {\n                q.cap = q.cap ? 2 * q.cap : 64;\n                q.fds = realloc(q.fds, sizeof *q.fds * (size_t)q.cap);\n                if (!q.fds) jig_oom();\n            }\n        }\n        q.fds[q.len++] = c;\n        pthread_cond_signal(&q.ready);\n        pthread_mutex_unlock(&q.mu);\n        accepted++;\n        *served = accepted;\n    }\n    if (!started) e = net_err(addr, \"cannot start a thread\");\n    pthread_mutex_lock(&q.mu);\n    q.done = true;\n    pthread_cond_broadcast(&q.ready);\n    pthread_mutex_unlock(&q.mu);\n    for (int i = 0; i < started; i++) pthread_join(ts[i], NULL);\n    __atomic_sub_fetch(&jig_sharing, 1, __ATOMIC_SEQ_CST);\n    free(ts);\n    free(q.fds);\n    sock_close(fd);\n    if (e) return e;\n    *ok = true;\n    return NULL;\n}\n\nint64_t jig_now_ns(void) {\n    struct timespec ts;\n    clock_gettime(CLOCK_MONOTONIC, &ts);\n    return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;\n}\n\nstatic uint64_t next_rand(void) {\n    SHARED_LOCK();\n    uint64_t x = g_rng;\n    x ^= x >> 12;\n    x ^= x << 25;\n    x ^= x >> 27;\n    g_rng = x;\n    SHARED_UNLOCK();\n    return x * 0x2545f4914f6cdd1dull;\n}\n\nint64_t jig_rand_int(int64_t lo, int64_t hi, const char *loc) {\n    if (lo >= hi) jig_panic(\"precondition failed: lo < hi\", loc);\n    uint64_t span = (uint64_t)hi - (uint64_t)lo;\n    return (int64_t)((uint64_t)lo + next_rand() % span);\n}\n\ndouble jig_rand_float(void) { return (double)(next_rand() >> 11) / (double)(1ull << 53); }\n\n/* ---------- C calls from an interpreter ----------\n   jigc's test runner calls C functions by name: one is looked up among the process's symbols\n   and those of the libraries opened here, then called through one signature that fills every\n   argument register (six integer, eight floating point). That is how the x86-64 System V and\n   AArch64 conventions pass arguments to a non-variadic C function, whatever its parameters;\n   the checker limits C functions to what fits. */\n\nstatic void *g_ccall_fn;\n\n#ifdef _WIN32\n/* Windows has no global symbol table: a name is looked up in the program, the libraries\n   opened here, then the C runtime's and the system's. */\nstatic void *g_ccall_libs[64];\nstatic int g_ccall_nlibs;\n\nbool jig_ccall_open(const char *lib) {\n    void *h = lib_open(lib);\n    if (h && g_ccall_nlibs < 64) g_ccall_libs[g_ccall_nlibs++] = h;\n    return h != NULL;\n}\n\nbool jig_ccall_find(const char *name) {\n    static const char *const system_libs[] = {\"ucrtbase.dll\", \"msvcrt.dll\", \"kernel32.dll\", \"ws2_32.dll\"};\n    g_ccall_fn = lib_sym(GetModuleHandleA(NULL), name);\n    for (int i = 0; !g_ccall_fn && i < g_ccall_nlibs; i++) g_ccall_fn = lib_sym(g_ccall_libs[i], name);\n    for (size_t i = 0; !g_ccall_fn && i < sizeof system_libs / sizeof *system_libs; i++) {\n        HMODULE h = GetModuleHandleA(system_libs[i]);\n        if (h) g_ccall_fn = lib_sym(h, name);\n    }\n    return g_ccall_fn != NULL;\n}\n#else\nbool jig_ccall_open(const char *lib) { return lib_open(lib) != NULL; }\n\nbool jig_ccall_find(const char *name) {\n    g_ccall_fn = lib_sym(RTLD_DEFAULT, name);\n    return g_ccall_fn != NULL;\n}\n#endif\n\n/* The next call's arguments in order: bit k of `floats` is set when argument k is a float.\n   System V and AArch64 need no order (integers and floats have registers of their own);\n   Windows x64 passes argument k in register k of its kind, then on the stack. */\nstatic int64_t g_ccall_floats, g_ccall_argc;\nvoid jig_ccall_order(int64_t floats, int64_t argc) {\n    g_ccall_floats = floats;\n    g_ccall_argc = argc;\n}\n\n#ifdef _WIN32\ntypedef union {\n    int64_t i;\n    double f;\n} ccall_slot;\n\n/* Calls g_ccall_fn with the arguments in their places: the first four typed as they are,\n   the rest as their 64 bits, which is all a stack slot holds. */\n#define CCALL_REST int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t\n#define CCALL_RESTV s[4].i, s[5].i, s[6].i, s[7].i, s[8].i, s[9].i, s[10].i, s[11].i, s[12].i, s[13].i\n#define CCALL(R, A, B, C, D, a, b, c, d) return ((R(*)(A, B, C, D, CCALL_REST))g_ccall_fn)(a, b, c, d, CCALL_RESTV)\n#define CCALL4(R)                                                                                                \\\n    switch (m & 15) {                                                                                            \\\n    case 0: CCALL(R, int64_t, int64_t, int64_t, int64_t, s[0].i, s[1].i, s[2].i, s[3].i);                       \\\n    case 1: CCALL(R, double, int64_t, int64_t, int64_t, s[0].f, s[1].i, s[2].i, s[3].i);                        \\\n    case 2: CCALL(R, int64_t, double, int64_t, int64_t, s[0].i, s[1].f, s[2].i, s[3].i);                        \\\n    case 3: CCALL(R, double, double, int64_t, int64_t, s[0].f, s[1].f, s[2].i, s[3].i);                         \\\n    case 4: CCALL(R, int64_t, int64_t, double, int64_t, s[0].i, s[1].i, s[2].f, s[3].i);                        \\\n    case 5: CCALL(R, double, int64_t, double, int64_t, s[0].f, s[1].i, s[2].f, s[3].i);                         \\\n    case 6: CCALL(R, int64_t, double, double, int64_t, s[0].i, s[1].f, s[2].f, s[3].i);                         \\\n    case 7: CCALL(R, double, double, double, int64_t, s[0].f, s[1].f, s[2].f, s[3].i);                          \\\n    case 8: CCALL(R, int64_t, int64_t, int64_t, double, s[0].i, s[1].i, s[2].i, s[3].f);                        \\\n    case 9: CCALL(R, double, int64_t, int64_t, double, s[0].f, s[1].i, s[2].i, s[3].f);                         \\\n    case 10: CCALL(R, int64_t, double, int64_t, double, s[0].i, s[1].f, s[2].i, s[3].f);                        \\\n    case 11: CCALL(R, double, double, int64_t, double, s[0].f, s[1].f, s[2].i, s[3].f);                         \\\n    case 12: CCALL(R, int64_t, int64_t, double, double, s[0].i, s[1].i, s[2].f, s[3].f);                        \\\n    case 13: CCALL(R, double, int64_t, double, double, s[0].f, s[1].i, s[2].f, s[3].f);                         \\\n    case 14: CCALL(R, int64_t, double, double, double, s[0].i, s[1].f, s[2].f, s[3].f);                         \\\n    default: CCALL(R, double, double, double, double, s[0].f, s[1].f, s[2].f, s[3].f);                          \\\n    }\n\n/* The arguments in their places: integers and floats, each in its own order, merged. */\nstatic unsigned ccall_slots(ccall_slot *s, const int64_t *ints, const double *floats) {\n    int ni = 0, nf = 0;\n    for (int k = 0; k < 14; k++) {\n        bool f = k < g_ccall_argc && ((g_ccall_floats >> k) & 1);\n        if (f) s[k].f = nf < 8 ? floats[nf++] : 0.0;\n        else s[k].i = ni < 6 && k < g_ccall_argc ? ints[ni++] : 0;\n    }\n    return (unsigned)g_ccall_floats;\n}\n\nint64_t jig_ccall_int(int64_t a, int64_t b, int64_t c, int64_t d, int64_t e, int64_t f, double x0, double x1,\n                      double x2, double x3, double x4, double x5, double x6, double x7) {\n    const int64_t ints[6] = {a, b, c, d, e, f};\n    const double floats[8] = {x0, x1, x2, x3, x4, x5, x6, x7};\n    ccall_slot s[14];\n    unsigned m = ccall_slots(s, ints, floats);\n    CCALL4(int64_t)\n}\n\ndouble jig_ccall_float(int64_t a, int64_t b, int64_t c, int64_t d, int64_t e, int64_t f, double x0, double x1,\n                       double x2, double x3, double x4, double x5, double x6, double x7) {\n    const int64_t ints[6] = {a, b, c, d, e, f};\n    const double floats[8] = {x0, x1, x2, x3, x4, x5, x6, x7};\n    ccall_slot s[14];\n    unsigned m = ccall_slots(s, ints, floats);\n    CCALL4(double)\n}\n#else\ntypedef int64_t (*jig_ccall_int_fn)(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, double, double, double,\n                                    double, double, double, double, double);\ntypedef double (*jig_ccall_float_fn)(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, double, double, double,\n                                     double, double, double, double, double);\n\nint64_t jig_ccall_int(int64_t a, int64_t b, int64_t c, int64_t d, int64_t e, int64_t f, double x0, double x1,\n                      double x2, double x3, double x4, double x5, double x6, double x7) {\n    return ((jig_ccall_int_fn)g_ccall_fn)(a, b, c, d, e, f, x0, x1, x2, x3, x4, x5, x6, x7);\n}\n\ndouble jig_ccall_float(int64_t a, int64_t b, int64_t c, int64_t d, int64_t e, int64_t f, double x0, double x1,\n                       double x2, double x3, double x4, double x5, double x6, double x7) {\n    return ((jig_ccall_float_fn)g_ccall_fn)(a, b, c, d, e, f, x0, x1, x2, x3, x4, x5, x6, x7);\n}\n#endif\n\n/* A C string's copy, as an address to pass in an integer register; freed after the call. */\nint64_t jig_ccall_strdup(const char *s) { return (int64_t)(intptr_t)strdup(s); }\nvoid jig_ccall_free(int64_t p) { free((void *)(intptr_t)p); }\n/* Byte buffers for `List<U8>` and `&mut List<U8>` arguments: allocated, filled, passed, read\n   back and freed with `jig_ccall_free`. */\nint64_t jig_ccall_buf(int64_t n) {\n    void *p = calloc((size_t)(n > 0 ? n : 1), 1);\n    if (!p) jig_oom();\n    return (int64_t)(intptr_t)p;\n}\nvoid jig_ccall_buf_set(int64_t p, int64_t i, int64_t b) { ((uint8_t *)(intptr_t)p)[i] = (uint8_t)b; }\nint64_t jig_ccall_buf_get(int64_t p, int64_t i) { return ((uint8_t *)(intptr_t)p)[i]; }\n/* The string a C function returned (empty for NULL). */\nconst char *jig_ccall_str(int64_t p) { return p ? (const char *)(intptr_t)p : \"\"; }\n\n/* Serving for jigc's interpreter, which cannot hand `jig_net_serve` a handler to call: listen,\n   take one connection's request, answer it. A failure returns -1, its message (\"ADDR: reason\")\n   kept for jig_ccall_net_error. */\nstatic char g_ccall_net_err[512];\nstatic char *g_ccall_request;\n\nint64_t jig_ccall_listen(const char *addr) {\n    jig_str *a = jig_str_new(addr, (int64_t)strlen(addr));\n    const char *err = NULL;\n    struct addrinfo *res = net_resolve(a, true, &err);\n    if (!res) {\n        jig_str_release(a);\n        snprintf(g_ccall_net_err, sizeof g_ccall_net_err, \"%s: %s\", addr, err);\n        return -1;\n    }\n    jig_str *e = NULL;\n    jig_sock fd = net_listen(a, res, 64, &e);\n    jig_str_release(a);\n    if (fd == BAD_SOCK) {\n        snprintf(g_ccall_net_err, sizeof g_ccall_net_err, \"%.*s\", (int)jig_str_len(e), jig_str_data(e));\n        jig_str_release(e);\n        return -1;\n    }\n    return (int64_t)fd;\n}\n\nint64_t jig_ccall_accept(int64_t fd, const char *addr) {\n    flush_out();\n    for (;;) {\n        jig_sock c = accept((jig_sock)fd, NULL, NULL);\n        if (c != BAD_SOCK) return (int64_t)c;\n        if (!sock_interrupted()) {\n            snprintf(g_ccall_net_err, sizeof g_ccall_net_err, \"%s: %s\", addr, sock_error());\n            sock_close((jig_sock)fd);\n            return -1;\n        }\n    }\n}\n\n/* The connection's request, read to its end (valid until the next call). */\nconst char *jig_ccall_request(int64_t conn) {\n    jig_str *r = net_read_all((jig_sock)conn);\n    size_t n = (size_t)jig_str_len(r);\n    free(g_ccall_request);\n    g_ccall_request = malloc(n + 1);\n    if (!g_ccall_request) jig_oom();\n    memcpy(g_ccall_request, jig_str_data(r), n);\n    g_ccall_request[n] = 0;\n    jig_str_release(r);\n    return g_ccall_request;\n}\n\n/* The connection's HTTP request, read until it is complete or refused (see http_frame); the\n   interpreter frames it again to tell which. */\nconst char *jig_ccall_request_http(int64_t conn) {\n    int refuse = 0;\n    jig_str *r = net_read_http((jig_sock)conn, &refuse);\n    size_t n = (size_t)jig_str_len(r);\n    free(g_ccall_request);\n    g_ccall_request = malloc(n + 1);\n    if (!g_ccall_request) jig_oom();\n    memcpy(g_ccall_request, jig_str_data(r), n);\n    g_ccall_request[n] = 0;\n    jig_str_release(r);\n    return g_ccall_request;\n}\n\nvoid jig_ccall_answer(int64_t conn, const char *reply) {\n    net_send_all((jig_sock)conn, reply, strlen(reply));\n    sock_close((jig_sock)conn);\n}\n\nvoid jig_ccall_close(int64_t fd) { sock_close((jig_sock)fd); }\n\nconst char *jig_ccall_net_error(void) { return g_ccall_net_err; }\n\n/* The last failed C call's error, as the C library words it. */\nconst char *jig_ccall_os_error(void) { return strerror(errno); }\n\n/* ---------- HTTP client (`net.fetch`) ----------\n   One request over TCP or TLS: send it, keep the sending side open (an HTTP server may take\n   a half-close for a client that has gone) and read the reply until the server closes, which\n   `Connection: close` asks it to. A read waits at most NET_TIMEOUT seconds.\n\n   TLS goes through the system's OpenSSL, opened when a program first fetches over it, so a\n   program that never does needs no OpenSSL to build or to run. These are the few functions it\n   calls, by their ABI, which is the same in OpenSSL 1.1 and 3. The server's certificate must\n   chain to a trusted root (the system's, or SSL_CERT_FILE's) and name the host. The Rust\n   interpreter does the same (`compiler/src/mir/tls.rs`), with the same messages. */\n\ntypedef struct {\n    int ready; /* 0: not tried, 1: loaded, -1: missing */\n    const void *(*client_method)(void);\n    void *(*ctx_new)(const void *);\n    int (*ctx_default_paths)(void *);\n    void (*ctx_set_verify)(void *, int, void *);\n    void (*ctx_free)(void *);\n    void *(*ssl_new)(void *);\n    int (*set_fd)(void *, int);\n    long (*ctrl)(void *, int, long, void *);\n    int (*set1_host)(void *, const char *);\n    int (*ssl_connect)(void *);\n    int (*ssl_write)(void *, const void *, int);\n    int (*ssl_read)(void *, void *, int);\n    long (*verify_result)(const void *);\n    void (*ssl_free)(void *);\n    void (*err_clear)(void);\n    unsigned long (*err_get)(void);\n    void (*err_string)(unsigned long, char *, size_t);\n    const char *(*verify_string)(long);\n} tls_api;\n\nstatic tls_api g_tls;\nstatic pthread_mutex_t g_tls_lock = PTHREAD_MUTEX_INITIALIZER;\n\nstatic bool tls_load(void) {\n    static const char *const names[] = {\n#ifdef _WIN32\n        \"libssl-3-x64.dll\", \"libssl-3.dll\", \"libssl-1_1-x64.dll\",\n#else\n        \"libssl.so.3\", \"libssl.so.1.1\", \"libssl.so\", \"libssl.3.dylib\",\n        \"/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib\", \"/usr/local/opt/openssl@3/lib/libssl.3.dylib\",\n#endif\n    };\n#ifdef _WIN32\n    /* A Windows library exports only its own functions: the ERR_ and X509_ ones are\n       libcrypto's. */\n    static const char *const crypto_names[] = {\"libcrypto-3-x64.dll\", \"libcrypto-3.dll\", \"libcrypto-1_1-x64.dll\"};\n#endif\n    pthread_mutex_lock(&g_tls_lock);\n    if (!g_tls.ready) {\n        void *h = NULL, *crypto = NULL;\n        for (size_t i = 0; !h && i < sizeof names / sizeof *names; i++) h = lib_open(names[i]);\n#ifdef _WIN32\n        for (size_t i = 0; h && !crypto && i < sizeof crypto_names / sizeof *crypto_names; i++)\n            crypto = lib_open(crypto_names[i]);\n#endif\n        g_tls.ready = -1;\n        if (h) {\n            void **f[] = {\n                (void **)&g_tls.client_method, (void **)&g_tls.ctx_new, (void **)&g_tls.ctx_default_paths,\n                (void **)&g_tls.ctx_set_verify, (void **)&g_tls.ctx_free, (void **)&g_tls.ssl_new,\n                (void **)&g_tls.set_fd, (void **)&g_tls.ctrl, (void **)&g_tls.set1_host,\n                (void **)&g_tls.ssl_connect, (void **)&g_tls.ssl_write, (void **)&g_tls.ssl_read,\n                (void **)&g_tls.verify_result, (void **)&g_tls.ssl_free, (void **)&g_tls.err_clear,\n                (void **)&g_tls.err_get, (void **)&g_tls.err_string, (void **)&g_tls.verify_string,\n            };\n            static const char *const syms[] = {\n                \"TLS_client_method\", \"SSL_CTX_new\", \"SSL_CTX_set_default_verify_paths\", \"SSL_CTX_set_verify\",\n                \"SSL_CTX_free\", \"SSL_new\", \"SSL_set_fd\", \"SSL_ctrl\", \"SSL_set1_host\", \"SSL_connect\",\n                \"SSL_write\", \"SSL_read\", \"SSL_get_verify_result\", \"SSL_free\", \"ERR_clear_error\",\n                \"ERR_get_error\", \"ERR_error_string_n\", \"X509_verify_cert_error_string\",\n            };\n            bool all = true;\n            for (size_t i = 0; i < sizeof syms / sizeof *syms; i++) {\n                *f[i] = lib_sym(h, syms[i]);\n                if (!*f[i] && crypto) *f[i] = lib_sym(crypto, syms[i]);\n                all = all && *f[i];\n            }\n            g_tls.ready = all ? 1 : -1;\n        }\n    }\n    bool ok = g_tls.ready == 1;\n    pthread_mutex_unlock(&g_tls_lock);\n    return ok;\n}\n\n/* Why the TLS connection failed: the certificate check's reason, else OpenSSL's first error. */\nstatic jig_str *tls_err(const jig_str *addr, const char *what, void *ssl) {\n    char msg[512], detail[256] = \"\";\n    long v = ssl ? g_tls.verify_result(ssl) : 0;\n    unsigned long e = g_tls.err_get();\n    if (v != 0) {\n        snprintf(detail, sizeof detail, \"%s\", g_tls.verify_string(v));\n    } else if (e) {\n        g_tls.err_string(e, detail, sizeof detail);\n    }\n    if (detail[0]) snprintf(msg, sizeof msg, \"%s: %s\", what, detail);\n    else snprintf(msg, sizeof msg, \"%s\", what);\n    return net_err(addr, msg);\n}\n\nstatic jig_sock net_connect(const jig_str *addr, const char **err) {\n    struct addrinfo *res = net_resolve(addr, false, err);\n    if (!res) return BAD_SOCK;\n    jig_sock fd = BAD_SOCK;\n    for (struct addrinfo *ai = res; ai; ai = ai->ai_next) {\n        fd = socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);\n        if (fd == BAD_SOCK) continue;\n        if (connect(fd, ai->ai_addr, ai->ai_addrlen) == 0) break;\n        sock_close(fd);\n        fd = BAD_SOCK;\n    }\n    freeaddrinfo(res);\n    if (fd == BAD_SOCK) *err = sock_error();\n    return fd;\n}\n\njig_str *jig_net_fetch(const jig_str *addr, const jig_str *req, bool tls, bool *ok) {\n    *ok = false;\n    if (tls && !tls_load()) return net_err(addr, \"TLS needs OpenSSL (libssl), which was not found\");\n    const char *err = NULL;\n    jig_sock fd = net_connect(addr, &err);\n    if (fd == BAD_SOCK) return net_err(addr, err);\n    sock_timeouts(fd, NET_TIMEOUT);\n    jig_buf b = {0};\n    char tmp[1 << 14];\n    if (!tls) {\n        if (!net_send_all(fd, jig_str_data(req), (size_t)jig_str_len(req))) {\n            jig_str *e = net_err(addr, sock_error());\n            sock_close(fd);\n            return e;\n        }\n        for (;;) {\n            ssize_t k = recv(fd, tmp, sizeof tmp, 0);\n            if (k < 0 && sock_interrupted()) continue;\n            if (k < 0 && sock_timed_out()) {\n                sock_close(fd);\n                jig_buf_free(&b);\n                return net_err(addr, \"timed out\");\n            }\n            if (k <= 0) break;\n            jig_buf_push(&b, tmp, (int64_t)k);\n        }\n        sock_close(fd);\n        *ok = true;\n        return jig_buf_to_str(&b);\n    }\n    /* The host the certificate must name: `addr` up to its last colon. */\n    char host[256];\n    int64_t n = jig_str_len(addr), colon = 0;\n    for (int64_t i = 0; i < n; i++)\n        if (jig_str_data(addr)[i] == ':') colon = i;\n    memcpy(host, jig_str_data(addr), (size_t)colon);\n    host[colon] = 0;\n    g_tls.err_clear();\n    void *ctx = g_tls.ctx_new(g_tls.client_method());\n    /* Before SSL_new, which copies the verification settings. */\n    if (ctx) {\n        g_tls.ctx_default_paths(ctx);\n        g_tls.ctx_set_verify(ctx, 1 /* SSL_VERIFY_PEER */, NULL);\n    }\n    void *ssl = ctx ? g_tls.ssl_new(ctx) : NULL;\n    jig_str *fail = NULL;\n    if (!ssl) {\n        fail = tls_err(addr, \"TLS setup failed\", NULL);\n    } else {\n        g_tls.set_fd(ssl, (int)fd);\n        g_tls.ctrl(ssl, 55 /* SSL_CTRL_SET_TLSEXT_HOSTNAME */, 0, host);\n        if (g_tls.set1_host(ssl, host) != 1 || g_tls.ssl_connect(ssl) != 1) fail = tls_err(addr, \"TLS handshake failed\", ssl);\n    }\n    const char *p = jig_str_data(req);\n    int64_t left = jig_str_len(req);\n    while (!fail && left > 0) {\n        int k = g_tls.ssl_write(ssl, p, left > (1 << 30) ? (1 << 30) : (int)left);\n        if (k <= 0) fail = tls_err(addr, \"TLS write failed\", NULL);\n        else {\n            p += k;\n            left -= k;\n        }\n    }\n    while (!fail) {\n        errno = 0;\n#ifdef _WIN32\n        WSASetLastError(0);\n#endif\n        int k = g_tls.ssl_read(ssl, tmp, (int)sizeof tmp);\n        if (k <= 0) {\n            if (sock_timed_out()) fail = net_err(addr, \"timed out\");\n            break;\n        }\n        jig_buf_push(&b, tmp, (int64_t)k);\n    }\n    if (ssl) g_tls.ssl_free(ssl);\n    if (ctx) g_tls.ctx_free(ctx);\n    sock_close(fd);\n    if (fail) {\n        jig_buf_free(&b);\n        return fail;\n    }\n    *ok = true;\n    return jig_buf_to_str(&b);\n}\n\n/* ---------- runtime element types ---------- */\n\nstatic void str_retain(void *p) { jig_str_retain(*(jig_str **)p); }\nstatic void str_release(void *p) { jig_str_release(*(jig_str **)p); }\nstatic bool str_eq(const void *a, const void *b) { return jig_str_eq(*(jig_str *const *)a, *(jig_str *const *)b); }\nstatic int str_cmp(const void *a, const void *b) { return jig_str_cmp(*(jig_str *const *)a, *(jig_str *const *)b); }\nstatic uint64_t str_hash(const void *a) { return jig_str_hash(*(jig_str *const *)a); }\nstatic void str_show(jig_buf *b, const void *a, bool nested) { jig_show_str(b, *(jig_str *const *)a, nested); }\nconst jig_type jig_type_str = {sizeof(jig_str *), str_retain, str_release, str_eq, str_cmp, str_hash, str_show};\n\nstatic bool u8_eq(const void *a, const void *b) { return *(const uint8_t *)a == *(const uint8_t *)b; }\nstatic int u8_cmp(const void *a, const void *b) { return (int)*(const uint8_t *)a - (int)*(const uint8_t *)b; }\nstatic uint64_t u8_hash(const void *a) { return jig_hash_u64(*(const uint8_t *)a); }\nstatic void u8_show(jig_buf *b, const void *a, bool nested) {\n    (void)nested;\n    jig_show_i64(b, *(const uint8_t *)a);\n}\nconst jig_type jig_type_u8 = {1, NULL, NULL, u8_eq, u8_cmp, u8_hash, u8_show};\n\nstatic bool char_eq(const void *a, const void *b) { return *(const uint32_t *)a == *(const uint32_t *)b; }\nstatic int char_cmp(const void *a, const void *b) {\n    uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;\n    return x < y ? -1 : x > y;\n}\nstatic uint64_t char_hash(const void *a) { return jig_hash_u64(*(const uint32_t *)a); }\nstatic void char_show(jig_buf *b, const void *a, bool nested) { jig_show_char(b, *(const uint32_t *)a, nested); }\nconst jig_type jig_type_char = {4, NULL, NULL, char_eq, char_cmp, char_hash, char_show};\n"

const RT_JIG_RT_H: Str = "/* The Jig runtime: reference-counted copy-on-write strings, lists and maps, checked\n * arithmetic, formatting and effects. Generated code includes this header.\n *\n * Conventions: a NULL string, list or map is empty, so zero-initialized values are valid.\n * Arguments are borrowed; results are owned. Objects with a negative reference count are\n * static and never freed. */\n#ifndef JIG_RT_H\n#define JIG_RT_H\n\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <string.h>\n\ntypedef uint8_t jig_unit;\n\ntypedef struct jig_buf {\n    char *data;\n    int64_t len;\n    int64_t cap;\n} jig_buf;\n\n/* Per-type operations, generated by the compiler for element, key and value types. */\ntypedef struct jig_type {\n    size_t size;\n    void (*retain)(void *);\n    void (*release)(void *);\n    bool (*eq)(const void *, const void *);\n    int (*cmp)(const void *, const void *);\n    uint64_t (*hash)(const void *);\n    void (*show)(jig_buf *, const void *, bool nested);\n} jig_type;\n\ntypedef struct jig_str {\n    int64_t rc;\n    int64_t len;\n    /* Bytes available in `data` (excluding the terminating NUL), for appends in place. */\n    int64_t cap;\n    char data[];\n} jig_str;\n\ntypedef struct jig_list {\n    int64_t rc;\n    int64_t len;\n    int64_t cap;\n    char *data;\n} jig_list;\n\ntypedef struct jig_map {\n    int64_t rc;\n    int64_t len;\n    int64_t cap;\n    char *keys;\n    char *vals;\n    int32_t *index; /* open addressing; -1 empty */\n    int64_t index_cap;\n} jig_map;\n\n/* A function value: code pointer plus a reference-counted environment (or NULL). */\ntypedef struct jig_env {\n    int64_t rc;\n    void (*drop)(struct jig_env *);\n} jig_env;\n\ntypedef struct jig_fn {\n    void *code;\n    jig_env *env;\n} jig_fn;\n\n/* Boxed (recursive) enum payload header. */\ntypedef struct jig_box {\n    int64_t rc;\n} jig_box;\n\n/* ---- process ---- */\nvoid jig_init(int argc, char **argv);\n/* Run the program entry point on a large stack. */\nvoid jig_run_main(void (*f)(void));\nvoid jig_exit(int code) __attribute__((noreturn, cold));\nvoid jig_panic(const char *msg, const char *loc) __attribute__((noreturn, cold));\nvoid jig_panic_buf(jig_buf *b, const char *loc) __attribute__((noreturn, cold));\nvoid jig_unreachable(const char *loc) __attribute__((noreturn, cold));\n\n/* ---- memory ---- */\nvoid *jig_alloc(size_t n);\nvoid jig_free(void *p);\n/* Objects of a size known at both ends (boxes, closures, list and map headers): no header. */\nvoid *jig_alloc_obj(size_t n);\nvoid jig_free_obj(void *p, size_t n);\n/* Nonzero while threads may share values: a batch of tasks runs, or a parallel server has\n * started. */\nextern int jig_sharing;\n#ifdef JIG_ATOMIC_RC\n/* Programs that run tasks share values between threads, so counts change atomically while\n * they can (jig_sharing); before and after, one thread holds every value and plain\n * arithmetic is enough. A count of 1 still means only this thread holds the value: nobody\n * else can raise it. */\nstatic inline bool jig_shared(void) { return __builtin_expect(__atomic_load_n(&jig_sharing, __ATOMIC_RELAXED) != 0, 0); }\nstatic inline void jig_rc_inc(int64_t *rc) {\n    if (*rc >= 0) {\n        if (jig_shared()) __atomic_fetch_add(rc, 1, __ATOMIC_RELAXED);\n        else (*rc)++;\n    }\n}\nstatic inline bool jig_rc_dec(int64_t *rc) {\n    if (*rc < 0) return false;\n    if (jig_shared()) return __atomic_sub_fetch(rc, 1, __ATOMIC_ACQ_REL) == 0;\n    return --(*rc) == 0;\n}\n#else\nstatic inline void jig_rc_inc(int64_t *rc) {\n    if (*rc >= 0) (*rc)++;\n}\n/* Returns true when the object should be freed. */\nstatic inline bool jig_rc_dec(int64_t *rc) {\n    if (*rc < 0) return false;\n    return --(*rc) == 0;\n}\n#endif\n\n/* ---- buffers ---- */\nvoid jig_buf_push(jig_buf *b, const char *s, int64_t n);\nvoid jig_buf_push_cstr(jig_buf *b, const char *s);\nvoid jig_buf_push_str(jig_buf *b, const jig_str *s);\nvoid jig_buf_free(jig_buf *b);\njig_str *jig_buf_to_str(jig_buf *b);\n\n/* ---- strings ---- */\n#define JIG_STATIC_STR(name, lit) \\\n    static struct { int64_t rc; int64_t len; int64_t cap; char data[sizeof(lit)]; } name = {-1, sizeof(lit) - 1, sizeof(lit) - 1, lit}\nstatic inline int64_t jig_str_len(const jig_str *s) { return s ? s->len : 0; }\nstatic inline const char *jig_str_data(const jig_str *s) { return s ? s->data : \"\"; }\nstatic inline void jig_str_retain(jig_str *s) {\n    if (s) jig_rc_inc(&s->rc);\n}\nstatic inline void jig_str_release(jig_str *s) {\n    if (s && jig_rc_dec(&s->rc)) jig_free(s);\n}\njig_str *jig_str_new(const char *data, int64_t len);\njig_str *jig_str_concat(const jig_str *a, const jig_str *b);\n/* `*s = *s + t`, growing `*s` in place when it is not shared. */\nvoid jig_str_append_slow(jig_str **s, const jig_str *t);\n/* Copy n bytes with a few fixed-size moves instead of a memcpy call (short strings). */\nstatic inline void jig_copy_small(char *d, const char *s, size_t n) {\n    if (n >= 8) {\n        if (n > 16) {\n            memcpy(d, s, n);\n            return;\n        }\n        uint64_t a, b;\n        memcpy(&a, s, 8);\n        memcpy(&b, s + n - 8, 8);\n        memcpy(d, &a, 8);\n        memcpy(d + n - 8, &b, 8);\n    } else if (n >= 4) {\n        uint32_t a, b;\n        memcpy(&a, s, 4);\n        memcpy(&b, s + n - 4, 4);\n        memcpy(d, &a, 4);\n        memcpy(d + n - 4, &b, 4);\n    } else if (n) {\n        d[0] = s[0];\n        d[n / 2] = s[n / 2];\n        d[n - 1] = s[n - 1];\n    }\n}\n/* s = s + t: in place when s is unshared and has room. */\nstatic inline void jig_str_append(jig_str **sp, const jig_str *t) {\n    jig_str *s = *sp;\n    if (__builtin_expect(t && s && s->rc == 1 && s != t && s->len + t->len <= s->cap, 1)) {\n        jig_copy_small(s->data + s->len, t->data, (size_t)t->len);\n        s->len += t->len;\n        s->data[s->len] = 0;\n        return;\n    }\n    jig_str_append_slow(sp, t);\n}\njig_str *jig_str_concat_n(int64_t n, const jig_str *const *xs);\n/* A copy of a C string (`NULL` is the empty string). */\njig_str *jig_str_from_cstr(const char *s);\n/* The assembler name of the C symbol `n`, for declarations bound to it. */\n#define JIG_ASM_STR2(x) #x\n#define JIG_ASM_STR(x) JIG_ASM_STR2(x)\n#define JIG_ASM_NAME(n) JIG_ASM_STR(__USER_LABEL_PREFIX__) n\njig_str *jig_str_split_next(const jig_str *s, const jig_str *sep, int64_t *pos);\nbool jig_str_eq(const jig_str *a, const jig_str *b);\nint jig_str_cmp(const jig_str *a, const jig_str *b);\nuint64_t jig_str_hash(const jig_str *s);\njig_str *jig_str_slice(const jig_str *s, int64_t lo, int64_t hi, const char *loc);\nbool jig_str_contains(const jig_str *s, const jig_str *t);\nbool jig_str_starts_with(const jig_str *s, const jig_str *t);\nbool jig_str_ends_with(const jig_str *s, const jig_str *t);\nint64_t jig_str_find(const jig_str *s, const jig_str *t); /* -1 if absent */\njig_list *jig_str_split(const jig_str *s, const jig_str *sep);\njig_list *jig_str_lines(const jig_str *s);\njig_str *jig_str_trim(const jig_str *s);\njig_str *jig_str_replace(const jig_str *s, const jig_str *from, const jig_str *to);\njig_str *jig_str_repeat(const jig_str *s, int64_t n, const char *loc);\njig_str *jig_str_to_upper(const jig_str *s);\njig_str *jig_str_to_lower(const jig_str *s);\nbool jig_str_to_int(const jig_str *s, int64_t *out);\nbool jig_str_to_float(const jig_str *s, double *out);\njig_list *jig_str_bytes(const jig_str *s);\njig_list *jig_str_chars(const jig_str *s);\njig_str *jig_str_from_chars(const jig_list *cs);\njig_str *jig_str_from_bytes(const jig_list *bs, bool *ok);\njig_str *jig_char_to_str(uint32_t c);\n\n/* ---- lists ---- */\nstatic inline int64_t jig_list_len(const jig_list *l) { return l ? l->len : 0; }\nvoid jig_list_retain(jig_list *l);\nvoid jig_list_release(jig_list *l, const jig_type *t);\njig_list *jig_list_with_capacity(int64_t n, const jig_type *t);\nvoid jig_list_make_unique(jig_list **l, const jig_type *t);\nvoid *jig_list_at(const jig_list *l, int64_t i, const jig_type *t, const char *loc);\nvoid *jig_list_at_mut(jig_list **l, int64_t i, const jig_type *t, const char *loc);\n/* Push takes ownership of *elem. */\nvoid jig_list_push(jig_list **l, void *elem, const jig_type *t);\nbool jig_list_pop(jig_list **l, void *out, const jig_type *t);\nbool jig_list_get(const jig_list *l, int64_t i, void *out, const jig_type *t);\nvoid jig_list_insert(jig_list **l, int64_t i, void *elem, const jig_type *t, const char *loc);\nvoid jig_list_remove(jig_list **l, int64_t i, void *out, const jig_type *t, const char *loc);\nvoid jig_list_clear(jig_list **l, const jig_type *t);\nvoid jig_list_extend(jig_list **l, const jig_list *other, const jig_type *t);\njig_list *jig_list_repeat(const jig_list *l, int64_t n, const jig_type *t, const char *loc);\nvoid jig_list_reverse(jig_list **l, const jig_type *t);\nvoid jig_list_swap(jig_list **l, int64_t i, int64_t j, const jig_type *t, const char *loc);\nvoid jig_list_truncate(jig_list **l, int64_t n, const jig_type *t, const char *loc);\nvoid jig_list_sort(jig_list **l, const jig_type *t);\n/* Sorts specialized for scalar elements (Char sorts as u32, Bool as u8). */\nvoid jig_list_sort_i64(jig_list **l, const jig_type *t);\nvoid jig_list_sort_i32(jig_list **l, const jig_type *t);\nvoid jig_list_sort_u8(jig_list **l, const jig_type *t);\nvoid jig_list_sort_u32(jig_list **l, const jig_type *t);\nvoid jig_list_sort_u64(jig_list **l, const jig_type *t);\nvoid jig_swap_oob(int64_t i, int64_t j, int64_t n, const char *loc) __attribute__((noreturn, cold));\n/* `less(f, a, b)`: a thunk calling the Jig comparator `f`. */\nvoid jig_list_sort_by(jig_list **l, const jig_type *t, bool (*less)(jig_fn *, const void *, const void *), jig_fn *f);\njig_list *jig_list_slice(const jig_list *l, int64_t lo, int64_t hi, const jig_type *t, const char *loc);\nbool jig_list_eq(const jig_list *a, const jig_list *b, const jig_type *t);\nint jig_list_cmp(const jig_list *a, const jig_list *b, const jig_type *t);\nuint64_t jig_list_hash(const jig_list *a, const jig_type *t);\nvoid jig_list_show(jig_buf *b, const jig_list *l, const jig_type *t);\n\n/* ---- maps and sets (a set is a map with unit values) ---- */\nstatic inline int64_t jig_map_len(const jig_map *m) { return m ? m->len : 0; }\nvoid jig_map_retain(jig_map *m);\nvoid jig_map_release(jig_map *m, const jig_type *k, const jig_type *v);\n/* Insert takes ownership of *key and *val. */\nvoid jig_map_insert(jig_map **m, void *key, void *val, const jig_type *k, const jig_type *v);\nbool jig_map_get(const jig_map *m, const void *key, void *out, const jig_type *k, const jig_type *v);\nbool jig_map_contains(const jig_map *m, const void *key, const jig_type *k);\nbool jig_map_remove(jig_map **m, const void *key, void *out, const jig_type *k, const jig_type *v);\njig_list *jig_map_keys(const jig_map *m, const jig_type *k);\njig_list *jig_map_values(const jig_map *m, const jig_type *v);\nvoid *jig_map_key_at(const jig_map *m, int64_t i, const jig_type *k);\nvoid *jig_map_val_at(const jig_map *m, int64_t i, const jig_type *v);\nbool jig_map_eq(const jig_map *a, const jig_map *b, const jig_type *k, const jig_type *v);\nvoid jig_map_show(jig_buf *b, const jig_map *m, const jig_type *k, const jig_type *v, bool is_set);\n\n/* Element access with the element size known at compile time, inlined at each use. */\nvoid jig_index_oob(int64_t i, int64_t len, const char *loc) __attribute__((noreturn, cold));\nstatic inline void *jig_list_idx(const jig_list *l, int64_t i, size_t sz, const char *loc) {\n    int64_t n = l ? l->len : 0;\n    if (__builtin_expect((uint64_t)i >= (uint64_t)n, 0)) jig_index_oob(i, n, loc);\n    return l->data + (size_t)i * sz;\n}\nstatic inline void *jig_list_idx_mut(jig_list **lp, int64_t i, size_t sz, const jig_type *t, const char *loc) {\n    jig_list *l = *lp;\n    int64_t n = l ? l->len : 0;\n    if (__builtin_expect((uint64_t)i >= (uint64_t)n, 0)) jig_index_oob(i, n, loc);\n    if (__builtin_expect(l->rc != 1, 0)) {\n        jig_list_make_unique(lp, t);\n        l = *lp;\n    }\n    return l->data + (size_t)i * sz;\n}\nstatic inline uint8_t jig_str_byte(const jig_str *s, int64_t i, const char *loc) {\n    int64_t n = jig_str_len(s);\n    if (__builtin_expect((uint64_t)i >= (uint64_t)n, 0)) jig_index_oob(i, n, loc);\n    return (uint8_t)s->data[i];\n}\n\n/* Push without a call when the list is unique and has room. Takes ownership of *elem. */\nstatic inline void jig_list_push_fast(jig_list **lp, void *elem, size_t sz, const jig_type *t) {\n    jig_list *l = *lp;\n    if (__builtin_expect(l != NULL && l->rc == 1 && l->len < l->cap, 1)) {\n        memcpy(l->data + (size_t)l->len * sz, elem, sz);\n        l->len++;\n        return;\n    }\n    jig_list_push(lp, elem, t);\n}\n\n/* Element access proved in bounds (or in bounds by construction). */\nstatic inline void *jig_list_ref(const jig_list *l, int64_t i, size_t sz) { return l->data + (size_t)i * sz; }\nstatic inline void *jig_list_ref_mut(jig_list **lp, int64_t i, size_t sz, const jig_type *t) {\n    if (__builtin_expect((*lp)->rc != 1, 0)) jig_list_make_unique(lp, t);\n    return (*lp)->data + (size_t)i * sz;\n}\n\n/* ---- tasks (std/task) ---- */\n/* Calls a task's function value: *out = f() or f(*in). */\ntypedef void (*jig_task_call)(jig_fn *f, const void *in, void *out);\njig_list *jig_task_all(const jig_list *jobs, jig_task_call call, const jig_type *rt);\njig_list *jig_task_map(const jig_list *items, jig_fn *f, jig_task_call call, const jig_type *it, const jig_type *rt);\nvoid jig_task_both(jig_fn *a, jig_fn *b, jig_task_call ca, jig_task_call cb, void *oa, void *ob);\n\n/* ---- function values ---- */\nstatic inline void jig_fn_retain(jig_fn *f) {\n    if (f->env) jig_rc_inc(&f->env->rc);\n}\nstatic inline void jig_fn_release(jig_fn *f) {\n    if (f->env && jig_rc_dec(&f->env->rc)) f->env->drop(f->env);\n}\n\n/* ---- checked arithmetic ---- */\nvoid jig_overflow(const char *op, const char *loc) __attribute__((noreturn, cold));\nvoid jig_div_zero(const char *loc) __attribute__((noreturn, cold));\nvoid jig_shift_range(int64_t amount, const char *loc) __attribute__((noreturn, cold));\nvoid jig_cast_range_i(int64_t v, const char *ty, const char *loc) __attribute__((noreturn, cold));\nvoid jig_cast_range_u(uint64_t v, const char *ty, const char *loc) __attribute__((noreturn, cold));\nvoid jig_cast_range_f(double v, const char *ty, const char *loc) __attribute__((noreturn, cold));\nvoid jig_index_oob(int64_t i, int64_t len, const char *loc) __attribute__((noreturn, cold));\nint64_t jig_ipow(int64_t base, int64_t exp, const char *loc);\n\n/* ---- formatting ---- */\nvoid jig_show_i64(jig_buf *b, int64_t v);\nvoid jig_show_u64(jig_buf *b, uint64_t v);\njig_str *jig_i64_str(int64_t v);\njig_str *jig_u64_str(uint64_t v);\nvoid jig_show_f64(jig_buf *b, double v);\nvoid jig_show_bool(jig_buf *b, bool v);\nvoid jig_show_char(jig_buf *b, uint32_t c, bool nested);\nvoid jig_show_str(jig_buf *b, const jig_str *s, bool nested);\nuint64_t jig_hash_u64(uint64_t x);\nuint64_t jig_hash_combine(uint64_t h, uint64_t x);\nstatic inline uint64_t jig_hash_f64(double d) {\n    uint64_t u;\n    memcpy(&u, &d, 8);\n    return jig_hash_u64(u);\n}\n\n/* ---- characters ---- */\nbool jig_char_is_digit(uint32_t c);\nbool jig_char_is_alpha(uint32_t c);\nbool jig_char_is_alnum(uint32_t c);\nbool jig_char_is_space(uint32_t c);\nbool jig_char_is_upper(uint32_t c);\nbool jig_char_is_lower(uint32_t c);\nuint32_t jig_char_to_upper(uint32_t c);\nuint32_t jig_char_to_lower(uint32_t c);\nvoid jig_char_invalid(int64_t v, const char *loc) __attribute__((noreturn, cold));\nstatic inline uint32_t jig_char_from_int(int64_t v, const char *loc) {\n    if (__builtin_expect((uint64_t)v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF), 0)) jig_char_invalid(v, loc);\n    return (uint32_t)v;\n}\n\n/* ---- effects ---- */\nvoid jig_print(const jig_str *s, bool newline, bool err);\njig_str *jig_read_line(bool *ok);\njig_str *jig_read_all(void);\njig_str *jig_read_n(int64_t n, const char *loc);\njig_str *jig_fs_read(const jig_str *path, bool *ok);\njig_str *jig_fs_write(const jig_str *path, const jig_str *contents, bool *ok);\nbool jig_fs_exists(const jig_str *path);\njig_list *jig_fs_list(const jig_str *dir, bool *ok, jig_str **err);\njig_list *jig_args(void);\njig_str *jig_env_var(const jig_str *name, bool *ok);\nint64_t jig_now_ms(void);\nint64_t jig_now_ns(void);\nvoid jig_sleep_ms(int64_t ms, const char *loc);\njig_str *jig_net_request(const jig_str *addr, const jig_str *req, bool *ok);\njig_str *jig_net_fetch(const jig_str *addr, const jig_str *req, bool tls, bool *ok);\n/* Runs a serve handler on *state in place and returns the reply. */\ntypedef jig_str *(*jig_serve_call)(jig_fn *f, void *state, jig_str *req);\njig_str *jig_net_serve(const jig_str *addr, void *state, jig_fn *f, jig_serve_call call, int64_t limit, bool *ok,\n                       const char *loc);\njig_str *jig_net_serve_http(const jig_str *addr, void *state, jig_fn *f, jig_serve_call call, int64_t limit,\n                            bool *ok, const char *loc);\n/* A stateless handler: reply = f(req). */\ntypedef jig_str *(*jig_handle_call)(jig_fn *f, jig_str *req);\njig_str *jig_net_serve_parallel(const jig_str *addr, jig_fn *f, jig_handle_call call, int64_t limit,\n                                int64_t *served, bool *ok, const char *loc);\nint64_t jig_rand_int(int64_t lo, int64_t hi, const char *loc);\ndouble jig_rand_float(void);\n\n/* Element types the runtime itself needs. */\nextern const jig_type jig_type_str;\nextern const jig_type jig_type_u8;\n\n/* A `List<U8>` argument to a C function: its bytes (an empty list gives a valid, empty\n   buffer). And `&mut List<U8>`: the list is made unique first, so what C writes lands in\n   this list only. */\nstatic inline const uint8_t *jig_list_bytes(const jig_list *l) {\n    static const uint8_t none[1];\n    return l && l->len ? (const uint8_t *)l->data : none;\n}\nstatic inline uint8_t *jig_list_bytes_mut(jig_list **lp) {\n    static uint8_t none[1];\n    if (!*lp || !(*lp)->len) return none;\n    if ((*lp)->rc != 1) jig_list_make_unique(lp, &jig_type_u8);\n    return (uint8_t *)(*lp)->data;\n}\nextern const jig_type jig_type_char;\n\n#endif\n"

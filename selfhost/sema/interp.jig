// The MIR interpreter, ported from the bootstrap compiler's `mir/interp.rs`: the deterministic
// test runner. Values follow the language's own value semantics. `&mut` parameters are copy-in
// and copy-out. Arithmetic, indexing and casts are checked. Every effect is faked: console I/O
// is captured, the clock and random numbers are deterministic, and the file system is in
// memory. `intrinsics.jig` holds the built-in operations.

import "syntax"

enum Value {
  Unit
  Bool(b: Bool)
  /// Every integer type except `U64`.
  Int(i: Int)
  UInt(u: U64)
  Float(f: Float)
  Char(c: Int)
  Str(s: Str)
  /// Structs and tuples.
  Tuple(xs: List<Value>)
  Variant(tag: Int, xs: List<Value>)
  List(xs: List<Value>)
  Map(m: OMap)
  Set(m: OMap)
  Fn(f: Int)
  Closure(f: Int, env: List<Value>)
}

/// An insertion-ordered map, indexed by a canonical text of each key.
struct OMap {
  keys: List<Value>
  vals: List<Value>
  index: Map<Str, Int>
}

fn new_omap() -> OMap {
  return OMap { keys: [], vals: [], index: Map.new() }
}

/// A text that two keys share exactly when they are equal.
fn key_text(v: Value) -> Str {
  return match v {
    Unit => "u"
    Bool(b) => if b { "t" } else { "f" }
    Int(i) => "i" + i.str()
    UInt(u) => "w" + u.str()
    Float(f) => "d" + f.str()
    Char(c) => "c" + c.str()
    Str(s) => "s" + s.len().str() + ":" + s
    Tuple(xs) | List(xs) => {
      var o = "(" + xs.len().str()
      for x in xs {
        o += " " + key_text(x)
      }
      o + ")"
    }
    Variant(t, xs) => {
      var o = "v" + t.str() + "("
      for x in xs {
        o += " " + key_text(x)
      }
      o + ")"
    }
    Map(m) | Set(m) => {
      var o = "m" + m.keys.len().str() + "("
      for k in m.keys {
        o += " " + key_text(k)
      }
      o + ")"
    }
    Fn(f) => "g" + f.str()
    Closure(f, _) => "g" + f.str()
  }
}

fn OMap.get(self, k: Value) -> Option<Value> {
  return match self.index.get(key_text(k)) {
    Some(i) => Some(self.vals[i])
    None => None
  }
}

fn OMap.contains(self, k: Value) -> Bool {
  return self.index.contains(key_text(k))
}

fn OMap.insert(&mut self, k: Value, v: Value) {
  let t = key_text(k)
  match self.index.get(t) {
    Some(i) => self.vals[i] = v
    None => {
      self.index.insert(t, self.keys.len())
      self.keys.push(k)
      self.vals.push(v)
    }
  }
}

fn OMap.remove(&mut self, k: Value) -> Option<Value> {
  let t = key_text(k)
  let i = match self.index.get(t) {
    Some(i) => i
    None => {
      return None
    }
  }
  let _ = self.index.remove(t)
  let _ = self.keys.remove(i)
  let v = self.vals.remove(i)
  for j in i..self.keys.len() {
    self.index.insert(key_text(self.keys[j]), j)
  }
  return Some(v)
}

fn val_eq(a: Value, b: Value) -> Bool {
  match (a, b) {
    (Unit, Unit) => {
      return true
    }
    (Bool(x), Bool(y)) => {
      return x == y
    }
    (Int(x), Int(y)) => {
      return x == y
    }
    (UInt(x), UInt(y)) => {
      return x == y
    }
    (Float(x), Float(y)) => {
      return x == y
    }
    (Char(x), Char(y)) => {
      return x == y
    }
    (Str(x), Str(y)) => {
      return x == y
    }
    (Tuple(x), Tuple(y)) | (List(x), List(y)) => {
      if x.len() != y.len() {
        return false
      }
      for i in 0..x.len() {
        if !val_eq(x[i], y[i]) {
          return false
        }
      }
      return true
    }
    (Variant(s, x), Variant(t, y)) => {
      if s != t {
        return false
      }
      for i in 0..min(x.len(), y.len()) {
        if !val_eq(x[i], y[i]) {
          return false
        }
      }
      return true
    }
    (Map(x), Map(y)) => {
      if x.keys.len() != y.keys.len() {
        return false
      }
      for i in 0..x.keys.len() {
        let same = match y.get(x.keys[i]) {
          Some(w) => val_eq(x.vals[i], w)
          None => false
        }
        if !same {
          return false
        }
      }
      return true
    }
    (Set(x), Set(y)) => {
      if x.keys.len() != y.keys.len() {
        return false
      }
      for k in x.keys {
        if !y.contains(k) {
          return false
        }
      }
      return true
    }
    _ => {
      return false
    }
  }
}

/// -1, 0 or 1.
fn val_cmp(a: Value, b: Value) -> Int {
  match (a, b) {
    (Bool(x), Bool(y)) => {
      return cmp_int(if x { 1 } else { 0 }, if y { 1 } else { 0 })
    }
    (Int(x), Int(y)) => {
      return cmp_int(x, y)
    }
    (UInt(x), UInt(y)) => {
      return if x < y { -1 } else if x > y { 1 } else { 0 }
    }
    (Float(x), Float(y)) => {
      return if x < y { -1 } else if x > y { 1 } else { 0 }
    }
    (Char(x), Char(y)) => {
      return cmp_int(x, y)
    }
    (Str(x), Str(y)) => {
      return if x < y { -1 } else if x > y { 1 } else { 0 }
    }
    (Tuple(x), Tuple(y)) | (List(x), List(y)) => {
      for i in 0..min(x.len(), y.len()) {
        let c = val_cmp(x[i], y[i])
        if c != 0 {
          return c
        }
      }
      return cmp_int(x.len(), y.len())
    }
    (Variant(s, x), Variant(t, y)) => {
      if s != t {
        return cmp_int(s, t)
      }
      for i in 0..min(x.len(), y.len()) {
        let c = val_cmp(x[i], y[i])
        if c != 0 {
          return c
        }
      }
      return 0
    }
    _ => {
      return 0
    }
  }
}

fn cmp_int(a: Int, b: Int) -> Int {
  return if a < b { -1 } else if a > b { 1 } else { 0 }
}

enum Trap {
  Panic(msg: Str, span: syntax.Span, backtrace: List<Str>)
  Exit(code: Int)
}

/// How effects behave: all faked.
struct Effects {
  stdout: Str
  stderr: Str
  stdin: List<Str>
  stdin_pos: Int
  args: List<Str>
  env: Map<Str, Str>
  files: Map<Str, Str>
  clock_ms: Int
  rng: U64
  /// Simulated network: queued replies and received requests per server address, and queued
  /// client requests and sent replies per address `net.serve` listens on.
  net_replies: Map<Str, List<Str>>
  net_requests: Map<Str, List<Str>>
  net_incoming: Map<Str, List<Str>>
  net_answers: Map<Str, List<Str>>
}

fn fake_effects(seed: U64) -> Effects {
  return Effects {
    stdout: ""
    stderr: ""
    stdin: []
    stdin_pos: 0
    args: ["test"]
    env: Map.new()
    files: Map.new()
    clock_ms: 1700000000000
    rng: seed | 1
    net_replies: Map.new()
    net_requests: Map.new()
    net_incoming: Map.new()
    net_answers: Map.new()
  }
}

fn Effects.next_rand(&mut self) -> U64 {
  // xorshift64*
  var x = self.rng
  x = x ^ (x >> 12)
  x = x ^ (x << 25)
  x = x ^ (x >> 27)
  self.rng = x
  return x.wrapping_mul(2685821657736338717)
}

struct Interp {
  lw: Lw
  fx: Effects
  /// The working directory, which locations are relative to.
  cwd: Str
  /// The function and the statement each active call is at.
  stack: List<(Int, syntax.Span)>
  /// Remaining steps before the run is stopped (guards tests against infinite loops).
  fuel: Int
}

const MAX_DEPTH: Int = 20000

fn new_interp(lw: Lw, fx: Effects, cwd: Str) -> Interp {
  return Interp { lw: lw, fx: fx, cwd: cwd, stack: [], fuel: 9223372036854775807 }
}

/// `path:line:col` for a global offset, as diagnostics name places.
fn Interp.location(self, lo: Int) -> Str {
  match self.lw.s.src_file_at(lo) {
    Some(f) => {
      var line = 1
      var col = 1
      let end = min(lo - f.base, f.text.len())
      for i in 0..end {
        if f.text[i] == 10 {
          line += 1
          col = 1
        } else if (f.text[i] as Int) < 128 || (f.text[i] as Int) >= 192 {
          col += 1
        }
      }
      return display_path(f.path, self.cwd) + ":" + line.str() + ":" + col.str()
    }
    None => {
      return ""
    }
  }
}

/// A path relative to the working directory when it is inside it.
fn display_path(path: Str, cwd: Str) -> Str {
  let prefix = join_path(cwd, "")
  return if !cwd.is_empty() && path.starts_with(prefix) {
    path[prefix.len()..path.len()]
  } else {
    path
  }
}

fn Interp.panic(self, msg: Str, span: syntax.Span) -> Trap {
  var bt: List<Str> = []
  var i = self.stack.len()
  for i > 0 && bt.len() < 32 {
    i -= 1
    let (f, s) = self.stack[i]
    bt.push(self.lw.mir.fns[f].name + " at " + self.location(s.lo))
  }
  return Trap.Panic(msg, span, bt)
}

/// Call a function with argument values (which it takes, leaving `()`): the result and the
/// final values of `&mut` parameters.
fn Interp.call(&mut self, f: Int, args: &mut List<Value>) -> Result<(Value, List<Value>), Trap> {
  self.lw.ensure_lowered(f)
  let code = self.lw.mir.fns[f]
  match code.intrinsic {
    Some(intr) => {
      let span = if self.stack.is_empty() { code.span } else { self.stack[self.stack.len() - 1].1 }
      return self.intrinsic(intr, &mut args, span)
    }
    None => {}
  }
  if self.stack.len() >= MAX_DEPTH {
    return Err(self.panic("stack overflow: recursion too deep", code.span))
  }
  self.stack.push((f, code.span))
  let r = self.run(code, &mut args)
  let _ = self.stack.pop()
  return r
}

fn Interp.run(&mut self, code: MFn, args: &mut List<Value>) -> Result<(Value, List<Value>), Trap> {
  var locals = [Value.Unit].repeat(code.locals.len())
  for i in 0..min(code.params.len(), args.len()) {
    locals[code.params[i].0] = take_at(&mut args, i)
  }
  var bb = 0
  for {
    let block = code.blocks[bb]
    for ss in block.stmts {
      let span = ss.span
      let top = self.stack.len() - 1
      self.stack[top] = (self.stack[top].0, span)
      if self.fuel == 0 {
        return Err(self.panic("step limit exceeded (infinite loop?)", span))
      }
      self.fuel -= 1
      match ss.stmt {
        Assign(p, rv) => {
          let v = self.rvalue(rv, &mut locals, span)?
          self.write(&mut locals, p, v, span)?
        }
        Check(cond, kind, msg, values, cspan) => {
          let c = self.operand(cond, locals, cspan)?
          let ok = match c {
            Bool(b) => b
            _ => false
          }
          if !ok {
            let what = match kind {
              Assert => "assertion failed"
              Precondition => "precondition failed"
              Postcondition => "postcondition failed"
              Invariant => "invariant failed"
              Refinement => "refinement failed"
            }
            var m = what + ": " + msg
            for cv in values {
              let v = self.operand(cv.op, locals, cspan)?
              m += "\n  " + cv.label + " = " + self.show(v, cv.ty, true)?
            }
            return Err(self.panic(m, cspan))
          }
        }
        Drop(l) => locals[l] = Value.Unit
      }
    }
    match block.term {
      Goto(b) => bb = b
      If(c, t, e) => {
        bb = match self.operand(c, locals, block.term_span)? {
          Bool(b) => if b { t } else { e }
          _ => e
        }
      }
      Switch(op, cases, default) => {
        let v = match self.operand(op, locals, block.term_span)? {
          Int(i) => i
          UInt(u) => if u > 9223372036854775807 { -2 } else { u as Int }
          _ => -1
        }
        var target = default
        for (k, b) in cases {
          if k == v {
            target = b
            break
          }
        }
        bb = target
      }
      Return => {
        break
      }
      Unreachable => {
        return Err(self.panic("entered unreachable code", block.term_span))
      }
    }
  }
  var outs: List<Value> = []
  for (l, m) in code.params {
    if m == Mode.MutRef {
      outs.push(locals[l])
    }
  }
  return Ok((locals[0], outs))
}

// ---------- places ----------

fn Interp.index_of(self, op: Operand, locals: List<Value>, span: syntax.Span) -> Result<Int, Trap> {
  return match self.operand(op, locals, span)? {
    Int(i) => Ok(i)
    UInt(u) => Ok(if u > 9223372036854775807 { -1 } else { u as Int })
    _ => Err(self.panic("index is not an integer", span))
  }
}

fn oob(i: Int, n: Int) -> Str {
  return "index out of bounds: the index is " + i.str() + " but the length is " + n.str()
}

fn Interp.read(self, locals: List<Value>, p: Place, span: syntax.Span) -> Result<Value, Trap> {
  var v = locals[p.local]
  for e in p.proj {
    v = match (e, v) {
      (Field(i), Tuple(xs)) => xs[i]
      (VariantField(t, i), Variant(tag, xs)) => {
        if tag != t {
          return Err(self.panic("internal error: wrong variant", span))
        }
        xs[i]
      }
      (Index(op, _), List(xs)) => {
        let i = self.index_of(op, locals, span)?
        if i < 0 || i >= xs.len() {
          return Err(self.panic(oob(i, xs.len()), span))
        }
        xs[i]
      }
      _ => {
        return Err(self.panic("internal error: bad place projection", span))
      }
    }
  }
  return Ok(v)
}

fn Interp.write(
  self,
  locals: &mut List<Value>,
  p: Place,
  val: Value,
  span: syntax.Span,
) -> Result<(), Trap> {
  if p.proj.is_empty() {
    locals[p.local] = val
    return Ok(())
  }
  // Evaluate index operands first.
  var idx: List<Int> = []
  for e in p.proj {
    match e {
      Index(op, _) => idx.push(self.index_of(op, locals, span)?)
      _ => {}
    }
  }
  var slot = locals[p.local]
  locals[p.local] = Value.Unit
  let r = self.write_into(&mut slot, p.proj, 0, idx, 0, val, span)
  locals[p.local] = slot
  return r
}

/// Write `val` at `proj[k..]` inside `v`, taking each part out while it changes so the change
/// happens in place.
fn Interp.write_into(
  self,
  v: &mut Value,
  proj: List<PlaceElem>,
  k: Int,
  idx: List<Int>,
  ki: Int,
  val: Value,
  span: syntax.Span,
) -> Result<(), Trap> {
  if k == proj.len() {
    v = val
    return Ok(())
  }
  let whole = v
  v = Value.Unit
  let shape = match (proj[k], whole) {
    (Field(_), Tuple(_)) => -1
    (VariantField(_, _), Variant(t, _)) => t
    (Index(_, _), List(_)) => -2
    _ => -3
  }
  if shape == -3 {
    v = whole
    return Err(self.panic("internal error: cannot write through a projection", span))
  }
  // The parts, moved out so that the write happens in place.
  var xs = items_of(whole)
  let i = match proj[k] {
    Field(f) => f
    VariantField(_, f) => f
    Index(_, _) => idx[ki]
  }
  if shape == -2 && (i < 0 || i >= xs.len()) {
    let n = xs.len()
    v = rebuilt(shape, xs)
    return Err(self.panic(oob(i, n), span))
  }
  let next = if shape == -2 { ki + 1 } else { ki }
  let r = self.write_into(&mut xs[i], proj, k + 1, idx, next, val, span)
  v = rebuilt(shape, xs)
  return r
}

/// A tuple or struct (shape -1), list (-2) or variant `shape` of these parts.
fn rebuilt(shape: Int, xs: List<Value>) -> Value {
  return if shape == -1 {
    Value.Tuple(xs)
  } else if shape == -2 {
    Value.List(xs)
  } else {
    Value.Variant(shape, xs)
  }
}

/// The parts of a tuple, struct, variant or list, which `v` gives up.
fn items_of(v: Value) -> List<Value> {
  return match v {
    Tuple(xs) | List(xs) => xs
    Variant(_, xs) => xs
    _ => []
  }
}

/// Move a value out of a place (for `&mut` arguments), leaving `()` behind.
fn Interp.take(self, locals: &mut List<Value>, p: Place, span: syntax.Span) -> Result<Value, Trap> {
  if p.proj.is_empty() {
    let v = locals[p.local]
    locals[p.local] = Value.Unit
    return Ok(v)
  }
  let v = self.read(locals, p, span)?
  self.write(&mut locals, p, Value.Unit, span)?
  return Ok(v)
}

fn Interp.operand(
  self,
  op: Operand,
  locals: List<Value>,
  span: syntax.Span,
) -> Result<Value, Trap> {
  return match op {
    Copy(p) => self.read(locals, p, span)
    Const(c) => Ok(const_value(c))
  }
}

fn const_value(c: Const) -> Value {
  return match c {
    Int(neg, mag, k) => {
      if k == IntTy.U64 {
        Value.UInt(mag)
      } else if neg {
        Value.Int(
          if mag == 9223372036854775808 { -9223372036854775807 - 1 } else { 0 - (mag as Int) },
        )
      } else {
        Value.Int(mag as Int)
      }
    }
    Float(f) => Value.Float(f)
    Bool(b) => Value.Bool(b)
    Char(ch) => Value.Char(ch)
    Str(s) => Value.Str(s)
    Unit => Value.Unit
    Fn(f) => Value.Fn(f)
  }
}

// ---------- rvalues ----------

fn Interp.rvalue(
  &mut self,
  rv: Rvalue,
  locals: &mut List<Value>,
  span: syntax.Span,
) -> Result<Value, Trap> {
  match rv {
    Use(op) => {
      return self.operand(op, locals, span)
    }
    Binary(op, a, b, ty) => {
      let x = self.operand(a, locals, span)?
      let y = self.operand(b, locals, span)?
      return self.binary(op, x, y, ty, span)
    }
    Unary(op, a, ty) => {
      let x = self.operand(a, locals, span)?
      return self.unary(op, x, ty, span)
    }
    Cast(a, _, to) => {
      let x = self.operand(a, locals, span)?
      return self.cast(x, to, span)
    }
    Inc(a, _) => {
      return match self.operand(a, locals, span)? {
        Int(i) => Ok(Value.Int(i.wrapping_add(1)))
        UInt(u) => Ok(Value.UInt(u.wrapping_add(1)))
        v => Ok(v)
      }
    }
    Aggregate(kind, _, ops) => {
      var vals: List<Value> = []
      for o in ops {
        vals.push(self.operand(o, locals, span)?)
      }
      return Ok(
        match kind {
          Tuple | Struct(_) => Value.Tuple(vals)
          Variant(_, v) => Value.Variant(v, vals)
          List => Value.List(vals)
        },
      )
    }
    Discriminant(p) => {
      return match self.read(locals, p, span)? {
        Variant(t, _) => Ok(Value.Int(t))
        _ => Err(self.panic("internal error: discriminant of a value that is not a variant", span))
      }
    }
    Closure(f, caps) => {
      var env: List<Value> = []
      for c in caps {
        env.push(self.operand(c, locals, span)?)
      }
      return Ok(Value.Closure(f, env))
    }
    Call(callee, args, ret) => {
      var vals: List<Value> = []
      var mut_places: List<Place> = []
      for a in args {
        match a {
          Value(o) => vals.push(self.operand(o, locals, span)?)
          MutRef(p) => {
            vals.push(self.take(&mut locals, p, span)?)
            mut_places.push(p)
          }
        }
      }
      let (r, outs) = match callee {
        Fn(f) => self.call(f, &mut vals)?
        Intrinsic(i) => self.intrinsic(i, &mut vals, span)?
        Ffi(name) => {
          let _ = ret
          return Err(self.panic("C functions cannot run in the test runner: `" + name + "`", span))
        }
        Value(op) => match self.operand(op, locals, span)? {
          Fn(f) => self.call(f, &mut vals)?
          Closure(f, env) => {
            var all = env
            all.extend(vals)
            self.call(f, &mut all)?
          }
          _ => {
            return Err(self.panic("internal error: calling a value that is not a function", span))
          }
        }
      }
      for i in 0..min(mut_places.len(), outs.len()) {
        self.write(&mut locals, mut_places[i], outs[i], span)?
      }
      return Ok(r)
    }
  }
}

// ---------- arithmetic ----------

fn Interp.int_kind(self, ty: Int) -> IntTy {
  return match self.lw.s.tys.kinds[ty] {
    Int(k, _) => k
    _ => IntTy.I64
  }
}

/// An integer value as a sign and a magnitude.
fn wide_of(v: Value) -> (Bool, U64) {
  return match v {
    Int(i) => if i < 0 { (true, neg_mag(i)) } else { (false, i as U64) }
    UInt(u) => (false, u)
    Char(c) => (false, c as U64)
    Bool(b) => (false, if b { 1 } else { 0 })
    _ => (false, 0)
  }
}

/// The magnitude of a negative Int.
fn neg_mag(i: Int) -> U64 {
  return if i == -9223372036854775807 - 1 { 9223372036854775808 } else { (0 - i) as U64 }
}

fn wide_text(w: (Bool, U64)) -> Str {
  return if w.0 && w.1 != 0 { "-" + w.1.str() } else { w.1.str() }
}

fn int_text(v: Value) -> Str {
  return wide_text(wide_of(v))
}

/// Whether a value (sign and magnitude) fits in `k`.
fn wide_fits(w: (Bool, U64), k: IntTy) -> Bool {
  let (neg, mag) = w
  if neg && mag != 0 {
    return match k {
      I64 => mag <= 9223372036854775808
      I32 => mag <= 2147483648
      _ => false
    }
  }
  return match k {
    I64 => mag <= 9223372036854775807
    I32 => mag <= 2147483647
    U8 => mag <= 255
    U32 => mag <= 4294967295
    U64 => true
  }
}

fn wide_value(w: (Bool, U64), k: IntTy) -> Value {
  let (neg, mag) = w
  if k == IntTy.U64 {
    return Value.UInt(mag)
  }
  if neg && mag != 0 {
    return Value.Int(
      if mag == 9223372036854775808 { -9223372036854775807 - 1 } else { 0 - (mag as Int) },
    )
  }
  return Value.Int(mag as Int)
}

/// Exact decimal arithmetic on signed digit strings, for the messages of overflowing
/// operations (whose results do not fit in 64 bits).
fn dec_cmp_mag(a: Str, b: Str) -> Int {
  if a.len() != b.len() {
    return cmp_int(a.len(), b.len())
  }
  return if a < b { -1 } else if a > b { 1 } else { 0 }
}

fn dec_strip(s: Str) -> Str {
  var i = 0
  for i + 1 < s.len() && s[i] == 48 {
    i += 1
  }
  return s[i..s.len()]
}

fn dec_add_mag(a: Str, b: Str) -> Str {
  var out: List<Char> = []
  var carry = 0
  var i = a.len()
  var j = b.len()
  for i > 0 || j > 0 || carry > 0 {
    var d = carry
    if i > 0 {
      i -= 1
      d += a[i] as Int - 48
    }
    if j > 0 {
      j -= 1
      d += b[j] as Int - 48
    }
    out.push((48 + d % 10) as Char)
    carry = d / 10
  }
  out.reverse()
  return dec_strip(Str.from_chars(out))
}

/// `a - b` for magnitudes with `a >= b`.
fn dec_sub_mag(a: Str, b: Str) -> Str {
  var out: List<Char> = []
  var borrow = 0
  var i = a.len()
  var j = b.len()
  for i > 0 {
    i -= 1
    var d = a[i] as Int - 48 - borrow
    if j > 0 {
      j -= 1
      d -= b[j] as Int - 48
    }
    borrow = if d < 0 { 1 } else { 0 }
    out.push((48 + d + borrow * 10) as Char)
  }
  out.reverse()
  return dec_strip(Str.from_chars(out))
}

fn dec_mul_mag(a: Str, b: Str) -> Str {
  var acc = [0].repeat(a.len() + b.len())
  for i in 0..a.len() {
    for j in 0..b.len() {
      acc[i + j + 1] += (a[i] as Int - 48) * (b[j] as Int - 48)
    }
  }
  var k = acc.len() - 1
  for k > 0 {
    acc[k - 1] += acc[k] / 10
    acc[k] = acc[k] % 10
    k -= 1
  }
  var out: List<Char> = []
  for d in acc {
    out.push((48 + d) as Char)
  }
  return dec_strip(Str.from_chars(out))
}

/// `a + b` (with `sub`, `a - b`) for signed decimals.
fn dec_add(a: (Bool, Str), b: (Bool, Str), sub: Bool) -> (Bool, Str) {
  let bn = if sub { !b.0 } else { b.0 }
  if a.0 == bn {
    return (a.0, dec_add_mag(a.1, b.1))
  }
  let c = dec_cmp_mag(a.1, b.1)
  if c == 0 {
    return (false, "0")
  }
  return if c > 0 { (a.0, dec_sub_mag(a.1, b.1)) } else { (bn, dec_sub_mag(b.1, a.1)) }
}

fn dec_text(d: (Bool, Str)) -> Str {
  return if d.0 && d.1 != "0" { "-" + d.1 } else { d.1 }
}

fn Interp.overflow(self, expr: Str, v: Str, k: IntTy, span: syntax.Span) -> Trap {
  return self.panic(
    "arithmetic overflow: " + expr + " = " + v + " does not fit in `" + k.name() + "`",
    span,
  )
}

/// `x op y` as an overflow or division error shows it.
fn op_text(x: Value, op: syntax.BinOp, y: Value) -> Str {
  return int_text(x) + " " + op.text() + " " + int_text(y)
}

/// The value `w` of `x op y` as type `k`, or the overflow error.
fn Interp.fit_op(
  self,
  w: (Bool, U64),
  k: IntTy,
  span: syntax.Span,
  x: Value,
  op: syntax.BinOp,
  y: Value,
) -> Result<Value, Trap> {
  if !wide_fits(w, k) {
    return Err(self.overflow(op_text(x, op, y), wide_text(w), k, span))
  }
  return Ok(wide_value(w, k))
}

/// The value `w` as type `k`, or the overflow error for `expr`.
fn Interp.fit(self, w: (Bool, U64), k: IntTy, span: syntax.Span, expr: Str) -> Result<Value, Trap> {
  if !wide_fits(w, k) {
    return Err(self.overflow(expr, wide_text(w), k, span))
  }
  return Ok(wide_value(w, k))
}

/// The low bits of an Int as a value of type `k` (not U64).
fn wrap_int(r: Int, k: IntTy) -> Value {
  return match k {
    I32 => {
      let m = r & 4294967295
      Value.Int(if m >= 2147483648 { m - 4294967296 } else { m })
    }
    U32 => Value.Int(r & 4294967295)
    U8 => Value.Int(r & 255)
    _ => Value.Int(r)
  }
}

fn Interp.binary(
  self,
  op: syntax.BinOp,
  x: Value,
  y: Value,
  ty: Int,
  span: syntax.Span,
) -> Result<Value, Trap> {
  match op {
    Eq => {
      return Ok(Value.Bool(val_eq(x, y)))
    }
    Ne => {
      return Ok(Value.Bool(!val_eq(x, y)))
    }
    Lt | Le | Gt | Ge => {
      match (x, y) {
        (Float(a), Float(b)) => {
          return Ok(
            Value.Bool(
              match op {
                Lt => a < b
                Le => a <= b
                Gt => a > b
                _ => a >= b
              },
            ),
          )
        }
        _ => {}
      }
      let c = val_cmp(x, y)
      return Ok(
        Value.Bool(
          match op {
            Lt => c < 0
            Le => c <= 0
            Gt => c > 0
            _ => c >= 0
          },
        ),
      )
    }
    _ => {}
  }
  match (x, y) {
    (Float(a), Float(b)) => {
      return match op {
        Add => Ok(Value.Float(a + b))
        Sub => Ok(Value.Float(a - b))
        Mul => Ok(Value.Float(a * b))
        Div => Ok(Value.Float(a / b))
        Rem => Ok(Value.Float(a % b))
        _ => Err(self.panic("internal error: bad float op", span))
      }
    }
    _ => {}
  }
  let k = self.int_kind(ty)
  if k == IntTy.U64 {
    return self.binary_u64(op, wide_of(x).1, wide_of(y).1, x, y, span)
  }
  let a = match x {
    Int(i) => i
    Char(c) => c
    Bool(b) => if b { 1 } else { 0 }
    _ => 0
  }
  let b = match y {
    Int(i) => i
    Char(c) => c
    Bool(v) => if v { 1 } else { 0 }
    _ => 0
  }
  match op {
    Add => {
      let r = a.wrapping_add(b)
      if (a >= 0) == (b >= 0) && (r >= 0) != (a >= 0) {
        let d = dec_add((a < 0, wide_of(x).1.str()), (b < 0, wide_of(y).1.str()), false)
        return Err(self.overflow(op_text(x, op, y), dec_text(d), k, span))
      }
      return self.fit_op(wide_of(Value.Int(r)), k, span, x, op, y)
    }
    Sub => {
      let r = a.wrapping_sub(b)
      if (a >= 0) != (b >= 0) && (r >= 0) != (a >= 0) {
        let d = dec_add((a < 0, wide_of(x).1.str()), (b < 0, wide_of(y).1.str()), true)
        return Err(self.overflow(op_text(x, op, y), dec_text(d), k, span))
      }
      return self.fit_op(wide_of(Value.Int(r)), k, span, x, op, y)
    }
    Mul => {
      let r = a.wrapping_mul(b)
      let min = -9223372036854775807 - 1
      let over = if a == -1 { b == min } else if b == -1 { a == min } else { a != 0 && r / a != b }
      if over {
        let m = dec_mul_mag(wide_of(x).1.str(), wide_of(y).1.str())
        return Err(self.overflow(op_text(x, op, y), dec_text(((a < 0) != (b < 0), m)), k, span))
      }
      return self.fit_op(wide_of(Value.Int(r)), k, span, x, op, y)
    }
    Div | Rem => {
      if b == 0 {
        return Err(self.panic("division by zero: " + op_text(x, op, y), span))
      }
      if b == -1 {
        if op == syntax.BinOp.Rem {
          return Ok(Value.Int(0))
        }
        if a == -9223372036854775807 - 1 {
          return Err(self.overflow(op_text(x, op, y), "9223372036854775808", k, span))
        }
        return self.fit_op(wide_of(Value.Int(0 - a)), k, span, x, op, y)
      }
      return self.fit_op(
        wide_of(Value.Int(if op == syntax.BinOp.Div { a / b } else { a % b })),
        k,
        span,
        x,
        op,
        y,
      )
    }
    BitAnd => {
      return Ok(wrap_int(a & b, k))
    }
    BitOr => {
      return Ok(wrap_int(a | b, k))
    }
    BitXor => {
      return Ok(wrap_int(a ^ b, k))
    }
    Shl | Shr => {
      if b < 0 || b >= int_bits(k) {
        return Err(
          self.panic("shift amount " + b.str() + " is out of range for `" + k.name() + "`", span),
        )
      }
      if op == syntax.BinOp.Shl {
        // Shifts wrap within the type's bits (no overflow check).
        return Ok(wrap_int(a << b, k))
      }
      return self.fit_op(wide_of(Value.Int(a >> b)), k, span, x, op, y)
    }
    _ => {
      return Err(self.panic("internal error: bad int op", span))
    }
  }
}

fn Interp.binary_u64(
  self,
  op: syntax.BinOp,
  a: U64,
  b: U64,
  x: Value,
  y: Value,
  span: syntax.Span,
) -> Result<Value, Trap> {
  let k = IntTy.U64
  match op {
    Add => {
      let r = a.wrapping_add(b)
      if r < a {
        return Err(self.overflow(op_text(x, op, y), dec_add_mag(a.str(), b.str()), k, span))
      }
      return Ok(Value.UInt(r))
    }
    Sub => {
      if b > a {
        return Err(self.overflow(op_text(x, op, y), "-" + (b - a).str(), k, span))
      }
      return Ok(Value.UInt(a - b))
    }
    Mul => {
      let r = a.wrapping_mul(b)
      if a != 0 && r / a != b {
        return Err(self.overflow(op_text(x, op, y), dec_mul_mag(a.str(), b.str()), k, span))
      }
      return Ok(Value.UInt(r))
    }
    Div | Rem => {
      if b == 0 {
        return Err(self.panic("division by zero: " + op_text(x, op, y), span))
      }
      return Ok(Value.UInt(if op == syntax.BinOp.Div { a / b } else { a % b }))
    }
    BitAnd => {
      return Ok(Value.UInt(a & b))
    }
    BitOr => {
      return Ok(Value.UInt(a | b))
    }
    BitXor => {
      return Ok(Value.UInt(a ^ b))
    }
    Shl | Shr => {
      if b >= 64 {
        return Err(self.panic("shift amount " + b.str() + " is out of range for `U64`", span))
      }
      let s = b as Int
      return Ok(Value.UInt(if op == syntax.BinOp.Shl { a << s } else { a >> s }))
    }
    _ => {
      return Err(self.panic("internal error: bad int op", span))
    }
  }
}

fn Interp.unary(
  self,
  op: syntax.UnOp,
  x: Value,
  ty: Int,
  span: syntax.Span,
) -> Result<Value, Trap> {
  match (op, x) {
    (Not, Bool(b)) => {
      return Ok(Value.Bool(!b))
    }
    (Neg, Float(f)) => {
      return Ok(Value.Float(0.0 - f))
    }
    (Neg, v) => {
      let k = self.int_kind(ty)
      let (neg, mag) = wide_of(v)
      return self.fit((!neg, mag), k, span, "-(" + int_text(v) + ")")
    }
    (BitNot, v) => {
      let k = self.int_kind(ty)
      return match v {
        UInt(u) => Ok(Value.UInt(~u))
        Int(i) => Ok(wrap_int(~i, k))
        _ => Ok(v)
      }
    }
    _ => {
      return Err(self.panic("internal error: bad unary operation", span))
    }
  }
}

fn trunc(f: Float) -> Float {
  return if f < 0.0 { f.ceil() } else { f.floor() }
}

fn Interp.cast(self, x: Value, to: Int, span: syntax.Span) -> Result<Value, Trap> {
  match self.lw.s.tys.kinds[to] {
    Float(_) => {
      return Ok(
        Value.Float(
          match x {
            Float(f) => f
            UInt(u) => u as Float
            Int(i) => i as Float
            Char(c) => c as Float
            Bool(b) => if b { 1.0 } else { 0.0 }
            _ => 0.0
          },
        ),
      )
    }
    Int(k, _) => {
      let w = match x {
        Float(f) => {
          let t = trunc(f)
          let (lo, hi) = int_float_range(k)
          if f.is_nan() || t < lo || t > hi {
            return Err(
              self.panic(
                "cannot convert " + f.str() + " to `" + k.name() + "`: out of range",
                span,
              ),
            )
          }
          // The bounds as floats round up: 2^63 and 2^64 pass the check above.
          if t == 9223372036854775808.0 && k == IntTy.I64 {
            return Err(
              self.panic("cannot convert 9223372036854775808 to `Int`: out of range", span),
            )
          }
          if t >= 18446744073709551616.0 {
            return Err(
              self.panic(
                "cannot convert 18446744073709551616 to `" + k.name() + "`: out of range",
                span,
              ),
            )
          }
          if t < 0.0 {
            (true, (0.0 - t) as U64)
          } else {
            (false, t as U64)
          }
        }
        _ => wide_of(x)
      }
      if !wide_fits(w, k) {
        return Err(
          self.panic(
            "cannot convert " + wide_text(w) + " to `" + k.name() + "`: out of range",
            span,
          ),
        )
      }
      return Ok(wide_value(w, k))
    }
    Char => {
      let (neg, mag) = wide_of(x)
      let valid = !neg && mag <= 1114111 && (mag < 55296 || mag > 57343)
      if !valid {
        return Err(self.panic(wide_text((neg, mag)) + " is not a valid `Char`", span))
      }
      return Ok(Value.Char(mag as Int))
    }
    _ => {
      return Ok(x)
    }
  }
}

/// A type's bounds as floats, as Rust's `as f64` rounds them.
fn int_float_range(k: IntTy) -> (Float, Float) {
  return match k {
    I64 => (-9223372036854775808.0, 9223372036854775808.0)
    I32 => (-2147483648.0, 2147483647.0)
    U8 => (0.0, 255.0)
    U32 => (0.0, 4294967295.0)
    U64 => (0.0, 18446744073709551616.0)
  }
}

// ---------- display ----------

/// A string as `{:?}` shows it: quoted, with escapes.
fn quoted(s: Str) -> Str {
  let t = [s].str()
  return t[1..t.len() - 1]
}

fn quoted_char(c: Int) -> Str {
  let valid = c >= 0 && c <= 1114111 && (c < 55296 || c > 57343)
  let t = [if valid { c as Char } else { '?' }].str()
  return t[1..t.len() - 1]
}

/// Format a value the way `.str()` does. `nested` quotes strings and characters.
fn Interp.show(&mut self, v: Value, ty: Int, nested: Bool) -> Result<Str, Trap> {
  let kind = self.lw.s.tys.kinds[ty]
  match (v, kind) {
    (Str(s), _) => {
      return Ok(if nested { quoted(s) } else { s })
    }
    (Char(c), _) => {
      if nested {
        return Ok(quoted_char(c))
      }
      let valid = c >= 0 && c <= 1114111 && (c < 55296 || c > 57343)
      return Ok(Str.from_chars([if valid { c as Char } else { '?' }]))
    }
    (Int(i), _) => {
      return Ok(i.str())
    }
    (UInt(u), _) => {
      return Ok(u.str())
    }
    (Float(f), _) => {
      return Ok(f.str())
    }
    (Bool(b), _) => {
      return Ok(if b { "true" } else { "false" })
    }
    (Unit, _) => {
      return Ok("()")
    }
    (List(xs), List(e)) => {
      var parts: List<Str> = []
      for x in xs {
        parts.push(self.show(x, e, true)?)
      }
      return Ok("[" + parts.join(", ") + "]")
    }
    (Set(m), Set(e)) => {
      var parts: List<Str> = []
      for x in m.keys {
        parts.push(self.show(x, e, true)?)
      }
      return Ok("{" + parts.join(", ") + "}")
    }
    (Map(m), Map(kt, vt)) => {
      var parts: List<Str> = []
      for i in 0..m.keys.len() {
        parts.push(self.show(m.keys[i], kt, true)? + ": " + self.show(m.vals[i], vt, true)?)
      }
      return Ok("{" + parts.join(", ") + "}")
    }
    (Tuple(xs), Tuple(ts)) => {
      var parts: List<Str> = []
      for i in 0..min(xs.len(), ts.len()) {
        parts.push(self.show(xs[i], ts[i], true)?)
      }
      return Ok(if parts.len() == 1 { "(" + parts[0] + ",)" } else { "(" + parts.join(", ") + ")" })
    }
    (Tuple(_), Adt(a, args)) | (Variant(_, _), Adt(a, args)) => {
      return self.show_adt(v, a, args)
    }
    (Fn(_), _) | (Closure(_, _), _) => {
      return Ok("<fn>")
    }
    _ => {
      return Ok("?")
    }
  }
}

fn Interp.show_adt(&mut self, v: Value, a: Int, args: List<Int>) -> Result<Str, Trap> {
  // A user-defined `str` takes precedence.
  match self.lw.s.defs.methods.get((TyKey.Adt(a), "str")) {
    Some(f) => {
      let m = self.lw.instance(f, args)
      var one = [v]
      let (r, _) = self.call(m, &mut one)?
      match r {
        Str(s) => {
          return Ok(s)
        }
        _ => {}
      }
    }
    None => {}
  }
  let ad = self.lw.s.defs.adts[a]
  match v {
    Tuple(xs) => {
      if ad.is_enum {
        return Ok("?")
      }
      var parts: List<Str> = []
      for i in 0..min(ad.fields.len(), xs.len()) {
        let ft = self.lw.s.tys.subst(ad.fields[i].ty, args)
        parts.push(ad.fields[i].name + ": " + self.show(xs[i], ft, true)?)
      }
      return Ok(
        if parts.is_empty() { ad.name + " {}" } else { ad.name + " { " + parts.join(", ") + " }" },
      )
    }
    Variant(t, xs) => {
      if !ad.is_enum || t >= ad.variants.len() {
        return Ok("?")
      }
      let var_def = ad.variants[t]
      if xs.is_empty() {
        return Ok(var_def.name)
      }
      var parts: List<Str> = []
      for i in 0..min(var_def.fields.len(), xs.len()) {
        let ft = self.lw.s.tys.subst(var_def.fields[i].ty, args)
        parts.push(self.show(xs[i], ft, true)?)
      }
      return Ok(var_def.name + "(" + parts.join(", ") + ")")
    }
    _ => {
      return Ok("?")
    }
  }
}

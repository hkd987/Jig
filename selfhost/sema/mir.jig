  SimAdvance
  SimSeed
  SimReply
  SimRequests
  SimConnect
  SimAnswers
  NetRequest
  NetServe
  NetServeHttp
  /// `x.str()` with derived formatting (the type in `tys[0]`).
  Show
  StrConcat
  /// `a + b + c + ...`: one string, allocated once.
  StrConcatN
  /// `s[i]`
  StrByte
  /// `s[a..b]`
  StrSlice
  /// `xs[a..b]`
  ListSlice
  /// The next piece of a `for w in s.split("sep")` loop.
  SplitNext
}

/// The intrinsic a bodiless standard library function is.
fn lookup_intrinsic(pkg_path: Str, recv: Option<TyKey>, name: Str) -> Option<(Op, Option<IntTy>)> {
  let op: Option<Op> = match recv {
    None => match pkg_path {
      "<prelude>" => match name {
        "panic" => Some(Op.Panic)
        "assert" => Some(Op.Assert)
        _ => None
      }
      "std/io" => match name {
        "print" => Some(Op.Print)
        "println" => Some(Op.Println)
        "eprintln" => Some(Op.Eprintln)
        "read_line" => Some(Op.ReadLine)
        "read_all" => Some(Op.ReadAll)
        _ => None
      }
      "std/fs" => match name {
        "read" => Some(Op.FsRead)
        "write" => Some(Op.FsWrite)
        "exists" => Some(Op.FsExists)
        "list" => Some(Op.FsList)
        _ => None
      }
      "std/os" => match name {
        "args" => Some(Op.Args)
        "env" => Some(Op.EnvVar)
        "exit" => Some(Op.Exit)
        _ => None
      }
      "std/time" => match name {
        "now_ms" => Some(Op.NowMs)
        "now_ns" => Some(Op.NowNs)
        "sleep" => Some(Op.Sleep)
        _ => None
      }
      "std/sim" => match name {
        "stdout" => Some(Op.SimStdout)
        "stderr" => Some(Op.SimStderr)
        "set_stdin" => Some(Op.SimSetStdin)
        "set_args" => Some(Op.SimSetArgs)
        "set_env" => Some(Op.SimSetEnv)
        "set_file" => Some(Op.SimSetFile)
        "file" => Some(Op.SimFile)
        "remove_file" => Some(Op.SimRemoveFile)
        "set_time" => Some(Op.SimSetTime)
        "advance" => Some(Op.SimAdvance)
        "seed" => Some(Op.SimSeed)
        "reply" => Some(Op.SimReply)
        "requests" => Some(Op.SimRequests)
        "connect" => Some(Op.SimConnect)
        "answers" => Some(Op.SimAnswers)
        _ => None
      }
      "std/net" => match name {
        "request" => Some(Op.NetRequest)
        "serve" => Some(Op.NetServe)
        "serve_http" => Some(Op.NetServeHttp)
        _ => None
      }
      "std/rand" => match name {
        "int" => Some(Op.RandInt)
        "float" => Some(Op.RandFloat)
        _ => None
      }
      "std/task" => match name {
        "all" => Some(Op.TaskAll)
        "map" => Some(Op.TaskMap)
        "both" => Some(Op.TaskBoth)
        _ => None
      }
      "std/math" => match name {
        "sin" => Some(Op.Sin)
        "cos" => Some(Op.Cos)
        "tan" => Some(Op.Tan)
        "atan2" => Some(Op.Atan2)
        "exp" => Some(Op.Exp)
        "ln" => Some(Op.Ln)
        "log10" => Some(Op.Log10)
        "pow" => Some(Op.Pow)
        _ => None
      }
      _ => None
    }
    Some(key) => if pkg_path != "<prelude>" { None } else { lookup_method_intrinsic(key, name) }
  }
  let int = match recv {
    Some(Int(k)) => Some(k)
    _ => None
  }
  return match op {
    Some(o) => Some((o, int))
    None => None
  }
}

fn lookup_method_intrinsic(key: TyKey, name: Str) -> Option<Op> {
  return match key {
    Int(_) => match name {
      "abs" => Some(Op.IntAbs)
      "min" => Some(Op.IntMin)
      "max" => Some(Op.IntMax)
      "pow" => Some(Op.IntPow)
      "wrapping_add" => Some(Op.WrappingAdd)
      "wrapping_sub" => Some(Op.WrappingSub)
      "wrapping_mul" => Some(Op.WrappingMul)
      _ => None
    }
    Float => match name {
      "abs" => Some(Op.FloatAbs)
      "sqrt" => Some(Op.Sqrt)
      "floor" => Some(Op.Floor)
      "ceil" => Some(Op.Ceil)
      "round" => Some(Op.Round)
      "min" => Some(Op.FloatMin)
      "max" => Some(Op.FloatMax)
      "is_nan" => Some(Op.IsNan)
      _ => None
    }
    Char => match name {
      "is_digit" => Some(Op.IsDigit)
      "is_alpha" => Some(Op.IsAlpha)
      "is_alnum" => Some(Op.IsAlnum)
      "is_space" => Some(Op.IsSpace)
      "is_upper" => Some(Op.IsUpper)
      "is_lower" => Some(Op.IsLower)
      "to_upper" => Some(Op.CharToUpper)
      "to_lower" => Some(Op.CharToLower)
      _ => None
    }
    Str => match name {
      "len" => Some(Op.StrLen)
      "is_empty" => Some(Op.StrIsEmpty)
      "contains" => Some(Op.StrContains)
      "starts_with" => Some(Op.StartsWith)
      "ends_with" => Some(Op.EndsWith)
      "find" => Some(Op.StrFind)
      "split" => Some(Op.Split)
      "lines" => Some(Op.Lines)
      "trim" => Some(Op.Trim)
      "replace" => Some(Op.Replace)
      "repeat" => Some(Op.Repeat)
      "to_upper" => Some(Op.StrToUpper)
      "to_lower" => Some(Op.StrToLower)
      "to_int" => Some(Op.ToInt)
      "to_float" => Some(Op.ToFloat)
      "bytes" => Some(Op.Bytes)
      "chars" => Some(Op.Chars)
      "from_chars" => Some(Op.FromChars)
      "from_bytes" => Some(Op.FromBytes)
      _ => None
    }
    List => match name {
      "new" => Some(Op.ListNew)
      "len" => Some(Op.ListLen)
      "is_empty" => Some(Op.ListIsEmpty)
      "push" => Some(Op.Push)
      "pop" => Some(Op.Pop)
      "get" => Some(Op.Get)
      "insert" => Some(Op.Insert)
      "remove" => Some(Op.Remove)
      "clear" => Some(Op.Clear)
      "extend" => Some(Op.Extend)
      "reverse" => Some(Op.Reverse)
      "swap" => Some(Op.Swap)
      "truncate" => Some(Op.Truncate)
      "repeat" => Some(Op.ListRepeat)
      "sort" => Some(Op.Sort)
      "sort_by" => Some(Op.SortBy)
      _ => None
    }
    Map => match name {
      "new" => Some(Op.MapNew)
      "len" => Some(Op.MapLen)
      "is_empty" => Some(Op.MapIsEmpty)
      "get" => Some(Op.MapGet)
      "insert" => Some(Op.MapInsert)
      "remove" => Some(Op.MapRemove)
      "contains" => Some(Op.MapContains)
      "keys" => Some(Op.Keys)
      "values" => Some(Op.Values)
      "entries" => Some(Op.Entries)
      _ => None
    }
    Set => match name {
      "new" => Some(Op.SetNew)
      "len" => Some(Op.SetLen)
      "is_empty" => Some(Op.SetIsEmpty)
      "insert" => Some(Op.SetInsert)
      "remove" => Some(Op.SetRemove)
      "contains" => Some(Op.SetContains)
      "items" => Some(Op.Items)
      _ => None
    }
    _ => None
  }
}

// MIR, ported from the bootstrap compiler's `mir/mod.rs` and `mir/intrinsics.rs`: a
// monomorphized control-flow graph per function instance. Local 0 is the return slot;
// parameters follow (captured values first for closures, then `self`, then the declared
// parameters). `&mut` parameters are written back when the call returns.

import "syntax"

enum PlaceElem {
  /// Field `i` of a struct or tuple.
  Field(i: Int)
  /// Field `i` of enum variant `v` (the value must be that variant).
  VariantField(v: Int, i: Int)
  /// An element of a list, bounds-checked; a dummy span means in bounds by construction.
  Index(op: Operand, span: syntax.Span)
}

struct Place {
  local: Int
  proj: List<PlaceElem>
}

fn place_of(l: Int) -> Place
  ensures result.local == l && result.proj.is_empty()
{
  return Place { local: l, proj: [] }
}

fn Place.field(self, i: Int) -> Place
  ensures result.local == self.local && result.proj.len() == self.proj.len() + 1
{
  var p = self
  p.proj.push(PlaceElem.Field(i))
  return p
}

fn Place.variant_field(self, v: Int, i: Int) -> Place
  ensures result.local == self.local && result.proj.len() == self.proj.len() + 1
{
  var p = self
  p.proj.push(PlaceElem.VariantField(v, i))
  return p
}

fn Place.index(self, op: Operand, span: syntax.Span) -> Place
  ensures result.local == self.local && result.proj.len() == self.proj.len() + 1
{
  var p = self
  p.proj.push(PlaceElem.Index(op, span))
  return p
}

enum Const {
  /// An integer: its sign and magnitude, and its type.
  Int(neg: Bool, mag: U64, k: IntTy)
  Float(v: Float)
  Bool(v: Bool)
  Char(v: Int)
  Str(v: Str)
  Unit
  /// A function item as a value.
  Fn(f: Int)
}

fn int_value(v: Int, k: IntTy) -> Const {
  if v >= 0 {
    return Const.Int(false, v as U64, k)
  }
  // The magnitude of the smallest `Int` does not fit in an `Int`.
  return Const.Int(true, ((-(v + 1)) as U64) + 1, k)
}

enum Operand {
  Copy(p: Place)
  Const(c: Const)
}

fn op_local(l: Int) -> Operand {
  return Operand.Copy(place_of(l))
}

fn op_int(v: Int) -> Operand {
  return Operand.Const(int_value(v, IntTy.I64))
}

fn op_bool(b: Bool) -> Operand {
  return Operand.Const(Const.Bool(b))
}

fn op_unit() -> Operand {
  return Operand.Const(Const.Unit)
}

enum AggKind {
  Tuple
  Struct(adt: Int)
  Variant(adt: Int, v: Int)
  List
}

enum Callee {
  Fn(f: Int)
  Intrinsic(i: Intrinsic)
  /// The C function of this name.
  Ffi(name: Str)
  /// A function value (closure or function item) held in an operand.
  Value(op: Operand)
}

enum Arg {
  Value(op: Operand)
  MutRef(p: Place)
}

enum Rvalue {
  Use(op: Operand)
  /// Checked arithmetic and comparisons; `ty` is the operand type.
  Binary(op: syntax.BinOp, a: Operand, b: Operand, ty: Int)
  Unary(op: syntax.UnOp, a: Operand, ty: Int)
  /// A checked numeric conversion.
  Cast(a: Operand, from: Int, to: Int)
  /// `x + 1` for a loop counter below its bound.
  Inc(a: Operand, k: IntTy)
  Aggregate(kind: AggKind, ty: Int, ops: List<Operand>)
  /// The variant index of an enum value.
  Discriminant(p: Place)
  Closure(f: Int, ops: List<Operand>)
  Call(callee: Callee, args: List<Arg>, ty: Int)
}

enum CheckKind {
  Assert
  Precondition
  Postcondition
  Invariant
  Refinement
}

struct CheckValue {
  label: Str
  op: Operand
  ty: Int
}

enum Stmt {
  Assign(p: Place, rv: Rvalue)
  /// Abort with a message unless `cond` holds, showing `values`.
  Check(cond: Operand, kind: CheckKind, msg: Str, values: List<CheckValue>, span: syntax.Span)
  /// The local is dead from here on.
  Drop(l: Int)
}

struct SpannedStmt {
  stmt: Stmt
  span: syntax.Span
}

enum Terminator {
  Goto(b: Int)
  If(op: Operand, t: Int, e: Int)
  /// Jump on an integer value (an enum discriminant or a length).
  Switch(op: Operand, cases: List<(Int, Int)>, default: Int)
  Return
  /// Control cannot reach here.
  Unreachable
}

struct Block {
  stmts: List<SpannedStmt>
  term: Terminator
  term_span: syntax.Span
}

struct MFn {
  name: Str
  source: Option<Int>
  /// The instance's type arguments.
  type_args: List<Int>
  params: List<(Int, Mode)>
  /// For closures: how many leading parameters are captured values.
  n_captures: Int
  ret: Int
  /// Each local's type.
  locals: List<Int>
  blocks: List<Block>
  intrinsic: Option<Intrinsic>
  span: syntax.Span
  lowered: Bool
}

struct Intrinsic {
  op: Op
  /// The instance's type arguments (element types, the shown type, ...).
  tys: List<Int>
  /// For integer methods: the integer type.
  int: Option<IntTy>
}

fn intrinsic(op: Op, tys: List<Int>) -> Intrinsic
  ensures result.op == op && result.tys == tys && result.int.is_none()
{
  return Intrinsic { op: op, tys: tys, int: None }
}

struct Mir {
  fns: List<MFn>
  instances: Map<(Int, List<Int>), Int>
  /// What proofs discharged: their runtime checks are left out.
  elide: Proven
}

/// Discharged obligations, by span (`lo`, `hi`), consulted by lowering and code generation to
/// drop runtime checks.
struct Proven {
  /// Contract checks (asserts, postconditions, invariants, refinements) at these spans.
  contract: Set<(Int, Int)>
  /// Arithmetic traps (overflow, division by zero, shift range) at these spans.
  safety: Set<(Int, Int)>
  /// List indexing proved in bounds at these spans.
  bounds: Set<(Int, Int)>
  /// Functions whose entry checks (`requires`, parameter refinements) are proved at every
  /// call, so the function itself need not check them.
  entries: Set<Int>
}

fn no_proofs() -> Proven {
  return Proven { contract: Set.new(), safety: Set.new(), bounds: Set.new(), entries: Set.new() }
}

fn span_key(s: syntax.Span) -> (Int, Int)
  ensures result.0 == s.lo && result.1 == s.hi
{
  return (s.lo, s.hi)
}

enum Op {
  Panic
  Assert
  IntAbs
  IntMin
  IntMax
  IntPow
  WrappingAdd
  WrappingSub
  WrappingMul
  FloatAbs
  Sqrt
  Floor
  Ceil
  Round
  FloatMin
  FloatMax
  IsNan
  IsDigit
  IsAlpha
  IsAlnum
  IsSpace
  IsUpper
  IsLower
  CharToUpper
  CharToLower
  StrLen
  StrIsEmpty
  StrContains
  StartsWith
  EndsWith
  StrFind
  Split
  Lines
  Trim
  Replace
  Repeat
  StrToUpper
  StrToLower
  ToInt
  ToFloat
  Bytes
  Chars
  FromChars
  FromBytes
  ListNew
  ListLen
  ListIsEmpty
  Push
  Pop
  Get
  Insert
  Remove
  Clear
  Extend
  Reverse
  Swap
  Truncate
  ListRepeat
  Sort
  SortBy
  MapNew
  MapLen
  MapIsEmpty
  MapGet
  MapInsert
  MapRemove
  MapContains
  Keys
  Values
  Entries
  SetNew
  SetLen
  SetIsEmpty
  SetInsert
  SetRemove
  SetContains
  Items
  Print
  Println
  Eprintln
  ReadLine
  ReadAll
  FsRead
  FsWrite
  FsExists
  FsList
  Args
  EnvVar
  Exit
  NowMs
  NowNs
  RandInt
  RandFloat
  Sin
  Cos
  Tan
  Atan2
  Exp
  Ln
  Log10
  Pow
  TaskAll

// Body checking, ported from the bootstrap compiler's `sema/check/mod.rs`: name resolution
// inside bodies, bidirectional type inference with unification, effects, mutability and
// `&mut` rules, divergence, and the lints that need types. Expressions are in `expr.jig`,
// calls and places in `call.jig`, statements and patterns in `stmt.jig`.

import "syntax"

/// What kind of code is being checked.
enum Ctx {
  /// Ordinary code.
  Code
  /// `requires`, invariants, refinements: pure and read-only.
  Pure
  /// `ensures`: pure, with `result` and `old` available.
  Ensures
}

/// What an inference variable may become.
enum VarKind {
  General
  /// An integer literal's type.
  IntLit
  /// A float literal's type.
  FloatLit
}

struct ClosureFrame {
  ret: Int
  /// Effects the closure may perform (`None`: inferred, anything goes).
  allowed: Option<Int>
  used: Int
  captures: List<Int>
  saved_loop_depth: Int
}

struct PendingBound {
  span: syntax.Span
  ty: Int
  bound: Bound
}

struct IntLit {
  expr: Int
  v: U64
  neg: Bool
}

/// The whole checker: the program, and the state of the item being checked.
struct Sema {
  pkgs: List<Package>
  tables: List<List<Tables>>
  defs: Defs
  tys: TyCtx
  diags: List<syntax.Diag>
  bodies: List<Option<Body>>
  test_bodies: List<Option<Body>>
  prelude: Int
  root: Int
  /// Every declared unit of measure.
  units: Set<Str>
  /// Per alias: 0 unresolved, 1 resolving, 2 resolved.
  alias_state: List<Int>
  /// Per package: (file, import name) of every import a body used.
  imports_used: List<Set<(Int, Str)>>
  /// The step functions bound scenarios call, and those with the worlds' constructors
  /// (roots of the dead-code check).
  scenario_steps: Set<Int>
  scenario_roots: List<Int>
  scenarios: List<ScenarioDef>
  /// The C libraries `jig.mod` links (for the interpreter's C calls).
  links: List<Str>
  // ---- the item being checked ----
  pkg: Int
  file: Int
  ast: syntax.Ast
  tab: Tables
  generics: List<GenericDef>
  ret_ty: Int
  declared_effects: Int
  ctx: Ctx
  /// Per inference variable: its binding (-1: none) and kind.
  var_ty: List<Int>
  var_kind: List<VarKind>
  trail: List<Int>
  body: Body
  scope: List<(Str, Int)>
  scope_marks: List<Int>
  loop_depth: Int
  /// For each enclosing loop, whether it contains a `break`.
  loop_breaks: List<Bool>
  closures: List<ClosureFrame>
  pending_bounds: List<PendingBound>
  int_lits: List<IntLit>
  touched: List<Int>
  touched_pats: List<Int>
  touched_insts: List<Int>
  diverges: Bool
  /// Report "cannot infer" once per variable.
  reported_vars: Set<Int>
  errors_at_start: Int
  /// The item's span (signature included), for functions.
  item_span: syntax.Span
}

fn empty_ast() -> syntax.Ast
  ensures result.items.is_empty() && result.exprs.is_empty() && result.top.is_empty()
{
  return syntax.Ast { items: [], exprs: [], stmts: [], types: [], pats: [], top: [] }
}

fn new_sema(ld: Loaded) -> Sema
  ensures result.pkgs.len() == ld.pkgs.len() && result.tables.len() == ld.pkgs.len()
  ensures result.var_ty.is_empty() && result.trail.is_empty()
{
  let tys = new_tys()
  var tables: List<List<Tables>> = []
  for p in ld.pkgs {
    var ts: List<Tables> = []
    for f in p.files {
      ts.push(new_tables(f.ast.exprs.len(), f.ast.pats.len(), tys.error))
    }
    tables.push(ts)
  }
  return Sema {
    pkgs: ld.pkgs
    tables: tables
    defs: Defs {
      fns: []
      adts: []
      ifaces: []
      consts: []
      aliases: []
      tests: []
      methods: Map.new()
      option: 0
      result: 0
      main: None
      sig_imports_used: Set.new()
    }
    tys: tys
    diags: ld.diags
    bodies: []
    test_bodies: []
    prelude: 0
    root: ld.root
    units: Set.new()
    alias_state: []
    imports_used: []
    scenario_steps: Set.new()
    scenario_roots: []
    scenarios: []
    links: ld.links
    pkg: 0
    file: 0
    ast: empty_ast()
    tab: new_tables(0, 0, 0)
    generics: []
    ret_ty: 0
    declared_effects: 0
    ctx: Ctx.Code
    var_ty: []
    var_kind: []
    trail: []
    body: new_body()
    scope: []
    scope_marks: []
    loop_depth: 0
    loop_breaks: []
    closures: []
    pending_bounds: []
    int_lits: []
    touched: []
    touched_pats: []
    touched_insts: []
    diverges: false
    reported_vars: Set.new()
    errors_at_start: 0
    item_span: dummy_span()
  }
}

/// Start checking an item of `pkg`'s file `file`: fresh state, and the file's tables.
fn Sema.begin(&mut self, pkg: Int, file: Int)
  requires pkg >= 0 &&
    pkg < self.pkgs.len() &&
    pkg >= 0 &&
    pkg < self.tables.len() &&
    file >= 0 &&
    file < self.tables[pkg].len() &&
    file >= 0 &&
    file < self.pkgs[pkg].files.len()
{
  self.pkg = pkg
  self.file = file
  self.ast = self.pkgs[pkg].files[file].ast
  self.tab = self.tables[pkg][file]
  self.tables[pkg][file] = new_tables(0, 0, 0)
  self.generics = []
  self.ret_ty = self.tys.unit_ty
  self.declared_effects = 0
  self.ctx = Ctx.Code
  self.var_ty = []
  self.var_kind = []
  self.trail = []
  self.body = new_body()
  self.scope = []
  self.scope_marks = []
  self.loop_depth = 0
  self.loop_breaks = []
  self.closures = []
  self.pending_bounds = []
  self.int_lits = []
  self.touched = []
  self.touched_pats = []
  self.touched_insts = []
  self.diverges = false
  self.reported_vars = Set.new()
  self.errors_at_start = self.diags.len()
  self.item_span = dummy_span()
}

/// Finish an item: its tables go back, and its body is the result.
fn Sema.end(&mut self) -> Body {
  self.tables[self.pkg][self.file] = self.tab
  self.tab = new_tables(0, 0, 0)
  let b = self.body
  self.body = new_body()
  return b
}

fn Sema.check_bodies(&mut self) {
  self.imports_used = []
  for _ in self.pkgs {
    self.imports_used.push(Set.new())
  }
  self.bodies = []
  for fid in 0..self.defs.fns.len() {
    let fd = self.defs.fns[fid]
    if fd.iface.is_some() {
      self.bodies.push(None)
      continue
    }
    self.begin(fd.pkg, fd.file)
    self.check_fn(fid)
    self.bodies.push(Some(self.end()))
  }
  self.test_bodies = []
  for tid in 0..self.defs.tests.len() {
    let td = self.defs.tests[tid]
    self.begin(td.pkg, td.file)
    self.check_test(tid)
    self.test_bodies.push(Some(self.end()))
  }
  for aid in 0..self.defs.adts.len() {
    let ad = self.defs.adts[aid]
    self.begin(ad.pkg, ad.file)
    self.check_adt_predicates(aid)
    let _ = self.end()
  }
  for al in 0..self.defs.aliases.len() {
    let a = self.defs.aliases[al]
    self.begin(a.pkg, a.file)
    self.check_alias_predicate(al)
    let _ = self.end()
  }
  // Unused imports.
  for pi in 0..self.pkgs.len() {
    let pkg = self.pkgs[pi]
    if pkg.is_std || pkg.external {
      continue
    }
    for fi in 0..pkg.imports.len() {
      for (name, imp) in pkg.imports[fi] {
        if !self.imports_used[pi].contains((fi, name)) &&
          !self.defs.sig_imports_used.contains((pi, fi, name)) {
          let item = pkg.files[fi].ast.items[imp.1]
          self.push(
            diag("E0502", item.span, "unused import `" + item.name.text + "`").fix(
              "remove the import",
              item.span,
              "",
            ),
          )
        }
      }
    }
  }
}

// ---------- diagnostics ----------

fn Sema.show(&mut self, t: Int) -> Str {
  let z = self.zonk(t)
  return self.tys.display(z)
}

fn Sema.mismatch(&mut self, span: syntax.Span, expected: Int, found: Int) {
  let e = self.show(expected)
  let f = self.show(found)
  var d = diag(
    "E0301",
    span,
    "mismatched types: expected `" + e + "`, found `" + f + "`",
  ).with_primary("expected `" + e + "`")
  // Suggestions for common conversions.
  let ek = self.tys.kinds[self.resolve(expected)]
  let fk = self.tys.kinds[self.resolve(found)]
  let snippet = self.fix_snippet(span)
  let numeric = match (ek, fk) {
    (Float(_), Int(_, _)) | (Int(_, _), Float(_)) | (Int(_, _), Int(_, _)) => true
    _ => false
  }
  let found_error = match fk {
    Error => true
    _ => false
  }
  if numeric {
    if !snippet.is_empty() {
      d = d.fix("convert with `as " + e + "`", span, "(" + snippet + ") as " + e)
    }
  } else {
    match ek {
      Str => if !snippet.is_empty() && !found_error {
        d = d.fix("convert to a string with `.str()`", span, snippet + ".str()")
      }
      Adt(a, _) => if a == self.defs.option && !snippet.is_empty() {
        d = d.fix("wrap the value in `Some(...)`", span, "Some(" + snippet + ")")
      } else if a == self.defs.result && !snippet.is_empty() {
        d = d.fix("wrap the value in `Ok(...)`", span, "Ok(" + snippet + ")")
      }
      _ => {}
    }
  }
  self.push(d)
}

/// The source text at `span` for a suggested fix (none if long or on several lines).
fn Sema.fix_snippet(self, span: syntax.Span) -> Str
  ensures result.len() <= 80
{
  let s = self.snippet(span.lo, span.hi)
  if s.len() > 80 || s.contains("\n") {
    return ""
  }
  return s
}

fn Sema.expr_span(self, e: Int) -> syntax.Span
  requires e >= 0 && e < self.ast.exprs.len()
{
  return self.ast.exprs[e].span
}

// ---------- inference variables ----------

fn Sema.new_var(&mut self, kind: VarKind) -> Int
  ensures self.var_ty.len() == old(self.var_ty.len()) + 1
  ensures self.var_kind.len() == old(self.var_kind.len()) + 1
{
  let v = self.var_ty.len()
  self.var_ty.push(-1)
  self.var_kind.push(kind)
  return self.tys.infer(v)
}

fn Sema.fresh(&mut self) -> Int
  ensures self.var_ty.len() == old(self.var_ty.len()) + 1
{
  return self.new_var(VarKind.General)
}

fn Sema.fresh_list(&mut self, n: Int) -> List<Int>
  ensures result.len() == max(n, 0)
{
  var out: List<Int> = []
  for _ in 0..n {
    out.push(self.fresh())
  }
  return out
}

/// Follow variable bindings at the top level.
fn Sema.resolve(self, t: Int) -> Int {
  var cur = t
  for {
    match self.tys.kinds[cur] {
      Infer(v) => {
        if v < self.var_ty.len() && self.var_ty[v] >= 0 {
          cur = self.var_ty[v]
        } else {
          return cur
        }
      }
      _ => {
        return cur
      }
    }
  }
}

fn Sema.kind_of(self, t: Int) -> TyKind {
  return self.tys.kinds[self.resolve(t)]
}

/// Deep-resolve inference variables.
fn Sema.zonk(&mut self, t: Int) -> Int {
  let r = self.resolve(t)
  // Without inference variables, zonking rebuilds the same type.
  if !self.tys.has_infer(r) {
    return r
  }
  return match self.tys.kinds[r] {
    Tuple(ts) => {
      let v = self.zonk_all(ts)
      self.tys.tuple(v)
    }
    Adt(a, ts) => {
      let v = self.zonk_all(ts)
      self.tys.adt(a, v)
    }
    List(x) => {
      let y = self.zonk(x)
      self.tys.list(y)
    }
    Set(x) => {
      let y = self.zonk(x)
      self.tys.set(y)
    }
    Map(k, v) => {
      let k2 = self.zonk(k)
      let v2 = self.zonk(v)
      self.tys.map_ty(k2, v2)
    }
    Fn(ps, ret, e) => {
      let v = self.zonk_all(ps)
      let r2 = self.zonk(ret)
      self.tys.func(v, r2, e)
    }
    _ => r
  }
}

fn Sema.zonk_all(&mut self, ts: List<Int>) -> List<Int>
  ensures result.len() == ts.len()
{
  var out: List<Int> = []
  for x in ts {
    out.push(self.zonk(x))
  }
  return out
}

/// Default unresolved literal variables (Int, Float) at the end of a body.
fn Sema.default_vars(&mut self) {
  for i in 0..self.var_ty.len() {
    if self.var_ty[i] < 0 {
      match self.var_kind[i] {
        IntLit => self.var_ty[i] = self.tys.int
        FloatLit => self.var_ty[i] = self.tys.float
        General => {}
      }
    }
  }
}

fn Sema.rollback(&mut self, snap: Int)
  ensures self.trail.len() <= snap
{
  for self.trail.len() > snap {
    let v = self.trail.pop().unwrap_or(0)
    self.var_ty[v] = -1
  }
}

fn Sema.bind(&mut self, v: Int, t: Int)
  requires v >= 0 && v < self.var_ty.len()
{
  self.var_ty[v] = t
  self.trail.push(v)
}

fn Sema.occurs(self, v: Int, t: Int) -> Bool {
  let r = self.resolve(t)
  return match self.tys.kinds[r] {
    Infer(w) => w == v
    Tuple(ts) | Adt(_, ts) => self.occurs_any(v, ts)
    List(x) | Set(x) => self.occurs(v, x)
    Map(k, x) => self.occurs(v, k) || self.occurs(v, x)
    Fn(ps, ret, _) => self.occurs_any(v, ps) || self.occurs(v, ret)
    _ => false
  }
}

fn Sema.occurs_any(self, v: Int, ts: List<Int>) -> Bool
  ensures !result || !ts.is_empty()
{
  for x in ts {
    if self.occurs(v, x) {
      return true
    }
  }
  return false
}

/// Make two types equal. Rolls back partial bindings on failure.
fn Sema.unify(&mut self, a: Int, b: Int) -> Bool
  ensures result || self.trail.len() <= old(self.trail.len())
{
  let snap = self.trail.len()
  let ok = self.unify_inner(a, b, false)
  if !ok {
    self.rollback(snap)
  }
  return ok
}

/// `actual` may be used where `expected` is required: equality, except that `Never`
/// converts to anything and a function with fewer effects fits a type with more.
fn Sema.coerce(&mut self, actual: Int, expected: Int) -> Bool
  ensures result || self.trail.len() <= old(self.trail.len())
{
  let snap = self.trail.len()
  let ok = self.unify_inner(actual, expected, true)
  if !ok {
    self.rollback(snap)
  }
  return ok
}

fn Sema.unify_lists(&mut self, x: List<Int>, y: List<Int>) -> Bool
  ensures result || (!x.is_empty() && !y.is_empty())
{
  let n = if x.len() < y.len() { x.len() } else { y.len() }
  for i in 0..n {
    if !self.unify_inner(x[i], y[i], false) {
      return false
    }
  }
  return true
}

fn Sema.unify_inner(&mut self, a0: Int, b0: Int, coerce: Bool) -> Bool {
  let a = self.resolve(a0)
  let b = self.resolve(b0)
  if a == b {
    return true
  }
  let ka = self.tys.kinds[a]
  let kb = self.tys.kinds[b]
  return match (ka, kb) {
    (Error, _) | (_, Error) => true
    (Never, _) if coerce => true
    (Infer(v), Infer(w)) => {
      let kv = self.var_kind[v]
      let kw = self.var_kind[w]
      if kv == VarKind.General {
        self.bind(v, b)
        true
      } else if kw == VarKind.General {
        self.bind(w, a)
        true
      } else if kv == kw {
        self.bind(v, b)
        true
      } else {
        false
      }
    }
    (Infer(v), _) => self.bind_checked(v, b, kb)
    (_, Infer(w)) => self.bind_checked(w, a, ka)
    (Tuple(x), Tuple(y)) => x.len() == y.len() && self.unify_lists(x, y)
    (Adt(p, x), Adt(q, y)) => p == q && self.unify_lists(x, y)
    (List(x), List(y)) | (Set(x), Set(y)) => self.unify_inner(x, y, false)
    (Map(k1, v1), Map(k2, v2)) => self.unify_inner(k1, k2, false) && self.unify_inner(v1, v2, false)
    (Fn(p1, r1, e1), Fn(p2, r2, e2)) => {
      let eff_ok = if coerce { effects_contain(e2, e1) } else { e1 == e2 }
      eff_ok && p1.len() == p2.len() && self.unify_lists(p1, p2) && self.unify_inner(r1, r2, coerce)
    }
    _ => false
  }
}

fn Sema.bind_checked(&mut self, v: Int, t: Int, k: TyKind) -> Bool {
  match self.var_kind[v] {
    IntLit => match k {
      Int(_, _) => {}
      _ => {
        return false
      }
    }
    FloatLit => match k {
      Float(_) => {}
      _ => {
        return false
      }
    }
    General => {}
  }
  if k == TyKind.Never {
    return false
  }
  if self.occurs(v, t) {
    return false
  }
  self.bind(v, t)
  return true
}

/// Join the types of two branches.
fn Sema.join(&mut self, a: Int, b: Int, span: syntax.Span) -> Int
  ensures result == a || result == b
{
  if self.resolve(a) == self.tys.never {
    return b
  }
  if self.resolve(b) == self.tys.never {
    return a
  }
  if !self.coerce(b, a) {
    self.mismatch(span, a, b)
  }
  return a
}

// ---------- scopes and locals ----------

fn Sema.push_scope(&mut self)
  ensures self.scope_marks.len() == old(self.scope_marks.len()) + 1
{
  self.scope_marks.push(self.scope.len())
}

fn Sema.pop_scope(&mut self) {
  let m = self.scope_marks.pop().unwrap_or(0)
  self.scope.truncate(m)
}

fn Sema.declare_local(&mut self, name: Str, ty: Int, kind: LocalKind, span: syntax.Span) -> Int {
  if name != "_" && kind != LocalKind.SelfValue && kind != LocalKind.SelfMut {
    match self.lookup_local(name) {
      Some(prev) => self.push(
        diag("E0505", span, "`" + name + "` shadows another variable")
          .label(self.body.locals[prev].span, "first declared here")
          .note("choose a different name"),
      )
      None => {}
    }
    self.check_snake(name, span, "variable")
  }
  let id = self.body.locals.len()
  self.body.locals.push(
    LocalDef {
      name: name
      ty: ty
      kind: kind
      span: span
      used: false
      mutated: false
      depth: self.closures.len()
    },
  )
  self.scope.push((name, id))
  return id
}

fn Sema.lookup_local(self, name: Str) -> Option<Int>
  ensures result.is_none() || !self.scope.is_empty()
{
  var i = self.scope.len() - 1
  for i >= 0 invariant i < self.scope.len() {
    if self.scope[i].0 == name {
      return Some(self.scope[i].1)
    }
    i -= 1
  }
  return None
}

/// Record a use of a local, capturing it into enclosing closures if needed.
fn Sema.use_local(&mut self, id: Int) {
  self.body.locals[id].used = true
  let depth = self.body.locals[id].depth
  for i in depth..self.closures.len() {
    if !self.closures[i].captures.contains(id) {
      self.closures[i].captures.push(id)
    }
  }
}

// ---------- effects ----------

/// Perform effects at `span` (a call or a function value invocation).
fn Sema.use_effects(&mut self, eff: Int, span: syntax.Span, what: Str)
  ensures self.diags.len() == old(self.diags.len()) || self.diags.len() == old(self.diags.len()) + 1
{
  if eff == 0 {
    return
  }
  if self.ctx != Ctx.Code {
    self.err(
      "E0321",
      span,
      "contracts must be pure, but " + what + " has effects " + effects_render(eff),
    )
    return
  }
  let nc = self.closures.len()
  if nc > 0 {
    self.closures[nc - 1].used = self.closures[nc - 1].used | eff
    match self.closures[nc - 1].allowed {
      Some(allowed) => {
        let missing = effects_minus(eff, allowed)
        if missing != 0 {
          // Count it as used by the function too, so its declaration is not also unused.
          self.body.used_effects = self.body.used_effects | missing
          let msg = what +
            " performs " +
            effects_render(missing) +
            " but the closure's type allows only " +
            effects_render(allowed)
          self.push(
            diag("E0401", span, msg).note("a function value's effects are part of its type"),
          )
        }
      }
      None => {}
    }
    return
  }
  self.body.used_effects = self.body.used_effects | eff
  let missing = effects_minus(eff, self.declared_effects)
  if missing != 0 {
    let names = effect_list(missing)
    let msg = what +
      " needs effect" +
      (if names.len() > 1 { "s" } else { "" }) +
      " `" +
      names.join("`, `") +
      "`, which this function does not declare"
    let want = effect_list(self.declared_effects | missing)
    self.push(diag("E0401", span, msg).note("declare it: `effects {" + want.join(", ") + "}`"))
  }
}

// ---------- bounds ----------

fn Sema.require_bound(&mut self, span: syntax.Span, ty: Int, b: Bound)
  ensures self.pending_bounds.len() == old(self.pending_bounds.len()) + 1
{
  self.pending_bounds.push(PendingBound { span: span, ty: ty, bound: b })
}

fn Sema.check_pending_bounds(&mut self) {
  let pending = self.pending_bounds
  self.pending_bounds = []
  for pb in pending {
    let t = self.zonk(pb.ty)
    if self.tys.has_infer(t) {
      continue
    }
    var seen: Set<(Int, Bound)> = Set.new()
    match self.satisfies(t, pb.bound, &mut seen) {
      Some(why) => {
        let msg = "`" +
          self.tys.display(t) +
          "` does not satisfy `" +
          self.bound_name(pb.bound) +
          "`"
        self.push(diag("E0312", pb.span, msg).note(why))
      }
      None => {}
    }
  }
}

fn Sema.bound_name(self, b: Bound) -> Str {
  return match b {
    Eq => "Eq"
    Ord => "Ord"
    Hash => "Hash"
    Show => "Show"
    Iface(i) => self.defs.ifaces[i].name
  }
}

/// Does `t` satisfy bound `b`?
/// Why `t` does not satisfy `b`, if it does not.
fn Sema.satisfies(&mut self, t: Int, b: Bound, seen: &mut Set<(Int, Bound)>) -> Option<Str> {
  if seen.contains((t, b)) {
    return None
  }
  seen.insert((t, b))
  let k = self.tys.kinds[t]
  match k {
    Error | Never => {
      return None
    }
    Param(i, name) => {
      let bounds = if i < self.generics.len() { self.generics[i].bounds } else { [] }
      // Every ordered or hashable type can be compared for equality.
      let implied = b == Bound.Eq && (bounds.contains(Bound.Ord) || bounds.contains(Bound.Hash))
      if bounds.contains(b) || implied {
        return None
      }
      return Some("add the bound to the type parameter: `" + name + ": " + self.bound_name(b) + "`")
    }
    Fn(_, _, _) => {
      return Some("functions cannot be compared, hashed, shown or used as interface values")
    }
    _ => {}
  }
  match b {
    Iface(iid) => {
      return self.satisfies_iface(t, iid)
    }
    _ => {}
  }
  match k {
    Float(_) => if b == Bound.Ord || b == Bound.Hash {
      return Some("`Float` is not totally ordered; use `sort_by` with an explicit comparison")
    }
    Tuple(ts) => {
      for x in ts {
        match self.satisfies(x, b, &mut seen) {
          Some(why) => {
            return Some(why)
          }
          None => {}
        }
      }
    }
    List(x) | Set(x) => {
      return self.satisfies(x, b, &mut seen)
    }
    Map(kk, v) => {
      match self.satisfies(kk, b, &mut seen) {
        Some(why) => {
          return Some(why)
        }
        None => {}
      }
      return self.satisfies(v, b, &mut seen)
    }
    Adt(a, args) => {
      if b == Bound.Show && self.defs.method(TyKey.Adt(a), "str").is_some() {
        return None
      }
      for ft in self.adt_payload_tys(a) {
        let st = self.tys.subst(ft, args)
        match self.satisfies(st, b, &mut seen) {
          Some(why) => {
            return Some("a field of `" + self.defs.adts[a].name + "` does not: " + why)
          }
          None => {}
        }
      }
    }
    _ => {}
  }
  return None
}

/// The type arguments of a type constructor.
fn Sema.type_args_of(self, t: Int) -> List<Int>
  requires t >= 0 && t < self.tys.kinds.len()
{
  return match self.tys.kinds[t] {
    Adt(_, args) => args
    List(x) | Set(x) => [x]
    Map(k, v) => [k, v]
    _ => []
  }
}

/// Why `t` does not implement interface `iid`, if it does not.
fn Sema.satisfies_iface(&mut self, t: Int, iid: Int) -> Option<Str> {
  let iname = self.defs.ifaces[iid].name
  let key = match ty_key(self.tys, t) {
    Some(k) => k
    None => {
      return Some("`" + self.tys.display(t) + "` has no methods")
    }
  }
  let targs = self.type_args_of(t)
  for m in self.defs.ifaces[iid].methods {
    let md = self.defs.fns[m]
    let cf = match self.defs.method(key, md.name) {
      Some(c) => c
      None => {
        return Some("missing method `" + md.name + "` required by `" + iname + "`")
      }
    }
    let cd = self.defs.fns[cf]
    if cd.self_mode != md.self_mode ||
      cd.params.len() != md.params.len() ||
      cd.generics.len() != cd.n_recv_generics {
      return Some(
        "method `" + md.name + "` does not match the signature required by `" + iname + "`",
      )
    }
    if targs.len() != cd.n_recv_generics {
      return Some("method `" + md.name + "` does not match `" + iname + "`")
    }
    for i in 0..cd.params.len() {
      let a = self.tys.subst(cd.params[i].ty, targs)
      let b = self.tys.subst(md.params[i].ty, [t])
      if a != b || cd.params[i].mode != md.params[i].mode {
        return Some(
          "parameter `" +
            cd.params[i].name +
            "` of `" +
            md.name +
            "` does not match `" +
            iname +
            "`",
        )
      }
    }
    let ra = self.tys.subst(cd.ret, targs)
    let rb = self.tys.subst(md.ret, [t])
    if ra != rb || !effects_contain(md.eff, cd.eff) {
      return Some(
        "method `" +
          md.name +
          "` does not match the return type or effects required by `" +
          iname +
          "`",
      )
    }
  }
  return None
}

// ---------- finishing ----------

fn Sema.finish(&mut self) {
  self.default_vars()
  // Final types for every expression this body touched.
  let touched = self.touched
  for e in touched {
    let z = self.zonk(self.tab.expr_ty[e])
    if self.tys.has_infer(z) && !self.item_has_errors() {
      match self.tys.kinds[self.first_var(z)] {
        Infer(v) => {
          if !self.reported_vars.contains(v) {
            self.reported_vars.insert(v)
            self.push(
              diag("E0305", self.ast.exprs[e].span, "type annotations needed").note(
                "add a type annotation, e.g. `let xs: List<Int> = []`",
              ),
            )
          }
        }
        _ => {}
      }
    }
    self.tab.expr_ty[e] = z
  }
  let pats = self.touched_pats
  self.touched_pats = []
  for p in pats {
    let t = self.tab.pat_ty[p]
    if self.tys.has_infer(t) {
      self.tab.pat_ty[p] = self.zonk(t)
    }
  }
  for id in 0..self.body.locals.len() {
    self.body.locals[id].ty = self.zonk(self.body.locals[id].ty)
  }
  let insts = self.touched_insts
  self.touched_insts = []
  for e in insts {
    let args = self.tab.expr_inst.get(e).unwrap_or([])
    let z = self.zonk_all(args)
    self.tab.expr_inst.insert(e, z)
  }
  // Integer literal ranges.
  let lits = self.int_lits
  self.int_lits = []
  for lit in lits {
    match self.tys.kinds[self.tab.expr_ty[lit.expr]] {
      Int(k, _) => {
        if !k.fits(lit.v, lit.neg) {
          let val = if lit.neg && lit.v != 0 { "-" + lit.v.str() } else { lit.v.str() }
          let msg = "literal `" +
            val +
            "` does not fit in `" +
            k.name() +
            "` (" +
            k.min_text() +
            "..=" +
            k.max_text() +
            ")"
          self.err("E0104", self.ast.exprs[lit.expr].span, msg)
        }
      }
      _ => {}
    }
  }
  self.check_pending_bounds()
}

/// Has an error been reported inside this item (body or signature)? Then unresolved types
/// are follow-on noise.
fn Sema.item_has_errors(self) -> Bool
  ensures result || self.diags.len() == self.errors_at_start
{
  if self.diags.len() != self.errors_at_start {
    return true
  }
  let s = self.item_span
  if s.lo == 0 && s.hi == 0 {
    return false
  }
  for d in self.diags {
    if d.lo >= s.lo && d.hi <= s.hi {
      return true
    }
  }
  return false
}

fn Sema.first_var(self, t: Int) -> Int {
  return match self.tys.kinds[t] {
    Infer(_) => t
    Tuple(ts) | Adt(_, ts) => self.first_var_in(ts, t)
    List(x) | Set(x) => self.first_var(x)
    Map(k, v) => {
      let a = self.first_var(k)
      if self.tys.is_infer(a) {
        a
      } else {
        self.first_var(v)
      }
    }
    Fn(ps, r, _) => {
      let a = self.first_var_in(ps, -1)
      if a >= 0 {
        a
      } else {
        self.first_var(r)
      }
    }
    _ => t
  }
}

fn Sema.first_var_in(self, ts: List<Int>, fallback: Int) -> Int
  ensures result == fallback || !ts.is_empty()
{
  for x in ts {
    let a = self.first_var(x)
    if self.tys.is_infer(a) {
      return a
    }
  }
  return fallback
}

/// Unused variables, needless `var`, needless `&mut`.
fn Sema.lint_locals(&mut self) {
  for l in self.body.locals {
    if l.name.starts_with("_") {
      continue
    }
    match l.kind {
      SelfValue => {}
      SelfMut => {
        if !l.mutated {
          self.push(
            diag("E0510", l.span, "`&mut self` is never mutated").fix(
              "take `self` by value",
              l.span,
              "self",
            ),
          )
        }
      }
      _ => {
        if !l.used {
          let what = if l.kind == LocalKind.Param || l.kind == LocalKind.MutParam {
            "parameter"
          } else {
            "variable"
          }
          self.push(
            diag("E0501", l.span, "unused " + what + " `" + l.name + "`").note(
              "remove it, or rename it to `_" + l.name + "` if it must exist",
            ),
          )
        } else if l.kind == LocalKind.Var && !l.mutated {
          self.push(
            diag("E0503", l.span, "`" + l.name + "` is declared `var` but never mutated").note(
              "use `let`",
            ),
          )
        } else if l.kind == LocalKind.MutParam && !l.mutated {
          self.push(
            diag("E0510", l.span, "parameter `" + l.name + "` is `&mut` but never mutated").note(
              "take it by value",
            ),
          )
        }
      }
    }
  }
}

// ---------- entry points ----------

fn Sema.setup_params(&mut self, params: List<ParamDef>) {
  for p in params {
    let kind = if p.mode == Mode.MutRef { LocalKind.MutParam } else { LocalKind.Param }
    let id = self.declare_local(p.name, p.ty, kind, p.span)
    self.body.param_locals.push(id)
  }
}

fn Sema.check_bool(&mut self, e: Int) {
  let b = self.tys.bool
  let _ = self.check_expr(e, Some(b))
}

fn Sema.check_fn(&mut self, fid: Int) {
  let fd = self.defs.fns[fid]
  let item = self.ast.items[fd.item]
  self.generics = fd.generics
  self.ret_ty = fd.ret
  self.declared_effects = fd.eff
  let f = match item.kind {
    Fn(decl) => decl
    _ => {
      return
    }
  }
  self.item_span = item.span
  self.check_snake(item.name.text, item.name.span, "function")
  for g in fd.generics {
    if g.name != "Self" {
      self.check_camel(g.name, g.span, "type parameter")
    }
  }
  self.push_scope()
  match (fd.self_mode, fd.self_ty) {
    (Some(m), Some(t)) => {
      let kind = if m == Mode.MutRef { LocalKind.SelfMut } else { LocalKind.SelfValue }
      let span = match f.self_param {
        Some(s) => s.span
        None => item.name.span
      }
      let id = self.declare_local("self", t, kind, span)
      self.body.param_locals.push(id)
    }
    _ => {}
  }
  self.setup_params(fd.params)
  // Parameter refinements and requires.
  self.ctx = Ctx.Pure
  for p in f.params {
    match p.refine {
      Some(pred) => self.check_bool(pred)
      None => {}
    }
  }
  for r in f.pre {
    self.check_bool(r)
  }
  self.ctx = Ctx.Code
  match f.body {
    Some(body) => {
      self.diverges = false
      self.check_block_stmts(body)
      if !self.diverges && self.ret_ty != self.tys.unit_ty {
        let span = self.ast.exprs[body].span
        let close = syntax.Span { lo: if span.hi > 0 { span.hi - 1 } else { 0 }, hi: span.hi }
        let rt = self.show(self.ret_ty)
        self.push(
          diag(
            "E0308",
            close,
            "missing `return`: this function must return `" + rt + "` on every path",
          ).note("Jig function bodies do not return their last expression; write `return <value>`"),
        )
      }
    }
    None => {}
  }
  self.ctx = Ctx.Ensures
  for e in f.post {
    self.check_bool(e)
  }
  self.ctx = Ctx.Code
  self.pop_scope()
  self.finish()
  if f.body.is_some() {
    self.lint_locals()
    let unused = effects_minus(self.declared_effects, self.body.used_effects)
    if unused != 0 && fd.iface.is_none() {
      let span = if f.effects_span.lo == 0 && f.effects_span.hi == 0 {
        item.name.span
      } else {
        f.effects_span
      }
      var quoted: List<Str> = []
      for n in effect_list(unused) {
        quoted.push("`" + n + "`")
      }
      let msg = "declared effect" + plural(quoted.len()) + " " + quoted.join(", ") + " never used"
      self.push(
        diag("E0403", span, msg).note(
          "remove unused effects so callers do not have to declare them",
        ),
      )
    }
  }
}

fn Sema.check_test(&mut self, tid: Int) {
  let td = self.defs.tests[tid]
  let item = self.ast.items[td.item]
  // Tests run against deterministic fakes and may use any effect.
  self.declared_effects = 255
  let (pre, body) = match item.kind {
    Test(_, _, pre, body) => (pre, body)
    _ => {
      return
    }
  }
  self.push_scope()
  self.setup_params(td.params)
  self.ctx = Ctx.Pure
  for r in pre {
    self.check_bool(r)
  }
  self.ctx = Ctx.Code
  self.diverges = false
  self.check_block_stmts(body)
  self.pop_scope()
  self.finish()
  self.lint_locals()
}

fn Sema.check_adt_predicates(&mut self, aid: Int) {
  let ad = self.defs.adts[aid]
  let item = self.ast.items[ad.item]
  self.generics = ad.generics
  self.check_camel(item.name.text, item.name.span, if ad.is_enum { "enum" } else { "struct" })
  self.ctx = Ctx.Pure
  match item.kind {
    Struct(_, fields, invariants) => {
      for f in fields {
        self.check_snake(f.name.text, f.name.span, "field")
      }
      for i in 0..fields.len() {
        let f = fields[i]
        match f.refine {
          Some(pred) => {
            self.push_scope()
            let t = if i < ad.fields.len() { ad.fields[i].ty } else { self.tys.error }
            let id = self.declare_local(f.name.text, t, LocalKind.Param, f.name.span)
            self.body.locals[id].used = true
            self.check_bool(pred)
            self.pop_scope()
          }
          None => {}
        }
      }
      if !invariants.is_empty() {
        self.push_scope()
        for i in 0..fields.len() {
          let t = if i < ad.fields.len() { ad.fields[i].ty } else { self.tys.error }
          let id = self.declare_local(fields[i].name.text, t, LocalKind.Param, fields[i].name.span)
          self.body.locals[id].used = true
        }
        for e in invariants {
          self.check_bool(e)
        }
        self.pop_scope()
      }
    }
    Enum(_, variants) => {
      for vi in 0..variants.len() {
        let v = variants[vi]
        self.check_camel(v.name.text, v.name.span, "variant")
        let none: List<FieldDef> = []
        let fdefs = if vi < ad.variants.len() { ad.variants[vi].fields } else { none }
        for i in 0..v.fields.len() {
          let f = v.fields[i]
          if !f.name.text.starts_with("_") {
            self.check_snake(f.name.text, f.name.span, "field")
          }
          // A field's `where` clause names the field, as a struct field's does.
          match f.refine {
            Some(pred) => {
              self.push_scope()
              let t = if i < fdefs.len() { fdefs[i].ty } else { self.tys.error }
              let id = self.declare_local(f.name.text, t, LocalKind.Param, f.name.span)
              self.body.locals[id].used = true
              self.check_bool(pred)
              self.pop_scope()
            }
            None => {}
          }
        }
      }
    }
    _ => {}
  }
  self.ctx = Ctx.Code
  self.finish()
}

fn Sema.check_alias_predicate(&mut self, al: Int) {
  let ad = self.defs.aliases[al]
  let item = self.ast.items[ad.item]
  self.check_camel(item.name.text, item.name.span, "type alias")
  self.generics = ad.generics
  match ad.refine {
    Some(pred) => {
      self.ctx = Ctx.Pure
      self.push_scope()
      let id = self.declare_local("self", ad.ty, LocalKind.SelfValue, item.name.span)
      self.body.locals[id].used = true
      self.check_bool(pred)
      self.pop_scope()
      self.ctx = Ctx.Code
    }
    None => {}
  }
  self.finish()
}

// ---------- shared helpers ----------

fn Sema.record(&mut self, e: Int, t: Int) -> Int
  requires e >= 0 && e < self.tab.expr_ty.len()
{
  self.tab.expr_ty[e] = t
  self.touched.push(e)
  return t
}

fn Sema.set_inst(&mut self, e: Int, args: List<Int>)
  ensures self.touched_insts.len() == old(self.touched_insts.len()) + 1
{
  self.tab.expr_inst.insert(e, args)
  self.touched_insts.push(e)
}

fn Sema.set_pat_ty(&mut self, p: Int, t: Int)
  requires p >= 0 && p < self.tab.pat_ty.len()
{
  self.tab.pat_ty[p] = t
  self.touched_pats.push(p)
}

fn Sema.set_res(&mut self, e: Int, r: Res)
  requires e >= 0 && e < self.tab.expr_res.len()
{
  self.tab.expr_res[e] = r
}

fn Sema.add_ref(&mut self, f: Int)
  ensures self.body.refs.len() >= old(self.body.refs.len())
{
  if !self.body.refs.contains(f) {
    self.body.refs.push(f)
  }
}

/// The package a name imports in the current file.
fn Sema.imported(self, name: Str) -> Option<Int> {
  return match self.pkgs[self.pkg].imports[self.file].get(name) {
    Some(imp) => Some(imp.0)
    None => None
  }
}

fn Sema.use_import(&mut self, name: Str) {
  self.imports_used[self.pkg].insert((self.file, name))
}

// ---------- naming ----------

fn is_snake(s: Str) -> Bool
  ensures !result || !s.is_empty()
{
  if s.is_empty() || (s[0] >= '0' && s[0] <= '9') {
    return false
  }
  for c in s.chars() {
    if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') {
      return false
    }
  }
  return true
}

fn is_camel(s: Str) -> Bool
  ensures !result || !s.is_empty()
{
  return !s.is_empty() && s[0] >= 'A' && s[0] <= 'Z' && !s.contains("_")
}

fn to_camel(s: Str) -> Str {
  var out = ""
  for part in s.split("_") {
    if part.is_empty() {
      continue
    }
    let cs = part.chars()
    out = out + cs[0].to_upper().str() + part[cs[0].str().len()..part.len()]
  }
  return out
}

fn Sema.check_snake(&mut self, name: Str, span: syntax.Span, what: Str)
  ensures self.diags.len() == old(self.diags.len()) || self.diags.len() == old(self.diags.len()) + 1
{
  var start = 0
  for start < name.len() && name[start] == '_' invariant start >= 0 && start <= name.len() {
    start += 1
  }
  let t = name[start..name.len()]
  if t.is_empty() || is_snake(t) {
    return
  }
  let fixed = to_snake(name)
  self.push(
    diag("E0504", span, what + " `" + name + "` should be snake_case").fix(
      "rename to `" + fixed + "`",
      span,
      fixed,
    ),
  )
}

fn to_snake(s: Str) -> Str {
  var out = ""
  var first = true
  for c in s.chars() {
    if c >= 'A' && c <= 'Z' {
      if !first && !out.ends_with("_") {
        out += "_"
      }
      out += ((c as Int + 32) as Char).str()
    } else {
      out += c.str()
    }
    first = false
  }
  return out
}

fn Sema.check_camel(&mut self, name: Str, span: syntax.Span, what: Str)
  ensures self.diags.len() == old(self.diags.len()) || self.diags.len() == old(self.diags.len()) + 1
{
  if is_camel(name) || to_camel(name) == name {
    return
  }
  let fixed = to_camel(name)
  self.push(
    diag("E0504", span, what + " `" + name + "` should be UpperCamel").fix(
      "rename to `" + fixed + "`",
      span,
      fixed,
    ),
  )
}

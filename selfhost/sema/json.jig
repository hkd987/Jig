// JSON as the bootstrap compiler's `util/json.rs` reads and writes it, for the hooks and the
// MCP server: a parser with its error messages (byte offsets) and the compact writer. (The
// proof cache reads its own files with `parse_json` in `hash.jig`.)

/// The value as compact JSON (`Json::to_string_compact`).
fn json_text(j: Json) -> Str {
  return match j {
    Null => "null"
    Bool(b) => if b { "true" } else { "false" }
    Num(n) => n.str()
    Real(f) => if f == f.floor() && f.abs() < 1000000000000000.0 {
      (f as Int).str()
    } else {
      f.str()
    }
    Str(s) => json_str(s)
    Arr(xs) => {
      var parts: List<Str> = []
      for x in xs {
        parts.push(json_text(x))
      }
      "[" + parts.join(",") + "]"
    }
    Obj(kv) => {
      var parts: List<Str> = []
      for (k, v) in kv {
        parts.push(json_str(k) + ":" + json_text(v))
      }
      "{" + parts.join(",") + "}"
    }
  }
}

/// A parse in progress: the text, its bytes and the offset reached.
struct JsonParser {
  s: Str
  b: List<U8>
  i: Int
}

/// Parse a whole JSON text, or say what is wrong where.
fn parse_json_result(src: Str) -> Result<Json, Str> {
  var p = JsonParser { s: src, b: src.bytes(), i: 0 }
  p.ws()
  let v = p.value()?
  p.ws()
  if p.i != p.b.len() {
    return Err("trailing characters at offset " + p.i.str())
  }
  return Ok(v)
}

fn JsonParser.ws(&mut self) {
  for self.i < self.b.len() &&
    (self.b[self.i] == 32 || self.b[self.i] == 9 || self.b[self.i] == 10 || self.b[self.i] == 13) {
    self.i += 1
  }
}

fn JsonParser.err(self, msg: Str) -> Str {
  return msg + " at offset " + self.i.str()
}

fn JsonParser.at(self, c: U8) -> Bool {
  return self.i < self.b.len() && self.b[self.i] == c
}

fn JsonParser.lit(&mut self, word: Str, v: Json) -> Result<Json, Str> {
  if self.s[self.i..self.s.len()].starts_with(word) {
    self.i += word.len()
    return Ok(v)
  }
  return Err(self.err("invalid literal"))
}

fn JsonParser.value(&mut self) -> Result<Json, Str> {
  if self.i >= self.b.len() {
    return Err(self.err("unexpected end of input"))
  }
  let c = self.b[self.i]
  if c == 110 {
    return self.lit("null", Json.Null)
  }
  if c == 116 {
    return self.lit("true", Json.Bool(true))
  }
  if c == 102 {
    return self.lit("false", Json.Bool(false))
  }
  if c == 34 {
    return Ok(Json.Str(self.string()?))
  }
  if c == 91 {
    self.i += 1
    var items: List<Json> = []
    self.ws()
    if self.at(93) {
      self.i += 1
      return Ok(Json.Arr(items))
    }
    for {
      self.ws()
      items.push(self.value()?)
      self.ws()
      if self.at(44) {
        self.i += 1
      } else if self.at(93) {
        self.i += 1
        return Ok(Json.Arr(items))
      } else {
        return Err(self.err("expected `,` or `]`"))
      }
    }
  }
  if c == 123 {
    self.i += 1
    var fields: List<(Str, Json)> = []
    self.ws()
    if self.at(125) {
      self.i += 1
      return Ok(Json.Obj(fields))
    }
    for {
      self.ws()
      if !self.at(34) {
        return Err(self.err("expected object key"))
      }
      let k = self.string()?
      self.ws()
      if !self.at(58) {
        return Err(self.err("expected `:`"))
      }
      self.i += 1
      self.ws()
      let v = self.value()?
      fields.push((k, v))
      self.ws()
      if self.at(44) {
        self.i += 1
      } else if self.at(125) {
        self.i += 1
        return Ok(Json.Obj(fields))
      } else {
        return Err(self.err("expected `,` or `}`"))
      }
    }
  }
  if c == 45 || (c >= 48 && c <= 57) {
    let start = self.i
    self.i += 1
    for self.i < self.b.len() && is_number_byte(self.b[self.i]) {
      self.i += 1
    }
    return match number_value(self.s[start..self.i]) {
      Some(v) => Ok(v)
      None => Err("invalid number at offset " + start.str())
    }
  }
  return Err(self.err("unexpected character"))
}

fn is_number_byte(c: U8) -> Bool {
  return (c >= 48 && c <= 57) || c == 46 || c == 101 || c == 69 || c == 43 || c == 45
}

/// No byte but digits (true for "").
fn digits_only(s: Str) -> Bool {
  for c in s.bytes() {
    if c < 48 || c > 57 {
      return false
    }
  }
  return true
}

/// A number's value, if the text is one as Rust's `f64` parsing takes it: a sign, digits with
/// an optional fraction (one side may be empty), an optional exponent.
fn number_value(text: Str) -> Option<Json> {
  var t = text
  if t.starts_with("-") || t.starts_with("+") {
    t = t[1..t.len()]
  }
  var mant = t
  var exp = ""
  let e_at = match t.find("e") {
    Some(i) => Some(i)
    None => t.find("E")
  }
  match e_at {
    Some(i) => {
      mant = t[0..i]
      exp = t[i + 1..t.len()]
      if exp.starts_with("-") || exp.starts_with("+") {
        exp = exp[1..exp.len()]
      }
      if exp.is_empty() || !digits_only(exp) {
        return None
      }
    }
    None => {}
  }
  let (whole, frac) = match mant.find(".") {
    Some(i) => (mant[0..i], mant[i + 1..mant.len()])
    None => (mant, "")
  }
  if (whole.is_empty() && frac.is_empty()) || !digits_only(whole) || !digits_only(frac) {
    return None
  }
  if !mant.contains(".") && exp.is_empty() && whole.len() < 16 {
    return Some(Json.Num(text.to_int()?))
  }
  return Some(Json.Real(text.to_float()?))
}

fn JsonParser.hex4(&mut self) -> Result<Int, Str> {
  if self.i + 4 > self.b.len() {
    return Err(self.err("truncated escape"))
  }
  var v = 0
  for k in 0..4 {
    let h = hex_val(self.b[self.i + k] as Char)
    if h < 0 {
      self.i += 4
      return Err("invalid \\u escape")
    }
    v = v * 16 + h
  }
  self.i += 4
  return Ok(v)
}

fn JsonParser.string(&mut self) -> Result<Str, Str> {
  // The opening quote.
  self.i += 1
  var out = ""
  for {
    let start = self.i
    for self.i < self.b.len() && self.b[self.i] != 34 && self.b[self.i] != 92 {
      self.i += 1
    }
    out += self.s[start..self.i]
    if self.i >= self.b.len() {
      return Err(self.err("unterminated string"))
    }
    if self.b[self.i] == 34 {
      self.i += 1
      return Ok(out)
    }
    self.i += 1
    if self.i >= self.b.len() {
      return Err(self.err("invalid escape"))
    }
    let e = self.b[self.i]
    if e == 117 {
      self.i += 1
      var cp = self.hex4()?
      if cp >= 55296 && cp < 56320 && self.s[self.i..self.s.len()].starts_with("\\u") {
        self.i += 2
        let lo = self.hex4()?
        cp = 65536 + ((cp - 55296) << 10) + ((lo - 56320) & 1023)
      }
      // Not a character (a lone surrogate): the replacement character.
      let ch = if (cp >= 55296 && cp < 57344) || cp > 1114111 { 65533 } else { cp }
      out += (ch as Char).str()
      continue
    }
    let c = if e == 34 {
      "\""
    } else if e == 92 {
      "\\"
    } else if e == 47 {
      "/"
    } else if e == 98 {
      (8 as Char).str()
    } else if e == 102 {
      (12 as Char).str()
    } else if e == 110 {
      "\n"
    } else if e == 114 {
      "\r"
    } else if e == 116 {
      "\t"
    } else {
      return Err(self.err("invalid escape"))
    }
    out += c
    self.i += 1
  }
}

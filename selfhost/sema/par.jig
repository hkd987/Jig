// Checking function bodies on several threads, as the bootstrap compiler does (D25). Bodies
// are independent once the signatures are collected, so each task checks a run of whole
// files on its own copy of the checker. What a task adds to the shared type table is then
// replayed into it in the sequential order, so every type gets the id a sequential check
// gives it, and the ids in the task's tables and bodies are renamed to match. Diagnostics,
// bodies and tables come back in function order, which is the order a sequential check
// produces them in.

import "std/task"
import "syntax"

/// How much source a program needs before its bodies are checked on several threads.
const PARALLEL_CHECK_BYTES: Int = 262144

/// How many runs of files the bodies are split into.
const CHECK_CHUNKS: Int = 8

/// What one task found: the bodies of its functions, the tables of their files, the
/// diagnostics it added, the imports bodies used, and its type table.
struct ChunkOut {
  bodies: List<Option<Body>>
  tables: List<(Int, Int, Tables)>
  diags: List<syntax.Diag>
  imports_used: List<Set<(Int, Str)>>
  tys: TyCtx
}

/// Runs of whole files, as ranges of function ids: about CHECK_CHUNKS of them, or none when
/// the program is too small for threads to pay.
fn Sema.body_chunks(self) -> List<(Int, Int)> {
  var bytes = 0
  for p in self.pkgs {
    for f in p.files {
      bytes = min(bytes + f.text.len(), syntax.MAX_OFFSET)
    }
  }
  let n = self.defs.fns.len()
  if bytes < PARALLEL_CHECK_BYTES || n < 2 {
    return []
  }
  let target = bytes / CHECK_CHUNKS
  var out: List<(Int, Int)> = []
  var lo = 0
  var size = 0
  for fid in 0..n {
    let fd = self.defs.fns[fid]
    let next_file = fid + 1 < n &&
      (self.defs.fns[fid + 1].pkg != fd.pkg || self.defs.fns[fid + 1].file != fd.file)
    if fid + 1 == n || next_file {
      size = min(size + self.pkgs[fd.pkg].files[fd.file].text.len(), syntax.MAX_OFFSET)
      if size >= target || fid + 1 == n {
        out.push((lo, fid + 1))
        lo = fid + 1
        size = 0
      }
    }
  }
  return out
}

/// Check functions `lo` to `hi` on a copy of the checker.
fn Sema.check_chunk(self, lo: Int, hi: Int) -> ChunkOut {
  var s = self
  let d0 = s.diags.len()
  var bodies: List<Option<Body>> = []
  var files: List<(Int, Int)> = []
  for fid in lo..hi {
    let fd = s.defs.fns[fid]
    if files.is_empty() || files[files.len() - 1] != (fd.pkg, fd.file) {
      files.push((fd.pkg, fd.file))
    }
    if fd.iface.is_some() {
      bodies.push(None)
      continue
    }
    s.begin(fd.pkg, fd.file)
    s.check_fn(fid)
    bodies.push(Some(s.end()))
  }
  var tables: List<(Int, Int, Tables)> = []
  for (p, f) in files {
    tables.push((p, f, s.tables[p][f]))
  }
  return ChunkOut {
    bodies: bodies
    tables: tables
    diags: s.diags[d0..s.diags.len()]
    imports_used: s.imports_used
    tys: s.tys
  }
}

/// Check the bodies of every function, on several threads when the program is big enough;
/// false when it is not, and nothing was done.
fn Sema.check_fns_parallel(&mut self) -> Bool effects {spawn} {
  let chunks = self.body_chunks()
  if chunks.len() < 2 {
    return false
  }
  let base = self
  let outs = task.map(chunks, fn(c) { base.check_chunk(c.0, c.1) })
  // The types, in order; then each run's ids renamed, on several threads again.
  let ty_base = self.tys.kinds.len()
  let unit_base = self.tys.units.len()
  var jobs: List<(ChunkOut, List<Int>)> = []
  for out in outs {
    jobs.push((out, self.tys.absorb(out.tys, ty_base, unit_base)))
  }
  let renamed_outs = task.map(jobs, fn(j) { renamed_chunk(j.0, ty_base, j.1) })
  for out in renamed_outs {
    for b in out.bodies {
      self.bodies.push(b)
    }
    for (p, f, tab) in out.tables {
      self.tables[p][f] = tab
    }
    for d in out.diags {
      self.diags.push(d)
    }
    for p in 0..min(self.imports_used.len(), out.imports_used.len()) {
      for x in out.imports_used[p].items() {
        self.imports_used[p].insert(x)
      }
    }
  }
  return true
}

/// A run's bodies and tables with its type ids as the shared table has them (`map`: what
/// each id from `base` on became). The first run's are already: it added its types first.
fn renamed_chunk(out: ChunkOut, base: Int, map: List<Int>) -> ChunkOut {
  var same = true
  for i in 0..map.len() {
    same = same && map[i] == base + i
  }
  if same {
    return out
  }
  var bodies: List<Option<Body>> = []
  for b in out.bodies {
    bodies.push(
      match b {
        Some(body) => Some(rename_body(body, base, map))
        None => None
      },
    )
  }
  var tables: List<(Int, Int, Tables)> = []
  for (p, f, tab) in out.tables {
    tables.push((p, f, rename_tables(tab, base, map)))
  }
  var r = out
  r.bodies = bodies
  r.tables = tables
  return r
}

/// A type id of another copy of the type table, in this one: ids below `base` are shared,
/// the others were replayed into `map`.
fn renamed(t: Int, base: Int, map: List<Int>) -> Int {
  if t < base || t - base >= map.len() {
    return t
  }
  return map[t - base]
}

fn renamed_all(ts: List<Int>, base: Int, map: List<Int>) -> List<Int> {
  var out: List<Int> = []
  for t in ts {
    out.push(renamed(t, base, map))
  }
  return out
}

/// Replay into this type table the types and units `other` added after `base` and
/// `unit_base`, in the order it added them; what each of its types is here.
fn TyCtx.absorb(&mut self, other: TyCtx, base: Int, unit_base: Int) -> List<Int> {
  var umap: List<Int> = []
  for u in unit_base..other.units.len() {
    umap.push(self.unit_id(other.units[u]))
  }
  var tmap: List<Int> = []
  for t in base..other.kinds.len() {
    let k = match other.kinds[t] {
      Int(ik, u) => TyKind.Int(ik, renamed(u, unit_base, umap))
      Float(u) => TyKind.Float(renamed(u, unit_base, umap))
      Tuple(ts) => TyKind.Tuple(renamed_all(ts, base, tmap))
      Adt(a, ts) => TyKind.Adt(a, renamed_all(ts, base, tmap))
      List(x) => TyKind.List(renamed(x, base, tmap))
      Map(a, b) => TyKind.Map(renamed(a, base, tmap), renamed(b, base, tmap))
      Set(x) => TyKind.Set(renamed(x, base, tmap))
      Fn(ps, r, e) => TyKind.Fn(renamed_all(ps, base, tmap), renamed(r, base, tmap), e)
      k => k
    }
    tmap.push(self.intern(k))
  }
  return tmap
}

fn rename_body(b: Body, base: Int, map: List<Int>) -> Body {
  var out = b
  for i in 0..out.locals.len() {
    out.locals[i].ty = renamed(out.locals[i].ty, base, map)
  }
  return out
}

fn rename_tables(t: Tables, base: Int, map: List<Int>) -> Tables {
  var out = t
  for i in 0..out.expr_ty.len() {
    if out.expr_ty[i] >= base {
      out.expr_ty[i] = renamed(out.expr_ty[i], base, map)
    }
  }
  for i in 0..out.pat_ty.len() {
    if out.pat_ty[i] >= base {
      out.pat_ty[i] = renamed(out.pat_ty[i], base, map)
    }
  }
  for i in 0..out.expr_res.len() {
    match out.expr_res[i] {
      Type(ty) => {
        out.expr_res[i] = Res.Type(renamed(ty, base, map))
      }
      _ => {}
    }
  }
  var inst: Map<Int, List<Int>> = Map.new()
  for (e, ts) in out.expr_inst {
    inst.insert(e, renamed_all(ts, base, map))
  }
  out.expr_inst = inst
  return out
}

// Ownership analyses over MIR that let code generation skip reference-count traffic, ported
// from the bootstrap compiler's `codegen/own.rs`: borrowed locals (parts of values that stay
// alive and unchanged while they are used, which need no count of their own), last uses
// (which may move a value out instead of retaining it) and unique lists (whose element
// writes need no copy check).

fn place_uses(p: Place, out: &mut List<Int>) {
  out.push(p.local)
  for e in p.proj {
    match e {
      Index(op, _) => operand_uses(op, &mut out)
      _ => {}
    }
  }
}

fn operand_uses(op: Operand, out: &mut List<Int>) {
  match op {
    Copy(p) => place_uses(p, &mut out)
    _ => {}
  }
}

/// The locals a statement reads (with repeats), and the local it assigns whole (or -1).
fn stmt_uses(stmt: Stmt, out: &mut List<Int>) -> Int {
  match stmt {
    Assign(p, rv) => {
      if !p.proj.is_empty() {
        // Writing part of a local reads the rest of it.
        place_uses(p, &mut out)
      }
      match rv {
        Use(a) | Unary(_, a, _) | Cast(a, _, _) | Inc(a, _) => operand_uses(a, &mut out)
        Binary(_, a, b, _) => {
          operand_uses(a, &mut out)
          operand_uses(b, &mut out)
        }
        Aggregate(_, _, ops) | Closure(_, ops) => {
          for o in ops {
            operand_uses(o, &mut out)
          }
        }
        Discriminant(q) => place_uses(q, &mut out)
        Call(callee, args, _) => {
          match callee {
            Value(f) => operand_uses(f, &mut out)
            _ => {}
          }
          for a in args {
            match a {
              Value(o) => operand_uses(o, &mut out)
              MutRef(q) => place_uses(q, &mut out)
            }
          }
        }
      }
      return if p.proj.is_empty() { p.local } else { -1 }
    }
    Check(cond, _, _, values, _) => {
      operand_uses(cond, &mut out)
      for v in values {
        operand_uses(v.op, &mut out)
      }
      return -1
    }
    Drop(_) => {
      return -1
    }
  }
}

fn term_uses(t: Terminator, out: &mut List<Int>) {
  match t {
    If(c, _, _) | Switch(c, _, _) => operand_uses(c, &mut out)
    Return => out.push(0)
    _ => {}
  }
}

fn successors(t: Terminator) -> List<Int> {
  return match t {
    Goto(b) => [b]
    If(_, a, b) => [a, b]
    Switch(_, cases, d) => {
      var out: List<Int> = []
      for (_, b) in cases {
        out.push(b)
      }
      out.push(d)
      out
    }
    _ => []
  }
}

fn by_value_params(mf: MFn) -> Set<Int> {
  var out: Set<Int> = Set.new()
  for (l, m) in mf.params {
    if m != Mode.MutRef {
      out.insert(l)
    }
  }
  return out
}

/// Locals that alias what they were copied from instead of counting their own reference:
/// match scrutinees and pattern bindings, typically. Each is only ever assigned whole, from a
/// place (never written in part or passed `&mut`). It is borrowed when what it was copied
/// from (its root, through other borrowed locals) stays alive and unchanged while it is used:
/// always for a by-value parameter, which the caller keeps alive and nobody changes; for any
/// other root (`rc` locals only), when no path from a copy to a use of the local writes,
/// drops or may move the root. Each borrowed local maps to its roots.
fn borrowed_locals(mf: MFn, rc: Set<Int>) -> Map<Int, List<Int>> {
  var params: Set<Int> = Set.new()
  for (l, _) in mf.params {
    params.insert(l)
  }
  let by_value = by_value_params(mf)
  // For each local assigned whole: the local each assignment copies from (-1: something else).
  var sources: Map<Int, List<Int>> = Map.new()
  var bad: Set<Int> = Set.new()
  for block in mf.blocks {
    for ss in block.stmts {
      match ss.stmt {
        Assign(p, rv) => {
          if !p.proj.is_empty() {
            bad.insert(p.local)
          } else {
            let src = match rv {
              Use(Copy(q)) => if q.local != p.local { q.local } else { -1 }
              _ => -1
            }
            var srcs = sources.get(p.local).unwrap_or([])
            srcs.push(src)
            sources.insert(p.local, srcs)
          }
          match rv {
            Call(_, args, _) => {
              for a in args {
                match a {
                  MutRef(q) => bad.insert(q.local)
                  _ => {}
                }
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
    }
  }
  // Candidates: not the return slot or a parameter, never written in part, every assignment
  // a copy of a place.
  var cands: List<(Int, List<Int>)> = []
  var is_cand: Set<Int> = Set.new()
  for (l, srcs) in sources {
    if l != 0 && !params.contains(l) && !bad.contains(l) && !srcs.contains(-1) {
      cands.push((l, srcs))
      is_cand.insert(l)
    }
  }
  var wcx: Option<WindowCx> = None
  // Each candidate's roots once decided (borrowed ones only); a candidate is decided once its
  // sources are.
  var decided: Set<Int> = Set.new()
  var roots: Map<Int, List<Int>> = Map.new()
  for {
    var progress = false
    for (l, srcs) in cands {
      if decided.contains(l) {
        continue
      }
      var ready = true
      for s in srcs {
        if is_cand.contains(s) && !decided.contains(s) {
          ready = false
        }
      }
      if !ready {
        continue
      }
      var rs: List<Int> = []
      for s in srcs {
        match roots.get(s) {
          Some(sr) => rs.extend(sr)
          None => rs.push(s)
        }
      }
      var stable: List<Int> = []
      for r in rs {
        if !by_value.contains(r) && !stable.contains(r) {
          stable.push(r)
        }
      }
      var ok = stable.is_empty()
      if !ok && rc.contains(l) {
        if wcx.is_none() {
          wcx = Some(window_cx(mf, is_cand, rc))
        }
        match wcx {
          Some(cx) => ok = window_clean(mf, cx, params, l, stable)
          None => {}
        }
      }
      if ok {
        roots.insert(l, rs)
      }
      decided.insert(l)
      progress = true
    }
    if !progress {
      break
    }
  }
  return roots
}

fn whole_read(op: Operand, roots: List<Int>, params: Set<Int>) -> Bool {
  return match op {
    Copy(q) => q.proj.is_empty() && !params.contains(q.local) && roots.contains(q.local)
    _ => false
  }
}

/// Whether a statement may write, drop or move one of `roots`: assign it (in whole or part),
/// pass it `&mut`, drop it, or read it whole (a last use moves the value out; a parameter is
/// never moved).
fn writes_any(stmt: Stmt, roots: List<Int>, params: Set<Int>) -> Bool {
  match stmt {
    Assign(p, rv) => {
      if roots.contains(p.local) {
        return true
      }
      match rv {
        Use(a) | Unary(_, a, _) | Cast(a, _, _) | Inc(a, _) => {
          return whole_read(a, roots, params)
        }
        Binary(_, a, b, _) => {
          return whole_read(a, roots, params) || whole_read(b, roots, params)
        }
        Aggregate(_, _, ops) | Closure(_, ops) => {
          for o in ops {
            if whole_read(o, roots, params) {
              return true
            }
          }
          return false
        }
        Discriminant(_) => {
          return false
        }
        Call(callee, args, _) => {
          match callee {
            Value(f) => if whole_read(f, roots, params) {
              return true
            }
            _ => {}
          }
          for a in args {
            let w = match a {
              Value(o) => whole_read(o, roots, params)
              MutRef(q) => roots.contains(q.local)
            }
            if w {
              return true
            }
          }
          return false
        }
      }
    }
    Check(_, _, _, _, _) => {
      return false
    }
    Drop(l) => {
      return roots.contains(l)
    }
  }
}

/// What `window_clean` needs, built once per function when a candidate first needs it: where
/// each `rc` candidate is read (statement index, or the block's length for its terminator),
/// and each block's predecessors.
struct WindowCx {
  uses_at: Map<Int, List<(Int, Int)>>
  preds: List<List<Int>>
}

fn note_uses(
  us: List<Int>,
  b: Int,
  k: Int,
  cands: Set<Int>,
  rc: Set<Int>,
  uses_at: &mut Map<Int, List<(Int, Int)>>,
) {
  for l in us {
    if cands.contains(l) && rc.contains(l) {
      var at = uses_at.get(l).unwrap_or([])
      at.push((b, k))
      uses_at.insert(l, at)
    }
  }
}

fn window_cx(mf: MFn, cands: Set<Int>, rc: Set<Int>) -> WindowCx {
  var uses_at: Map<Int, List<(Int, Int)>> = Map.new()
  var preds: List<List<Int>> = []
  for _ in mf.blocks {
    preds.push([])
  }
  for b in 0..mf.blocks.len() {
    let block = mf.blocks[b]
    for k in 0..block.stmts.len() {
      var us: List<Int> = []
      let _ = stmt_uses(block.stmts[k].stmt, &mut us)
      note_uses(us, b, k, cands, rc, &mut uses_at)
    }
    var t: List<Int> = []
    term_uses(block.term, &mut t)
    note_uses(t, b, block.stmts.len(), cands, rc, &mut uses_at)
    for s in successors(block.term) {
      preds[s].push(b)
    }
  }
  return WindowCx { uses_at: uses_at, preds: preds }
}

/// Whether no path from an assignment of `l` to a use of it passes a statement that writes
/// one of `roots` (a statement that both uses `l` and writes a root counts too). Searches
/// backwards from each use until the assignments.
fn window_clean(mf: MFn, cx: WindowCx, params: Set<Int>, l: Int, roots: List<Int>) -> Bool {
  var visited: List<Bool> = []
  for _ in 0..mf.blocks.len() {
    visited.push(false)
  }
  // (block, k): look at the statements before the k-th.
  var work: List<(Int, Int)> = []
  for (b, k) in cx.uses_at.get(l).unwrap_or([]) {
    let stmts = mf.blocks[b].stmts
    if k < stmts.len() && writes_any(stmts[k].stmt, roots, params) {
      return false
    }
    work.push((b, k))
  }
  for !work.is_empty() {
    let (b, k) = work.pop().unwrap_or((0, 0))
    let stmts = mf.blocks[b].stmts
    var i = k
    var defined = false
    for i > 0 {
      i -= 1
      let defines = match stmts[i].stmt {
        Assign(p, _) => p.local == l
        _ => false
      }
      if defines {
        defined = true
        break
      }
      if writes_any(stmts[i].stmt, roots, params) {
        return false
      }
    }
    if !defined {
      for p in cx.preds[b] {
        if !visited[p] {
          visited[p] = true
          work.push((p, mf.blocks[p].stmts.len()))
        }
      }
    }
  }
  return true
}

/// For each statement, the locals whose value it may move out: read exactly once there and
/// dead afterwards. `owners` own their values (not parameters, borrowed locals or the
/// return slot).
fn last_uses(mf: MFn, owners: Set<Int>) -> List<List<Set<Int>>> {
  let n = mf.blocks.len()
  var uses_b: List<Set<Int>> = []
  var defs_b: List<Set<Int>> = []
  for block in mf.blocks {
    var u: Set<Int> = Set.new()
    var d: Set<Int> = Set.new()
    var t: List<Int> = []
    term_uses(block.term, &mut t)
    for x in t {
      u.insert(x)
    }
    var i = block.stmts.len() - 1
    for i >= 0 {
      var us: List<Int> = []
      let l = stmt_uses(block.stmts[i].stmt, &mut us)
      if l >= 0 {
        let _ = u.remove(l)
        d.insert(l)
      }
      for x in us {
        u.insert(x)
      }
      i -= 1
    }
    uses_b.push(u)
    defs_b.push(d)
  }
  var succ: List<List<Int>> = []
  for block in mf.blocks {
    succ.push(successors(block.term))
  }
  var live_in: List<Set<Int>> = []
  for _ in 0..n {
    live_in.push(Set.new())
  }
  var changed = true
  for changed {
    changed = false
    var b = n - 1
    for b >= 0 {
      var inn: Set<Int> = Set.new()
      for s in succ[b] {
        for l in live_in[s].items() {
          if !defs_b[b].contains(l) {
            inn.insert(l)
          }
        }
      }
      for l in uses_b[b].items() {
        inn.insert(l)
      }
      if inn.len() != live_in[b].len() {
        live_in[b] = inn
        changed = true
      }
      b -= 1
    }
  }
  var result: List<List<Set<Int>>> = []
  for b in 0..n {
    let block = mf.blocks[b]
    var live: Set<Int> = Set.new()
    for s in succ[b] {
      for l in live_in[s].items() {
        live.insert(l)
      }
    }
    var t: List<Int> = []
    term_uses(block.term, &mut t)
    for x in t {
      live.insert(x)
    }
    var per: List<Set<Int>> = []
    for _ in block.stmts {
      per.push(Set.new())
    }
    var i = block.stmts.len() - 1
    for i >= 0 {
      var us: List<Int> = []
      let def = stmt_uses(block.stmts[i].stmt, &mut us)
      var counts: Map<Int, Int> = Map.new()
      for l in us {
        counts.insert(l, counts.get(l).unwrap_or(0) + 1)
      }
      var moves: Set<Int> = Set.new()
      for (l, c) in counts {
        if c == 1 && owners.contains(l) && !live.contains(l) {
          moves.insert(l)
        }
      }
      per[i] = moves
      if def >= 0 {
        let _ = live.remove(def)
      }
      for x in us {
        live.insert(x)
      }
      i -= 1
    }
    result.push(per)
  }
  return result
}

/// Locals with their borrowed locals' roots added.
fn with_roots(us: &mut List<Int>, roots: Map<Int, List<Int>>) {
  let n = us.len()
  for i in 0..n {
    match roots.get(us[i]) {
      Some(rs) => us.extend(rs)
      None => {}
    }
  }
}

/// For each statement, the owned locals to release after it: the ones it reads or assigns that
/// are dead afterwards, where reading a borrowed local reads its roots too (a root stays alive
/// while what borrows from it is used). Values then die at their last use, so a value they
/// shared is not copied when it is changed next.
fn dead_after(mf: MFn, owners: Set<Int>, roots: Map<Int, List<Int>>) -> List<List<List<Int>>> {
  let n = mf.blocks.len()
  var uses_b: List<Set<Int>> = []
  var defs_b: List<Set<Int>> = []
  var term_b: List<List<Int>> = []
  for block in mf.blocks {
    var u: Set<Int> = Set.new()
    var d: Set<Int> = Set.new()
    var t: List<Int> = []
    term_uses(block.term, &mut t)
    with_roots(&mut t, roots)
    for x in t {
      u.insert(x)
    }
    term_b.push(t)
    var i = block.stmts.len() - 1
    for i >= 0 {
      var us: List<Int> = []
      let l = stmt_uses(block.stmts[i].stmt, &mut us)
      with_roots(&mut us, roots)
      if l >= 0 {
        let _ = u.remove(l)
        d.insert(l)
      }
      for x in us {
        u.insert(x)
      }
      i -= 1
    }
    uses_b.push(u)
    defs_b.push(d)
  }
  var succ: List<List<Int>> = []
  for block in mf.blocks {
    succ.push(successors(block.term))
  }
  var live_in: List<Set<Int>> = []
  for _ in 0..n {
    live_in.push(Set.new())
  }
  var changed = true
  for changed {
    changed = false
    var b = n - 1
    for b >= 0 {
      var inn: Set<Int> = Set.new()
      for s in succ[b] {
        for l in live_in[s].items() {
          if !defs_b[b].contains(l) {
            inn.insert(l)
          }
        }
      }
      for l in uses_b[b].items() {
        inn.insert(l)
      }
      if inn.len() != live_in[b].len() {
        live_in[b] = inn
        changed = true
      }
      b -= 1
    }
  }
  var result: List<List<List<Int>>> = []
  for b in 0..n {
    let block = mf.blocks[b]
    var live: Set<Int> = Set.new()
    for s in succ[b] {
      for l in live_in[s].items() {
        live.insert(l)
      }
    }
    for x in term_b[b] {
      live.insert(x)
    }
    var per: List<List<Int>> = []
    for _ in block.stmts {
      per.push([])
    }
    var i = block.stmts.len() - 1
    for i >= 0 {
      var us: List<Int> = []
      let def = stmt_uses(block.stmts[i].stmt, &mut us)
      with_roots(&mut us, roots)
      var dead: List<Int> = []
      for l in us {
        if owners.contains(l) && !live.contains(l) && !dead.contains(l) {
          dead.push(l)
        }
      }
      if def >= 0 && owners.contains(def) && !live.contains(def) && !dead.contains(def) {
        dead.push(def)
      }
      dead.sort()
      per[i] = dead
      if def >= 0 {
        let _ = live.remove(def)
      }
      for x in us {
        live.insert(x)
      }
      i -= 1
    }
    result.push(per)
  }
  return result
}

/// For each block, the owned locals that may hold a value when its terminator runs: assigned
/// (or passed `&mut`) on some path since they were last released. Every local starts empty, so
/// a function's return releases only these.
fn held_at_end(mf: MFn, owners: Set<Int>, dead: List<List<List<Int>>>) -> List<Set<Int>> {
  let n = mf.blocks.len()
  var succ: List<List<Int>> = []
  for block in mf.blocks {
    succ.push(successors(block.term))
  }
  var held_in: List<Set<Int>> = []
  var held_out: List<Set<Int>> = []
  for _ in 0..n {
    held_in.push(Set.new())
    held_out.push(Set.new())
  }
  var changed = true
  for changed {
    changed = false
    for b in 0..n {
      var h = held_in[b]
      let stmts = mf.blocks[b].stmts
      for i in 0..stmts.len() {
        match stmts[i].stmt {
          Assign(p, rv) => {
            if owners.contains(p.local) {
              h.insert(p.local)
            }
            match rv {
              Call(_, args, _) => {
                for a in args {
                  match a {
                    MutRef(q) => if owners.contains(q.local) { h.insert(q.local) }
                    _ => {}
                  }
                }
              }
              _ => {}
            }
          }
          Drop(l) => {
            let _ = h.remove(l)
          }
          _ => {}
        }
        for l in dead[b][i] {
          let _ = h.remove(l)
        }
      }
      // Sets only grow, so a change shows in the size.
      if h.len() != held_out[b].len() {
        for s in succ[b] {
          for l in h.items() {
            held_in[s].insert(l)
          }
        }
        held_out[b] = h
        changed = true
      }
    }
  }
  return held_out
}

/// Intrinsics that read a list argument in place.
fn reads_in_place(op: Op) -> Bool {
  return match op {
    ListLen | ListIsEmpty | Get | ListSlice | ListRepeat | Show => true
    _ => false
  }
}

fn whole_use(op: Operand, bad: &mut Set<Int>) {
  match op {
    Copy(p) => if p.proj.is_empty() { bad.insert(p.local) }
    _ => {}
  }
}

fn index_first(p: Place) -> Bool {
  if p.proj.is_empty() {
    return false
  }
  return match p.proj[0] {
    Index(_, _) => true
    _ => false
  }
}

/// Lists that stay unique once made so: written through indices, and otherwise used only by
/// intrinsics that read them in place or keep them unique.
fn unique_lists(mf: MFn, tys: TyCtx) -> Set<Int> {
  var written: Set<Int> = Set.new()
  var bad: Set<Int> = Set.new()
  for block in mf.blocks {
    for ss in block.stmts {
      match ss.stmt {
        Assign(p, rv) => {
          if index_first(p) {
            written.insert(p.local)
          }
          match rv {
            Use(a) | Unary(_, a, _) | Cast(a, _, _) | Inc(a, _) => whole_use(a, &mut bad)
            Binary(_, a, b, _) => {
              whole_use(a, &mut bad)
              whole_use(b, &mut bad)
            }
            Aggregate(_, _, ops) | Closure(_, ops) => {
              for o in ops {
                whole_use(o, &mut bad)
              }
            }
            Discriminant(_) => {}
            Call(callee, args, _) => {
              var intr: Option<Op> = None
              match callee {
                Intrinsic(i) => intr = Some(i.op)
                Value(f) => whole_use(f, &mut bad)
                _ => {}
              }
              for a in args {
                match a {
                  Value(o) => {
                    let in_place = match intr {
                      Some(op) => reads_in_place(op)
                      None => false
                    }
                    if !in_place {
                      whole_use(o, &mut bad)
                    }
                  }
                  MutRef(q) => {
                    // List intrinsics taking `&mut` keep a unique list unique.
                    if intr.is_none() {
                      if q.proj.is_empty() {
                        bad.insert(q.local)
                      } else if index_first(q) {
                        written.insert(q.local)
                      }
                    }
                  }
                }
              }
            }
          }
        }
        _ => {}
      }
    }
  }
  let by_value = by_value_params(mf)
  var out: Set<Int> = Set.new()
  for l in written.items() {
    let is_list = match tys.kinds[mf.locals[l]] {
      List(_) => true
      _ => false
    }
    if l != 0 && !bad.contains(l) && !by_value.contains(l) && is_list {
      out.insert(l)
    }
  }
  return out
}

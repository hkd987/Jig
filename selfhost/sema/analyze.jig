// The checker's driver, ported from the bootstrap compiler's `sema/mod.rs`, and the dump
// compared with `jig debug check DIR`: every diagnostic, then the type of every expression
// and pattern of the project's own packages.

import "std/fs"
import "std/os"
import "std/time"
import "syntax"

/// A package that failed to parse reports only its syntax errors: recovery drops code, and
/// what follows is noise that buries the one real mistake.
fn Sema.quiet_after_syntax_errors(&mut self) {
  var bad: Set<(Int, Int)> = Set.new()
  for d in self.diags {
    // Errors whose recovery skips source text.
    if d.code == "E0101" || d.code == "E0102" || d.code == "E0105" || d.code == "E0108" {
      match self.file_of(d.lo) {
        Some(pf) => bad.insert(pf)
        None => {}
      }
    }
  }
  if bad.is_empty() {
    return
  }
  var quiet: Set<Int> = Set.new()
  for (p, _) in bad.items() {
    quiet.insert(p)
  }
  var kept: List<syntax.Diag> = []
  for d in self.diags {
    let keep = d.code.starts_with("E01") ||
      match self.file_of(d.lo) {
        Some((p, _)) => !quiet.contains(p)
        None => true
      }
    if keep {
      kept.push(d)
    }
  }
  self.diags = kept
}

/// The (package, file) holding global offset `pos`.
fn Sema.file_of(self, pos: Int) -> Option<(Int, Int)>
  ensures result.is_none() || (result.unwrap().0 >= 0 && result.unwrap().0 < self.pkgs.len())
  ensures result.is_none() ||
    (result.unwrap().1 >= 0 && result.unwrap().1 < self.pkgs[result.unwrap().0].files.len())
{
  for p in 0..self.pkgs.len() {
    let files = self.pkgs[p].files
    for f in 0..files.len() {
      if files[f].base <= pos && pos <= files[f].base + files[f].text.len() {
        return Some((p, f))
      }
    }
  }
  return None
}

/// Sort by position (then code), keeping the order of equal keys, and drop exact duplicates.
fn Sema.sort_diags(&mut self) {
  var keyed: List<(syntax.Diag, Int)> = []
  for i in 0..self.diags.len() {
    keyed.push((self.diags[i], i))
  }
  keyed.sort_by(fn(a, b) {
    a.0.lo < b.0.lo ||
      (a.0.lo == b.0.lo && (a.0.code < b.0.code || (a.0.code == b.0.code && a.1 < b.1)))
  })
  var out: List<syntax.Diag> = []
  for (d, _) in keyed {
    // Duplicates: the same place, code and message (what is attached may differ).
    let n = out.len()
    if n > 0 &&
      out[n - 1].lo == d.lo &&
      out[n - 1].hi == d.hi &&
      out[n - 1].code == d.code &&
      out[n - 1].msg == d.msg {
      continue
    }
    out.push(d)
  }
  self.diags = out
}

/// Check the package in `dir` (an absolute path) with the standard library in `std_dir`.
fn analyze(dir: Str, std_dir: Str) -> (Sema, Str) effects {fs, env} {
  let ld = load_program(dir, std_dir)
  let root = ld.project_root.unwrap_or(dir)
  var s = new_sema(ld)
  s.collect()
  s.check_bodies()
  s.bind_features()
  s.quiet_after_syntax_errors()
  s.drop_lints_in_modules()
  s.sort_diags()
  s.check_dead_code()
  return (s, root)
}

/// A file's name in the dump: relative to the project root.
fn dump_name(path: Str, root: Str) -> Str
  ensures result.len() <= path.len()
{
  let prefix = join_path(root, "")
  return if path.starts_with(prefix) { path[prefix.len()..path.len()] } else { path }
}

/// Lints and dead code in required modules are their authors' business.
fn Sema.drop_lints_in_modules(&mut self) {
  var kept: List<syntax.Diag> = []
  for d in self.diags {
    let lint = d.code.starts_with("E05") || d.code.starts_with("E06")
    let external = match self.file_of(d.lo) {
      Some((p, _)) => self.pkgs[p].external
      None => false
    }
    if !lint || !external {
      kept.push(d)
    }
  }
  self.diags = kept
}

/// The file, `.jig` or `.feature`, that holds global offset `pos`.
fn Sema.src_file_at(self, pos: Int) -> Option<SrcFile> {
  for pkg in self.pkgs {
    for f in pkg.files {
      if f.base <= pos && pos <= f.base + f.text.len() {
        return Some(f)
      }
    }
    for f in pkg.features {
      if f.base <= pos && pos <= f.base + f.text.len() {
        return Some(f)
      }
    }
  }
  return None
}

fn Sema.place(self, root: Str, lo: Int, hi: Int) -> Str {
  if lo == 0 && hi == 0 {
    return "- 0 0"
  }
  return match self.src_file_at(lo) {
    Some(file) => {
      let rel_hi = if hi > file.base { hi - file.base } else { 0 }
      dump_name(file.path, root) + " " + (lo - file.base).str() + " " + rel_hi.str()
    }
    None => "- 0 0"
  }
}

/// `jigc check DIR STD`: the same lines as `jig debug check DIR`.
fn check_dump(dir: Str, std_dir: Str) -> Str effects {fs, env} {
  let (s, root) = analyze(dir, std_dir)
  // One string, appended to in place.
  var out = ""
  for d in s.diags {
    out += "error " + d.code + " " + s.place(root, d.lo, d.hi) + " " + d.msg + "\n"
  }
  // Types render once each.
  var shown = [""].repeat(s.tys.kinds.len())
  for p in 0..s.pkgs.len() {
    if s.pkgs[p].is_std {
      continue
    }
    let files = s.pkgs[p].files
    for f in 0..files.len() {
      let name = dump_name(files[f].path, root)
      let base = files[f].base
      let ast = files[f].ast
      let tab = s.tables[p][f]
      for i in 0..ast.exprs.len() {
        let sp = ast.exprs[i].span
        let t = tab.expr_ty[i]
        if shown[t].is_empty() {
          shown[t] = s.tys.display(t)
        }
        out += "expr "
        out += name
        out += " "
        out += (sp.lo - base).str()
        out += " "
        out += (sp.hi - base).str()
        out += " "
        out += shown[t]
        out += "\n"
      }
      for i in 0..ast.pats.len() {
        let sp = ast.pats[i].span
        let t = tab.pat_ty[i]
        if shown[t].is_empty() {
          shown[t] = s.tys.display(t)
        }
        out += "pat "
        out += name
        out += " "
        out += (sp.lo - base).str()
        out += " "
        out += (sp.hi - base).str()
        out += " "
        out += shown[t]
        out += "\n"
      }
    }
  }
  return out
}

/// `jigc c DIR STD`: the C program for the package in DIR, the same text as `jig debug c DIR`.
/// Locations name files relative to `cwd`.
fn c_dump(dir: Str, std_dir: Str, cwd: Str) -> Result<Str, Str> effects {fs, env} {
  let (s, _) = analyze(dir, std_dir)
  if !s.diags.is_empty() {
    return Err(dir + " has errors")
  }
  return generate_c(new_lw(s), cwd)
}

/// `jigc c DIR STD proofs`: the C program with the cached proofs (`.jig/proofs` in the project)
/// removing the checks they discharge, the same text as `jig debug c DIR proofs`.
fn c_dump_proved(dir: Str, std_dir: Str, cwd: Str) -> Result<Str, Str>
  effects {fs, env, ffi, clock}
{
  let (s, _) = analyze(dir, std_dir)
  if !s.diags.is_empty() {
    return Err(dir + " has errors")
  }
  let cache = join_path(join_path(find_project_root(dir).unwrap_or(dir), ".jig"), "proofs")
  let proven = s.cached_proven(std_dir, cache)
  var lw = new_lw(s)
  lw.mir.elide = proven
  return generate_c(lw, cwd)
}

/// A release build of DIR as one self-contained C file: `c_dump`'s program with the runtime
/// (`STD/../runtime`) inlined, so a C compiler alone builds it (`cc FILE -pthread -lm`).
fn c_unit(dir: Str, std_dir: Str, cwd: Str) -> Result<Str, Str> effects {fs, env} {
  let c = c_dump(dir, std_dir, cwd)?
  let header = read_runtime(std_dir, "jig_rt.h")?
  let runtime = read_runtime(std_dir, "jig_rt.c")?
  let include = "#include \"jig_rt.h\"\n"
  let program = c.replace(include, header) + "\n" + runtime.replace(include, "")
  return Ok("#define _GNU_SOURCE\n#define JIG_POOL 1\n" + program)
}

/// `jigc sim DIR STD`: run `main` of DIR on the interpreter with simulated effects, printing
/// its output and then `<exit N>` or `<panic: MESSAGE>` if it did not return.
fn sim_main(dir: Str, std_dir: Str, cwd: Str) -> Result<Str, Str>
  effects {io, fs, net, clock, env, ffi}
{
  let (s, _) = analyze(dir, std_dir)
  if !s.diags.is_empty() {
    return Err(dir + " has errors")
  }
  return run_main_sim(new_lw(s), cwd)
}

fn base_name(b: Base, tys: TyCtx) -> Str
  ensures !result.is_empty()
{
  return match b {
    Bool => "bool"
    Int(k) => "int " + k.name()
    Char => "char"
    Tag(n) => "tag " + n.str()
    Str => "str"
    Float => "float"
    Opaque(t) => "opaque " + tys.display(t)
  }
}

/// The functions `prove` checks: the program's functions with bodies (or the standard
/// library's), except interface signatures and test helpers.
fn Sema.prove_targets(self, std: Bool) -> List<Int> {
  var out: List<Int> = []
  for f in 0..self.defs.fns.len() {
    let fd = self.defs.fns[f]
    let p = self.pkgs[fd.pkg]
    if p.is_std == std &&
      !p.external &&
      !p.files[fd.file].path.ends_with("_test.jig") &&
      fd.has_body &&
      fd.iface.is_none() &&
      self.bodies[f].is_some() {
      out.push(f)
    }
  }
  return out
}

/// `jigc vc DIR STD [std]`: the verification conditions of each function, the same text as
/// `jig debug vc DIR [std]`.
fn vc_dump(dir: Str, std_dir: Str, std: Bool) -> Result<Str, Str> effects {fs, env} {
  let (s, root) = analyze(dir, std_dir)
  if !s.diags.is_empty() {
    return Err(dir + " has errors")
  }
  var fns = s.prove_targets(std)
  // By position (stable: ties keep their order).
  var keyed: List<(Int, Int, Int)> = []
  for i in 0..fns.len() {
    keyed.push((s.defs.fns[fns[i]].span.lo, i, fns[i]))
  }
  keyed.sort()
  fns = []
  for (_, _, f) in keyed {
    fns.push(f)
  }
  var titles: List<Str> = []
  for f in fns {
    let sp = s.defs.fns[f].span
    titles.push("fn " + s.fn_display_name(f) + " " + s.place(root, sp.lo, sp.hi))
  }
  let frames = compute_frames(s)
  let reads = compute_reads(s)
  var g = new_gen(s, frames, reads)
  var out = ""
  for i in 0..fns.len() {
    let vcs = match g.function(fns[i]) {
      Some(v) => v
      None => {
        continue
      }
    }
    out += titles[i] + "\n"
    for d in vcs.decls {
      out += "decl " + d + "\n"
    }
    for o in vcs.obligations {
      out += "ob " +
        o.kind.name() +
        " " +
        g.s.place(root, o.span.lo, o.span.hi) +
        " " +
        (if o.elidable { "1" } else { "0" }) +
        " " +
        o.msg +
        "\n"
      for p in o.pc {
        out += "pc " + p + "\n"
      }
      out += "goal " + o.goal + "\n"
    }
    for (label, term, b) in vcs.show {
      out += "show " + label + " " + term + " " + base_name(b, g.s.tys) + "\n"
    }
    match vcs.inputs {
      Some(ins) => {
        for (t, leaves) in ins {
          var ls: List<Str> = []
          for (lt, lb) in leaves {
            ls.push(lt + ":" + base_name(lb, g.s.tys))
          }
          out += "input " + g.s.tys.display(t) + " " + ls.join(" ") + "\n"
        }
      }
      None => out += "inputs none\n"
    }
  }
  return Ok(out)
}

/// `jigc prove DIR STD [--json] [--verbose] [--std] [--no-cache] [FILTER]`: prove the package in
/// DIR (or the standard library) as `jig prove` does, printing the same report and sharing its
/// proof cache (`.jig/proofs` in the project). Returns the
/// output and the exit code.
fn prove_cmd(dir: Str, std_dir: Str, cwd: Str, flags: List<Str>) -> Output
  effects {io, fs, net, clock, env, ffi}
{
  let json = flags.contains("--json")
  let verbose = flags.contains("--verbose")
  let std = flags.contains("--std")
  var filter = ""
  for f in flags {
    if !f.starts_with("--") {
      filter = f
    }
  }
  var root = dir
  if std {
    // A package importing every standard package, as the bootstrap compiler's `analyze_std`.
    root = join_path(os.env("TMPDIR").unwrap_or("/tmp"), "jigc-std-" + time.now_ns().str())
    var src = ""
    for p in [
      "io",
      "fs",
      "os",
      "time",
      "rand",
      "math",
      "task",
      "sim",
      "net",
      "lists",
      "strings",
      "html",
      "json",
      "hash",
      "regex",
    ] {
      src += "import \"std/" + p + "\"\n"
    }
    let _ = system("mkdir -p '" + root + "'")
    let _ = fs.write(join_path(root, "main.jig"), src + "\nfn main() {\n}\n")
  }
  var (s, _) = analyze(root, std_dir)
  if std {
    let _ = system("rm -rf '" + root + "'")
    // The imports are there to load the packages.
    var kept: List<syntax.Diag> = []
    for d in s.diags {
      if d.code != "E0502" {
        kept.push(d)
      }
    }
    s.diags = kept
  }
  if !s.diags.is_empty() {
    if std {
      return output(s.error_output(json, cwd).out, "", 1)
    }
    return s.error_output(json, cwd)
  }
  let start = time.now_ms()
  let cache_dir = if flags.contains("--no-cache") {
    None
  } else if std {
    Some(join_path(join_path(cwd, ".jig"), "proofs"))
  } else {
    Some(join_path(join_path(find_project_root(dir).unwrap_or(dir), ".jig"), "proofs"))
  }
  let reports = match prove_program(s, std_dir, std, filter, cwd, cache_dir) {
    Ok(r) => r
    Err(e) => {
      return output("", "error: " + e + "\n", 2)
    }
  }
  let millis = time.now_ms() - start
  var out = ""
  if json {
    for f in reports {
      for o in f.obligations {
        out += s.obligation_json(f, o, cwd) + "\n"
      }
    }
    out += s.summary_json(reports, millis) + "\n"
  } else {
    out = s.render_report(reports, verbose, millis, cwd)
  }
  return output(out, "", if failed_contracts(reports) > 0 { 1 } else { 0 })
}

/// The C compiler for a mode: `$JIG_CC`, else `clang` for release builds when present, else
/// `cc` (as the bootstrap compiler picks it).
fn c_compiler(release: Bool) -> Str effects {env, ffi} {
  match os.env("JIG_CC") {
    Some(cc) => {
      return cc
    }
    None => {}
  }
  if release && system("clang --version > /dev/null 2>&1") == 0 {
    return "clang"
  }
  return "cc"
}

/// `jigc build DIR STD [--release] [-o OUT]`: build `main` of the package in DIR into a native
/// executable, with the checks the cached proofs discharge removed, as `jig build` does (one
/// C file, the runtime included; release builds allocate from the runtime's pools and
/// optimize). Prints the executable's path. Returns the output and the exit code.
fn build_cmd(dir: Str, std_dir: Str, cwd: Str, flags: List<Str>) -> Output
  effects {fs, env, ffi, clock}
{
  let (s, _) = analyze(dir, std_dir)
  if !s.diags.is_empty() {
    return s.error_output(false, cwd)
  }
  return build_sema(s, dir, std_dir, cwd, flags)
}

/// Build the analyzed package in DIR (without errors), as `jigc build` does.
fn build_sema(s: Sema, dir: Str, std_dir: Str, cwd: Str, flags: List<Str>) -> Output
  effects {fs, env, ffi, clock}
{
  let release = flags.contains("--release")
  let root = find_project_root(dir).unwrap_or(dir)
  let proven = s.cached_proven(std_dir, join_path(join_path(root, ".jig"), "proofs"))
  var note = ""
  let some = !proven.contract.is_empty() ||
    !proven.safety.is_empty() ||
    !proven.bounds.is_empty() ||
    !proven.entries.is_empty()
  if some && os.env("JIG_QUIET").is_none() {
    let n = proven.entries.len()
    note = "using proofs: " +
      proven.contract.len().str() +
      " contract, " +
      proven.safety.len().str() +
      " arithmetic and " +
      proven.bounds.len().str() +
      " bounds checks removed" +
      (if n == 0 {
        ""
      } else if n == 1 {
        "; 1 function's preconditions hold at every call"
      } else {
        "; " + n.str() + " functions' preconditions hold at every call"
      }) +
      "\n"
  }
  let links = s.links
  var lw = new_lw(s)
  lw.mir.elide = proven
  let c = match generate_c(lw, cwd) {
    Ok(c) => c
    Err(e) => {
      return output("", note + "error: " + e + "\n", 1)
    }
  }
  let header = match read_runtime(std_dir, "jig_rt.h") {
    Ok(t) => t
    Err(e) => {
      return output("", note + "error: " + e + "\n", 1)
    }
  }
  let runtime = match read_runtime(std_dir, "jig_rt.c") {
    Ok(t) => t
    Err(e) => {
      return output("", note + "error: " + e + "\n", 1)
    }
  }
  let include = "#include \"jig_rt.h\"\n"
  let prefix = if release {
    "#define _GNU_SOURCE\n#define JIG_POOL 1\n"
  } else {
    "#define _GNU_SOURCE\n"
  }
  let program = prefix + c.replace(include, header) + "\n" + runtime.replace(include, "")
  var dir_name = dir
  for dir_name.ends_with("/") && dir_name.len() > 1 {
    dir_name = dir_name[0..dir_name.len() - 1]
  }
  var name = dir_name
  match last_index_of(dir_name, "/") {
    Some(i) => name = dir_name[i + 1..dir_name.len()]
    None => {}
  }
  if name == "." || name.is_empty() {
    name = "main"
  }
  let build_dir = join_path(
    join_path(join_path(root, ".jig"), "build"),
    if release { "release" } else { "debug" },
  )
  var out = join_path(build_dir, name)
  for i in 0..flags.len() {
    if flags[i] == "-o" && i + 1 < flags.len() {
      out = flags[i + 1]
    }
  }
  let _ = system("mkdir -p '" + build_dir + "'")
  let src = join_path(build_dir, name + ".c")
  match fs.write(src, program) {
    Ok(_) => {}
    Err(e) => {
      return output("", note + "error: " + e + "\n", 1)
    }
  }
  var cmd = c_compiler(release) +
    (if release { " -O2 -fno-math-errno" } else { " -O0 -g -fno-math-errno" }) +
    " -std=gnu11 -w -pthread '" +
    src +
    "'"
  for l in links {
    cmd += " -l" + l
  }
  let log = src + ".log"
  cmd += " -lm -o '" + out + "' > '" + log + "' 2>&1"
  if system(cmd) != 0 {
    let msg = fs.read(log).unwrap_or("")
    return output("", note + "error: C compiler failed:\n" + msg, 1)
  }
  return output(out + "\n", note, 0)
}

// Loading packages, ported from the bootstrap compiler's `sema/load.rs`: find the project
// root, read each package's files, parse them, follow imports wave by wave, and report
// import cycles. The standard library is read from a directory.

import "std/fs"
import "std/os"
import "std/strings"
import "syntax"

/// The standard packages: import path and file name.
fn std_packages() -> List<(Str, Str)>
  ensures result.len() == 11
{
  return [
    ("std/io", "io.jig"),
    ("std/fs", "fs.jig"),
    ("std/os", "os.jig"),
    ("std/time", "time.jig"),
    ("std/rand", "rand.jig"),
    ("std/math", "math.jig"),
    ("std/task", "task.jig"),
    ("std/sim", "sim.jig"),
    ("std/net", "net.jig"),
    ("std/lists", "lists.jig"),
    ("std/strings", "strings.jig"),
  ]
}

fn std_package_paths() -> List<Str>
  ensures result.len() == std_packages().len()
{
  var out: List<Str> = []
  for (p, _) in std_packages() {
    out.push(p)
  }
  return out
}

/// A standard library file: read from `std_dir`, or the built-in copy when it is empty.
fn read_std(std_dir: Str, file: Str) -> Result<Str, Str> effects {fs} {
  if std_dir.is_empty() {
    return std_source(file).ok_or("no standard library file `" + file + "`")
  }
  return fs.read(join_path(std_dir, file))
}

/// A C runtime file: read from `std_dir/../runtime`, or the built-in copy when `std_dir` is
/// empty.
fn read_runtime(std_dir: Str, file: Str) -> Result<Str, Str> effects {fs} {
  if std_dir.is_empty() {
    return runtime_source(file).ok_or("no runtime file `" + file + "`")
  }
  return fs.read(std_dir + "/../runtime/" + file)
}

fn join_path(a: Str, b: Str) -> Str
  ensures result.len() >= a.len() + b.len()
{
  if a.ends_with("/") {
    return a + b
  }
  return a + "/" + b
}

fn parent_dir(d: Str) -> Option<Str>
  ensures result.is_none() || !result.unwrap().is_empty()
{
  if d == "/" || d.is_empty() {
    return None
  }
  var i = d.len() - 1
  for i > 0 && d[i] != '/' invariant i >= 0 && i < d.len() {
    i -= 1
  }
  if d[i] != '/' {
    return None
  }
  return Some(if i == 0 { "/" } else { d[0..i] })
}

fn find_project_root(start: Str) -> Option<Str> effects {fs} {
  var cur = Some(start)
  for {
    match cur {
      Some(d) => {
        if fs.exists(join_path(d, "jig.mod")) {
          return Some(d)
        }
        cur = parent_dir(d)
      }
      None => {
        return None
      }
    }
  }
}

/// The lines of a `jig.mod` this port understands: `module` and `link` (modules are not
/// supported yet), and the errors of the others.
/// A parsed `jig.mod`.
struct ModFile {
  module: Option<Str>
  links: List<Str>
  reqs: List<(Str, Str)>
  replaces: List<(Str, Str)>
  /// Lines that are not understood, with their line numbers.
  errors: List<(Int, Str)>
}

fn is_mod_name(s: Str) -> Bool
  ensures !result || !s.is_empty()
{
  if s.is_empty() {
    return false
  }
  for c in s.chars() {
    if !(c.is_alnum() && (c as Int) < 128) && c != '_' && c != '-' && c != '.' {
      return false
    }
  }
  return true
}

fn is_module_path(s: Str) -> Bool
  ensures !result || !s.is_empty()
{
  if s.is_empty() {
    return false
  }
  for seg in s.split("/") {
    if !is_mod_name(seg) || seg == "." || seg == ".." {
      return false
    }
  }
  return true
}

fn parse_mod(text: Str) -> ModFile {
  var m = ModFile { module: None, links: [], reqs: [], replaces: [], errors: [] }
  let lines = text.lines()
  for i in 0..lines.len() invariant m.errors.len() <= i {
    let line = lines[i].split("//")[0].trim()
    let w = strings.words(line)
    var ok = false
    if w.is_empty() {
      ok = true
    } else if w.len() == 2 && w[0] == "module" {
      m.module = Some(w[1])
      ok = true
    } else if w.len() == 2 && w[0] == "link" && is_mod_name(w[1]) {
      m.links.push(w[1])
      ok = true
    } else if w.len() == 3 && w[0] == "require" && is_module_path(w[1]) && is_mod_name(w[2]) {
      m.reqs.push((w[1], w[2]))
      ok = true
    } else if w.len() == 4 && w[0] == "replace" && w[2] == "=>" && is_module_path(w[1]) {
      m.replaces.push((w[1], w[3]))
      ok = true
    }
    if !ok {
      let msg = "`" +
        line +
        "`: expected `module NAME`, `link NAME`, `require PATH VERSION` or `replace PATH => DIR`"
      m.errors.push((i + 1, msg))
    }
  }
  return m
}

/// `a` joined with `b` as a path: `b` itself if it is absolute.
fn path_join(a: Str, b: Str) -> Str
  ensures result == b || result.len() >= a.len() + b.len()
{
  if b.starts_with("/") || a.is_empty() {
    return b
  }
  return join_path(a, b)
}

/// Where downloaded modules live (`$JIG_HOME/mod`, by default `~/.jig/mod`).
fn cache_dir() -> Str effects {env} {
  match os.env("JIG_HOME") {
    Some(h) => {
      return path_join(h, "mod")
    }
    None => {}
  }
  return path_join(path_join(os.env("HOME").unwrap_or("."), ".jig"), "mod")
}

/// A version's parts: numbers, or text where a part is not one.
fn version_parts(v: Str) -> List<(Bool, Int, Str)> {
  var t = v
  for t.starts_with("v") {
    t = t[1..t.len()]
  }
  var parts: List<(Bool, Int, Str)> = []
  var cur: List<Char> = []
  for c in (t + ".").chars() {
    if c == '.' || c == '-' {
      let part = Str.from_chars(cur)
      cur = []
      var digits = part
      if digits.starts_with("+") {
        digits = digits[1..digits.len()]
      }
      var numeric = !digits.is_empty()
      for b in digits.bytes() {
        if b < 48 || b > 57 {
          numeric = false
        }
      }
      let n = if numeric { digits.to_int() } else { None }
      parts.push(
        match n {
          Some(x) => (true, x, "")
          None => (false, 0, part)
        },
      )
    } else {
      cur.push(c)
    }
  }
  return parts
}

/// Order versions: `v1.10.0` after `v1.9.2`; numbers compare as numbers (-1, 0 or 1).
fn version_cmp(a: Str, b: Str) -> Int
  ensures result >= -1 && result <= 1
{
  let (pa, pb) = (version_parts(a), version_parts(b))
  for i in 0..min(pa.len(), pb.len()) {
    let (an, ai, as_) = pa[i]
    let (bn, bi, bs) = pb[i]
    let o = if an && bn {
      if ai < bi {
        -1
      } else if ai > bi {
        1
      } else {
        0
      }
    } else if an {
      1
    } else if bn {
      -1
    } else if as_ < bs {
      -1
    } else if as_ > bs {
      1
    } else {
      0
    }
    if o != 0 {
      return o
    }
  }
  return if pa.len() < pb.len() { -1 } else if pa.len() > pb.len() { 1 } else { 0 }
}

/// One module in the build.
struct Resolved {
  path: Str
  version: Str
  dir: Str
  /// Pointed at a local directory by `replace`.
  replaced: Bool
  /// Not downloaded yet (`jig get`).
  missing: Bool
}

/// Every module the project at `root` needs, one version each: the highest any module in the
/// build requires.
fn resolve_modules(root: Str, top: ModFile) -> (List<Resolved>, List<Str>) effects {fs, env} {
  var errors: List<Str> = []
  var chosen: List<Resolved> = []
  var pending = top.reqs
  // Raise versions until nothing changes; each newly chosen version's own requirements count.
  for !pending.is_empty() {
    let (path, version) = pending.pop().unwrap_or(("", ""))
    var at = -1
    for i in 0..chosen.len() {
      if at < 0 && chosen[i].path == path {
        at = i
      }
    }
    if at >= 0 && version_cmp(version, chosen[at].version) <= 0 {
      continue
    }
    var dir = path_join(cache_dir(), path + "@" + version)
    var replaced = false
    for (rp, rd) in top.replaces {
      if rp == path {
        dir = path_join(root, rd)
        replaced = true
        break
      }
    }
    let mod_file = path_join(dir, "jig.mod")
    let missing = !fs.exists(mod_file)
    let r = Resolved {
      path: path
      version: version
      dir: dir
      replaced: replaced
      missing: missing
    }
    if at >= 0 {
      chosen[at] = r
    } else {
      chosen.push(r)
    }
    if missing {
      continue
    }
    match fs.read(mod_file) {
      Ok(t) => {
        let m = parse_mod(t)
        let named = match m.module {
          Some(x) => x == path
          None => false
        }
        if !named {
          errors.push(
            mod_file +
              " says `module " +
              m.module.unwrap_or("?") +
              "`, but it is required as `" +
              path +
              "`",
          )
        }
        pending.extend(m.reqs)
      }
      Err(e) => errors.push("cannot read " + mod_file + ": " + e)
    }
  }
  chosen.sort_by(fn(a, b) { a.path < b.path })
  return (chosen, errors)
}

/// The module an import path belongs to: the longest module path it starts with, and the
/// rest of the import path.
fn module_of(mods: List<Resolved>, import_path: Str) -> Option<(Int, Str)> {
  var best: Option<(Int, Str)> = None
  for i in 0..mods.len() {
    let mp = mods[i].path
    var rest: Option<Str> = None
    if import_path == mp {
      rest = Some("")
    } else if import_path.starts_with(mp + "/") {
      rest = Some(import_path[mp.len() + 1..import_path.len()])
    }
    match rest {
      Some(r) => {
        let better = match best {
          Some((b, _)) => mods[b].path.len() < mp.len()
          None => true
        }
        if better {
          best = Some((i, r))
        }
      }
      None => {}
    }
  }
  return best
}

struct Loader {
  std_dir: Str
  pkgs: List<Package>
  by_path: Map<Str, Int>
  /// Packages found but not parsed yet.
  queue: List<Int>
  /// Each package's imports in source order: (target, import path span).
  edges: List<List<(Int, syntax.Span)>>
  diags: List<syntax.Diag>
  project_root: Option<Str>
  next_base: Int
  /// Required modules (`jig.mod`), and the module each package belongs to (`None`: the
  /// project itself or the standard library).
  modules: List<Resolved>
  pkg_module: List<Option<Int>>
}

/// What loading produced: the packages, parsed, and the diagnostics.
struct Loaded {
  pkgs: List<Package>
  diags: List<syntax.Diag>
  root: Int
  project_root: Option<Str>
  /// The C libraries `jig.mod` links.
  links: List<Str>
}

fn diag(code: Str, span: syntax.Span, msg: Str) -> syntax.Diag
  ensures result.code == code && result.lo == span.lo && result.hi == span.hi && result.msg == msg
  ensures result.labels.is_empty() && result.notes.is_empty() && result.fixes.is_empty()
{
  return syntax.new_diag(code, span.lo, span.hi, msg)
}

fn dummy_span() -> syntax.Span
  ensures result.lo == 0 && result.hi == 0
{
  return syntax.Span { lo: 0, hi: 0 }
}

/// Load the package in `dir` (an absolute path) and everything it imports.
fn load_program(dir: Str, std_dir: Str) -> Loaded effects {fs, env} {
  let project_root = find_project_root(dir)
  var ld = Loader {
    std_dir: std_dir
    pkgs: []
    by_path: Map.new()
    queue: []
    edges: []
    diags: []
    project_root: project_root
    next_base: 1
    modules: []
    pkg_module: []
  }
  var links: List<Str> = []
  match project_root {
    Some(r) => match fs.read(join_path(r, "jig.mod")) {
      Ok(text) => {
        let m = parse_mod(text)
        links = m.links
        for (line, e) in m.errors {
          ld.diags.push(diag("E0211", dummy_span(), "jig.mod line " + line.str() + ": " + e))
        }
        if !m.reqs.is_empty() {
          let (mods, errors) = resolve_modules(r, m)
          for e in errors {
            ld.diags.push(diag("E0211", dummy_span(), e))
          }
          ld.modules = mods
        }
      }
      Err(_) => {}
    }
    None => {}
  }
  let prelude = ld.add_std("<prelude>", "prelude.jig")
  var root_path = "main"
  match project_root {
    Some(r) => {
      if dir.starts_with(r) && dir.len() > r.len() {
        var rel = dir[r.len()..dir.len()]
        if rel.starts_with("/") {
          rel = rel[1..rel.len()]
        }
        if !rel.is_empty() {
          root_path = rel
        }
      }
    }
    None => {}
  }
  let root = ld.add_dir_package(root_path, dir, None, None)
  for {
    let wave = ld.queue
    if wave.is_empty() {
      break
    }
    ld.queue = []
    for p in wave {
      ld.parse_package(p)
    }
    for p in wave {
      ld.resolve_imports(p)
    }
  }
  ld.report_cycles([prelude, root.unwrap_or(-1)])
  return Loaded {
    pkgs: ld.pkgs
    diags: ld.diags
    root: root.unwrap_or(prelude)
    project_root: project_root
    links: links
  }
}

fn Loader.new_package(&mut self, path: Str, is_std: Bool, module: Option<Int>) -> Int
  ensures result == old(self.pkgs.len()) && self.pkgs.len() == result + 1
  ensures self.edges.len() == old(self.edges.len()) + 1
  ensures self.pkg_module.len() == old(self.pkg_module.len()) + 1
{
  let id = self.pkgs.len()
  self.pkgs.push(
    Package {
      path: path
      files: []
      features: []
      is_std: is_std
      external: module.is_some()
      scope: Map.new()
      imports: []
    },
  )
  self.pkg_module.push(module)
  self.by_path.insert(path, id)
  self.edges.push([])
  return id
}

/// Register a file of package `p`; a `.jig` file is parsed with the next wave.
fn Loader.add_file(&mut self, p: Int, path: Str, text: Str) {
  let base = self.next_base
  self.next_base = base + text.len() + 1
  let empty = syntax.Ast { items: [], exprs: [], stmts: [], types: [], pats: [], top: [] }
  let f = SrcFile { path: path, base: base, text: text, ast: empty }
  if path.ends_with(".feature") {
    self.pkgs[p].features.push(f)
  } else {
    self.pkgs[p].files.push(f)
  }
}

/// A standard package (the prelude is `<prelude>`).
fn Loader.add_std(&mut self, path: Str, file: Str) -> Int effects {fs} {
  let p = self.new_package(path, true, None)
  let text = match read_std(self.std_dir, file) {
    Ok(t) => t
    Err(e) => {
      self.diags.push(diag("E0902", dummy_span(), "cannot read the standard library: " + e))
      ""
    }
  }
  self.add_file(p, "<std>/" + file, text)
  self.queue.push(p)
  return p
}

fn Loader.add_dir_package(
  &mut self,
  path: Str,
  dir: Str,
  import_span: Option<syntax.Span>,
  module: Option<Int>,
) -> Option<Int>
  effects {fs}
{
  let span = import_span.unwrap_or(dummy_span())
  let names = match fs.list(dir) {
    Ok(ns) => ns
    Err(_) => {
      self.diags.push(
        diag("E0203", span, "cannot find package `" + path + "` (no directory " + dir + ")"),
      )
      return None
    }
  }
  // Source files: not directories (such as a build's `.jig`).
  var sources: List<Str> = []
  var any_jig = false
  for n in names {
    let kind = source_kind(n)
    if !kind.is_empty() && !is_dir(join_path(dir, n)) {
      sources.push(n)
      any_jig = any_jig || kind == "jig"
    }
  }
  if !any_jig {
    self.diags.push(diag("E0203", span, "package `" + path + "` has no .jig files in " + dir))
    return None
  }
  let p = self.new_package(path, false, module)
  for n in sources {
    let f = join_path(dir, n)
    match fs.read(f) {
      Ok(text) => self.add_file(p, f, text)
      Err(_) => self.diags.push(diag("E0902", dummy_span(), "cannot read " + f))
    }
  }
  self.queue.push(p)
  return Some(p)
}

/// "jig" or "feature" for a source file's name, else "": its extension, as a path's (`.jig`
/// alone has none).
fn source_kind(name: Str) -> Str
  ensures result == "" || result == "jig" || result == "feature"
{
  if name.ends_with(".jig") && name.len() > 4 {
    return "jig"
  }
  if name.ends_with(".feature") && name.len() > 8 {
    return "feature"
  }
  return ""
}

fn Loader.parse_package(&mut self, p: Int) {
  for i in 0..self.pkgs[p].files.len() {
    let f = self.pkgs[p].files[i]
    let parsed = syntax.parse(f.text, f.base)
    self.pkgs[p].files[i].ast = parsed.ast
    for d in parsed.errors {
      self.diags.push(d)
    }
  }
}

fn Loader.resolve_imports(&mut self, p: Int) effects {fs} {
  var per_file: List<Map<Str, (Int, Int)>> = []
  for fi in 0..self.pkgs[p].files.len() {
    let ast = self.pkgs[p].files[fi].ast
    var m: Map<Str, (Int, Int)> = Map.new()
    for item_id in ast.top {
      let item = ast.items[item_id]
      match item.kind {
        Import(path, path_span) => {
          match self.import_pkg(path, path_span, self.pkg_module[p]) {
            Some(target) => {
              if target == p {
                self.diags.push(diag("E0204", path_span, "a package cannot import itself"))
              } else {
                self.edges[p].push((target, path_span))
                match m.get(item.name.text) {
                  Some((_, prev)) => self.diags.push(
                    diag("E0209", item.span, "`" + item.name.text + "` is imported twice").label(
                      ast.items[prev].span,
                      "first imported here",
                    ),
                  )
                  None => m.insert(item.name.text, (target, item_id))
                }
              }
            }
            None => {}
          }
        }
        _ => {}
      }
    }
    per_file.push(m)
  }
  self.pkgs[p].imports = per_file
}

/// Import cycles, found by walking imports depth first from `roots`.
fn Loader.report_cycles(&mut self, roots: List<Int>) {
  var done = [false].repeat(self.pkgs.len())
  for root in roots {
    if root < 0 || done[root] {
      continue
    }
    var stack: List<Int> = [root]
    var work: List<(Int, Int)> = [(root, 0)]
    for !work.is_empty() {
      let (p, next) = work[work.len() - 1]
      if next >= self.edges[p].len() {
        done[p] = true
        let _ = stack.pop()
        let _ = work.pop()
        continue
      }
      work[work.len() - 1] = (p, next + 1)
      let (target, span) = self.edges[p][next]
      if done[target] {
        continue
      }
      if stack.contains(target) {
        var chain: List<Str> = []
        var on = false
        for q in stack {
          if q == target {
            on = true
          }
          if on {
            chain.push(self.pkgs[q].path)
          }
        }
        chain.push(self.pkgs[target].path)
        self.diags.push(
          diag("E0204", span, "import cycle: " + chain.join(" -> ")).note(
            "move the shared code into a package that both can import",
          ),
        )
        continue
      }
      stack.push(target)
      work.push((target, 0))
    }
  }
}

/// The package an import names, loading it if needed. `from` is the module of the importing
/// package: its own packages are named relative to its root.
fn Loader.import_pkg(&mut self, path: Str, span: syntax.Span, from: Option<Int>) -> Option<Int>
  effects {fs}
{
  for (p, file) in std_packages() {
    if p == path {
      match self.by_path.get(p) {
        Some(id) => {
          return Some(id)
        }
        None => {
          return Some(self.add_std(p, file))
        }
      }
    }
  }
  if path.starts_with("std/") || path == "std" {
    self.diags.push(
      diag("E0203", span, "no standard library package `" + path + "`").note(
        "standard packages: " + std_package_paths().join(", "),
      ),
    )
    return None
  }
  for seg in path.split("/") {
    if seg.is_empty() || seg == "." || seg == ".." {
      self.diags.push(diag("E0203", span, "invalid import path `" + path + "`"))
      return None
    }
  }
  // A required module's package, a package of the importing module, or the project's.
  var full = path
  var dir = ""
  var module: Option<Int> = None
  match module_of(self.modules, path) {
    Some((mi, rest)) => {
      let m = self.modules[mi]
      if m.missing {
        self.diags.push(
          diag("E0211", span, "module `" + m.path + "` " + m.version + " is not downloaded").note(
            "run `jig get` to download the modules `jig.mod` requires",
          ),
        )
        return None
      }
      dir = path_join(m.dir, rest)
      module = Some(mi)
    }
    None => match from {
      Some(mi) => {
        let m = self.modules[mi]
        full = m.path + "/" + path
        dir = path_join(m.dir, path)
        module = Some(mi)
      }
      None => {
        let root = match self.project_root {
          Some(r) => r
          None => {
            let msg = "cannot import `" + path + "`: no project root (a directory with `jig.mod`)"
            self.diags.push(
              diag("E0210", span, msg).note(
                "create `jig.mod` containing `module <name>` in the project's top directory",
              ),
            )
            return None
          }
        }
        dir = join_path(root, path)
      }
    }
  }
  match self.by_path.get(full) {
    Some(id) => {
      return Some(id)
    }
    None => {}
  }
  return self.add_dir_package(full, dir, Some(span), module)
}

// The formatter's expressions, statements, blocks, types and patterns, ported from the
// bootstrap compiler's `fmt/expr.rs`.

/// An element of a parenthesized or bracketed list.
enum Elem {
  Expr(id: Int)
  Param(p: Param)
  SelfParam(sp: SelfParam)
}

/// One postfix operation of a chain `root.a(x).b[i]?`.
enum Op {
  Field(name: Name)
  TupleField(index: Int)
  /// The call expression and its arguments.
  Call(call: Int, args: List<Int>)
  Index(index: Int)
  Try
  TypeArgs(args: List<Int>)
}

fn is_call(op: Op) -> Bool {
  return match op {
    Call(_, _) => true
    _ => false
  }
}

/// Indices of the ops that start a method segment: a `.name` followed by a call.
fn segment_starts(ops: List<Op>) -> List<Int>
  ensures result.len() <= ops.len()
{
  var v: List<Int> = []
  for i in 0..ops.len() invariant v.len() <= i {
    match ops[i] {
      Field(_) => {
        var j = i + 1
        if j < ops.len() {
          match ops[j] {
            TypeArgs(_) => j += 1
            _ => {}
          }
        }
        if j < ops.len() && is_call(ops[j]) {
          v.push(i)
        }
      }
      _ => {}
    }
  }
  return v
}

// ---------- flat layouts ----------

/// The single-line layout of `e`, or None if it has none (a multi-statement block, a
/// comment to place) or it is far too long to fit anyway.
fn Printer.flat(self, e: Int) -> Option<Str> {
  var o = ""
  return if self.flat_into(e, &mut o) { Some(o) } else { None }
}

fn Printer.flat_into(self, e: Int, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  if o.len() > FLAT_LIMIT {
    return false
  }
  let ex = self.ast.exprs[e]
  match ex.kind {
    // Numbers print as written: `0xff`, `1_000`, `1e-9`.
    Int(_) | Float => o += self.span_text(ex.span)
    Bool(b) => o += if b { "true" } else { "false" }
    Str(s) => push_str_lit(&mut o, s)
    Char(c) => push_char_lit(&mut o, c)
    Name(n) => o += n
    Paren(x) => {
      o += "("
      if !self.flat_into(x, &mut o) {
        return false
      }
      o += ")"
    }
    Tuple(xs) => {
      if self.has(Key.Expr(e)) {
        return false
      }
      o += "("
      if !self.flat_list_into(xs, &mut o) {
        return false
      }
      if xs.len() == 1 {
        o += ","
      }
      o += ")"
    }
    List(xs) => {
      if self.has(Key.Expr(e)) {
        return false
      }
      o += "["
      if !self.flat_list_into(xs, &mut o) {
        return false
      }
      o += "]"
    }
    Field(base, name) => {
      if !self.flat_into(base, &mut o) {
        return false
      }
      o += "." + name.text
    }
    TupleField(base, index, _) => {
      if !self.flat_into(base, &mut o) {
        return false
      }
      o += "." + index.str()
    }
    Call(callee, args) => {
      if self.has(Key.Expr(e)) || !self.flat_into(callee, &mut o) {
        return false
      }
      o += "("
      if !self.flat_list_into(args, &mut o) {
        return false
      }
      o += ")"
    }
    MutArg(x) => {
      o += "&mut "
      return self.flat_into(x, &mut o)
    }
    Index(base, index) => {
      if !self.flat_into(base, &mut o) {
        return false
      }
      o += "["
      if !self.flat_into(index, &mut o) {
        return false
      }
      o += "]"
    }
    Range(lo, hi) => {
      match lo {
        Some(l) => if !self.flat_into(l, &mut o) {
          return false
        }
        None => {}
      }
      o += ".."
      match hi {
        Some(h) => {
          return self.flat_into(h, &mut o)
        }
        None => {}
      }
    }
    Unary(op, x) => {
      o += op.text()
      return self.flat_into(x, &mut o)
    }
    Binary(_, _, _) => {
      return self.flat_binary_into(e, &mut o)
    }
    Cast(x, ty) => {
      if !self.flat_into(x, &mut o) {
        return false
      }
      o += " as "
      self.ty_into(ty, &mut o)
    }
    Try(x) => {
      if !self.flat_into(x, &mut o) {
        return false
      }
      o += "?"
    }
    If(cond, then, els) => {
      o += "if "
      if !self.flat_into(cond, &mut o) {
        return false
      }
      o += " "
      if !self.flat_block_into(then, &mut o) {
        return false
      }
      match els {
        Some(x) => {
          o += " else "
          return match self.ast.exprs[x].kind {
            If(_, _, _) => self.flat_into(x, &mut o)
            _ => self.flat_block_into(x, &mut o)
          }
        }
        None => {}
      }
    }
    Match(scrut, arms) => {
      // Arms always print one per line.
      if !arms.is_empty() || self.has(Key.Expr(e)) {
        return false
      }
      o += "match "
      if !self.flat_into(scrut, &mut o) {
        return false
      }
      o += " {}"
    }
    Block(_) => {
      // A block of statements is multi-line; inline `{ e }` is for if/else, arm and closure
      // bodies only.
      if !self.is_empty_block(e) {
        return false
      }
      o += "{}"
    }
    StructLit(ty, fields) => {
      if self.has(Key.Expr(e)) {
        return false
      }
      self.ty_into(ty, &mut o)
      if fields.is_empty() {
        o += " {}"
        return true
      }
      o += " { "
      for i in 0..fields.len() {
        if i > 0 {
          o += ", "
        }
        o += fields[i].name.text + ": "
        if !self.flat_into(fields[i].value, &mut o) {
          return false
        }
      }
      o += " }"
    }
    Closure(params, ret, body) => {
      if self.has(Key.Expr(e)) {
        return false
      }
      o += "fn("
      if !self.flat_params_into(params, &mut o) {
        return false
      }
      o += ")"
      match ret {
        Some(r) => {
          o += " -> "
          self.ty_into(r, &mut o)
        }
        None => {}
      }
      o += " "
      return self.flat_block_into(body, &mut o)
    }
    TypeArgs(base, args) => {
      if !self.flat_into(base, &mut o) {
        return false
      }
      self.type_args_into(args, &mut o)
    }
    Quant(is_forall, binder, lo, hi, body) => {
      o += if is_forall { "forall " } else { "exists " }
      o += binder.text + " in "
      if !self.flat_into(lo, &mut o) {
        return false
      }
      o += ".."
      if !self.flat_into(hi, &mut o) {
        return false
      }
      o += ": "
      return self.flat_into(body, &mut o)
    }
  }
  return true
}

/// A binary expression, iterating down its left spine.
fn Printer.flat_binary_into(self, e: Int, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  var spine: List<(BinOp, Int)> = []
  var cur = e
  for {
    match self.ast.exprs[cur].kind {
      Binary(op, lhs, rhs) => {
        spine.push((op, rhs))
        cur = lhs
      }
      _ => {
        break
      }
    }
  }
  if !self.flat_into(cur, &mut o) {
    return false
  }
  var i = spine.len()
  for i > 0 {
    i -= 1
    let (op, rhs) = spine[i]
    o += " " + op.text() + " "
    if !self.flat_into(rhs, &mut o) {
      return false
    }
  }
  return true
}

fn Printer.flat_list_into(self, xs: List<Int>, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  for i in 0..xs.len() invariant o.len() >= start {
    if i > 0 {
      o += ", "
    }
    if !self.flat_into(xs[i], &mut o) {
      return false
    }
  }
  return true
}

/// The conditions of a clause, comma-separated on one line.
fn Printer.flat_joined(self, xs: List<Int>) -> Option<Str> {
  var o = ""
  return if self.flat_list_into(xs, &mut o) { Some(o) } else { None }
}

fn Printer.flat_params_into(self, params: List<Param>, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  for i in 0..params.len() invariant o.len() >= start {
    if i > 0 {
      o += ", "
    }
    if !self.elem_flat_into(Elem.Param(params[i]), &mut o) {
      return false
    }
  }
  return true
}

/// For a block that may print inline: 0 if it is empty, 1 if it holds just an expression
/// statement; -1 if it must print one statement per line (or is not a block).
fn Printer.inline_kind(self, b: Int) -> Int {
  let stmts = match self.ast.exprs[b].kind {
    Block(ss) => ss
    _ => {
      return -1
    }
  }
  if self.has(Key.Expr(b)) {
    return -1
  }
  if stmts.is_empty() {
    return 0
  }
  if stmts.len() == 1 {
    match self.ast.stmts[stmts[0]].kind {
      Expr(_) => {
        return 1
      }
      _ => {}
    }
  }
  return -1
}

fn Printer.is_empty_block(self, b: Int) -> Bool {
  return self.inline_kind(b) == 0
}

/// The expression of a block that holds just one.
fn Printer.only_expr(self, b: Int) -> Int {
  return match self.ast.exprs[b].kind {
    Block(stmts) => match self.ast.stmts[stmts[0]].kind {
      Expr(x) => x
      _ => b
    }
    _ => b
  }
}

/// `{}` or `{ e }`.
fn Printer.flat_block_into(self, b: Int, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  let k = self.inline_kind(b)
  if k == 0 {
    o += "{}"
    return true
  }
  if k < 0 {
    return false
  }
  o += "{ "
  if !self.flat_into(self.only_expr(b), &mut o) {
    return false
  }
  o += " }"
  return true
}

// ---------- broken layouts ----------

/// The layout of `e`: flat if it fits, broken otherwise.
fn Printer.render(self, e: Int, ind: Int, col: Int, trail: Int) -> Str {
  match self.flat(e) {
    Some(f) => if col + width(f) + trail <= WIDTH {
      return f
    }
    None => {}
  }
  return self.broken(e, ind, col, trail)
}

fn Printer.expr_elems(self, xs: List<Int>) -> List<Elem>
  ensures result.len() == xs.len()
{
  var out: List<Elem> = []
  for x in xs {
    out.push(Elem.Expr(x))
  }
  return out
}

fn Printer.broken(self, e: Int, ind: Int, col: Int, trail: Int) -> Str {
  match self.ast.exprs[e].kind {
    Paren(x) => {
      return "(" + self.render(x, ind, col + 1, trail + 1) + ")"
    }
    Tuple(xs) => {
      return self.delimited("(", ")", Key.Expr(e), self.expr_elems(xs), ind, col, trail, true)
    }
    List(xs) => {
      return self.delimited("[", "]", Key.Expr(e), self.expr_elems(xs), ind, col, trail, false)
    }
    Field(_, _) | TupleField(_, _, _) | Call(_, _) | Index(_, _) | Try(_) | TypeArgs(_, _) => {
      return self.postfix(e, ind, col, trail)
    }
    MutArg(x) => {
      return "&mut " + self.render(x, ind, col + 5, trail)
    }
    Range(lo, hi) => {
      var s = ""
      match lo {
        Some(l) => s += self.render(l, ind, col, 2)
        None => {}
      }
      s += ".."
      match hi {
        Some(h) => {
          let c = end_col(col, s)
          s += self.render(h, ind, c, trail)
        }
        None => {}
      }
      return s
    }
    Unary(op, x) => {
      return op.text() + self.render(x, ind, col + op.text().len(), trail)
    }
    Binary(_, _, _) => {
      return self.binary(e, ind, col, trail)
    }
    Cast(x, ty) => {
      let t = " as " + self.ty(ty)
      return self.render(x, ind, col, trail + width(t)) + t
    }
    If(_, _, _) => {
      return self.if_broken(e, ind, col)
    }
    Match(_, _) => {
      return self.match_expr(e, ind, col)
    }
    Block(_) => {
      return self.block(e, ind)
    }
    StructLit(ty, fields) => {
      let s = self.ty(ty) + " "
      var elems: List<LineElem> = []
      for fi in fields {
        var text = fi.name.text + ": "
        let c = ind + 2 + width(text)
        text += self.render(fi.value, ind + 2, c, 0)
        elems.push(
          LineElem { lo: fi.name.span.lo, hi: self.ast.exprs[fi.value].span.hi, text: text },
        )
      }
      return s + self.braced(Key.Expr(e), elems, ind)
    }
    Closure(params, ret, body) => {
      let r = match ret {
        Some(t) => " -> " + self.ty(t)
        None => ""
      }
      var elems: List<Elem> = []
      for p in params {
        elems.push(Elem.Param(p))
      }
      var s = "fn"
      s += self.delimited("(", ")", Key.Expr(e), elems, ind, col + 2, width(r) + 2, false)
      s += r + " "
      return s + self.block(body, ind)
    }
    Quant(is_forall, binder, lo, hi, body) => {
      var s = (if is_forall { "forall" } else { "exists" }) + " " + binder.text + " in "
      s += self.render(lo, ind, col + width(s), 2)
      s += ".."
      s += self.render(hi, ind, end_col(col, s), 1)
      s += ": "
      s += self.render(body, ind, end_col(col, s), trail)
      return s
    }
    _ => {
      var o = ""
      let _ = self.flat_into(e, &mut o)
      return o
    }
  }
}

/// A chain of binary operators of one precedence, broken after each operator: the operator
/// ends its line so the line break cannot end the statement.
fn Printer.binary(self, e: Int, ind: Int, col: Int, trail: Int) -> Str {
  let prec = match self.ast.exprs[e].kind {
    Binary(op, _, _) => op.precedence()
    _ => 0
  }
  var ops: List<BinOp> = []
  var operands: List<Int> = []
  var cur = e
  for {
    match self.ast.exprs[cur].kind {
      Binary(op, lhs, rhs) => {
        if op.precedence() != prec {
          break
        }
        ops.push(op)
        operands.push(rhs)
        cur = lhs
      }
      _ => {
        break
      }
    }
  }
  operands.push(cur)
  operands.reverse()
  ops.reverse()
  var s = ""
  for i in 0..operands.len() {
    let t = if i < ops.len() { 1 + ops[i].text().len() } else { trail }
    if i == 0 {
      s += self.render(operands[i], ind, col, t)
    } else {
      newline(&mut s, ind + 2)
      s += self.render(operands[i], ind + 2, ind + 2, t)
    }
    if i < ops.len() {
      s += " " + ops[i].text()
    }
  }
  return s
}

// ---------- lists ----------

/// `open elems close` on one line if it fits and holds no comments; otherwise one element per
/// line with trailing commas. `tuple`: a single element keeps its comma.
fn Printer.delimited(
  self,
  open: Str,
  close: Str,
  key: Key,
  elems: List<Elem>,
  ind: Int,
  col: Int,
  trail: Int,
  tuple: Bool,
) -> Str {
  if !self.has(key) {
    var f = open
    var ok = true
    for i in 0..elems.len() {
      if i > 0 {
        f += ", "
      }
      if !self.elem_flat_into(elems[i], &mut f) {
        ok = false
        break
      }
    }
    if ok {
      if tuple && elems.len() == 1 {
        f += ","
      }
      f += close
      if col + width(f) + trail <= WIDTH {
        return f
      }
    }
  }
  return self.delimited_broken(open, close, key, elems, ind)
}

fn Printer.delimited_broken(
  self,
  open: Str,
  close: Str,
  key: Key,
  elems: List<Elem>,
  ind: Int,
) -> Str {
  var lines: List<LineElem> = []
  for el in elems {
    let (lo, hi) = self.elem_span(el)
    lines.push(LineElem { lo: lo, hi: hi, text: self.elem_render(el, ind + 2, ind + 2, 1) + "," })
  }
  return self.wrapped(open, close, key, lines, ind, Blanks.Never)
}

fn Printer.elem_span(self, el: Elem) -> (Int, Int) {
  return match el {
    Expr(x) => span_pair(self.ast.exprs[x].span)
    Param(p) => span_pair(p.span)
    SelfParam(sp) => span_pair(sp.span)
  }
}

fn Printer.elem_flat_into(self, el: Elem, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  match el {
    Expr(x) => {
      return self.flat_into(x, &mut o)
    }
    SelfParam(sp) => {
      o += if sp.mutable { "&mut self" } else { "self" }
      return true
    }
    Param(p) => {
      self.param_head_into(p, &mut o)
      match p.refine {
        Some(r) => {
          o += " where "
          return self.flat_into(r, &mut o)
        }
        None => {
          return true
        }
      }
    }
  }
}

fn Printer.elem_render(self, el: Elem, ind: Int, col: Int, trail: Int) -> Str {
  match el {
    Expr(x) => {
      return self.render(x, ind, col, trail)
    }
    SelfParam(sp) => {
      return if sp.mutable { "&mut self" } else { "self" }
    }
    Param(p) => {
      var o = ""
      self.param_head_into(p, &mut o)
      match p.refine {
        Some(r) => {
          o += " where "
          let c = col + width(o)
          o += self.render(r, ind, c, trail)
        }
        None => {}
      }
      return o
    }
  }
}

/// `name`, `name: T` or `name: &mut T`.
fn Printer.param_head_into(self, p: Param, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  o += p.name.text
  match p.ty {
    Some(t) => {
      o += ": "
      if p.mut_ref {
        o += "&mut "
      }
      self.ty_into(t, &mut o)
    }
    None => {}
  }
}

// ---------- calls and chains ----------

/// Split a postfix chain into its root and operations, innermost first.
fn Printer.chain(self, e: Int) -> (Int, List<Op>) {
  var ops: List<Op> = []
  var cur = e
  for {
    match self.ast.exprs[cur].kind {
      Field(base, name) => {
        ops.push(Op.Field(name))
        cur = base
      }
      TupleField(base, index, _) => {
        ops.push(Op.TupleField(index))
        cur = base
      }
      Call(callee, args) => {
        ops.push(Op.Call(cur, args))
        cur = callee
      }
      Index(base, index) => {
        ops.push(Op.Index(index))
        cur = base
      }
      Try(x) => {
        ops.push(Op.Try)
        cur = x
      }
      TypeArgs(base, args) => {
        ops.push(Op.TypeArgs(args))
        cur = base
      }
      _ => {
        break
      }
    }
  }
  ops.reverse()
  return (cur, ops)
}

/// A postfix chain that does not fit flat. With two or more method calls it breaks before each
/// `.name(...)` (a line starting with `.` continues the previous one); otherwise only call
/// arguments and indexes break.
fn Printer.postfix(self, e: Int, ind: Int, col: Int, trail: Int) -> Str {
  let (root, ops) = self.chain(e)
  let starts = segment_starts(ops)
  if starts.len() >= 2 {
    match self.chain_hug(root, ops, ind, col) {
      Some(s) => {
        return s
      }
      None => {}
    }
    let head = ops[0..starts[0]]
    var s = self.render(root, ind, col, self.ops_trail(head, 0))
    let c = end_col(col, s)
    s += self.ops_inline(head, ind, c, 0)
    for n in 0..starts.len() {
      let end = if n + 1 < starts.len() { starts[n + 1] } else { ops.len() }
      let t = if end == ops.len() { trail } else { 0 }
      newline(&mut s, ind + 2)
      s += self.ops_inline(ops[starts[n]..end], ind + 2, ind + 2, t)
    }
    return s
  }
  var s = self.render(root, ind, col, self.ops_trail(ops, trail))
  let c = end_col(col, s)
  s += self.ops_inline(ops, ind, c, trail)
  return s
}

/// The width that follows on the same line after a chain's root, up to the next point where it
/// may break.
fn Printer.ops_trail(self, ops: List<Op>, trail: Int) -> Int {
  var w = 0
  for op in ops {
    match op {
      Field(n) => w += 1 + width(n.text)
      TupleField(i) => w += 1 + i.str().len()
      Try => w += 1
      TypeArgs(ts) => {
        var o = ""
        self.type_args_into(ts, &mut o)
        w += width(o)
      }
      Index(_) | Call(_, _) => {
        return w + 1
      }
    }
  }
  return w + trail
}

/// Print `ops` on the current line; only call arguments and indexes may break.
fn Printer.ops_inline(self, ops: List<Op>, ind: Int, col: Int, trail: Int) -> Str {
  var s = ""
  var c = col
  for i in 0..ops.len() {
    let rest = self.ops_trail(ops[i + 1..ops.len()], trail)
    let part = match ops[i] {
      Field(n) => "." + n.text
      TupleField(k) => "." + k.str()
      Try => "?"
      TypeArgs(ts) => {
        var o = ""
        self.type_args_into(ts, &mut o)
        o
      }
      Index(x) => "[" + self.render(x, ind, c + 1, rest + 1) + "]"
      Call(call, args) => self.call_args(call, args, ind, c, rest)
    }
    c = end_col(c, part)
    s += part
  }
  return s
}

fn Printer.op_flat_into(self, op: Op, o: &mut Str) -> Bool
  ensures o.len() >= old(o.len())
{
  match op {
    Field(n) => o += "." + n.text
    TupleField(k) => o += "." + k.str()
    Try => o += "?"
    TypeArgs(ts) => self.type_args_into(ts, &mut o)
    Index(x) => {
      o += "["
      if !self.flat_into(x, &mut o) {
        return false
      }
      o += "]"
    }
    Call(call, args) => {
      if self.has(Key.Expr(call)) {
        return false
      }
      o += "("
      if !self.flat_list_into(args, &mut o) {
        return false
      }
      o += ")"
    }
  }
  return true
}

/// A whole chain on one line except for a multi-line closure that ends the last call:
/// `xs.iter().map(fn(x) {` ... `})`.
fn Printer.chain_hug(self, root: Int, ops: List<Op>, ind: Int, col: Int) -> Option<Str> {
  var k = -1
  for i in 0..ops.len() {
    if is_call(ops[i]) {
      k = i
    }
  }
  if k < 0 {
    return None
  }
  for i in k + 1..ops.len() {
    match ops[i] {
      Index(_) => {
        return None
      }
      _ => {}
    }
  }
  var s = match self.flat(root) {
    Some(f) => f
    None => {
      return None
    }
  }
  for i in 0..k {
    if !self.op_flat_into(ops[i], &mut s) {
      return None
    }
  }
  let (call, args) = match ops[k] {
    Call(c, a) => (c, a)
    _ => {
      return None
    }
  }
  let c = col + width(s)
  match self.hug(call, args, ind, c, true) {
    Some(h) => s += h
    None => {
      return None
    }
  }
  for i in k + 1..ops.len() {
    let _ = self.op_flat_into(ops[i], &mut s)
  }
  return Some(s)
}

/// The parenthesized arguments of `call`: flat, else hugging a final closure, else one per
/// line.
fn Printer.call_args(self, call: Int, args: List<Int>, ind: Int, col: Int, trail: Int) -> Str {
  let key = Key.Expr(call)
  if !self.has(key) {
    var f = "("
    if self.flat_list_into(args, &mut f) {
      f += ")"
      if col + width(f) + trail <= WIDTH {
        return f
      }
    }
    match self.hug(call, args, ind, col, false) {
      Some(h) => {
        return h
      }
      None => {}
    }
  }
  return self.delimited_broken("(", ")", key, self.expr_elems(args), ind)
}

/// `(a, b, fn(x) {` ... `})`: the other arguments flat on the call's line, the final closure's
/// body on the following lines. With `multiline_only`, only for a closure whose body cannot be
/// inline anyway.
fn Printer.hug(
  self,
  call: Int,
  args: List<Int>,
  ind: Int,
  col: Int,
  multiline_only: Bool,
) -> Option<Str> {
  if args.is_empty() {
    return None
  }
  let last = args[args.len() - 1]
  let (params, ret, body) = match self.ast.exprs[last].kind {
    Closure(ps, r, b) => (ps, r, b)
    _ => {
      return None
    }
  }
  if self.has(Key.Expr(call)) || self.has(Key.Expr(last)) {
    return None
  }
  let k = self.inline_kind(body)
  if k == 0 || (k == 1 && multiline_only) {
    return None
  }
  var s = "("
  for i in 0..args.len() - 1 {
    if !self.flat_into(args[i], &mut s) {
      return None
    }
    s += ", "
  }
  s += "fn("
  if !self.flat_params_into(params, &mut s) {
    return None
  }
  s += ")"
  match ret {
    Some(r) => {
      s += " -> "
      self.ty_into(r, &mut s)
    }
    None => {}
  }
  s += " "
  if col + width(s) + 1 > WIDTH {
    return None
  }
  s += self.block(body, ind)
  s += ")"
  return Some(s)
}

// ---------- blocks and control flow ----------

/// A block: `{}` when empty, else one statement per line at `ind + 2` and `}` at `ind`.
fn Printer.block(self, b: Int, ind: Int) -> Str {
  let stmts = match self.ast.exprs[b].kind {
    Block(ss) => ss
    _ => {
      return self.render(b, ind, ind, 0)
    }
  }
  var elems: List<LineElem> = []
  for s in stmts {
    let sp = self.ast.stmts[s].span
    elems.push(LineElem { lo: sp.lo, hi: sp.hi, text: self.stmt(s, ind + 2) })
  }
  return self.braced(Key.Expr(b), elems, ind)
}

/// An `if` with every branch on its own lines.
fn Printer.if_broken(self, e: Int, ind: Int, col: Int) -> Str {
  let (cond, then, els) = match self.ast.exprs[e].kind {
    If(c, t, x) => (c, t, x)
    _ => {
      return ""
    }
  }
  var s = "if " + self.render(cond, ind, col + 3, 2) + " " + self.block(then, ind)
  match els {
    Some(x) => {
      s += " else "
      let c = end_col(col, s)
      s += match self.ast.exprs[x].kind {
        If(_, _, _) => self.if_broken(x, ind, c)
        _ => self.block(x, ind)
      }
    }
    None => {}
  }
  return s
}

fn Printer.match_expr(self, e: Int, ind: Int, col: Int) -> Str {
  let (scrut, arms) = match self.ast.exprs[e].kind {
    Match(s, a) => (s, a)
    _ => {
      return ""
    }
  }
  let s = "match " + self.render(scrut, ind, col + 6, 2) + " "
  var elems: List<LineElem> = []
  for a in arms {
    elems.push(LineElem { lo: a.span.lo, hi: a.span.hi, text: self.arm(a, ind + 2) })
  }
  return s + self.braced(Key.Expr(e), elems, ind)
}

/// `pat if guard => body`.
fn Printer.arm(self, a: Arm, ind: Int) -> Str {
  var s = self.pat(a.pat)
  match a.guard {
    Some(g) => {
      s += " if "
      let c = ind + width(s)
      s += self.render(g, ind, c, 3)
    }
    None => {}
  }
  s += " => "
  let c = end_col(ind, s)
  let body = self.ast.exprs[a.body]
  match body.kind {
    Block(ids) => {
      // `Open => open += 1`: a brace-less assignment arm stays one statement.
      if ids.len() == 1 &&
        self.ast.stmts[ids[0]].span.lo == body.span.lo &&
        !self.has(Key.Expr(a.body)) {
        match self.ast.stmts[ids[0]].kind {
          Assign(_, _, _) => {
            return s + self.stmt(ids[0], ind)
          }
          _ => {}
        }
      }
      var f = ""
      if self.flat_block_into(a.body, &mut f) && c + width(f) <= WIDTH {
        s += f
      } else {
        s += self.block(a.body, ind)
      }
    }
    _ => s += self.render(a.body, ind, c, 0)
  }
  return s
}

/// `head kw a, b {body}`, for the single clause of a `for` (`invariant`) or a `test`
/// (`requires`): on one line if it fits, else the clause on its own line and `{` on the next,
/// else one condition per line.
fn Printer.with_clause(
  self,
  head: Str,
  col: Int,
  kw: Str,
  conds: List<Int>,
  body: Int,
  ind: Int,
) -> Str {
  var s = head
  let blk = self.block(body, ind)
  if conds.is_empty() {
    return s + " " + blk
  }
  let end = end_col(col, s)
  match self.flat_joined(conds) {
    Some(j) => {
      if end + kw.len() + width(j) + 4 <= WIDTH {
        return s + " " + kw + " " + j + " " + blk
      }
      if ind + 2 + kw.len() + 1 + width(j) <= WIDTH {
        newline(&mut s, ind + 2)
        s += kw + " " + j
        newline(&mut s, ind)
        return s + blk
      }
    }
    None => {}
  }
  newline(&mut s, ind + 2)
  s += kw + " "
  for i in 0..conds.len() {
    let t = if i + 1 < conds.len() { 1 } else { 0 }
    if i == 0 {
      s += self.render(conds[i], ind + 2, ind + 3 + kw.len(), t)
    } else {
      s += ","
      newline(&mut s, ind + 4)
      s += self.render(conds[i], ind + 4, ind + 4, t)
    }
  }
  newline(&mut s, ind)
  return s + blk
}

// ---------- statements ----------

/// A statement whose first line starts at column `ind`.
fn Printer.stmt(self, id: Int, ind: Int) -> Str {
  match self.ast.stmts[id].kind {
    Let(pat, ty, init, mutable) => {
      var s = if mutable { "var " } else { "let " }
      self.pat_into(pat, &mut s)
      match ty {
        Some(t) => {
          s += ": "
          self.ty_into(t, &mut s)
        }
        None => {}
      }
      s += " = "
      let c = ind + width(s)
      return s + self.render(init, ind, c, 0)
    }
    Assign(target, op, value) => {
      var s = self.render(target, ind, ind, 0) + " "
      match op {
        Some(o) => s += o.text()
        None => {}
      }
      s += "= "
      let c = end_col(ind, s)
      return s + self.render(value, ind, c, 0)
    }
    Expr(e) => {
      return match self.ast.exprs[e].kind {
        // A statement `if` always spans lines; inline `if` is for values.
        If(_, _, _) => self.if_broken(e, ind, ind)
        _ => self.render(e, ind, ind, 0)
      }
    }
    Return(v) => {
      return match v {
        Some(e) => "return " + self.render(e, ind, ind + 7, 0)
        None => "return"
      }
    }
    Break => {
      return "break"
    }
    Continue => {
      return "continue"
    }
    For(head, invariants, body) => {
      let t = if invariants.is_empty() { 2 } else { 0 }
      var s = "for"
      match head {
        Forever => {}
        While(c) => s += " " + self.render(c, ind, ind + 4, t)
        In(pat, iter) => {
          s += " "
          self.pat_into(pat, &mut s)
          s += " in "
          let c = ind + width(s)
          s += self.render(iter, ind, c, t)
        }
      }
      return self.with_clause(s, ind, "invariant", invariants, body, ind)
    }
  }
}

// ---------- types ----------

fn Printer.ty(self, t: Int) -> Str {
  var o = ""
  self.ty_into(t, &mut o)
  return o
}

fn Printer.ty_into(self, t: Int, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  match self.ast.types[t].kind {
    Named(pkg, name, args, units) => {
      match pkg {
        Some(p) => o += p.text + "."
        None => {}
      }
      o += name.text
      match units {
        Some(u) => {
          o += "<"
          self.unit_into(u, &mut o)
          o += ">"
        }
        None => self.type_args_into(args, &mut o)
      }
    }
    Tuple(ts) => {
      o += "("
      self.types_into(ts, &mut o)
      if ts.len() == 1 {
        o += ","
      }
      o += ")"
    }
    Fn(params, ret, effect_names) => {
      o += "fn("
      self.types_into(params, &mut o)
      o += ")"
      match ret {
        Some(r) => {
          o += " -> "
          self.ty_into(r, &mut o)
        }
        None => {}
      }
      match effect_names {
        Some(es) => {
          o += " "
          self.effects_into(es, &mut o)
        }
        None => {}
      }
    }
    Refined(base, pred) => {
      self.ty_into(base, &mut o)
      o += " where "
      o += match self.flat(pred) {
        Some(f) => f
        None => self.render(pred, 0, 0, 0)
      }
    }
  }
}

fn Printer.types_into(self, ts: List<Int>, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  for i in 0..ts.len() invariant o.len() >= start {
    if i > 0 {
      o += ", "
    }
    self.ty_into(ts[i], &mut o)
  }
}

/// `<A, B>`, or nothing for no arguments.
fn Printer.type_args_into(self, args: List<Int>, o: &mut Str)
  ensures args.is_empty() || !o.is_empty(), o.len() >= old(o.len())
{
  if !args.is_empty() {
    o += "<"
    self.types_into(args, &mut o)
    o += ">"
  }
}

/// A unit expression: `m`, `m/s^2`, `kg*m`, `1/s`.
fn Printer.unit_into(self, factors: List<UnitFactor>, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  if factors.is_empty() {
    o += "1"
  }
  for i in 0..factors.len() invariant o.len() >= start {
    let f = factors[i]
    if i == 0 && f.exp < 0 {
      o += "1/"
    } else if i > 0 {
      o += if f.exp < 0 { "/" } else { "*" }
    }
    o += f.name.text
    let m = if f.exp < 0 { 0 - f.exp } else { f.exp }
    if m != 1 {
      o += "^" + m.str()
    }
  }
}

/// `effects {io, fs}`.
fn Printer.effects_into(self, es: List<Name>, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  o += "effects {"
  for i in 0..es.len() invariant o.len() >= start {
    if i > 0 {
      o += ", "
    }
    o += es[i].text
  }
  o += "}"
}

/// `<T: Ord + Hash, U>`, or nothing.
fn Printer.generics_into(self, gs: List<GenericParam>, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  if gs.is_empty() {
    return
  }
  o += "<"
  for i in 0..gs.len() invariant o.len() >= start {
    if i > 0 {
      o += ", "
    }
    o += gs[i].name.text
    for j in 0..gs[i].bounds.len() invariant o.len() >= start {
      o += if j == 0 { ": " } else { " + " }
      self.ty_into(gs[i].bounds[j], &mut o)
    }
  }
  o += ">"
}

// ---------- patterns ----------

fn Printer.pat(self, p: Int) -> Str {
  var o = ""
  self.pat_into(p, &mut o)
  return o
}

fn Printer.pat_into(self, p: Int, o: &mut Str)
  requires p >= 0 && p < self.ast.pats.len()
  ensures o.len() >= old(o.len())
{
  match self.ast.pats[p].kind {
    Wild => o += "_"
    Bind(s) => o += s
    Lit(e) => {
      let _ = self.flat_into(e, &mut o)
    }
    Variant(name, args, has_parens) => {
      o += name.text
      if has_parens {
        o += "("
        self.pats_into(args, ", ", &mut o)
        o += ")"
      }
    }
    Tuple(ps) => {
      o += "("
      self.pats_into(ps, ", ", &mut o)
      if ps.len() == 1 {
        o += ","
      }
      o += ")"
    }
    Or(alts) => self.pats_into(alts, " | ", &mut o)
  }
}

fn Printer.pats_into(self, ps: List<Int>, sep: Str, o: &mut Str)
  ensures o.len() >= old(o.len())
{
  let start = o.len()
  for i in 0..ps.len() invariant o.len() >= start {
    if i > 0 {
      o += sep
    }
    self.pat_into(ps[i], &mut o)
  }
}

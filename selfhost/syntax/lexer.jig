// The lexer, ported from the bootstrap compiler's `syntax/lexer.rs`, with Go-style statement
// termination: a line break ends a statement when the last token on the line can end one,
// except inside `(...)` and `[...]`, and except when the next line continues the expression
// with a leading `.`, `&&` or `||`.

/// A comment's span; `doc` for `///`, `trailing` if code precedes it on its line.
struct Comment {
  lo: Int
  hi: Int
  doc: Bool
  trailing: Bool
}

/// An error: its diagnostic code, span and message.
pub struct Diag {
  pub code: Str
  pub lo: Int
  pub hi: Int
  pub msg: Str
}

struct Lexed {
  tokens: List<Token>
  comments: List<Comment>
  /// Offsets of line starts that follow a blank line.
  blank_lines: List<Int>
  errors: List<Diag>
}

struct Lexer {
  s: Str
  n: Int
  i: Int
  base: Int
  tokens: List<Token>
  comments: List<Comment>
  blank_lines: List<Int>
  errors: List<Diag>
  /// Open delimiters: `(`, `[` or `{`.
  stack: List<Char>
  line_has_code: Bool
  invariant n == s.len()
  invariant i >= 0 && i <= n
  invariant base >= 0 && base <= MAX_OFFSET - n
}

/// Global source offsets stay below 2^62, so offset arithmetic cannot overflow.
const MAX_OFFSET: Int = 4611686018427387904

/// Lex `src`, whose first byte is at global offset `base`. The tokens end with `Eof`.
fn lex(src: Str, base: Int) -> Lexed
  requires base >= 0 && base <= MAX_OFFSET - src.len()
  ensures result.tokens.len() > 0 && result.tokens[result.tokens.len() - 1].kind == Kind.Eof
{
  var lx = Lexer {
    s: src
    n: src.len()
    i: 0
    base: base
    tokens: []
    comments: []
    blank_lines: []
    errors: []
    stack: []
    line_has_code: false
  }
  lx.run()
  return Lexed {
    tokens: lx.tokens
    comments: lx.comments
    blank_lines: lx.blank_lines
    errors: lx.errors
  }
}

fn is_digit(c: Char) -> Bool
  ensures result == (c >= '0' && c <= '9')
{
  return c >= '0' && c <= '9'
}

fn is_alpha(c: Char) -> Bool
  ensures result == ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
{
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_word(c: Char) -> Bool
  ensures result == (is_alpha(c) || is_digit(c) || c == '_')
{
  return is_alpha(c) || is_digit(c) || c == '_'
}

fn is_hex(c: Char) -> Bool
  ensures result == ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))
{
  return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn is_blank(c: Char) -> Bool
  ensures result == (c == ' ' || c == '\t' || c == '\r')
{
  return c == ' ' || c == '\t' || c == '\r'
}

/// Bytes in the UTF-8 sequence that starts with `b`.
fn utf8_len(b: Int) -> Int
  ensures result >= 1 && result <= 4
{
  if b < 128 {
    return 1
  }
  if b >= 192 && b < 224 {
    return 2
  }
  if b >= 224 && b < 240 {
    return 3
  }
  if b >= 240 && b < 248 {
    return 4
  }
  return 1
}

fn hex_value(c: Char) -> Int
  requires is_hex(c)
  ensures result >= 0 && result < 16
{
  if is_digit(c) {
    return c as Int - '0' as Int
  }
  if c >= 'a' && c <= 'f' {
    return c as Int - 'a' as Int + 10
  }
  return c as Int - 'A' as Int + 10
}

/// The byte at `i` as a character (`'\0'` past the end).
fn Lexer.at(self, i: Int) -> Char
  ensures result == '\0' || (i >= 0 && i < self.n)
{
  if i < 0 || i >= self.n {
    return '\0'
  }
  return self.s[i] as Char
}

fn Lexer.peek(self, k: Int) -> Char
  requires k >= 0 && k <= 3
  ensures result == '\0' || self.i + k < self.n
{
  return self.at(self.i + k)
}

/// The end of the character at `i`: past its UTF-8 sequence, but not past the source.
fn Lexer.char_end(self, i: Int) -> Int
  requires i >= 0 && i < self.n
  ensures result > i && result <= self.n
{
  let end = i + utf8_len(self.s[i] as Int)
  if end > self.n {
    return self.n
  }
  return end
}

fn Lexer.push(&mut self, kind: Kind, lo: Int, hi: Int)
  requires lo >= 0 && lo <= hi && hi <= self.n
  ensures self.tokens.len() == old(self.tokens.len()) + 1
{
  self.tokens.push(Token { kind: kind, lo: self.base + lo, hi: self.base + hi })
  self.line_has_code = true
}

/// An inserted statement end: zero width, and not code on the line.
fn Lexer.push_semi(&mut self, at: Int)
  requires at >= 0 && at <= self.n
{
  let p = self.base + at
  self.tokens.push(Token { kind: Kind.Semi, lo: p, hi: p })
}

fn Lexer.err(&mut self, code: Str, lo: Int, hi: Int, msg: Str)
  requires lo >= 0 && lo <= hi && hi <= self.n
{
  self.errors.push(Diag { code: code, lo: self.base + lo, hi: self.base + hi, msg: msg })
}

fn Lexer.newlines_significant(self) -> Bool
  ensures result || !self.stack.is_empty()
{
  return match self.stack.last() {
    Some(c) => c != '(' && c != '['
    None => true
  }
}

fn Lexer.last_ends_statement(self) -> Bool
  ensures !result || !self.tokens.is_empty()
{
  return match self.tokens.last() {
    Some(t) => t.kind.ends_statement()
    None => false
  }
}

/// Does the text after the line break before `start` continue the previous expression?
fn Lexer.continues_on_next_line(self, start: Int) -> Bool
  requires start >= 0 && start <= self.n
{
  var j = start
  for invariant j >= start && j <= self.n {
    for j < self.n && (is_blank(self.at(j)) || self.at(j) == '\n')
      invariant j >= start && j <= self.n
    {
      j += 1
    }
    // Skip full-line comments between the lines.
    if j + 1 < self.n && self.at(j) == '/' && self.at(j + 1) == '/' {
      for j < self.n && self.at(j) != '\n' invariant j >= start && j <= self.n {
        j += 1
      }
      continue
    }
    break
  }
  let c = self.at(j)
  let d = self.at(j + 1)
  return (c == '.' && d != '.') || (c == '&' && d == '&') || (c == '|' && d == '|')
}

fn Lexer.newline(&mut self, at: Int)
  requires self.at(at) == '\n'
{
  if self.newlines_significant() &&
    self.last_ends_statement() &&
    !self.continues_on_next_line(at + 1) {
    self.push_semi(at)
  }
  // A blank line (only whitespace) after some content.
  var j = at + 1
  for j < self.n && is_blank(self.at(j)) invariant j > at && j <= self.n {
    j += 1
  }
  if j < self.n && self.at(j) == '\n' && (!self.tokens.is_empty() || !self.comments.is_empty()) {
    self.blank_lines.push(self.base + j + 1)
  }
  self.line_has_code = false
}

fn Lexer.run(&mut self)
  ensures self.tokens.len() > 0 && self.tokens[self.tokens.len() - 1].kind == Kind.Eof
{
  for self.i < self.n {
    let c = self.at(self.i)
    let start = self.i
    if c == '\n' {
      self.newline(self.i)
      self.i += 1
    } else if is_blank(c) {
      self.i += 1
    } else if c == '/' && self.peek(1) == '/' {
      let doc = self.peek(2) == '/' && self.peek(3) != '/'
      for self.i < self.n && self.at(self.i) != '\n' invariant self.i >= start {
        self.i += 1
      }
      var hi = self.i
      for hi > start && is_blank(self.at(hi - 1)) invariant hi >= start && hi <= self.i {
        hi -= 1
      }
      self.comments.push(
        Comment {
          lo: self.base + start
          hi: self.base + hi
          doc: doc
          trailing: self.line_has_code
        },
      )
    } else if is_alpha(c) || c == '_' {
      for self.i < self.n && is_word(self.at(self.i))
        invariant self.i >= start && self.i <= self.n
      {
        self.i += 1
      }
      let kind = keyword(self.s[start..self.i]).unwrap_or(Kind.Ident)
      self.push(kind, start, self.i)
    } else if is_digit(c) {
      self.number()
    } else if c == '"' {
      self.string()
    } else if c == '\'' {
      self.char_lit()
    } else {
      self.punct()
    }
  }
  // Terminate the last statement.
  if self.last_ends_statement() {
    self.push_semi(self.n)
  }
  let p = self.base + self.n
  self.tokens.push(Token { kind: Kind.Eof, lo: p, hi: p })
}

fn Lexer.digits(&mut self)
  ensures self.i >= old(self.i)
{
  let start = self.i
  for self.i < self.n && (is_digit(self.at(self.i)) || self.at(self.i) == '_')
    invariant self.i >= start && self.i <= self.n
  {
    self.i += 1
  }
}

fn Lexer.number(&mut self)
  requires is_digit(self.at(self.i))
  ensures self.i > old(self.i)
{
  let start = self.i
  let after_dot = match self.tokens.last() {
    Some(t) => t.kind == Kind.Dot
    None => false
  }
  var is_float = false
  let p1 = self.peek(1)
  if self.at(self.i) == '0' && (p1 == 'x' || p1 == 'b' || p1 == 'o') {
    self.i += 2
    for self.i < self.n && is_word(self.at(self.i)) invariant self.i > start && self.i <= self.n {
      self.i += 1
    }
  } else {
    // The first digit, then the rest.
    self.i += 1
    self.digits()
    if !after_dot && self.peek(0) == '.' && is_digit(self.peek(1)) {
      is_float = true
      self.i += 1
      self.digits()
    }
    if !after_dot && (self.peek(0) == 'e' || self.peek(0) == 'E') {
      let save = self.i
      self.i += 1
      if self.peek(0) == '+' || self.peek(0) == '-' {
        self.i += 1
      }
      if is_digit(self.peek(0)) {
        is_float = true
        self.digits()
      } else {
        self.i = save
      }
    }
    // A trailing identifier character makes the literal invalid (`12abc`).
    if self.i < self.n && (is_alpha(self.at(self.i)) || self.at(self.i) == '_') {
      for self.i < self.n && is_word(self.at(self.i)) invariant self.i > start && self.i <= self.n {
        self.i += 1
      }
      self.err("E0104", start, self.i, "invalid number literal")
    }
  }
  self.push(if is_float { Kind.Float } else { Kind.Int }, start, self.i)
}

/// At a backslash.
fn Lexer.escape(&mut self)
  requires self.at(self.i) == '\\'
  ensures self.i > old(self.i)
{
  let start = self.i
  self.i += 1
  let c = self.peek(0)
  if c == 'n' || c == 't' || c == 'r' || c == '0' || c == '\\' || c == '"' || c == '\'' {
    self.i += 1
  } else if c == 'u' && self.peek(1) == '{' {
    self.i += 2
    let hs = self.i
    var value = 0
    for self.i < self.n && is_hex(self.at(self.i))
      invariant self.i >= hs && self.i <= self.n && value >= 0
    {
      if value < 1114112 {
        value = value * 16 + hex_value(self.at(self.i))
      }
      self.i += 1
    }
    let digits = self.i - hs
    let ok = self.peek(0) == '}' &&
      digits >= 1 &&
      digits <= 6 &&
      value < 1114112 &&
      (value < 55296 || value > 57343)
    if self.peek(0) == '}' {
      self.i += 1
    }
    if !ok {
      self.err("E0103", start, self.i, "invalid unicode escape")
    }
  } else if c != '\0' && c != '\n' {
    self.i = self.char_end(self.i)
    self.err("E0103", start, self.i, "invalid escape sequence")
  }
}

fn Lexer.string(&mut self)
  requires self.at(self.i) == '"'
  ensures self.i > old(self.i)
{
  let start = self.i
  self.i += 1
  for invariant self.i > start {
    if self.i >= self.n || self.at(self.i) == '\n' {
      self.err("E0102", start, self.i, "unterminated string literal")
      break
    }
    let c = self.at(self.i)
    if c == '"' {
      self.i += 1
      break
    }
    if c == '\\' {
      self.escape()
    } else {
      self.i += 1
    }
  }
  self.push(Kind.Str, start, self.i)
}

fn Lexer.char_lit(&mut self)
  requires self.at(self.i) == '\''
  ensures self.i > old(self.i)
{
  let start = self.i
  self.i += 1
  var count = 0
  for invariant self.i > start && count >= 0 && count < self.i - start {
    if self.i >= self.n || self.at(self.i) == '\n' {
      self.err("E0106", start, self.i, "unterminated character literal")
      break
    }
    let c = self.at(self.i)
    if c == '\'' {
      self.i += 1
      break
    }
    if c == '\\' {
      self.escape()
    } else {
      self.i = self.char_end(self.i)
    }
    count += 1
  }
  if count != 1 {
    self.err("E0106", start, self.i, "a character literal holds exactly one character")
  }
  self.push(Kind.Char, start, self.i)
}

/// A punctuation token and its length in bytes.
struct Punct {
  kind: Kind
  len: Int
  invariant len >= 1 && len <= 3
}

/// The punctuation token at the cursor, if any, from the next three characters: one of two
/// or three characters needs the second (and third) to be there.
fn punct_kind(c: Char, n1: Char, n2: Char) -> Option<Punct>
  ensures match result {
    Some(p) => (p.len == 1 || n1 != '\0') && (p.len <= 2 || n2 != '\0')
    None => true
  }
{
  return match c {
    '(' => Some(Punct { kind: Kind.LParen, len: 1 })
    ')' => Some(Punct { kind: Kind.RParen, len: 1 })
    '{' => Some(Punct { kind: Kind.LBrace, len: 1 })
    '}' => Some(Punct { kind: Kind.RBrace, len: 1 })
    '[' => Some(Punct { kind: Kind.LBracket, len: 1 })
    ']' => Some(Punct { kind: Kind.RBracket, len: 1 })
    ',' => Some(Punct { kind: Kind.Comma, len: 1 })
    '.' => if n1 == '.' {
      Some(Punct { kind: Kind.DotDot, len: 2 })
    } else {
      Some(Punct { kind: Kind.Dot, len: 1 })
    }
    ':' => Some(Punct { kind: Kind.Colon, len: 1 })
    ';' => Some(Punct { kind: Kind.Semi, len: 1 })
    '?' => Some(Punct { kind: Kind.Question, len: 1 })
    '~' => Some(Punct { kind: Kind.Tilde, len: 1 })
    '-' => if n1 == '>' {
      Some(Punct { kind: Kind.Arrow, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.MinusEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Minus, len: 1 })
    }
    '=' => if n1 == '>' {
      Some(Punct { kind: Kind.FatArrow, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.EqEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Eq, len: 1 })
    }
    '&' => if n1 == '&' {
      Some(Punct { kind: Kind.AmpAmp, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.AmpEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Amp, len: 1 })
    }
    '|' => if n1 == '|' {
      Some(Punct { kind: Kind.PipePipe, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.PipeEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Pipe, len: 1 })
    }
    '^' => if n1 == '=' {
      Some(Punct { kind: Kind.CaretEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Caret, len: 1 })
    }
    '!' => if n1 == '=' {
      Some(Punct { kind: Kind.Ne, len: 2 })
    } else {
      Some(Punct { kind: Kind.Bang, len: 1 })
    }
    '<' => if n1 == '<' && n2 == '=' {
      Some(Punct { kind: Kind.ShlEq, len: 3 })
    } else if n1 == '<' {
      Some(Punct { kind: Kind.Shl, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.Le, len: 2 })
    } else {
      Some(Punct { kind: Kind.Lt, len: 1 })
    }
    '>' => if n1 == '>' && n2 == '=' {
      Some(Punct { kind: Kind.ShrEq, len: 3 })
    } else if n1 == '>' {
      Some(Punct { kind: Kind.Shr, len: 2 })
    } else if n1 == '=' {
      Some(Punct { kind: Kind.Ge, len: 2 })
    } else {
      Some(Punct { kind: Kind.Gt, len: 1 })
    }
    '+' => if n1 == '=' {
      Some(Punct { kind: Kind.PlusEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Plus, len: 1 })
    }
    '*' => if n1 == '=' {
      Some(Punct { kind: Kind.StarEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Star, len: 1 })
    }
    '/' => if n1 == '=' {
      Some(Punct { kind: Kind.SlashEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Slash, len: 1 })
    }
    '%' => if n1 == '=' {
      Some(Punct { kind: Kind.PercentEq, len: 2 })
    } else {
      Some(Punct { kind: Kind.Percent, len: 1 })
    }
    _ => None
  }
}

fn Lexer.punct(&mut self)
  requires self.i < self.n
  ensures self.i > old(self.i)
{
  let start = self.i
  let c = self.at(self.i)
  match punct_kind(c, self.peek(1), self.peek(2)) {
    None => {
      self.i = self.char_end(self.i)
      self.err("E0101", start, self.i, "unexpected character `" + self.s[start..self.i] + "`")
    }
    Some(p) => {
      let kind = p.kind
      self.i += p.len
      if kind == Kind.LParen {
        self.stack.push('(')
      } else if kind == Kind.LBracket {
        self.stack.push('[')
      } else if kind == Kind.LBrace {
        self.stack.push('{')
      } else if kind == Kind.RParen || kind == Kind.RBracket || kind == Kind.RBrace {
        let _ = self.stack.pop()
      } else if kind == Kind.Semi {
        self.err("E0107", start, self.i, "semicolons are not used in Jig")
      }
      self.push(kind, start, self.i)
    }
  }
}
